  "discourse_dimensions": [
    {
      "id": "ND-D01",
      "key": "focalization",
      "basis_refs": [
        "LE-D01",
        "LE-D09"
      ],
      "principle": "每个场景只设一个主聚焦者；旁人可形成副视角，但叙述者不得替人物越权知情。"
    },
    {
      "id": "ND-D02",
      "key": "temporal_mediation",
      "basis_refs": [
        "LE-D02",
        "LE-D09",
        "TECH-02",
        "TECH-10"
      ],
      "principle": "事件不必按发生顺序全景重放；后果、错身、转述、中断均可先于解释。"
    },
    {
      "id": "ND-D03",
      "key": "knowledge_aperture",
      "basis_refs": [
        "LE-D06",
        "LE-D13",
        "TECH-04"
      ],
      "principle": "只让读者得到人物行动所能承载的信息；OPEN接口必须精确留白而非普遍含糊。"
    },
    {
      "id": "ND-D04",
      "key": "narrative_distance",
      "basis_refs": [
        "LE-D01",
        "LE-D09"
      ],
      "principle": "近距动作、关系对白与中距转述交替，避免全程作者俯瞰。"
    },
    {
      "id": "ND-D05",
      "key": "relay_channel",
      "basis_refs": [
        "LE-D08",
        "LE-D13",
        "TECH-15"
      ],
      "principle": "消息通过动作、物件、文书、声音、转述和沉默传播，不让旁白包办因果。"
    },
    {
      "id": "ND-D06",
      "key": "scene_breath",
      "basis_refs": [
        "LE-D02",
        "LE-D09",
        "TECH-05",
        "TECH-11"
      ],
      "principle": "场景从普通事务进入，以余波、物件、声音、问题或中断退出，不以主题格言封口。"
    },
    {
      "id": "ND-D07",
      "key": "indirection",
      "basis_refs": [
        "LE-D06",
        "LE-D09",
        "TECH-07",
        "TECH-14"
      ],
      "principle": "重大事件可写可不写正面；必须允许背面傅粉、不写之写和虚实互换。"
    },
    {
      "id": "ND-D08",
      "key": "narrator_restraint",
      "basis_refs": [
        "LE-D02",
        "LE-D07",
        "LE-D12"
      ],
      "principle": "叙述者不替制度、动机、象征和人生意义作总结；程序只写到人物受制。"
    }
  ],
