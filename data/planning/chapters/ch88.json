          22360
        ],
        "text_sha256": "94449cc2d7d85e3d2f2e5e1c07526b41500b6897b0172b44de0a4d182c9dea4f"
      }
    },
    {
      "number": 8,
      "name": "笑料",
      "text": "**8｜笑料**  \n麝月钥匙、药盒、打喷嚏、衣柜卡锁保留。\n\n",
      "citation": {
        "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
        "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
        "lines": [
          550,
          552
        ],
        "byte_range": [
          22360,
          22436
        ],
        "text_sha256": "ec2d98f3491730991cc75b288b4040d6716c5158c9936c1fb5bc93b843f41532"
      }
    },
    {
      "number": 9,
      "name": "宗教/梦",
      "text": "**9｜宗教/梦**  \n迎春“命苦”只许人物俗语；不托梦，不烈女化。\n\n",
      "citation": {
        "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
        "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
        "lines": [
          553,
          555
        ],
        "byte_range": [
          22436,
          22525
        ],
        "text_sha256": "9b86f34b6742dfae929c43948ff738774766e212e4c5c54c27c810672932f8b8"
      }
    },
    {
      "number": 10,
      "name": "职业",
      "text": "**10｜职业**  \n婚嫁跑腿、孙家传信人、蒋家戏业只作为各自生计。\n\n",
      "citation": {
        "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
        "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
        "lines": [
          556,
          558
        ],
        "byte_range": [
          22525,
          22614
        ],
        "text_sha256": "17cf1f4f23998c1b6e7661ef27a7ba2c77a82805b2afda4964f668a7df18e09f"
      }
    },
    {
      "number": 11,
      "name": "四链",
      "text": "**11｜四链**  \n袭线：嫁妆/随身物谁出、哪些属于她。迎线：消息从孙家→娘家→内宅；丧务控制权不在贾府。\n\n",
      "citation": {
        "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
        "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
        "lines": [
          559,
          561
        ],
        "byte_range": [
          22614,
          22761
        ],
        "text_sha256": "ab716736a05ead801e8dc836d4fc75d4441bea728ddc875ec53fc6e4cdee8329"
      }
    },
    {
      "number": 12,
      "name": "必须保留",
      "text": "**12｜必须保留**  \n药盒给麝月、“药陈了可换，盒子别丢”；钥匙；最后日常动作；盆沿“当”声。\n\n",
      "citation": {
        "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
        "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
        "lines": [
          562,
