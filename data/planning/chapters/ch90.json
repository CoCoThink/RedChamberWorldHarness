          26910
        ],
        "text_sha256": "776b7d07b0dedb0de597b4616480b48ee313dcc6dd0a5588eb41108011eb11fe"
      }
    },
    {
      "number": 2,
      "name": "最强处",
      "text": "**2｜最强处**  \n青布夹衣送病妇；宝玉下午反受冷披宝钗披风；空衣钉；凤姐病中仍算米、铺盖、冬物；平儿跑单。\n\n",
      "citation": {
        "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
        "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
        "lines": [
          658,
          660
        ],
        "byte_range": [
          26910,
          27064
        ],
        "text_sha256": "48ca71f39bd96218e8f373e7ea629f7de678063970767b48b9ae1c9eb78e9d3d"
      }
    },
    {
      "number": 3,
      "name": "最薄处",
      "text": "**3｜最薄处**  \n现稿宝玉被劝得略“成功”；凤姐“强”足而“知命”不足。\n\n",
      "citation": {
        "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
        "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
        "lines": [
          661,
          663
        ],
        "byte_range": [
          27064,
          27167
        ],
        "text_sha256": "2f2d2a44c8cf808ed58f6f9cc0524bdb32f37491ee4f6d3503a76532ee0c8bfa"
      }
    },
    {
      "number": 4,
      "name": "缺失情节",
      "text": "**4｜缺失情节**  \n宝钗两次含讽：送衣前指出“如今给出去真少一件”；宝玉受冷后指出“你周全一个，总有人补这个缺”。宝玉承认道理却不承诺改变。凤姐用现实算账承认旧办法回不来。\n\n",
      "citation": {
        "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
        "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
        "lines": [
          664,
