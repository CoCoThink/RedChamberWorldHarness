          11660
        ],
        "text_sha256": "00709f943e80372ebdc9115bd1b9ba9695b28e3d39dec9f2819c2eed6ca862e8"
      }
    },
    {
      "number": 8,
      "name": "笑料",
      "text": "**8｜笑料**  \n小丫头跑急滴水、饭单传错等日常轻笔可保留，不拿元妃死亡开笑。\n\n",
      "citation": {
        "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
        "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
        "lines": [
          309,
          311
        ],
        "byte_range": [
          11660,
          11769
        ],
        "text_sha256": "c63b413d1ac09f8927aec3404dc4c4f34787fcfbd4d917855c96e8f63c06d779"
      }
    },
    {
      "number": 9,
      "name": "宗教/梦",
      "text": "**9｜宗教/梦**  \n丧俗可有；严禁元春托梦解释宫中死因。\n\n",
      "citation": {
        "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
        "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
        "lines": [
          312,
