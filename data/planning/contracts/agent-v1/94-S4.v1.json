  "required_beats": [
    {
      "id": "94-S4-R1",
      "description": "刘姥姥先给住处和饭，再说乡邻可借针线、能搭手的劳动网络；旧恩与社会信用是实际可行的救命机制。",
      "status": "PENDING",
      "scope": "CURRENT_IMPLEMENTATION_REQUIREMENT_NOT_HISTORICAL_FACT",
      "grounding": {
        "seed": {
          "path": "data/prewrite/v06.json",
