  "required_beats": [
    {
      "id": "92-S4-R1",
      "description": "小红先在门外问明能不能送、由谁经手及哪些物品可送，再把规则转告家中和茜雪；贾芸只承接跑腿。",
      "status": "PENDING",
      "scope": "CURRENT_IMPLEMENTATION_REQUIREMENT_NOT_HISTORICAL_FACT",
      "grounding": {
        "seed": {
          "path": "data/prewrite/v06.json",
