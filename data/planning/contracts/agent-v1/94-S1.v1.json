  "required_beats": [
    {
      "id": "94-S1-R1",
      "description": "说亲先显得条件还不错、可议可问；媒人关心说成，王仁先算礼钱，平儿仍需查家情。",
      "status": "PENDING",
      "scope": "CURRENT_IMPLEMENTATION_REQUIREMENT_NOT_HISTORICAL_FACT",
      "grounding": {
        "seed": {
          "path": "data/prewrite/v06.json",
