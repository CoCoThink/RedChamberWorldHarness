  "forbidden_beats": [
    {
      "id": "99-S1-F1",
      "description": "不得玉归即出家、以98《续庄子》因果点化，或靠黛玉/警幻托梦、神谕驱动离家。",
      "status": "PENDING",
      "scope": "AUTHORING_REQUIREMENT_NOT_HISTORICAL_FACT",
      "grounding": {
        "seed": {
          "path": "data/prewrite/v06.json",
          "pointer": "/omitted_scene_plans/18/candidate_scenes/0",
          "ref": "data/prewrite/v06.json#/omitted_scene_plans/18/candidate_scenes/0",
          "sha256": "caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff",
          "text_sha256": "19d0b3a1bd082949a8e53ac46a1f025c165225825222053c224c164b28cef029",
          "value": {
            "id": "99-S1",
            "title": "退出顺序保留，但再明确“不是所有人都看懂”"
          }
        },
        "chapter_card_fields": [
          {
            "citation": {
              "byte_range": [
                48516,
                48652
              ],
              "lines": [
                1211,
                1213
              ],
              "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
              "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
              "text_sha256": "4d940c20ce2ccf5876d98ce58189804461e7f2d293c380db4e44f12f0f34c38b"
            },
            "name": "硬节点",
            "number": 1,
            "text": "**1｜硬节点**  \nR43；P09：撒手时宝钗为妻、麝月为婢状态已成立；O10负责99/100分工。禁止玉归即出家。\n\n"
          },
          {
            "citation": {
              "byte_range": [
                49677,
                49820
              ],
              "lines": [
                1231,
                1233
              ],
              "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
              "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
              "text_sha256": "298b7827a42b8060950276d7070057dfce17bf759e43d4b6b8c904cac0ef652b"
            },
            "name": "诗文身份",
            "number": 7,
            "text": "**7｜诗文身份**  \nG07“无字”强锁：无诀别信、诗、偈。作者层也无诗无偈。98《续庄子》不得成为99因果。\n\n"
          },
          {
            "citation": {
              "byte_range": [
                49917,
                50167
              ],
              "lines": [
                1237,
                1239
              ],
              "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
              "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
              "text_sha256": "df442582d663b0e260423cbe8216b6a1f5cd2e046979778ce3d3ccc2f0ef343f"
            },
            "name": "宗教/梦",
            "number": 9,
            "text": "**9｜宗教/梦**  \n41核心：“情尽未尽”。宝玉不是无情，而是“不想再接”世俗角色。可加一次极短早/晚课：跟诵不熟，小和尚指页，散课马上搬水/看锅。严禁高僧点化、黛玉/警幻托梦。\n\n"
          },
          {
            "citation": {
              "byte_range": [
                50486,
                50630
              ],
              "lines": [
                1246,
                1248
              ],
              "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
              "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
              "text_sha256": "e046fdccc95aec8e61e37820cec4ad06726b3039d65d6e04b111032a006a80a9"
            },
            "name": "必须保留",
            "number": 12,
            "text": "**12｜必须保留**  \n98→99普通日缓冲；无玉触发；“没有，只说我平安”；两人份晚饭；旧衣针仍别在边上。\n\n"
          },
          {
            "citation": {
              "byte_range": [
                50630,
                50755
              ],
              "lines": [
                1249,
                1251
              ],
              "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
              "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
              "text_sha256": "fd1078f64f822afe747f39e993129b7585a2f583727d800a9b1b5cc4c5615d87"
            },
            "name": "应删",
            "number": 13,
            "text": "**13｜应删**  \n人生论文、佛理总结、精神胜利叙述、“终于看破宝钗黛玉”、玉触发、神谕。\n\n"
          }
        ]
      }
    },
