        "chapter_card_fields": [
          {
            "citation": {
              "byte_range": [
                30851,
                31264
              ],
              "lines": [
                772,
                779
              ],
              "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
              "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
              "text_sha256": "747f3dded7f17758329dc18f6add30897c7b5175d8bbaafa7a3dc93209b1f75b"
            },
            "name": "硬节点",
            "number": 1,
            "text": "**1｜硬节点**  \nR05\n\n**EVIDENCE-INTERFACES｜**\n- T2/DRAFT-LABEL：`狱神庙慰宝玉`；\n- V5：`茜雪至狱神庙方呈正文`、`红玉茜雪一大回文字`、`红玉后有宝玉大得力处`；\n- **W2已裁：`狱庙相逢` = OPEN-W2 / NO-ACTIVE-INSERTION。92明确不加巧姐/刘姥姥。**/R30/R31/R32；H01/H02；O02开放具体法律接口。必须是真实羁押/待质，不是地牢传奇。\n\n"
          },
          {
            "citation": {
              "byte_range": [
                31534,
                31700
              ],
              "lines": [
                783,
                785
              ],
              "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
              "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
              "text_sha256": "c04613526fd337f964446697d4e207ceaaadf2335cc01f8654cbb2c1d9c081bf"
            },
            "name": "最薄处",
            "number": 3,
            "text": "**3｜最薄处**  \n“为什么留质—问什么—范围如何变窄—为什么放”需要司法链更清楚；小红“大得力”必须具体而非万能。\n\n"
          },
          {
            "citation": {
              "byte_range": [
                31700,
                31908
              ],
              "lines": [
                786,
                788
              ],
              "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
              "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
              "text_sha256": "4e9955259a25cacca5651767990721298088a9e0a8ab597e8a6de8d12f908d41"
            },
            "name": "缺失情节",
            "number": 4,
            "text": "**4｜缺失情节**  \n92-S1认单≠定罪；S2第一次留质家里不知多久；S3第一夜规则学习；S4小红办能不能送；S5茜雪办保暖；S6第二轮问讯使范围缩小；正常释放。\n\n"
          },
          {
            "citation": {
              "byte_range": [
                32543,
                32693
              ],
              "lines": [
                805,
                807
              ],
              "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
              "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
              "text_sha256": "691f1024a95d253812f2620688e641beb554b5e454142152b155e0e99a7bd18a"
            },
            "name": "职业",
            "number": 10,
            "text": "**10｜职业**  \n本回职业密度最高：狱卒关心班次/规矩，书办关心记录一致，同监关心饭和毡，小红先搞清制度。\n\n"
          },
          {
            "citation": {
              "byte_range": [
                33398,
                33795
              ],
              "lines": [
                826,
                829
              ],
              "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
              "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
              "text_sha256": "fb8033734c34167c334c5c15e4ff3e09d2a92e4fc9451811424991f81a7d1565"
            },
            "name": "章法 / 风险",
            "number": 18,
            "text": "**18｜章法 / 风险**  \n传问等候 → 留质突然发生 → 第一夜规则 → 家中信息断裂 → 小红制度性帮助 → 茜雪旧情保暖 → 第二轮问讯 → 范围收窄 → 正常释放 → 饭香/窄门。  \n**压力测试问题：**是否既有法律可信度又仍是小说；小红帮助是否“大得力”但不传奇；宗教是否真实存在却完全不救案。\n\n"
          }
        ],
