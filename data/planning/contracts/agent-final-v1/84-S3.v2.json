              "text_sha256": "c84c7cd5fc18cd127989e04b61baa8ff4c205108e2dc1a836f2740c518f63cb8"
            },
            "name": "文化",
            "number": 6,
            "text": "**6｜文化**  \n第38禁补；不写挽联展览。\n\n"
          },
          {
            "citation": {
              "byte_range": [
                11550,
                11660
              ],
              "lines": [
                306,
