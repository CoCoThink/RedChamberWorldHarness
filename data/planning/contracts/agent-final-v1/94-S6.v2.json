  "required_beats": [
    {
      "id": "94-S6-R1",
      "description": "包袱到炕、粗饭到鞋跟、鸡狗到纺车，逐项写生活难题；邻人有人好奇、有人嫌娇、有人肯借针线。",
      "status": "PENDING",
      "scope": "CURRENT_IMPLEMENTATION_REQUIREMENT_NOT_HISTORICAL_FACT",
      "grounding": {
        "seed": {
          "path": "data/prewrite/v06.json",
          "pointer": "/omitted_scene_plans/13/candidate_scenes/5",
          "ref": "data/prewrite/v06.json#/omitted_scene_plans/13/candidate_scenes/5",
          "sha256": "caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff",
          "text_sha256": "ec3238c27c8fb1956ca7a9979253c87e3bb5ee7bed64310078275d79395fa39d",
          "value": {
            "id": "94-S6",
            "title": "乡下第一日不是田园解脱"
          }
        },
        "chapter_card_fields": [
          {
            "citation": {
              "byte_range": [
                36447,
                36682
              ],
              "lines": [
                904,
                906
              ],
              "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
              "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
              "text_sha256": "135860b221082b18275aafef2bf4205009dafc102d87d8e2ab245aa30453387e"
            },
            "name": "最强处",
            "number": 2,
            "text": "**2｜最强处**  \n王仁先算礼钱；平儿追问家情；贾母一句“人没问明白，礼倒先算清了”；刘姥姥提供空间、饭、劳动网络；巧姐乡下鞋跟、鸡狗、纺车；两句不定词劳动小曲。\n\n"
          },
          {
            "citation": {
              "byte_range": [
                36815,
                37029
              ],
              "lines": [
                910,
                912
              ],
              "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
              "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
              "text_sha256": "af109a504aacd0b27b977e5c2515968bb574e8172efd225f0d65c1880c8341db"
            },
            "name": "缺失情节",
            "number": 4,
            "text": "**4｜缺失情节**  \n94-S1条件表面不错 → S2平儿逐项核问 → S3只需证明“不对劲”而非人口买卖大阴谋 → S4刘姥姥给空间 → S5小包袱/路费/谁陪 → S6乡下第一日。\n\n"
          },
          {
            "citation": {
              "byte_range": [
                37029,
                37174
              ],
              "lines": [
                913,
                915
              ],
              "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
              "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
              "text_sha256": "ff7f8933d12457b3e1a4116e33233eea38b1bbeb08dc3a3f1fa38ca264c267af"
            },
            "name": "人物",
            "number": 5,
            "text": "**5｜人物**  \n媒人不是恶魔，只关心说成；王仁贪但不必大反派；乡邻有人好奇、有人嫌娇、有人肯借针线。\n\n"
          },
          {
            "citation": {
              "byte_range": [
                37597,
                37662
              ],
              "lines": [
                930,
                932
              ],
              "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
              "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
              "text_sha256": "f7694a45870f0109fefab7dd0e46b9559d3f93ad31ba3da0a728a9892bcd67e6"
            },
            "name": "职业",
            "number": 10,
            "text": "**10｜职业**  \n媒人、车脚、乡妇、邻里、小贩。\n\n"
          },
          {
            "citation": {
              "byte_range": [
                37662,
                37872
              ],
              "lines": [
                933,
                935
              ],
              "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
              "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
              "text_sha256": "23b67b7e92911914f052fc5addfb3743639841fdcd9437fac09d7d9aa0429b40"
            },
            "name": "四链",
            "number": 11,
            "text": "**11｜四链**  \n钱：小额路费/衣物即可；坏亲事的危险首先从定礼、急办、信息含糊显现。物：小包袱→炕→粗饭→鞋→纺线。信：巧姐本人只知“住几日”。\n\n"
          },
          {
            "citation": {
              "byte_range": [
                37872,
                37988
              ],
              "lines": [
                936,
                938
              ],
              "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
              "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
              "text_sha256": "cb54057cd85d931e7aafa9dc6e198b3ebc75e610f9b0eaf03933e473481526bc"
            },
            "name": "必须保留",
            "number": 12,
            "text": "**12｜必须保留**  \n贾母那句；王仁钱先行；刘姥姥不拿大银；鸡狗纺车；不定词小曲。\n\n"
          }
        ]
      }
    },
    {
      "id": "94-S6-R2",
      "description": "保留板儿追鸡改口、巧姐误认平儿及乡下口语的笑；笑里仍有适应和离开旧照料者的成本。",
      "status": "PENDING",
