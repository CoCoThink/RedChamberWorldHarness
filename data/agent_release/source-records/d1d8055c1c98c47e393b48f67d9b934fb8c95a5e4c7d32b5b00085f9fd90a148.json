954947f9cc3d11f9eeb32a6932cc504fd1a5","title":"《大清律例》卷十——居丧嫁娶","type":"HISTORICAL_PRIMARY","witness":{"annotation":"户律·婚姻·居丧嫁娶","label":"《大清律例》卷十","siglum":"DQLL-V10"}}]}
