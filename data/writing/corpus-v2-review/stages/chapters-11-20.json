ge:196"}],"transforms":[]},"record_type":"SEGMENT","section_ref":"chapter:14","segment_id":"hlm80:chapter:14:p00007","text":" \n  诗云：…… \n \n  话说宁国府中都总管来升闻得里面委请了凤姐，因传齐同\n事人等说道：“如今请了西府里琏二奶奶管理内事。倘或他来\n支取东西或是说话，我们须要比往日小心些。每日大家早来晚\n散，宁可辛苦这一个月，过后再歇着，不要把老脸面丢了。","text_sha256":"063ad22e3ecaaf1b71815f033f2f9be1e0d5d9dbb0b409a0b19cd2e2c1148cce"},{"asset_ref":"asset:primary:hlm:zhihui:v3.1416:pdf","chapter":14,"classification":{"human_review":"PENDING","method":"DECLARED_PDF_TYPOGRAPHY_V2","reasons":["DECLARED_ANNOTATION_COLOR","WITNESS_LABEL_GLYPH"],"styles":[{"color":15609134,"font":"00-GBK-EUC-H","size":12.15},{"color":15609134,"font":"KaiTi-GBK-EUC-H","size":12.11}]},"dataset_ref":"corpus:front80:v2-candidate","kind":"ZHIPI","locator":{"extraction_ref":"asset:sha256:1c9dee98f867ea07dade7b69b2b8d3987c5046ddb51e1e377c5e306fd26ba900","spans":[{"end":458,"start":446,"unit_ref":"pdf:page:196"}],"transforms":[]},"record_type":"SEGMENT","section_ref":"chapter:14","segment_id":"hlm80:chapter:14:p00008","text":"庚侧\n此是都总管的话头。","text_sha256":"46df6de43ffa305b031317659f000faed741d30b1893fc75c16f86be3f625538"}],"page_navigation":[{"end":446,"exact_span_text":" \n  诗云：…… \n \n  话说宁国府中都总管来升闻得里面委请了凤姐，因传齐同\n事人等说道：“如今请了西府里琏二奶奶管理内事。倘或他来\n支取东西或是说话，我们须要比往日小心些。每日大家早来晚\n散，宁可辛苦这一个月，过后再歇着，不要把老脸面丢了。","extraction_text_sha256":"1c7d2d85deca7eff7cdc56c7c98de5501d3e85331af63a46ab8bec36e9fc6320","full_pdf":{"asset_ref":"asset:primary:hlm:zhihui:v3.1416:pdf","path":"sources/primary/hongloumeng/zhihui/v3.1416/original.pdf","sha256":"37441da3cb438d1b3eab2b511aa6f1695f309192fa63bea842413ff91655c1d7"},"pdf_page_index_zero_based":195,"physical_page_one_based":196,"start":323,"unit_ref":"pdf:page:196","viewer_fragment":"#page=196"}],"sample":{"reason":"MAIN_TEXT coverage of chapter 14","segment_id":"hlm80:chapter:14:p00007","text_sha256":"063ad22e3ecaaf1b71815f033f2f9be1e0d5d9dbb0b409a0b19cd2e2c1148cce"},"segment":{"asset_ref":"asset:primary:hlm:zhihui:v3.1416:pdf","chapter":14,"classification":{"human_review"