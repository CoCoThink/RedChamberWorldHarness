record_type":"SEGMENT","section_ref":"chapter:49","segment_id":"hlm80:chapter:49:p00006","text":" \n  话说香菱见众人正说笑，他便迎上去笑道：“你们看这一\n首。若使得，我便还学；若还不好，我就死了这作诗的心了。”\n","text_sha256":"b50a369b0efd323a9dac6ead1e55d7efb80055496979bd962bef7eed93be0257"},{"asset_ref":"asset:primary:hlm:zhihui:v3.1416:pdf","chapter":49,"classification":{"human_review":"PENDING","method":"DECLARED_PDF_TYPOGRAPHY_V2","reasons":["DECLARED_ANNOTATION_COLOR","WITNESS_LABEL_GLYPH"],"styles":[{"color":1865405,"font":"00-GBK-EUC-H","size":12.15},{"color":1865405,"font":"KaiTi-GBK-EUC-H","size":12.11}]},"dataset_ref":"corpus:front80:v2-candidate","kind":"ZHIPI","locator":{"extraction_ref":"asset:sha256:1c9dee98f867ea07dade7b69b2b8d3987c5046ddb51e1e377c5e306fd26ba900","spans":[{"end":227,"start":200,"unit_ref":"pdf:page:659"}],"transforms":[]},"record_type":"SEGMENT","section_ref":"chapter:49","segment_id":"hlm80:chapter:49:p00007","text":"蒙侧说“死了心不学”，方是才人“语不惊人死不休”本怀！","text_sha256":"911b3ac49005bc3b2fb87bd30f9fb0952a959b38fb7869de574fe9d9aa5e77fb"}],"page_navigation":[{"end":200,"exact_span_text":" \n  话说香菱见众人正说笑，他便迎上去笑道：“你们看这一\n首。若使得，我便还学；若还不好，我就死了这作诗的心了。”\n","extraction_text_sha256":"bbc6cd3933f213467def451522c55207f4caf1d103825fb32e400e08e234e6d7","full_pdf":{"asset_ref":"asset:primary:hlm:zhihui:v3.1416:pdf","path":"sources/primary/hongloumeng/zhihui/v3.1416/original.pdf","sha256":"37441da3cb438d1b3eab2b511aa6f1695f309192fa63bea842413ff91655c1d7"},"pdf_page_index_zero_based":658,"physical_page_one_based":659,"start":141,"unit_ref":"pdf:page:659","viewer_fragment":"#page=659"}],"sample":{"reason":"MAIN_TEXT coverage of chapter 49","segment_id":"hlm80:chapter:49:p00006","text_sha256":"b50a369b0efd323a9dac6ead1e55d7efb80055496979bd962bef7eed93be0257"},"segment":{"asset_ref":"asset:primary:hlm:zhihui:v3.1416:pdf","chapter":49,"classification":{"human_review":"PENDING","method":"DECLARED_PDF_TYPOGRAPHY_V2","reasons":["DECLARED_MAIN_FONT_SIZE_COLOR"],"styles":[{"color":2301728,"font":"SimSun-GBK-EUC-H","siz