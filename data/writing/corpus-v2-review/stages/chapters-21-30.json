hapter":23,"classification":{"human_review":"PENDING","method":"DECLARED_PDF_TYPOGRAPHY_V2","reasons":["LAYOUT_WHITESPACE"],"styles":[{"color":2301728,"font":"KaiTi-GBK-EUC-H","size":15.58}]},"dataset_ref":"corpus:front80:v2-candidate","kind":"EDITORIAL","locator":{"extraction_ref":"asset:sha256:1c9dee98f867ea07dade7b69b2b8d3987c5046ddb51e1e377c5e306fd26ba900","spans":[{"end":89,"start":87,"unit_ref":"pdf:page:330"}],"transforms":[]},"record_type":"SEGMENT","section_ref":"chapter:23","segment_id":"hlm80:chapter:23:p00005","text":" \n","text_sha256":"e16f1596201850fd4a63680b27f603cb64e67176159be3d8ed78a4403fdb1700"},{"asset_ref":"asset:primary:hlm:zhihui:v3.1416:pdf","chapter":23,"classification":{"human_review":"PENDING","method":"DECLARED_PDF_TYPOGRAPHY_V2","reasons":["DECLARED_MAIN_FONT_SIZE_COLOR"],"styles":[{"color":2301728,"font":"SimSun-GBK-EUC-H","size":15.58}]},"dataset_ref":"corpus:front80:v2-candidate","kind":"MAIN_TEXT","locator":{"extraction_ref":"asset:sha256:1c9dee98f867ea07dade7b69b2b8d3987c5046ddb51e1e377c5e306fd26ba900","spans":[{"end":414,"start":89,"unit_ref":"pdf:page:330"}],"transforms":[]},"record_type":"SEGMENT","section_ref":"chapter:23","segment_id":"hlm80:chapter:23:p00006","text":" \n  话说贾元春自那日幸大观园回宫去后，便命将那日所有的\n题咏，命探春依次抄录妥协，自己编次，叙其优劣，又命在大\n观园勒石，为千古风流雅事。因此，贾政命人各处选拔精工名\n匠，在大观园磨石镌字，贾珍率领蓉、萍等监工。因贾蔷又管\n理着文官等十二个女戏并行头等事，不大得便，因此贾珍又将\n贾菖、贾菱唤来监工。一日，烫蜡钉朱，动起手来。这也不在\n话下。 \n  且说那个玉皇庙并达摩庵两处，一班的十二个小沙弥并十\n二个小道士，如今挪出大观园来，贾政正想发到各庙去分住。\n不想后街上住的贾芹之母周氏，正盘算着也要到贾政这边谋一\n个大小事务与儿子管管，也好弄些银钱使用，可巧听见这件事\n出来，便坐轿子来求凤姐。凤姐因见他素日不大拿班作势的，\n便依允了，想了几句话","text_sha256":"d3a7fa3d112cd5f2fb366aa3b3f3864408697426cf6acd1165fb813d9769d918"},{"asset_ref":"asset:primary:hlm:zhihui:v3.1416:pdf","chapter":23,"classification":{"human_review":"PENDING","method":"DECLARED_PDF_TYPOGRAPHY_V2","reasons":["DECLARED_ANNOTATION_COLOR","WITNESS_LABEL_GLYPH"],"styles":[{"color":15609134,"font":"00-GBK-EUC-H","size":12.15},{"color":15609134,"font":"KaiTi-GBK-EUC-H","size":12.11}]},"dataset_ref":"corpu