004","text":" \n  题曰： \n    十二花容色最新，不知谁是惜花人？ \n    相逢若问名何氏？家住江南姓本秦。 \n \n  话说周瑞家的送了刘姥姥去后，便上来回王夫人话。","text_sha256":"93d9175395a5a0781117e720b453b5cbbc2d171c78ad35e3e16ee4387d882f13"},{"asset_ref":"asset:primary:hlm:zhihui:v3.1416:pdf","chapter":7,"classification":{"human_review":"PENDING","method":"DECLARED_PDF_TYPOGRAPHY_V2","reasons":["DECLARED_ANNOTATION_COLOR","WITNESS_LABEL_GLYPH"],"styles":[{"color":15609134,"font":"00-GBK-EUC-H","size":12.15},{"color":15609134,"font":"KaiTi-GBK-EUC-H","size":12.11}]},"dataset_ref":"corpus:front80:v2-candidate","kind":"ZHIPI","locator":{"extraction_ref":"asset:sha256:1c9dee98f867ea07dade7b69b2b8d3987c5046ddb51e1e377c5e306fd26ba900","spans":[{"end":229,"start":203,"unit_ref":"pdf:page:112"}],"transforms":[]},"record_type":"SEGMENT","section_ref":"chapter:7","segment_id":"hlm80:chapter:7:p00005","text":"甲侧不\n回凤姐，却回王夫人，不交代处，正交代得清楚。","text_sha256":"6817e3a62ab2c6a44f2348ec806e6684e98f104bd366138098ab8e727745d519"}],"page_navigation":[{"end":203,"exact_span_text":" \n  题曰： \n    十二花容色最新，不知谁是惜花人？ \n    相逢若问名何氏？家住江南姓本秦。 \n \n  话说周瑞家的送了刘姥姥去后，便上来回王夫人话。","extraction_text_sha256":"05f7c5f36a8df1567964852929e97be694b98111f0f45ec3306cc4b1414879b4","full_pdf":{"asset_ref":"asset:primary:hlm:zhihui:v3.1416:pdf","path":"sources/primary/hongloumeng/zhihui/v3.1416/original.pdf","sha256":"37441da3cb438d1b3eab2b511aa6f1695f309192fa63bea842413ff91655c1d7"},"pdf_page_index_zero_based":111,"physical_page_one_based":112,"start":123,"unit_ref":"pdf:page:112","viewer_fragment":"#page=112"}],"sample":{"reason":"MAIN_TEXT coverage of chapter 7","segment_id":"hlm80:chapter:7:p00004","text_sha256":"93d9175395a5a0781117e720b453b5cbbc2d171c78ad35e3e16ee4387d882f13"},"segment":{"asset_ref":"asset:primary:hlm:zhihui:v3.1416:pdf","chapter":7,"classification":{"human_review":"PENDING","method":"DECLARED_PDF_TYPOGRAPHY_V2","reasons":["DECLARED_MAIN_FONT_SIZE_COLOR"],"styles":[{"color":2301728,"font":"SimSun-GBK-EUC-H","size":15.58}]},"dataset_ref":"corpus:front80: