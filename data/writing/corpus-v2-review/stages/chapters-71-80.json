05,"font":"00-GBK-EUC-H","size":15.61},{"color":1865405,"font":"KaiTi-GBK-EUC-H","size":15.58}]},"dataset_ref":"corpus:front80:v2-candidate","kind":"ZHIPI","locator":{"extraction_ref":"asset:sha256:1c9dee98f867ea07dade7b69b2b8d3987c5046ddb51e1e377c5e306fd26ba900","spans":[{"end":96,"start":63,"unit_ref":"pdf:page:1088"}],"transforms":[]},"record_type":"SEGMENT","section_ref":"chapter:79","segment_id":"hlm80:chapter:79:p00003","text":"戚静含天地自宽，动荡吉凶难定。一啄一饮系生成，何必\n梦中说醒。 \n","text_sha256":"af9bc9ff88d991c36b9be88fadcf4d24d3339033f620aec35800a436b6079b88"},{"asset_ref":"asset:primary:hlm:zhihui:v3.1416:pdf","chapter":79,"classification":{"human_review":"PENDING","method":"DECLARED_PDF_TYPOGRAPHY_V2","reasons":["DECLARED_MAIN_FONT_SIZE_COLOR"],"styles":[{"color":2301728,"font":"SimSun-GBK-EUC-H","size":15.58}]},"dataset_ref":"corpus:front80:v2-candidate","kind":"MAIN_TEXT","locator":{"extraction_ref":"asset:sha256:1c9dee98f867ea07dade7b69b2b8d3987c5046ddb51e1e377c5e306fd26ba900","spans":[{"end":584,"start":96,"unit_ref":"pdf:page:1088"}],"transforms":[]},"record_type":"SEGMENT","section_ref":"chapter:79","segment_id":"hlm80:chapter:79:p00004","text":" \n  话说宝玉祭完了晴雯，只听花影中有人声，倒唬了一跳。\n及走出来细看，不是别人，却是林黛玉，满面含笑，口内说道：\n“好新奇的祭文！可与曹娥碑并传的了。”宝玉听了，不觉红\n了脸，笑答道：“我想着世上这些祭文都蹈于熟滥了，所以改\n个新样，原不过是我一时的顽意，谁知又被你听见了。有什么\n大使不得的，何不改削改削。” \n  黛玉道：“原稿在那里？倒要细细一读。长篇大论，不知\n说的是什么，只听见中间两句，什么‘红绡帐里，公子多情，\n黄土垄中，女儿薄命。’这一联意思却好，只是‘红绡帐里’\n未免熟滥些。放着现成真事，为什么不用？”宝玉忙问：“什\n么现成的真事？”黛玉笑道：“咱们如今都系霞影纱糊的窗槅，\n何不说‘茜纱窗下，公子多情’呢？”宝玉听了，不禁跌足笑\n道：“好极，是极！到底是你想的出，说的出。可知天下古今\n现成的好景妙事尽多，只是愚人蠢子说不出想不出罢了。但只\n一件：虽然这一改新妙之极，但你居此则可，在我实不敢当。”\n说着，又接连说了一二百句“不敢”。 \n  黛玉笑道：“何妨。我的窗即可为你之窗，何必分晰得如\n此生疏。古人异姓陌路，尚然同肥马，衣轻裘，敝之而无憾，\n","text_sha256":"058fa21d475e869b90eb34e3db26867b0c4475a543f0832aad128b6eac388e16"},{"asset_ref":"asset:primary:hlm:zhihui:v3.1416:pdf","chapter":79,"classification":{"human_review":"PENDING","method":"DECLARED_PDF_TYPOGRAPHY_V2","reasons":["HEADER_FOOTNOTE_TITLE_OR_COLLATION_MARKER","INVISIBLE_TEXT","WATERMARK_FONT"],"styles":[{