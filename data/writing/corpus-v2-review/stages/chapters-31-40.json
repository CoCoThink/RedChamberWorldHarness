46ddb51e1e377c5e306fd26ba900","spans":[{"end":303,"start":231,"unit_ref":"pdf:page:509"}],"transforms":[]},"record_type":"SEGMENT","section_ref":"chapter:37","segment_id":"hlm80:chapter:37:p00007","text":" \n  这年贾政又点了学差，择于八月二十日起身。是日拜过宗\n祠及贾母起身，宝玉诸子弟等送至洒泪亭。 \n  却说贾政出门去后，外面诸事不能多记。\n","text_sha256":"169be34dd3fefabcbf50382b893d3b87baf0edf80d80dd6fbbac3bf6ec5950c5"},{"asset_ref":"asset:primary:hlm:zhihui:v3.1416:pdf","chapter":37,"classification":{"human_review":"PENDING","method":"DECLARED_PDF_TYPOGRAPHY_V2","reasons":["HEADER_FOOTNOTE_TITLE_OR_COLLATION_MARKER"],"styles":[{"color":2301728,"font":"SimSun-GBK-EUC-H","size":8.1}]},"dataset_ref":"corpus:front80:v2-candidate","kind":"EDITORIAL","locator":{"extraction_ref":"asset:sha256:1c9dee98f867ea07dade7b69b2b8d3987c5046ddb51e1e377c5e306fd26ba900","spans":[{"end":304,"start":303,"unit_ref":"pdf:page:509"}],"transforms":[]},"record_type":"SEGMENT","section_ref":"chapter:37","segment_id":"hlm80:chapter:37:p00008","text":"①","text_sha256":"9e96ca1ce18ffb97f67c1230d8282320058da75aa86fc44fb435d25c512a5423"}],"page_navigation":[{"end":303,"exact_span_text":" \n  这年贾政又点了学差，择于八月二十日起身。是日拜过宗\n祠及贾母起身，宝玉诸子弟等送至洒泪亭。 \n  却说贾政出门去后，外面诸事不能多记。\n","extraction_text_sha256":"c6e7f646101e26f73cdf34265951b1b0d02fb80ad5fdbafa96c80b69acabb0bf","full_pdf":{"asset_ref":"asset:primary:hlm:zhihui:v3.1416:pdf","path":"sources/primary/hongloumeng/zhihui/v3.1416/original.pdf","sha256":"37441da3cb438d1b3eab2b511aa6f1695f309192fa63bea842413ff91655c1d7"},"pdf_page_index_zero_based":508,"physical_page_one_based":509,"start":231,"unit_ref":"pdf:page:509","viewer_fragment":"#page=509"}],"sample":{"reason":"MAIN_TEXT coverage of chapter 37","segment_id":"hlm80:chapter:37:p00007","text_sha256":"169be34dd3fefabcbf50382b893d3b87baf0edf80d80dd6fbbac3bf6ec5950c5"},"segment":{"asset_ref":"asset:primary:hlm:zhihui:v3.1416:pdf","chapter":37,"classification":{"human_review":"PENDING","method":"DECLARED_PDF_TYPOGRAPHY_V2","reasons":["DECLARED_MAIN_FONT_SIZE_COLOR"],"styles":[{"color":2301728,"font":"SimSun-GBK-EUC-H","size":15.58}]},"dataset_ref":"corpus:front80:v2-candidate","kind":"MAIN_TEXT","locator":{"extraction_ref":"asset:sha256:1c9dee98f867ea07dade7b69b2b8d3987c5046ddb51e1e377c5e306fd26ba900","spans":[{"end":303,"start":231,"unit_ref":"pdf:page:509"}],"transforms":[]},"record_type":"SEGMENT","section_ref":"chapter:37","segment_id":"hlm80:chapter:37:p00007","text":" \n  这年贾政又点了学差，择于八月二十日起身。是日拜过宗\n祠及贾母起身，宝玉诸子弟等送至洒泪亭。 \n  却说贾政出门去后，外面诸事不能多记。\n","text_sha256":"169be34dd3fefabcbf50382b893d3b87baf0edf80d80dd6fbbac3bf6ec5950c5"}},{"adjacent_segments":[{"asset_ref":"asset:primary:hlm:zhihui:v3.1416:pdf","chapter":38,"classification":{"human_review":"PENDING","method":"DECLARED_PDF_TYPOGRAPHY_V2","reasons":["DECLARED_ANNOTATION_COLOR","WITNESS_LABEL_GLYPH"],"styles":[{"color":8032840,"font":"00-GBK-EUC-H","size":15.61},{"color":8032840,"font":"KaiTi-GBK-EUC-H","size":15.58}]},"dataset_ref":"corpus:front80:v2-candidate","kind":"ZHIPI","locator":{"extraction_ref":"asset:sha256:1c9dee98f867ea07dade7b69b2b8d3987c5046ddb51e1e377c5e306fd26ba900","spans":[{"end":176,"start":62,"unit_ref":"pdf:page:526"}],"transforms":[]},"record_type":"SEGMENT","section_ref":"chapter:38","segment_id":"hlm80:chapter:38:p00003","text":"己题曰“菊花诗”“螃蟹咏”，偏自太君前阿凤若许诙谐\n中不失体、鸳鸯平儿宠婢中多少放肆之迎合取乐写来，似难入\n题，却轻轻用弄水戏鱼看花等游玩事及王夫人云“这里风大”\n一句收住入题，并无纤毫牵强。此重作轻抹法也。妙极，好看\n煞！ \n","text_sha256":"bc337db734b039c832ecca368c3e308969171f5fb0a1cee1d837013cf0736563"},{"asset_ref":"asset:primary:hlm:zhihui:v3.1416:pdf","chapter":38,"classification":{"human_review":"PENDING","method":"DECLARED_PDF_TYPOGRAPHY_V2","reasons":["DECLARED_MAIN_FONT_SIZE_COLOR"],"styles":[{"color":2301728,"font":"SimSun-GBK-EUC-H","size":15.58}]},"dataset_ref":"corpus:front80:v2-candidate","kind":"MAIN_TEXT","locator":{"extraction_ref":"asset:sha256:1c9dee98f867ea07dade7b69b2b8d3987c5046ddb51e1e377c5e306fd26ba900","spans":[{"end":236,"start":176,"unit_ref":"pdf:page:526"}],"transforms":[]},"record_type":"SEGMENT","section_ref":"chapter:38","segment_id":"hlm80:chapter:38:p00004","text":" \n  话说宝钗湘云二人计议已妥，一宿无话。湘云次日便请贾\n母等赏桂花。贾母等都说道：“是他有兴头，须要扰他这雅兴。”\n","text_sha256":"722255e0e965faafb324af617702710f97d2755309643f0d9931302511be3b03"},{"asset_ref":"asset:primary:hlm:zhihui:v3.1416:pdf","chapter":38,"classification":{"human_review":"PENDING","method":"DECLARED_PDF_TYPOGRAPHY_V2","reasons":["DECLARED_ANNOTATION_COLOR","WITNESS_LABEL_GLYPH"],"styles":[{"color":8032840,"font":"00-GBK-EUC-H","size":12.15},{"color":8032840,"font":"KaiTi-GBK-EUC-H","size":12.11}]},"dataset_ref":"corpus:front80:v2-candidate","kind":"ZHIPI","locator":{"extraction_ref":"asset:sha256:1c9dee98f867ea07dade7b69b2b8d3987c5046ddb51e1e377c5e306fd26ba900","spans":[{"end":273,"start":236,"unit_ref":"pdf:page:526"}],"transforms":[]},"record_type":"SEGMENT","section_ref":"chapter:38","segment_id":"hlm80:chapter:38:p00005","text":"己夹若在世俗小家，则云：“你是客，在我们舍下，怎么反扰你的？”一何可笑。\n","text_sha256":"e278e98be413cb81c8fc56bb2cee9274e9e4466ce028c779b862f4c214b838f0"}],"page_navigation":[{"end":236,"exact_span_text":" \n  话说宝钗湘云二人计议已妥，一宿无话。湘云次日便请贾\n母等赏桂花。贾母等都说道：“是他有兴头，须要扰他这雅兴。”\n","extraction_text_sha256":"c00841e946df694c3b39b3ac7c76175ee0eff05cee26c947b689c0382cf15c5f","full_pdf":{"asset_ref":"asset:primary:hlm:zhihui:v3.1416:pdf","path":"sources/primary/hongloumeng/zhihui/v3.1416/original.pdf","sha256":"37441da3cb438d1b3eab2b511aa6f1695f309192fa63bea842413ff91655c1d7"},"pdf_page_index_zero_based":525,"physical_page_one_based":526,"start":176,"unit_ref":"pdf:page:526","viewer_fragment":"#page=526"}],"sample":{"reason":"MAIN_TEXT coverage of chapter 38","segment_id":"hlm80:chapter:38:p00004","text_sha256":"722255e0e965faafb324af617702710f97d2755309643f0d9931302511be3b03"},"segment":{"asset_ref":"asset:primary:hlm:zhihui:v3.1416:pdf","chapter":38,"classification":{"human_review":"PENDING","method":"DECLARED_PDF_TYPOGRAPHY_V2","reasons":["DECLARED_MAIN_FONT_SIZE_COLOR"],"styles":[{"color":2301728,"font":"SimSun-GBK-EUC-H","size":15.58}]},"dataset_ref":"corpus:front80:v2-candidate","kind":"MAIN_TEXT","locator":{"extraction_ref":"asset:sha256:1c9dee98f867ea07dade7b69b2b8d3987c5046ddb51e1e377c5e306fd26ba900","spans":[{"end":236,"start":176,"unit_ref":"pdf:page:526"}],"transforms":[]},"record_type":"SEGMENT","section_ref":"chapter:38","segment_id":"hlm80:chapter:38:p00004","text":" \n  话说宝钗湘云二人计议已妥，一宿无话。湘云次日便请贾\n母等赏桂花。贾母等都说道：“是他有兴头，须要扰他这雅兴。”\n","text_sha256":"722255e0e965faafb324af617702710f97d2755309643f0d9931302511be3b03"}},{"adjacent_segments":[{"asset_ref":"asset:primary:hlm:zhihui:v3.1416:pdf","chapter":39,"classification":{"human_review":"PENDING","method":"DECLARED_PDF_TYPOGRAPHY_V2","reasons":["DECLARED_ANNOTATION_COLOR","WITNESS_LABEL_GLYPH"],"styles":[{"color":1865405,"font":"00-GBK-EUC-H","size":15.61},{"color":1865405,"font":"KaiTi-GBK-EUC-H","size":15.58}]},"dataset_ref":"corpus:front80:v2-candidate","kind":"ZHIPI","locator":{"extraction_ref":"asset:sha256:1c9dee98f867ea07dade7b69b2b8d3987c5046ddb51e1e377c5e306fd26ba900","spans":[{"end":98,"start":62,"unit_ref":"pdf:page:537"}],"transforms":[]},"record_type":"SEGMENT","section_ref":"chapter:39","segment_id":"hlm80:chapter:39:p00003","text":"戚只为贫寒不拣行，富家趋入且逢迎。岂知着意无名利，\n便是三才最上乘。 \n","text_sha256":"31a232dd09330bb0883b20e0ce54694867536afbd3ddfdf9483b30a04b9a3f45"},{"asset_ref":"asset:primary:hlm:zhihui:v3.1416:pdf","chapter":39,"classification":{"human_review":"PENDING","method":"DECLARED_PDF_TYPOGRAPHY_V2","reasons":["DECLARED_MAIN_FONT_SIZE_COLOR"],"styles":[{"color":2301728,"font":"SimSun-GBK-EUC-H","size":15.58}]},"dataset_ref":"corpus:front80:v2-candidate","kind":"MAIN_TEXT","locator":{"extraction_ref":"asset:sha256:1c9dee98f867ea07dade7b69b2b8d3987c5046ddb51e1e377c5e306fd26ba900","spans":[{"end":591,"start":98,"unit_ref":"pdf:page:537"}],"transforms":[]},"record_type":"SEGMENT","section_ref":"chapter:39","segment_id":"hlm80:chapter:39:p00004","text":" \n  话说众人见平儿来了，都说：“你们奶奶作什么呢，怎么\n不来了？”平儿笑道：“他那里得空儿来。因为说没有好生吃\n得，又不得来，所以叫我来问还有没有，叫我要几个拿了家去\n吃罢。”湘云道：“有，多着呢。”忙令人拿了十个极大的。\n平儿道：“多拿几个团脐的。”众人又拉平儿坐，平儿不肯。\n李纨拉着他笑道：“偏要你坐。”拉着他身边坐下，端了一杯\n酒送到他嘴边。平儿忙喝了一口就要走。李纨道：“偏不许你\n去。显见得只有凤丫头，就不听我的话了。”说着又命嬷嬷们：\n“先送了盒子去，就说我留下平儿了。”那婆子一时拿了盒子\n回来说：“二奶奶说，叫奶奶和姑娘们别笑话要嘴吃。这个盒\n子里是方才舅太太那里送来的菱粉糕和鸡油卷儿，给奶奶姑娘\n们吃的。”又向平儿道：“说使你来你就贪住顽不去了。劝你\n少喝一杯儿罢。”平儿笑道：“多喝了又把我怎么样？”一面\n说，一面只管喝，又吃螃蟹。李纨揽着他笑道：“可惜这么个\n好体面模样儿，命却平常，只落得屋里使唤。不知道的人，谁\n不拿你当作奶奶太太看。” \n  平儿一面和宝钗湘云等吃喝，一面回头笑道：“奶奶，别\n只摸的我怪痒的。”李氏道：“嗳哟！这硬的是什么？”平儿\n","text_sha256":"d94cb95a8664b6a2c74dd6ce890bc7a6304d6c293126e102c58236347e0041b5"},{"asset_ref":"asset:primary:hlm:zhihui:v3.1416:pdf","chapter":39,"classification":{"human_review":"PENDING","method":"DECLARED_PDF_TYPOGRAPHY_V2","reasons":["HEADER_FOOTNOTE_TITLE_OR_COLLATION_MARKER","INVISIBLE_TEXT"],"styles":[{"color":2301728,"font":"KaiTi-GBK-EUC-H","size":10.38},{"color":16777215,"font":"TimesNewRomanPSMT","size":1.18},{"color":2301728,"font":"TimesNewRomanPSMT","size":10.38}]},"dataset_ref":"corpus:front80:v2-candidate","kind":"EDITORIAL","locator":{"extraction_ref":"asset:sha256:1c9dee98f867ea07dade7b69b2b8d3987c5046ddb51e1e377c5e306fd26ba900","spans":[{"end":45,"start":0,"unit_ref":"pdf:page:538"}],"transforms":[]},"record_type":"SEGMENT","section_ref":"chapter:39","segment_id":"hlm80:chapter:39:p00005","text":"第三十九回 村姥姥是信口开河 情哥哥偏寻根究底 \nwww.hlmbbs.com \n527\n","text_sha256":"9fae242bfb73497085ec8f4aae78ec43fbe3c0af7d20c70399739118fcfb0287"}],"page_navigation":[{"end":591,"exact_span_text":" \n  话说众人见平儿来了，都说：“你们奶奶作什么呢，怎么\n不来了？”平儿笑道：“他那里得空儿来。因为说没有好生吃\n得，又不得来，所以叫我来问还有没有，叫我要几个拿了家去\n吃罢。”湘云道：“有，多着呢。”忙令人拿了十个极大的。\n平儿道：“多拿几个团脐的。”众人又拉平儿坐，平儿不肯。\n李纨拉着他笑道：“偏要你坐。”拉着他身边坐下，端了一杯\n酒送到他嘴边。平儿忙喝了一口就要走。李纨道：“偏不许你\n去。显见得只有凤丫头，就不听我的话了。”说着又命嬷嬷们：\n“先送了盒子去，就说我留下平儿了。”那婆子一时拿了盒子\n回来说：“二奶奶说，叫奶奶和姑娘们别笑话要嘴吃。这个盒\n子里是方才舅太太那里送来的菱粉糕和鸡油卷儿，给奶奶姑娘\n们吃的。”又向平儿道：“说使你来你就贪住顽不去了。劝你\n少喝一杯儿罢。”平儿笑道：“多喝了又把我怎么样？”一面\n说，一面只管喝，又吃螃蟹。李纨揽着他笑道：“可惜这么个\n好体面模样儿，命却平常，只落得屋里使唤。不知道的人，谁\n不拿你当作奶奶太太看。” \n  平儿一面和宝钗湘云等吃喝，一面回头笑道：“奶奶，别\n只摸的我怪痒的。”李氏道：“嗳哟！这硬的是什么？”平儿\n","extraction_text_sha256":"e71ca8da4ddfabf485020e9a