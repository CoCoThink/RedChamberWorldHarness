{"actors":[{"duty":"普通病日、改字未成与长期病程终点；不预知死期。","id":"daiyu","identity_record":{"id":"daiyu","name":"林黛玉"},"name":"黛玉","provenance":"COORDINATOR_EDITORIAL_CHOICE_NOT_EVIDENCE","registration":"EXISTING_IDENTITY_ONLY"},{"duty":"持续床边照护，观察突变后托雪雁报病危；死后料理身体，不翻稿。","id":"zijuan","identity_record":{"id":"zijuan","name":"紫鹃"},"name":"紫鹃","provenance":"COORDINATOR_EDITORIAL_CHOICE_NOT_EVIDENCE","registration":"EXISTING_IDENTITY_ONLY"},{"duty":"迟获病危消息才赶来，到场问药后获告死亡发生及相对经过；精确死时、医学判定的生理过程和医学死因仍未知，不赶上最后一息。","id":"baoyu","identity_record":{"id":"baoyu","name":"贾宝玉"},"name":"宝玉","provenance":"COORDINATOR_EDITORIAL_CHOICE_NOT_EVIDENCE","registration":"EXISTING_IDENTITY_ONLY"},{"duty":"协助照护，受托传病危消息至宝玉；与请医跑腿分开，不捏造现存ID、路线或地点。","id":"local:ch86:xueyan","name":"雪雁","provenance":"COORDINATOR_EDITORIAL_CHOICE_NOT_EVIDENCE","registration":"NEW_LOCAL_IDENTITY"},{"duty":"承接一次米汤或热水交接，保留独立实务出场；不设置床边告别，不默认目击死亡。","id":"baochai","identity_record":{"id":"baochai","name":"薛宝钗"},"name":"宝钗","provenance":"COORDINATOR_EDITORIAL_CHOICE_NOT_EVIDENCE","registration":"EXISTING_IDENTITY_ONLY"},{"duty":"选择死后接到通知再接手热水衣物的第一轮身体料理；须补传播与到场事件。","id":"liwan","identity_record":{"id":"liwan","name":"李纨"},"name":"李纨","provenance":"COORDINATOR_EDITORIAL_CHOICE_NOT_EVIDENCE","registration":"EXISTING_IDENTITY_ONLY"},{"duty":"选择获死讯后分派第一轮后事和持续劳务；不设围哭或默认亲见死亡。","id":"wangfuren","identity_record":{"id":"wangfuren","name":"王夫人"},"name":"王夫人","provenance":"COORDINATOR_EDITORIAL_CHOICE_NOT_EVIDENCE","registration":"EXISTING_IDENTITY_ONLY"},{"duty":"别处普通事务绊住，由请医链反馈；不新增具体病家、诊断、时辰或已到床边事实。","id":"local:ch86:doctor","name":"医者","provenance":"COORDINATOR_EDITORIAL_CHOICE_NOT_EVIDENCE","registration":"NEW_LOCAL_IDENTITY"},{"duty":"请医并带回现实延误反馈；不兼作雪雁的病危报信，以免两链混淆。","id":"local:ch86:doctor-runner","name":"请医跑腿","provenance":"COORDINATOR_EDITORIAL_CHOICE_NOT_EVIDENCE","registration":"NEW_LOCAL_IDENTITY"}],"authority_effect":"NONE","before":[["ordinary_care","doctor_feedback"],["doctor_feedback","unfinished_revision"],["unfinished_revision","rapi