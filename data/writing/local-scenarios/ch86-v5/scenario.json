OBSERVED"},{"description":"请医跑腿携延误反馈返回，和雪雁病危消息分链。","effects":[],"execution":"NOT_OBSERVED","id":"doctor_reply_sent","observed_facts":[],"participants":["local:ch86:doctor-runner"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"请医反馈到达紫鹃；不表示医者已到床边。","effects":[{"basis":{"id":"doctor-reply","kind":"MESSAGE"},"from":"NOT_KNOWN","reason":"局部计划中的观察/送达，不声明已发生或已在正文实现。","target":"actor.zijuan.knowledge.doctor_delayed","to":"KNOWS"}],"execution":"NOT_OBSERVED","id":"doctor_feedback","observed_facts":[],"participants":["local:ch86:doctor-runner","zijuan"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"伸手改字而未成；G01空字不补，紫鹃不翻稿。身体能做多少仍UNKNOWN，不编中止机制。","effects":[],"execution":"NOT_OBSERVED","id":"unfinished_revision","observed_facts":[],"participants":["daiyu","zijuan"],"requires":[{"target":"actor.daiyu.life_state","value":"ACTIVE"}],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"观察最后突变后才报病危，不把长病程等同本刻预知。","effects":[{"basis":{"kind":"OBSERVATION"},"from":"NOT_KNOWN","reason":"局部计划中的观察/送达，不声明已发生或已在正文实现。","target":"actor.zijuan.knowledge.critical_decline","to":"KNOWS"},{"basis":{"kind":"OBSERVATION"},"from":"NOT_KNOWN","reason":"局部计划中的观察/送达，不声明已发生或已在正文实现。","target":"actor.local:ch86:xueyan.knowledge.critical_decline","to":"KNOWS"}],"execution":"NOT_OBSERVED","id":"rapid_decline_observed","observed_facts":["critical_decline"],"participants":["daiyu","zijuan","local:ch86:xueyan"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"雪雁受托携病危消息出发；内容不含尚未发生的死时。","effects":[],"execution":"NOT_OBSERVED","id":"critical_message_dispatched","observed_facts":[],"participants":["local:ch86:xueyan","zijuan"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"紫鹃目击死亡，生命终点来自长期病程，不归因婚姻、失玉或缺药。","effects":[{"from":"ACTIVE","reason":"新编辑模型的死亡节点，不回写Evidence Truth。","target":"actor.daiyu.life_state","to":"DEAD"},{"basis":{"kind":"OBSERVATION"},"from":"NOT_KNOWN","reason":"局部计划中的观察/送达，不声明已发生或已在正文实现。","target":"actor.zijuan.knowledge.death_occurred","to":"KNOWS"},{"basis":{"kind":"OBSERVATION"},"from":"NOT_KNOWN","reason":"局部计划中的观察/送达，不声明已发生或已在正文实现。","target":"actor.zijuan.knowledge.death_relative_account","to":"KNOWS"}],"execution":"NOT_OBSERVED","id":"death_witnessed","observed_facts":["death_occurred","death_relative_account"],"participants":["daiyu","zijuan"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"先处理身体、热水衣物；不追加礼俗清单或抒情长哭。","effects":[],"execution":"NOT_OBSERVED","id":"body_care_started","observed_facts":[],"participants":["zijuan"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"新增明确编辑选择：请医跑腿在返回后的劳务中看见已死身体，承担后事通知；不知确切死时。","effects":[{"basis":{"kind":"OBSERVATION"},"from":"NOT_KNOWN","reason":"局部计划中的观察/送达，不声明已发生或已在正文实现。","target":"actor.local:ch86:doctor-runner.knowledge.death_occurred","to":"KNOWS"}],"execution":"NOT_OBSERVED","id":"runner_observes_death","observed_facts":["death_occurred"],"participants":["local:ch86:doctor-runner","zijuan"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"请医跑腿携死讯通知李纨和王夫人，传播路径与时长保持未知。","effects":[],"execution":"NOT_OBSERVED","id":"household_notices_sent","observed_facts":[],"participants":["local:ch86:doctor-runner"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"李纨收到死讯，尚未据此宣称到床边。","effects":[{"basis":{"id":"liwan-death-notice","kind":"MESSAGE"},"from":"NOT_KNOWN","reason":"局部计划中的观察/送达，不声明已发生或已在正文实现。","target":"actor.liwan.knowledge.death_occurred","to":"KNOWS"}],"execution":"NOT_OBSERVED","id":"liwan_notified","observed_facts":[],"participants":["liwan","local:ch86:doctor-runner"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"显式登记李纨进入身体料理劳务；具体房间和路线未知。","effects":[],"execution":"NOT_OBSERVED","id":"liwan_arrives","observed_facts":[],"participants":["liwan"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"李纨接手热水衣物第一轮身体料理。","effects":[],"execution":"NOT_OBSERVED","id":"liwan_takes_care","observed_facts":[],"participants":["liwan","zijuan"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"王夫人获死讯，不默认亲见死亡。","effects":[{"basis":{"id":"wangfuren-death-notice","kind":"MESSAGE"},"from":"NOT_KNOWN","reason":"局部计划中的观察/送达，不声明已发生或已在正文实现。","target":"actor.wangfuren.knowledge.death_occurred","to":"KNOWS"}],"execution":"NOT_OBSERVED","id":"wangfuren_notified","observed_facts":[],"participants":["wangfuren","local:ch86:doctor-runner"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"王夫人分派后事第一轮和持续劳务；不默认已到床边。","effects":[],"execution":"NOT_OBSERVED","id":"wangfuren_assigns_work","observed_facts":[],"participants":["wangfuren"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"宝玉迟获病危消息；不含确切死时，不强定相对身体料理的顺序。","effects":[{"basis":{"id":"critical-message","kind":"MESSAGE"},"from":"NOT_KNOWN","reason":"局部计划中的观察/送达，不声明已发生或已在正文实现。","target":"actor.baoyu.knowledge.critical_decline","to":"KNOWS"}],"execution":"NOT_OBSERVED","id":"baoyu_receives_critical_message","observed_facts":[],"participants":["baoyu","local:ch86:xueyan"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"收到病危消息后赶来；未知出发地点、路线、时辰。","effects":[],"execution":"NOT_OBSERVED","id":"baoyu_departs","observed_facts":[],"participants":["baoyu"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"死亡之后到场，不赶上最后一息；到场不自动更新死时。","effects":[{"from":"NOT_ARRIVED","reason":"局部到场边界，非全局空间移动。","target":"actor.baoyu.arrival","to":"ARRIVED"}],"execution":"NOT_OBSERVED","id":"baoyu_arrives","observed_facts":[],"participants":["baoyu","zijuan"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"只问“药还没吃么？再温一温”；请求不执行，不加热、不代饮、不换碗。","effects":[],"execution":"NOT_OBSERVED","id":"baoyu_asks_rewarm","observed_facts":[],"participants":["baoyu","zijuan"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"问药后紫鹃讲述她亲历的死亡相对经过；不传达精确死时或医学因果。","effects":[],"execution":"NOT_OBSERVED","id":"death_account_notice_sent","observed_facts":[],"participants":["zijuan"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"到场并问药后宝玉获告死亡发生及相对经过；精确死时和医学因果仍未知。","effects":[{"basis":{"id":"death-account-notice","kind":"MESSAGE"},"from":"NOT_KNOWN","reason":"局部计划中的观察/送达，不声明已发生或已在正文实现。","target":"actor.baoyu.knowledge.death_occurred","to":"KNOWS"},{"basis":{"id":"death-account-notice","kind":"MESSAGE"},"from":"NOT_KNOWN","reason":"局部计划中的观察/送达，不声明已发生或已在正文实现。","target":"actor.baoyu.knowledge.death_relative_account","to":"KNOWS"}],"execution":"NOT_OBSERVED","id":"baoyu_learns_death_account","observed_facts":[],"participants":["baoyu","zijuan"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"新增末端检查边界：本节点核定同碗为冷；中间药温UNKNOWN，不声称现实冷却耗时或刚在本刻变冷。","effects":[{"from":"UNKNOWN","reason":"计划的末端冷药检查，不把未知的转冷时刻改成已知。","target":"object.OBJ-MEDICINE-BOWL-86.temperature","to":"cold"},{"from":"LIT","reason":"炉火熄是末端编辑安排，不推导缺药致死。","target":"object.local:ch86:stove-fire.state","to":"OUT"}],"execution":"NOT_OBSERVED","id":"medicine_cools","observed_facts":[],"participants":[],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"同一网络药碗：未尽且冷，无人再温；请求未执行。","effects":[],"execution":"NOT_OBSERVED","id":"terminal_cold_unfinished_medicine","observed_facts":[],"participants":["baoyu","zijuan"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"}],"evidence_effect":"NONE","extra_editorial_choices":["请医跑腿观察已死身体后传后事通知；不是目击确切死时。","起始温药后中间药温UNKNOWN；末端medicine_cools核定为冷，不确定真实转冷时刻。","李纨通知与到场分开；王夫人不设床边到场。","20261111 review clarification: contracts explicitly list core registered actors, including continuing care and arrivals. Anonymous service is narrative only; no replay claim for unregistered props. This changes editorial scope, not upstream facts or original UNKNOWN.","旧 death_exact_moment 无等值映射；相对经过不证明精确死时或医学因果，旧合同声明保持原样。"],"facts":[{"id":"illness_severe","meaning":"病重"},{"id":"crit