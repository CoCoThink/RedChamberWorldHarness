  "corpus_ecology_profiles": [
    {
      "id": "chapter_frames",
      "name": "前80章回外框与回前回末韵文",
      "source_ref": "asset:sha256:516935ff3a97a24fea0f25f287f7c212037edc8bbe95ccb647c03d3ef0ca473e",
      "frozen_conclusions": [
        "前80不存在稳定的一回一首回前诗制度",
        "正是/有诗为证等套语不是必须格式",
        "真正稳定的是回末制造余势",
        "回前回末韵文必须按回决定，不得配额化"
      ]
    },
    {
      "id": "poetry_ecology",
      "name": "前80诗词曲赋生态",
      "source_ref": "asset:sha256:ddeb1147fda8c4b5fd6de214ace78ddc672f07e527ac636143419ebb24cef299",
      "frozen_conclusions": [
        "诗文首先是人物行动，不是文化装饰",
        "失败稿、改稿、未成稿、残稿属于正常生态",
        "人物诗必须有可辨声口",
        "有祭未必有祭文，有死未必有绝命诗",
        "删除后若人物、关系或章法不减少一层，则不应为补诗而补诗"
      ]
    },
    {
      "id": "cultural_life",
      "name": "前80琴棋书画文人生活",
      "source_ref": "asset:sha256:663d991bedc4d362a6898f135edfe6f4bb907c5a25334374766667cbd964eb2d",
      "frozen_conclusions": [
        "高频的是戏曲、游戏、书写、文房、器物与鉴赏",
        "琴棋书画不是四艺平均配额",
        "技艺应写工序、材料、规则、失败、返工与社会功能",
        "后20恢复旧文化生活，不做古雅陈列"
      ]
    },
    {
      "id": "medical_body",
      "name": "前80医学身体疾病书写",
      "source_ref": "asset:sha256:98d9c0a13e692043b440941fe50cdcb719ab9cb4f1623f061f894cb6d6a3155c",
      "frozen_conclusions": [
        "病是一副身体拖动整个家庭，不是单一病名",
        "医疗链包括家属、婢女、医者、药钱、饮食与执行",
        "既有长程病史不得为后20剧情方便而重置",
        "急病后有恢复期，死亡后进入社会料理"
      ]
    },
    {
      "id": "metaphysics",
      "name": "前80佛道梦幻哲学系统",
      "source_ref": "asset:sha256:2e573c452396e356265837b9130fb28351ca8b8a691c539685ffdcaba4e76136",
      "frozen_conclusions": [
        "真神异、民间信仰、骗术、制度宗教可以同场",
        "梦不只负责预言",
        "空不能取消情",
        "太虚改变观看角度，不应成为答案发布会",
        "事件可以成立而意义保持不锁死"
      ]
    },
    {
      "id": "social_ecology",
      "name": "前80世情百业礼俗经济",
      "source_ref": "asset:sha256:e9b9b54f25c6c2419433b9b3da040e936d0f4d1bad4945817c5cad1643161f97",
      "frozen_conclusions": [
        "世情百科是情节的因果基础设施，不是资料陈列",
        "豪门财富依赖庄地、现金、家内行政与人情网络",
        "内宅是高度女性化的行政系统",
        "奴仆是多级职业网络",
        "婚丧、医疗、文化、宗教都需要钱、物、人、劳务与信息流"
      ]
