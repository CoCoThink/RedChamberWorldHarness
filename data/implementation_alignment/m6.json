  "chapter_plans": [
    {
      "chapter": 81,
      "plan_class": "B级补桥",
      "edit_level": "L2",
      "title_source": "TG工作回目",
      "hard_boundary": "香菱死亡回次属C施工；承接第80病线，不另造新病。",
      "must_keep": "淡青袖口、银匙、甜羹、诗稿合匣、无人重读。",
      "risk": "把香菱写成第二黛玉；把诗命写成临终才华展览。",
      "source_ref": "doc:23861cce04ac"
    },
    {
      "chapter": 82,
      "plan_class": "保护型",
      "edit_level": "L1",
      "title_source": "TG工作回目",
      "hard_boundary": "探春远适早于事败；对象、地点、婚期开放。",
      "must_keep": "三分筐、短夹袄争论、待书晕船、补日期、船火。",
      "risk": "远适抒情化；把探春才干写成现代项目管理。",
      "source_ref": "doc:23861cce04ac"
    },
    {
      "chapter": 83,
      "plan_class": "保护型",
      "edit_level": "L1",
      "title_source": "TG工作回目",
      "hard_boundary": "卫若兰射圃佩金麒麟；婚期、事故、生死开放。",
      "must_keep": "旧麒麟疑问、空食盒、脚费、菜地笑话。",
      "risk": "把金麒麟神秘化或提前宣布宿命。",
      "source_ref": "doc:23861cce04ac"
    },
    {
      "chapter": 84,
      "plan_class": "B级补桥",
      "edit_level": "L2",
      "title_source": "TG工作回目",
      "hard_boundary": "元春必须死；死因和日期开放；丧制只作真实延宕。",
      "must_keep": "饭单、传讯人袖上水、压低声音、紫鹃夜醒记录。",
      "risk": "把元妃之死直接等同抄家因果；把丧礼写成百科。",
      "source_ref": "doc:23861cce04ac"
    },
    {
      "chapter": 85,
      "plan_class": "B级补桥",
      "edit_level": "L2",
      "title_source": "TG工作回目",
      "hard_boundary": "黛玉沉痼日深；不得另造急性绝症；《十独吟》题名存在但作者/形制开放。",
      "must_keep": "起居纸、热水、窗纱、旧集、夜守、日常玩笑。",
      "risk": "诗压过身体；把《十独吟》写成绝命组诗。",
      "source_ref": "doc:23861cce04ac"
    },
    {
      "chapter": 86,
      "plan_class": "压力测试回",
      "edit_level": "L3",
      "title_source": "TG工作回目",
      "hard_boundary": "黛玉死亡是长期病程终点；宝玉来迟为C级章法。",
      "must_keep": "再温一温、未成稿、药吊子、紫鹃不翻稿、冷药结尾。",
      "risk": "绝命诗、大哭总声、传奇同步诀别、单因果死亡。",
      "source_ref": "doc:23861cce04ac"
    },
    {
      "chapter": 87,
      "plan_class": "一级重做",
      "edit_level": "L3",
      "title_source": "TG工作回目",
      "hard_boundary": "宝玉宝钗必须成夫妇；黛亡与婚的精确相位仍属C；丧期需真实缓冲。",
      "must_keep": "几个月缓冲、不进去、旧素笺别动、低调婚礼、普通饭与针线声。",
      "risk": "骗婚掉包、大排场、钗黛论文式裁判。",
      "source_ref": "doc:23861cce04ac"
    },
    {
