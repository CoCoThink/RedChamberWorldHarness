9762176","contentEncryptType":0,"translateContent":"","chapterId":"1l93wyyn97p5n","dataSize":892,"chapterOrder":23,"inChapterOrder":30,"volumeId":"7520927815609352211","volumeVersion":5},{"paragraphId":"7535740237960806410","paragraphType":1,"content":"{\"lines\":[{\"lineId\":\"392\",\"lineNum\":0,\"lineType\":1,\"content\":\"監獄在大門内西向。舊分内外二監，乾\",\"logicSentenceId\":\"0\",\"marginNoteIdList\":null,\"pinYin\":null},{\"lineId\":\"393\",\"lineNum\":0,\"lineType\":1,\"content\":\"隆三十年，知州萬廷蘭將外監歸併內監，現在囚房六間，女囚房\",\"logicSentenceId\":\"0\",\"marginNoteIdList\":null,\"pinYin\":null},{\"lineId\":\"394\",\"lineNum\":0,\"lineType\":1,\"content\":\"一間，獄神廟一間，禁卒房一間，更夫房一間。\",\"logicSentenceId\":\"0\",\"marginNoteIdList\":null,\"pinYin\":null}],\"indent\":0,\"textIndent\":false}","startPageId":"7520927614819762176","endPageId":"7520927614819762176","contentEncryptType":0,"translateContent":"","chapterId":"1l93wyyn97p5n","dataSize":440,"chapterOrder":23,"inChapterOrder":31,"volumeId":"7520927815609352211","volumeVersion":5},{"paragraphId":"7535740237960839178","paragraphType":1,"content":"{\"lines\":[{\"lineId\":\"395\",\"lineNum\":0,\"lineType\":1,\"content\":\"庫房明時有東西兩\",\"logicSentenceId\":\"0\",\"marginNoteIdList\":null,\"pinYin\":null},{\"lineId\":\"396\",\"lineNum\":0,\"lineType\":1,\"content\":\"間，在大堂之右。康熙十八年，地震圯後，均未復設。乾隆三十二年，\",\"logicSentenceId\":\"0\",\"marginNoteIdList\":null,\"pinYin\":null},{\"lineId\":\"397\",\"lineNum\":0,\"lineType\":1,\"content\":\"知州曹元瑞以徴存櫃糧，藏貯內署，殊非體制，詳請於大堂東將\",\"logicSentenceId\":\"0\",\"marginNoteIdList\":null,\"pinYin\":null},{\"lineId\":\"398\",\"lineNum\":0,\"lineType\":1,\"content\":\"舊官廳一間改造庫房，不果。至今未建。\",\"logicSentenceId\":\"0\",\"marginNoteIdList\":null,\"pinYin\":null},{\"lineId\":\"399\",\"lineNum\":0,\"lineType\":2,\"content\":\"通州高志\",\"logicSentenceId\":\"0\",\"marginNoteIdList\":null,\"pinYin\":null}],\"indent\":0,\"textIndent\":false}","startPageId":"7520927614819762176","endPageId":"7520927614819762176","contentEncryptType":0,"transl