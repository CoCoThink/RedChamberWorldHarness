",\"source_ref\":\"asset:sha256:ffed02aee8809a8937651529048e2cc10256a0ae2e2706251c9b806a6ea6ef50\"},{\"boundary\":\"至少有一次外出经济行为\",\"chapter\":95,\"epistemic\":\"REFERENCE_RESOURCE_FLOW\",\"food_medicine\":\"典衣买米、少买炭、酸齑、破毡\",\"labor\":\"宝钗核日用；麝月做饭补衣；典当/米炭外部劳务\",\"money_state\":\"进入稳定低现金状态\",\"object_interface\":\"米瓮、夹袄、炭筐、旧毡\",\"source_ref\":\"asset:sha256:ffed02aee8809a8937651529048e2cc10256a0ae2e2706251c9b806a6ea6ef50\"},{\"boundary\":\"援助应被节制使用\",\"chapter\":96,\"epistemic\":\"REFERENCE_RESOURCE_FLOW\",\"food_medicine\":\"一袋米、一筐炭、小包碎银；晚饭标准不变\",\"labor\":\"蒋玉菡搬物/出钱，袭人问日用，麝月收放\",\"money_state\":\"有限外援，不能逆转贫困\",\"object_interface\":\"米只倒一半、银收匣\",\"source_ref\":\"asset:sha256:ffed02aee8809a8937651529048e2cc10256a0ae2e2706251c9b806a6ea6ef50\"},{\"boundary\":\"不能把所有人都写成同一贫困\",\"chapter\":97,\"epistemic\":\"REFERENCE_RESOURCE_FLOW\",\"food_medicine\":\"湘云家仍能维持仆妇；妙玉依赖小庵米油；惜春尼庵生活简化\",\"labor\":\"各空间自己的劳动系统\",\"money_state\":\"各人物进入不同经济处境\",\"object_interface\":\"若兰衣箱、米油、灰衣、灯油\",\"source_ref\":\"asset:sha256:ffed02aee8809a8937651529048e2cc10256a0ae2e2706251c9b806a6ea6ef50\"},{\"boundary\":\"甄家不送钱\",\"chapter\":98,\"epistemic\":\"REFERENCE_RESOURCE_FLOW\",\"food_medicine\":\"茶、绦线、旧帕、书札\",\"labor\":\"麝月换绦送茶；甄仆收包\",\"money_state\":\"贫居仍可最低待客\",\"object_interface\":\"两个相邻小包\",\"source_ref\":\"asset:sha256:ffed02aee8809a8937651529048e2cc10256a0ae2e2706251c9b806a6ea6ef50\"},{\"boundary\":\"宝玉不是因当日断粮出家\",\"chapter\":99,\"epistemic\":\"REFERENCE_RESOURCE_FLOW\",\"food_medicine\":\"早饭简单、旧衣缝补\",\"labor\":\"宝钗/麝月维持家务；贾芸跑街寻找\",\"money_state\":\"最低生活可维持\",\"object_interface\":\"借书包、旧棉衣、未补完旧衣\",\"source_ref\":\"asset:sha256:ffed02aee8809a8937651529048e2cc10256a0ae2e2706251c9b806a6ea6ef50\"},{\"boundary\":\"不能写中兴\",\"chapter\":100,\"epistemic\":\"REFERENCE_RESOURCE_FLOW\",\"food_medicine\":\"受贺可办几桌茶饭；李纨病中有医药\",\"labor\":\"贾兰在外任职/回家侍母；少量家人待客\",\"money_state\":\"贾兰官俸/功名带来名位，但旧产业不复\",\"object_interface\":\"公服、冠帔、旧箱柜\",\"source_ref\":\"asset:sha256:ffed02aee8809a8937651529048e2cc10256a0ae2e2706251c9b806a6ea6ef50\"}]}}}\n"
      }
