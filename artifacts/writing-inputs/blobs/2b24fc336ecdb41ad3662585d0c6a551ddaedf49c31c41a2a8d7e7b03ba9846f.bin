a60fe348fc816c060d39901714efb1006695da81a68823\",\"targets\":[\"zhen_baoyu\"]},{\"chapter\":99,\"epistemic\":\"REFERENCE_INFORMATION_ASYMMETRY\",\"fact\":\"baoyu_departure_intent\",\"kind\":\"EARLY_INTENT\",\"note\":\"宝玉最早知道自己要走，其他人分层后知\",\"source_ref\":\"asset:sha256:bc6bf7cb5e60a47ff8a60fe348fc816c060d39901714efb1006695da81a68823\",\"targets\":[\"baoyu\"]},{\"chapter\":100,\"epistemic\":\"REFERENCE_INFORMATION_ASYMMETRY\",\"fact\":\"outer_frame_emotion_register\",\"kind\":\"FORBIDDEN_KNOWLEDGE\",\"note\":\"太虚/情榜层的信息绝不倒灌给人间人物\",\"source_ref\":\"asset:sha256:bc6bf7cb5e60a47ff8a60fe348fc816c060d39901714efb1006695da81a68823\",\"targets\":[\"human\"]}],\"longlines\":[{\"active_range\":\"84—90、95、99\",\"epistemic\":\"REFERENCE_LONG_LINE\",\"forbidden\":\"不用现代婚姻心理分析；不把黛亡直接变成金婚触发器\",\"id\":\"L01\",\"name\":\"宝玉—黛玉—宝钗情感与婚姻\",\"source_ref\":\"asset:sha256:56727d17b5588cdecac3d0cf66b0030a6673ace47d532937d7988141e9cc41cd\"},{\"active_range\":\"84、89—100\",\"epistemic\":\"REFERENCE_LONG_LINE\",\"forbidden\":\"不一回抄完；败落必须通过居所、钱粮、劳务持续\",\"id\":\"L02\",\"name\":\"贾府败落 / 官面 / 钱粮\",\"source_ref\":\"asset:sha256:56727d17b5588cdecac3d0cf66b0030a6673ace47d532937d7988141e9cc41cd\"},{\"active_range\":\"84、89—94\",\"epistemic\":\"REFERENCE_LONG_LINE\",\"forbidden\":\"凤姐死后线仍由平儿/巧姐继续\",\"id\":\"L03\",\"name\":\"凤姐—平儿—巧姐\",\"source_ref\":\"asset:sha256:56727d17b5588cdecac3d0cf66b0030a6673ace47d532937d7988141e9cc41cd\"},{\"active_range\":\"83、87—88、90、95—96、99\",\"epistemic\":\"REFERENCE_LONG_LINE\",\"forbidden\":\"袭人嫁后不复位；麝月长期稳定\",\"id\":\"L04\",\"name\":\"袭人—麝月—蒋玉菡\",\"source_ref\":\"asset:sha256:56727d17b5588cdecac3d0cf66b0030a6673ace47d532937d7988141e9cc41cd\"},{\"active_range\":\"89、92、96、98、99\",\"epistemic\":\"REFERENCE_LONG_LINE\",\"forbidden\":\"三人功能必须分开\",\"id\":\"L05\",\"name\":\"贾芸—小红—茜雪旧人回流\",\"source_ref\":\"asset:sha256:56727d17b5588cdecac3d0cf66b0030a6673ace47d532937d7988141e9cc41cd\"},{\"active_range\":\"82起低频延续\",\"epistemic\":\"REFERENCE_LONG_LINE\",\"forbidden\":\"不临时召回；不锁夫家与政治任务\",\"id\":\"L06\",\"name\":\"探春远适\",\"source_ref\":\"asset:sha256:56727d17b5588cdecac3d0cf66b0030a6673ace47d532937d7988141e9cc41cd\"},{\"active_range\":\"83、96、97、100\",\"epistemic\":\"REFERENCE_LONG_LINE\",\"forbidden\":\"不锁若兰死；先有真实乐再有悲\",\"id\":\"L07\",\"name\":\"湘云—卫若兰\",\"source_ref\":\"asset:sha256:56727d17b5588cdecac3d0cf66b0030a6673ace47d532937d7988141e9cc41cd\"},{\"active_range\":\"89前置、97、100\",\"epistemic\":\"REFERENCE_LONG_LINE\",\"forbidden\":\"妙玉失自主，惜春主动断返\",\"id\":\"L08\",\"name\":\"妙玉—惜春\",\"source_ref\":\"asset:sha256:56727d17b5588cdecac3d0cf66b0030a6673ace47d532937d7988141e9cc41cd\"},{\"active_range\":\"91、98、99开放、100外框\",\"epistemic\":\"REFERENCE_LONG_LINE\",\"forbidden\":\"91遗玉不自动等于通灵玉；99不以玉触发撒手\",\"id\":\"L09\",\"name\":\"玉线—甄宝玉\",\"source_ref\":\"asset:sha256:56727d17b5588cdecac3d0cf66b0030a6673ace47d532937d7988141e9cc41cd\"},{\"active_range\":\"84/87/89背景，100总收\",\"epistemic\":\"REFERENCE_LONG_LINE\",\"forbidden\":\"贾兰功名不等于家族中兴；情榜不擅造完整评语\",\"id\":\"L10\",\"name\":\"李纨—贾兰—情榜—石头\",\"source_ref\":\"asset:sha256:56727d17b5588cdecac3d0cf66b0030a6673ace47d532937d7988141e9cc41cd\"}]},\"data/world/m3_locations.json\":{\"locations\":[{\"access_rule\":\"内外房、药饭进入路径\",\"anchors\":\"旧诗稿、针线、药气\",\"chapters\":\"81\",\"epistemic\":\"REFERENCE_WORLD_SPACE\",\"id\":\"S01\",\"name\":\"薛家内宅/香菱病房\",\"social_state\":\"病床、药炉、宝钗/莺儿往返；金桂一侧仍构成心理环境\",\"source_ref\":\"asset:sha256:92749de3e62e80c89611bf1b19081bbb56e4d025df981092451682333dd2b6bb\"},{\"access_rule\":\"主仆等级仍完整\",\"anchors\":\"箱笼、花木、旧房、送别路线\",\"chapters\":\"82—88\",\"epistemic\":\"REFERENCE_WORLD_SPACE\",\"id\":\"S02\",\"name\":\"贾府/大观园末期空间\",\"social_state\":\"尚未抄没；人物可在房、园、二门、长辈处移动\",\"source_ref\":\"asset:sha256:92749de3e62e80c89611bf1b19081bbb56e4d025df981092451682333dd2b6bb\"},{\"access_rule\":\"入场需随相熟子弟\",\"anchors\":\"弓箭、小厮、衣带、大金麒麟\",\"chapters\":\"83\",\"epistemic\":\"REFERENCE_WORLD_SPACE\",\"id\":\"S03\",\"name\":\"城外射圃\",\"social_state\":\"男性社交场；宝玉非主场中心\",\"source_ref\":\"asset:sha256:92749de