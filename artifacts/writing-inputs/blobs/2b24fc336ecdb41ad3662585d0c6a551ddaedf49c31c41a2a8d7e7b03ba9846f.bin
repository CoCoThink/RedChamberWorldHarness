    "chapter_plan": {
      "authority_effect": "NONE",
      "evidence_effect": "NONE",
      "chapter": 81,
      "title": "薄命女沉疴香魂逝　蘅芜君收存旧诗稿",
      "title_status": "TG工作回目",
      "source": {
        "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
        "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
        "lines": [
          106,
          167
        ],
        "byte_range": [
          4054,
          6835
        ],
        "text_sha256": "fbd00bbe7949123cb3f7304182d15913f176f2f933f44f891f6faf8f021420ba"
      },
      "card_fields": [
        {
          "number": 1,
          "name": "现有硬节点",
          "text": "**1｜现有硬节点**  \nR36“香魂返故乡”强约束；第80香菱已有血分亏损、干血病史，81只能承接，不得另造新病。当前死亡回次属C级施工，不把具体死法反升硬证。\n\n",
          "citation": {
            "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
            "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
            "lines": [
              111,
              113
            ],
            "byte_range": [
              4174,
              4390
            ],
            "text_sha256": "b6b8679c7fb2ec2253cea1f80a4236fa4276d15fe39299b90bb87bd6bc7c846d"
          }
        },
        {
          "number": 2,
          "name": "当前正文最强处",
          "text": "**2｜当前正文最强处**  \n莺儿抢针线、甜羹银匙、淡青袖口未缝完；宝钗把旧诗稿夹入匣中；最终“并没人再念一遍”。这是本回最高P-Lock。\n\n",
          "citation": {
            "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
            "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
            "lines": [
              114,
              116
            ],
            "byte_range": [
              4390,
              4577
            ],
            "text_sha256": "f0879c9ca2829acf13a4d6803a04c8a7ba938d4250c61c309de7be8b82b901b7"
          }
        },
        {
          "number": 3,
          "name": "当前正文最薄处",
          "text": "**3｜当前正文最薄处**  \n病程从“已经坏下去”到死亡的家庭判断过程仍略快；谁决定换不换医生、谁开始预备后事、薛家如何分担费用可再实一层。\n\n",
          "citation": {
            "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
            "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
            "lines": [
              117,
              119
            ],
            "byte_range": [
              4577,
              4776
            ],
            "text_sha256": "27c6a142b564a9acd734196fe15be392177c7e2290430abc7d111cc668fbe3a5"
          }
        },
        {
          "number": 4,
          "name": "缺失情节",
          "text": "**4｜缺失情节**  \n补81-S1小争执：是否换医；81-S2病危后先备什么；81-S3死后第一轮谁料理、谁守、谁报信。只补过程，不加第二场危机。\n\n",
          "citation": {
            "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
            "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
            "lines": [
              120,
              122
            ],
            "byte_range": [
              4776,
              4957
            ],
            "text_sha256": "a13f7d23002b036937d0acdcdc8bcc5cce743b37083f8054a98e45d057a5fbde"
          }
        },
        {
          "number": 5,
          "name": "缺失人物",
          "text": "**5｜缺失人物**  \n药铺跑腿、旧大夫/替换大夫可一闪而过；薛姨妈、宝钗、莺儿权责要清。不得新造“名医”。\n\n",
          "citation": {
            "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
            "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
            "lines": [
              123,
              125
            ],
            "byte_range": [
              4957,
              5106
            ],
            "text_sha256": "2b9586da6ba1c5848634b2f92bcce0d00397aa3b91c2a227aef055688b317c4c"
          }
        },
        {
          "number": 6,
          "name": "缺失文化门类",
          "text": "**6｜缺失文化门类**  \n不补琴棋书画。香菱唯一文化主轴是诗稿。\n\n",
          "citation": {
            "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
            "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
            "lines": [
              126,
              128
            ],
            "byte_range": [
              5106,
              5194
            ],
            "text_sha256": "e714852c80abf0969e357bcb0571759ada6cada4611dd65fec130f7a928682cc"
          }
        },
        {
          "number": 7,
          "name": "诗文身份",
          "text": "**7｜诗文身份**  \nG02唯一开放：可在三张旧月诗之外夹一张**病前未成旧稿**，最多一两句；第45三案竞选。不得临终口占、绝命诗。作者回前/回末诗：无。\n\n",
          "citation": {
            "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
            "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
            "lines": [
              129,
              131
            ],
            "byte_range": [
              5194,
              5400
            ],
            "text_sha256": "75205d4f3524473192ddf886335faa979e8db919fa738b8db63e3e1455ea152b"
          }
        },
        {
          "number": 8,
          "name": "笑料/俗文化",
          "text": "**8｜笑料/俗文化**  \n保留“药苦是不是莺儿煎久了”等轻口角，让病回仍有人味；不新增临终笑料。\n\n",
          "citation": {
            "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
            "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
            "lines": [
              132,
              134
            ],
            "byte_range": [
              5400,
              5534
            ],
            "text_sha256": "abc7114b6235f49d80259c7b5007dbf662d5e06f1b0d7335b4f7f496d7e48e8c"
          }
        },
        {
          "number": 9,
          "name": "梦/宗教",
          "text": "**9｜梦/宗教**  \n低强度。人物可说“命苦”等俗语，不做香菱梦归故乡、托梦、悟道。\n\n",
          "citation": {
            "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
            "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
            "lines": [
              135,
              137
            ],
            "byte_range": [
              5534,
              5650
            ],
            "text_sha256": "589fddb1c50bf47a5f899b6e0e855604ad48847f520f0b4c908fc81fe81741c4"
          }
        },
        {
          "number": 10,
          "name": "职业人物",
          "text": "**10｜职业人物**  \n大夫、药铺伙计只承担真实医药链；后事可有普通买棺/白布接口，但不要展开行业展示。\n\n",
          "citation": {
            "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
            "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
            "lines": [
              138,
              140
            ],
            "byte_range": [
              5650,
              5794
            ],
            "text_sha256": "389c8ad25226231e7e1f32902e9727ed2a4baf79c2f398b381656e9e73bb66e5"
          }
        },
        {
          "number": 11,
          "name": "人钱物信四链",
          "text": "**11｜人钱物信四链**  \n人：薛姨妈—宝钗—莺儿—医者。钱：仍属E0，薛家有钱但不是无限。物：药、米汤、甜羹、寿衣/白布、诗稿。信：病危先在内宅，死后再分头报人。\n\n",
          "citation": {
            "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
            "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
            "lines": [
              141,
              143
            ],
            "byte_range": [
              5794,
              6024
            ],
            "text_sha256": "c25ae2da466fd1bb06d1f27066219d885d8188bb098617b4905f0e88fd1cb22d"
          }
        },
        {
          "number": 12,
          "name": "必须保留",
          "text": "**12｜必须保留**  \n淡青袖口、银匙、甜羹、诗稿合匣、无人重读。\n\n",
          "citation": {
            "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
            "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
            "lines": [
              144,
              146
            ],
            "byte_range": [
              6024,
              6113
            ],
            "text_sha256": "15aa16c8737f925efc18b5cf931fa8df6c839e745041936244018df0589aad62"
          }
        },
        {
          "number": 13,
          "name": "应删/应降",
          "text": "**13｜应删/应降**  \n任何把香菱一生概括成“诗成而命尽”的作者说明；任何新咳血奇观。\n\n",
          "citation": {
            "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
            "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
            "lines": [
              147,
              149
            ],
            "byte_range": [
              6113,
              6233
            ],
            "text_sha256": "44868fa023026893e476840b3e9d860421adf22f498b597e35b5512801855557"
          }
        },
        {
          "number": 14,
          "name": "L3候选",
          "text": "**14｜L3候选**  \n无。最高L2。\n\n",
          "citation": {
            "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
            "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
            "lines": [
              150,
              152
            ],
            "byte_range": [
              6233,
              6272
            ],
            "text_sha256": "f139bd53eab5c715ba42c69c45afb23b68241f0f05ce11a5075a301f8b5cb4d2"
          }
        },
        {
          "number": 15,
          "name": "前80同构",
          "text": "**15｜前80同构**  \n48—49香菱学诗的“用力、改稿、梦中得句”与本回旧稿形成回声；63“死金丹”提示死亡回仍可并存家务。\n\n",
          "citation": {
            "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
            "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
            "lines": [
              153,
              155
            ],
            "byte_range": [
              6272,
              6438
            ],
            "text_sha256": "f27e6fc231316cf9ef8b8d71fcc7ed74cff0c73ecaa5829600f71745f936d734"
          }
        },
        {
          "number": 16,
          "name": "回前诗",
          "text": "**16｜回前诗**  \n无。\n\n",
          "citation": {
            "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
            "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
            "lines": [
              156,
              158
            ],
            "byte_range": [
              6438,
              6467
            ],
            "text_sha256": "62839ce573b6e44b7587da02b72bc758ff77474e45becd4e4e057625041775cd"
          }
        },
        {
          "number": 17,
          "name": "回末诗",
          "text": "**17｜回末诗**  \n无；“没人再念一遍”必须胜过作者挽诗。\n\n",
          "citation": {
            "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
            "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
            "lines": [
              159,
              161
            ],
            "byte_range": [
              6467,
              6547
            ],
            "text_sha256": "3850fe112671cba7c2411df7e6d44677ffe2b792011cd04fe0dfd4ae3e75bbdb"
          }
        },
        {
          "number": 18,
          "name": "最终章法 / 风险",
          "text": "**18｜最终章法 / 风险**  \n病日常 → 是否换医的小争执 → 短暂好转/饮食 → 病危 → 女眷处理身体 → 报信与后事 → 诗稿/袖口归置 → 无人再念。  \n**风险：**把香菱写成第二黛玉；把“诗命”写成临终才华展览。\n\n",
          "citation": {
            "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
            "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
