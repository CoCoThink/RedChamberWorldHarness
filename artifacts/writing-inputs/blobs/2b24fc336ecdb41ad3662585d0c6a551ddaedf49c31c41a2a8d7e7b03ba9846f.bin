        "required_beats": [
          {
            "id": "81-S3-R1",
            "description": "死亡作为本场叙事前提必须由正文交代，不在料理场重演一次死亡；区分薛姨妈的授权与宝钗的实际料理，为谁守、谁报信交代接手与去向。香菱只作被料理的身体和旧物所指，不增列能行动的参与者；消息仍逐一传到，不靠旁白一笔包办。",
            "status": "PENDING",
            "scope": "AUTHORING_REQUIREMENT_NOT_HISTORICAL_FACT",
            "grounding": {
              "seed": {
