te\":[{\"basis\":[{\"path\":\"data/world/m3_core.json\",\"pointer\":\"/characters/3\",\"ref\":\"data/world/m3_core.json#/characters/3\",\"sha256\":\"c4bf1c75fda8994fd846e570a64ae69efeb6ca17cd27e78c1bb1af4d7783d733\",\"text_sha256\":\"258762fbcedf06308334686b9af172f3c4616dbd82c070d37c77576c914d6f57\",\"value\":{\"baseline\":{\"body_state\":\"terminal_chronic\",\"household_role\":\"xue_household_concubine\",\"legal_status\":\"NOT_AT_ISSUE\",\"life_state\":\"ACTIVE\",\"location\":\"S01\",\"marital_status\":\"CONCUBINE_OF_XUEPAN\"},\"groups\":[\"xue_household\",\"human\"],\"id\":\"xiangling\",\"name\":\"香菱\"}}],\"equals\":\"character.xiangling.body_state\",\"status\":\"KNOWN\",\"value\":\"terminal_chronic\"},{\"basis\":[{\"path\":\"data/world/m3_core.json\",\"pointer\":\"/characters/3\",\"ref\":\"data/world/m3_core.json#/characters/3\",\"sha256\":\"c4bf1c75fda8994fd846e570a64ae69efeb6ca17cd27e78c1bb1af4d7783d733\",\"text_sha256\":\"258762fbcedf06308334686b9af172f3c4616dbd82c070d37c77576c914d6f57\",\"value\":{\"baseline\":{\"body_state\":\"terminal_chronic\",\"household_role\":\"xue_household_concubine\",\"legal_status\":\"NOT_AT_ISSUE\",\"life_state\":\"ACTIVE\",\"location\":\"S01\",\"marital_status\":\"CONCUBINE_OF_XUEPAN\"},\"groups\":[\"xue_household\",\"human\"],\"id\":\"xiangling\",\"name\":\"香菱\"}}],\"equals\":\"character.xiangling.life_state\",\"status\":\"KNOWN\",\"value\":\"ACTIVE\"}],\"event_refs\":[],\"evidence_effect\":\"NONE\",\"exit_state\":[{\"basis\":[],\"equals\":\"character.xiangling.body_state\",\"reason\":\"换医讨论、短暂进食与病情走向没有本场事件或可比较的医学状态；不得由待写情节给出改善值。\",\"status\":\"PENDING\",\"value\":null},{\"basis\":[],\"equals\":\"character.baochai.household_role\",\"reason\":\"医药传话与费用分担尚待正文和独立审读落实；注册家庭身份并不证明本场实际负责了哪些事项。\",\"status\":\"PENDING\",\"value\":null}],\"forbidden_beats\":[{\"description\":\"不得把换医争执扩写成第二场急病、新咳血奇观或新增绝症；原有慢病是边界。\",\"grounding\":{\"chapter_card_fields\":[{\"citation\":{\"byte_range\":[4174,4390],\"lines\":[111,113],\"path\":\"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md\",\"sha256\":\"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c\",\"text_sha256\":\"b6b8679c7fb2ec2253cea1f80a4236fa4276d15fe39299b90bb87bd6bc7c846d\"},\"name\":\"现有硬节点\",\"number\":1,\"text\":\"**1｜现有硬节点**  \\nR36“香魂返故乡”强约束；第80香菱已有血分亏损、干血病史，81只能承接，不得另造新病。当前死亡回次属C级施工，不把具体死法反升硬证。\\n\\n\"},{\"citation\":{\"byte_range\":[4776,4957],\"lines\":[120,122],\"path\":\"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md\",\"sha256\":\"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c\",\"text_sha256\":\"a13f7d23002b036937d0acdcdc8bcc5cce743b37083f8054a98e45d057a5fbde\"},\"name\":\"缺失情节\",\"number\":4,\"text\":\"**4｜缺失情节**  \\n补81-S1小争执：是否换医；81-S2病危后先备什么；81-S3死后第一轮谁料理、谁守、谁报信。只补过程，不加第二场危机。\\n\\n\"},{\"citation\":{\"byte_range\":[6113,6233],\"lines\":[147,149],\"path\":\"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md\",\"sha256\":\"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c\",\"text_sha256\":\"44868fa023026893e476840b3e9d860421adf22f498b597e35b5512801855557\"},\"name\":\"应删/应降\",\"number\":13,\"text\":\"**13｜应删/应降**  \\n任何把香菱一生概括成“诗成而命尽”的作者说明；任何新咳血奇观。\\n\\n\"}],\"seed\":{\"path\":\"data/prewrite/v06.json\",\"pointer\":\"/omitted_scene_plans/0/candidate_scenes/0\",\"ref\":\"data/prewrite/v06.json#/omitted_scene_plans/0/candidate_scenes/0\",\"sha256\":\"caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff\",\"text_sha256\":\"6119a11c8d2a2daedbc16f909094e28120c77365d85fb9ab1ab8d8bf0315f7e1\",\"value\":{\"id\":\"81-S1\",\"title\":\"“这回是不是该换大夫”的小争执\"}}},\"id\":\"81-S1-F1\",\"scope\":\"AUTHORING_REQUIREMENT_NOT_HISTORICAL_FACT\",\"status\":\"PENDING\"},{\"description\":\"不得用病人口占诗、绝命诗或神医断言来决定生死；不得把香菱写成第二黛玉。\",\"grounding\":{\"chapter_card_fields\":[{\"citation\":{\"byte_range\":[4957,5106],\"lines\":[123,125],\"path\":\"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md\",\"sha256\":\"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c\",\"text_sha256\":\"2b9586da6ba1c5848634b2f92bcce0d00397aa3b91c2a227aef055688b317c4c\"},\"name\":\"缺失人物\",\"number\":5,\"text\":\"**5｜缺失人物**  \\n药铺跑腿、旧大夫/替换大夫可一闪而过；薛姨妈、宝钗、莺儿权责要清。不得新造“名医”。\\n\\n\"},{\"citation\":{\"byte_range\":[5194,5400],\"lines\":[129,131],\"path\":\"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md\",\"sha256\":\"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c\",\"text_sha256\":\"75205d4f3524473192ddf886335faa979e8db919fa738b8db63e3e1455ea152b\"},\"name\":\"诗文身份\",\"number\":7,\"text\":\"**7｜诗文身份**  \\nG02唯一开放：可在三张旧月诗之外夹一张**病前未成旧稿**，最多一两句；第45三案竞选。不得临终口占、绝命诗。作者回前/回末诗：无。\\n\\n\"},{\"citation\":{\"byte_range\":[6547,6830],\"lines\":[162,165],\"path\":\"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md\",\"sha256\":\"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c\",\"text_sha256\":\"4fc2d6eb3d26982bacc72a3385e0066eb197112b17d8b57d417640929e63e596\"},\"name\":\"最终章法 / 风险\",\"number\":18,\"text\":\"**18｜最终章法 / 风险**  \\n病日常 → 是否换医的小争执 → 短暂好转/饮食 → 病危 → 女眷处理身体 → 报信与后事 → 诗稿/袖口归置 → 无人再念。  \\n**风险：**把香菱写成第二黛玉；把“诗命”写成临终才华展览。\\n\\n\"}],\"seed\":{\"path\":\"data/prewrite/v06.json\",\"pointer\":\"/omitted_scene_plans/0/candidate_scenes/0\",\"ref\":\"data/prewrite/v06.json#/omitted_scene_plans/0/candidate_scenes/0\",\"sha256\":\"caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff\",\"text_sha256\":\"6119a11c8d2a2daedbc16f909094e28120c77365d85fb9ab1ab8d8bf0315f7e1\",\"value\":{\"id\":\"81-S1\",\"title\":\"“这回是不是该换大夫”的小争执\"}}},\"id\":\"81-S1-F2\",\"scope\":\"AUTHORING_REQUIREMENT_NOT_HISTORICAL_FACT\",\"status\":\"PENDING\"}],\"function\":\"在原有慢病的饮食、煎药日常中，补足是否换医的小争执及由谁作主、谁支付、谁传话的过程；只加厚判断，不另造病因或死亡危机。\",\"id\":\"81-S1\",\"kind\":\"AGENT_SCENE_CONTRACT\",\"knowledge_binding\":null,\"knowledge_event_refs\":[],\"notes\":\"81—85编辑从本场实际v1深拷贝新建v2，status=AGENT_EDITED只表示已作编辑，不表示语义支持、独立阅读、证据或权威；authority_effect=NONE、evidence_effect=NONE。原v1字节不变。本次逐项改动：81-S1-R2：让薛姨妈与宝钗的分歧落在是否再请旧大夫或换一位普通医者、由谁去问、诊药费用从哪里支出；明确谁作主、谁承接支出和传话，不把有限开支写成已无钱请医或缺药致死。具体人名、金额和新方均待核。；81-S1-R3：保留莺儿抢针线这一章卡P-Lock动作，不以煎药或报药信替代；煎药、报信可接在其前后，但莺儿仍为未绑定、待正文落实的既有角色接口。医者和跑腿只执行医药工序，不成为力挽病势的名医。。后场前驱如有只改指同一编辑选集v2，显式顺序仍非核实年代且不继承状态。参与者KNOWN只指已绑定注册主体子集，不证明现场同在或涵盖未注册接口；所有原状态值、UNKNOWN/PENDING、basis、知识绑定、事件关联及对象ID不变。章卡要求不作历史状态依据；不借86知识场景或药碗补本场缺口。模型同侪阅读与正文语义验证仍待进行，不声明任何语义PASS。\",\"object_transition_refs\":[],\"order\":1,\"participants\":[\"xiangling\",\"xue_yima\",\"baochai\"],\"participants_status\":\"KNOWN\",\"preconditions\":[{\"basis\":[],\"equals\":\"character.baochai.location\",\"reason\":\"第80回基线只能给出S02；没有换医交谈的局部位置或她赴病榻的已登记事件。\",\"status\":\"UNKNOWN\",\"value\":null},{\"basis\":[],\"equals\":\"character.xue_yima.location\",\"reason\":\"有薛姨妈注册身份和基线，但未登记本场到场或会诊位置，不能把章卡权责变成现场状态。\",\"status\":\"UNKNOWN\",\"value\":null}],\"references\":{\"knowledge\":[],\"objects\":[],\"participants\":[{\"path\":\"data/world/m3_core.json\",\"pointer\":\"/characters/3\",\"ref\":\"data/world/m3_core.json#/characters/3\",\"sha256\":\"c4bf1c75fda8994fd846e570a64ae69efeb6ca17cd27e78c1bb1af4d7783d733\",\"text_sha256\":\"258762fbcedf06308334686b9af172f3c4616dbd82c070d37c77576c914d6f57\",\"value\":{\"baseline\":{\"body_state\":\"terminal_chronic\",\"household_role\":\"xue_household_concubine\",\"legal_status\":\"NOT_AT_ISSUE\",\"life_state\":\"ACTIVE\",\"location\":\"S01\",\"marital_status\":\"CONCUBINE_OF_XUEPAN\"},\"groups\":[\"xue_household\",\"human\"],\"id\":\"xiangling\",\"name\":\"香菱\"}},{\"path\":\"data/world/m3_core.json\",\"pointer\":\"/characters/26\",\"ref\":\"data/world/m3_core.json#/characters/26\",\"sha256\":\"c4bf1c75fda8994fd846e570a64ae69efeb6ca17cd27e78c1bb1af4d7783d733\",\"text_sha256\":\"26f65be472892755beebd1cf953ca0f7c7b048431c54ce82d5eff8da83bd880b\",\"value\":{\"baseline\":{\"body_state\":\"ordinary\",\"household_role\":\"xue_matriarch\",\"legal_status\":\"NOT_AT_ISSUE\",\"life_state\":\"ACTIVE\",\"location\":\"S02\",\"marital_status\":\"WIDOWED\"},\"groups\":[\"xue_household\",\"human\"],\"id\":\"xue_yima\",\"name\":\"薛姨妈\"}},{\"path\":\"data/world/m3_core.json\",\"pointer\":\"/characters/1\",\"ref\":\"data/world/m3_core.json#/characters/1\",\"sha256\":\"c4bf1c75fda8994fd846e570a64ae69efeb6ca17cd27e78c1bb1af4d7783d733\",\"text_sha256\":\"539bb81553f85ece6e29214a008c499290b50068e2127c17a80cc113c82ae6b5\",\"value\":{\"baseline\":{\"body_state\":\"ordinary\",\"household_role\":\"xue_daughter_guest\",\"legal_status\":\"NOT_AT_ISSUE\",\"life_state\":\"ACTIVE\",\"location\":\"S02\",\"marital_status\":\"UNMARRIED\"},\"groups\":[\"jia_household\",\"xue_household\",\"human\"],\"id\":\"baochai\",\"name\":\"薛宝钗\"}}]},\"required_beats\":[{\"description\":\"以病中仍需入口的药、米汤或甜羹引出换医争执：询问旧方是否照办、药苦是否煎久，不让人物只说抽象的命数。\",\"grounding\":{\"chapter_card_fields\":[{\"citation\":{\"byte_range\":[4174,4390],\"lines\":[111,113],\"path\":\"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md\",\"sha256\":\"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c\",\"text_sha256\":\"b6b8679c7fb2ec2253cea1f80a4236fa4276d15fe39299b90bb87bd6bc7c846d\"},\"name\":\"现有硬节点\",\"number\":1,\"text\":\"**1｜现有硬节点**  \\nR36“香魂返故乡”强约束；第80香菱已有血分亏损、干血病史，81只能承接，不得另造新病。当前死亡回次属C级施工，不把具体死法反升硬证。\\n\\n\"},{\"citation\":{\"byte_range\":[5400,5534],\"lines\":[132,134],\"path\":\"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md\",\"sha256\":\"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c\",\"text_sha256\":\"abc7114b6235f49d80259c7b5007dbf662d5e06f1b0d7335b4f7f496d7e48e8c\"},\"name\":\"笑料/俗文化\",\"number\":8,\"text\":\"**8｜笑料/俗文化**  \\n保留“药苦是不是莺儿煎久了”等轻口角，让病回仍有人味；不新增临终笑料。\\n\\n\"},{\"citation\":{\"byte_range\":[5794,6024],\"lines\":[141,143],\"path\":\"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md\",\"sha256\":\"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c\",\"text_sha256\":\"c25ae2da466fd1bb06d1f27066219d885d8188bb098617b4905f0e88fd1cb22d\"},\"name\":\"人钱物信四链\",\"number\":11,\"text\":\"**11｜人钱物信四链**  \\n人：薛姨妈—宝钗—莺儿—医者。钱：仍属E0，薛家有钱但不是无限。物：药、米汤、甜羹、寿衣/白布、诗稿。信：病危先在内宅，死后再分头报人。\\n\\n\"}],\"seed\":{\"path\":\"data/prewrite/v06.json\",\"pointer\":\"/omitted_scene_plans/0/candidate_scenes/0\",\"ref\":\"data/prewrite/v06.json#/omitted_scene_plans/0/candidate_scenes/0\",\"sha256\":\"caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff\",\"text_sha256\":\"6119a11c8d2a2daedbc16f909094e28120c77365d85fb9ab1ab8d8bf0315f7e1\",\"value\":{\"id\":\"81-S1\",\"title\":\"“这回是不是该换大夫”的小争执\"}}},\"id\":\"81-S1-R1\",\"scope\":\"AUTHORING_REQUIREMENT_NOT_HISTORICAL_FACT\",\"status\":\"PENDING\"},{\"description\":\"让薛姨妈与宝钗的分歧落在是否再请旧大夫或换一位普通医者、由谁去问、诊药费用从哪里支出；明确谁作主、谁承接支出和传话，不把有限开支写成已无钱请医或缺药致死。具体人名、金额和新方均待核。\",\"grounding\":{\"chapter_card_fields\":[{\"citation\":{\"byte_range\":[4577,4776],\"lines\":[117,119],\"path\":\"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md\",\"sha256\":\"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c\",\"text_sha256\":\"27c6a142b564a9acd734196fe15be392177c7e2290430abc7d111cc668fbe3a5\"},\"name\":\"当前正文最薄处\",\"number\":3,\"text\":\"**3｜当前正文最薄处**  \\n病程从“已经坏下去”到死亡的家庭判断过程仍略快；谁决定换不换医生、谁开始预备后事、薛家如何分担费用可再实一层。\\n\\n\"},{\"citation\":{\"byte_range\":[4776,4957],\"lines\":[120,122],\"path\":\"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md\",\"sha256\":\"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c\",\"text_sha256\":\"a13f7d23002b036937d0acdcdc8bcc5cce743b37083f8054a98e45d057a5fbde\"},\"name\":\"缺失情节\",\"number\":4,\"text\":\"**4｜缺失情节**  \\n补81-S1小争执：是否换医；81-S2病危后先备什么；81-S3死后第一轮谁料理、谁守、谁报信。只补过程，不加第二场危机。\\n\\n\"},{\"citation\":{\"byte_range\":[4957,5106],\"lines\":[123,125],\"path\":\"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md\",\"sha256\":\"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c\",\"text_sha256\":\"2b9586da6ba1c5848634b2f92bcce0d00397aa3b91c2a227aef055688b317c4c\"},\"name\":\"缺失人物\",\"number\":5,\"text\":\"**5｜缺失人物**  \\n药铺跑腿、旧大夫/替换大夫可一闪而过；薛姨妈、宝钗、莺儿权责要清。不得新造“名医”。\\n\\n\"},{\"citation\":{\"byte_range\":[5794,6024],\"lines\":[141,143],\"path\":\"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md\",\"sha256\":\"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c\",\"text_sha256\":\"c25ae2da466fd1bb06d1f27066219d885d8188bb098617b4905f0e88fd1cb22d\"},\"name\":\"人钱物信四链\",\"number\":11,\"text\":\"**11｜人钱物信四链**  \\n人：薛姨妈—宝钗—莺儿—医者。钱：仍属E0，薛家有钱但不是无限。物：药、米汤、甜羹、寿衣/白布、诗稿。信：病危先在内宅，死后再分头报人。\\n\\n\"}],\"seed\":{\"path\":\"data/prewrite/v06.json\",\"pointer\":\"/omitted_scene_plans/0/candidate_scenes/0\",\"ref\":\"data/prewrite/v06.json#/omitted_scene_plans/0/candidate_scenes/0\",\"sha256\":\"caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff\",\"text_sha256\":\"6119a11c8d2a2daedbc16f909094e28120c77365d85fb9ab1ab8d8bf0315f7e1\",\"value\":{\"id\":\"81-S1\",\"title\":\"“这回是不是该换大夫”的小争执\"}}},\"id\":\"81-S1-R2\",\"scope\":\"AUTHORING_REQUIREMENT_NOT_HISTORICAL_FACT\",\"status\":\"PENDING\"},{\"description\":\"保留莺儿抢针线这一章卡P-Lock动作，不以煎药或报药信替代；煎药、报信可接在其前后，但莺儿仍为未绑定、待正文落实的既有角色接口。医者和跑腿只执行医药工序，不成为力挽病势的名医。\",\"grounding\":{\"chapter_card_fields\":[{\"citation\":{\"byte_range\":[4390,4577],\"lines\":[114,116],\"path\":\"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md\",\"sha256\":\"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c\",\"text_sha256\":\"f0879c9ca2829acf13a4d6803a04c8a7ba938d4250c61c309de7be8b82b901b7\"},\"name\":\"当前正文最强处\",\"number\":2,\"text\":\"**2｜当前正文最强处**  \\n莺儿抢针线、甜羹银匙、淡青袖口未缝完；宝钗把旧诗稿夹入匣中；最终“并没人再念一遍”。这是本回最高P-Lock。\\n\\n\"},{\"citation\":{\"byte_range\":[4957,5106],\"lines\":[123,125],\"path\":\"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md\",\"sha256\":\"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c\",\"text_sha256\":\"2b9586da6ba1c5848634b2f92bcce0d00397aa3b91c2a227aef055688b317c4c\"},\"name\":\"缺失人物\",\"number\":5,\"text\":\"**5｜缺失人物**  \\n药铺跑腿、旧大夫/替换大夫可一闪而过；薛姨妈、宝钗、莺儿权责要清。不得新造“名医”。\\n\\n\"},{\"citation\":{\"byte_range\":[5650,5794],\"lines\":[138,140],\"path\":\"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md\",\"sha256\":\"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c\",\"text_sha256\":\"389c8ad25226231e7e1f32902e9727ed2a4baf79c2f398b381656e9e73bb66e5\"},\"name\":\"职业人物\",\"number\":10,\"text\":\"**10｜职业人物**  \\n大夫、药铺伙计只承担真实医药链；后事可有普通买棺/白布接口，但不要展开行业展示。\\n\\n\"}],\"seed\":{\"path\":\"data/prewrite/v06.json\",\"pointer\":\"/omitted_scene_plans/0/candidate_scenes/0\",\"ref\":\"data/prewrite/v06.json#/omitted_scene_plans/0/candidate_scenes/0\",\"sha256\":\"caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff\",\"text_sha256\":\"6119a11c8d2a2daedbc16f909094e28120c77365d85fb9ab1ab8d8bf0315f7e1\",\"value\":{\"id\":\"81-S1\",\"title\":\"“这回是不是该换大夫”的小争执\"}}},\"id\":\"81-S1-R3\",\"scope\":\"AUTHORING_REQUIREMENT_NOT_HISTORICAL_FACT\",\"status\":\"PENDING\"},{\"description\":\"把淡青袖口、银匙和甜羹放回持续生活的动作中；争执之后仍需喂食、收拾，短暂能吃些东西也不当作治愈证据。\",\"grounding\":{\"chapter_card_fields\":[{\"citation\":{\"byte_range\":[4390,4577],\"lines\":[114,116],\"path\":\"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md\",\"sha256\":\"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c\",\"text_sha256\":\"f0879c9ca2829acf13a4d6803a04c8a7ba938d4250c61c309de7be8b82b901b7\"},\"name\":\"当前正文最强处\",\"number\":2,\"text\":\"**2｜当前正文最强处**  \\n莺儿抢针线、甜羹银匙、淡青袖口未缝完；宝钗把旧诗稿夹入匣中；最终“并没人再念一遍”。这是本回最高P-Lock。\\n\\n\"},{\"citation\":{\"byte_range\":[6024,6113],\"lines\":[144,146],\"path\":\"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md\",\"sha256\":\"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c\",\"text_sha256\":\"15aa16c8737f925efc18b5cf931fa8df6c839e745041936244018df0589aad62\"},\"name\":\"必须保留\",\"number\":12,\"text\":\"**12｜必须保留**  \\n淡青袖口、银匙、甜羹、诗稿合匣、无人重读。\\n\\n\"},{\"citation\":{\"byte_range\":[6547,6830],\"lines\":[162,165],\"path\":\"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md\",\"sha256\":\"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c\",\"text_sha256\":\"4fc2d6eb3d26982bacc72a3385e0066eb197112b17d8b57d417640929e63e596\"},\"name\":\"最终章法 / 风险\",\"number\":18,\"text\":\"**18｜最终章法 / 风险**  \\n病日常 → 是否换医的小争执 → 短暂好转/饮食 → 病危 → 女眷处理身体 → 报信与后事 → 诗稿/袖口归置 → 无人再念。  \\n**风险：**把香菱写成第二黛玉；把“诗命”写成临终才华展览。\\n\\n\"}],\"seed\":{\"path\":\"data/prewrite/v06.json\",\"pointer\":\"/omitted_scene_plans/0/candidate_scenes/0\",\"ref\":\"data/prewrite/v06.json#/omitted_scene_plans/0/candidate_scenes/0\",\"sha256\":\"caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff\",\"text_sha256\":\"6119a11c8d2a2daedbc16f909094e28120c77365d85fb9ab1ab8d8bf0315f7e1\",\"value\":{\"id\":\"81-S1\",\"title\":\"“这回是不是该换大夫”的小争执\"}}},\"id\":\"81-S1-R4\",\"scope\":\"AUTHORING_REQUIREMENT_NOT_HISTORICAL_FACT\",\"status\":\"PENDING\"}],\"required_objects\":[],\"revision\":\"v2\",\"schema_version\":1,\"status\":\"AGENT_EDITED\",\"unresolved\":[\"model_peer_readings_pending: 已由81—85编辑核对实际v1、绑定章卡/种子及世界边界；编辑不计独立读者，模型同侪阅读尚待进行，正文语义未验。\",\"declared_sequence_only: 依候选列表显式声明前驱；历史场景顺序和与既有正文的精确放置未核验。\",\"chapter_entry_not_scene_snapshot: 首场chapter-1仅是显式章入口，未覆盖本场所有位置、医学、物态和知情条件。\",\"unregistered_participants: 莺儿、医者、药铺跑腿无entity_references实际ID；不得创设ying_er等占位身份。\",\"unregistered_objects: 淡青袖口、银匙、甜羹、药与米汤没有本章对象登记；不能借用第86回药碗冒充。\",\"event_localization: W81-XIANGLING-DEATH是章级死亡事件，不绑定到发生于死亡前的换医讨论。\",\"knowledge_registry_gap: 没有香菱病情、处方、换医决定或费用知情的注册事实及本章知识场景。\"]},{\"authority_effect\":\"NONE\",\"bindings\":{\"chapter_plan\":{\"path\":\"data/planning/chapters/ch81.json\",\"sha256\":\"2a0cbae8058f6022e842336a99acbfcb8bc703954eb86c4e873a1cbf50251f6c\"},\"seed\":{\"path\":\"data/planning/scenes/81-S2.json\",\"sha256\":\"636ee5a52a3b473842a791a1aabe27848b9614d3b73af5d945f54458826a43f5\"},\"source_packet\":{\"path\":\"artifacts/agent_research/phase5/inputs/contract-packet-81-85.json\",\"sha256\":\"64a339142412c537b6caf39c03642449db6d69e5da39d1f239037a1a34e05b35\"},\"world\":{\"inputs\":[{\"path\":\"data/project/scope.j