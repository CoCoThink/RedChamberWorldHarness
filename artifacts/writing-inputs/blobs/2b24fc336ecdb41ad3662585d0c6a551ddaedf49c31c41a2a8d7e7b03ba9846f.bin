me\":\"妙玉寄居小庵\",\"social_state\":\"失去栊翠庵独立性，与他人共食用\",\"source_ref\":\"asset:sha256:92749de3e62e80c89611bf1b19081bbb56e4d025df981092451682333dd2b6bb\"},{\"access_rule\":\"老尼可日常管理但不能成为命运导师\",\"anchors\":\"灰衣、灯油、经书\",\"chapters\":\"97\",\"epistemic\":\"REFERENCE_WORLD_SPACE\",\"id\":\"S11\",\"name\":\"惜春尼庵\",\"social_state\":\"惜春主动留下，不是临时做客\",\"source_ref\":\"asset:sha256:92749de3e62e80c89611bf1b19081bbb56e4d025df981092451682333dd2b6bb\"},{\"access_rule\":\"麝月送茶、包裹临时摆放\",\"anchors\":\"茶、书札包、旧帕、通灵玉\",\"chapters\":\"98\",\"epistemic\":\"REFERENCE_WORLD_SPACE\",\"id\":\"S12\",\"name\":\"甄家来访—贫居客座\",\"social_state\":\"仍在S09内，但客人进入暴露贫居待客能力\",\"source_ref\":\"asset:sha256:92749de3e62e80c89611bf1b19081bbb56e4d025df981092451682333dd2b6bb\"},{\"access_rule\":\"家人可探访但不能强制带回\",\"anchors\":\"柴、粗布衣、僧舍/院落\",\"chapters\":\"99\",\"epistemic\":\"REFERENCE_WORLD_SPACE\",\"id\":\"S13\",\"name\":\"城外寺院\",\"social_state\":\"宝玉自行留下，非囚禁\",\"source_ref\":\"asset:sha256:92749de3e62e80c89611bf1b19081bbb56e4d025df981092451682333dd2b6bb\"},{\"access_rule\":\"可接待少量亲友、报喜、吊客\",\"anchors\":\"几桌茶饭、公服、冠帔、旧箱柜\",\"chapters\":\"100\",\"epistemic\":\"REFERENCE_WORLD_SPACE\",\"id\":\"S14\",\"name\":\"多年后的李纨/贾兰旧居\",\"social_state\":\"空间仍狭小，官身并未恢复旧府\",\"source_ref\":\"asset:sha256:92749de3e62e80c89611bf1b19081bbb56e4d025df981092451682333dd2b6bb\"},{\"access_rule\":\"与人间层严格分文体\",\"anchors\":\"榜文、册籍、石上文字\",\"chapters\":\"100\",\"epistemic\":\"REFERENCE_WORLD_SPACE\",\"id\":\"S15\",\"name\":\"太虚幻境—青埂峰外框\",\"social_state\":\"非人间现实空间；只在末回打开\",\"source_ref\":\"asset:sha256:92749de3e62e80c89611bf1b19081bbb56e4d025df981092451682333dd2b6bb\"}]},\"data/world/m3_presence.json\":{\"presence_matrix\":[{\"chapter\":81,\"epistemic\":\"LITERARY_CONSTRUCTION_RESOURCE\",\"forbidden_note\":\"宝玉等贾府人物只可由消息轻触\",\"main_source\":\"香菱、宝钗、薛姨妈\",\"natural_source\":\"莺儿、薛蟠\",\"source_ref\":\"asset:sha256:30a6ecd37a4f3e846a72ef3cd445ba78db902fa788d45ee7cd3d73d86eb4df32\",\"state_change\":\"香菱本回死亡；此后仅可被回忆/列榜\"},{\"chapter\":82,\"epistemic\":\"LITERARY_CONSTRUCTION_RESOURCE\",\"forbidden_note\":\"夫家、丈夫保持场外；不命名\",\"main_source\":\"探春、侍书、宝玉\",\"natural_source\":\"贾母、王夫人、赵姨娘、贾环\",\"source_ref\":\"asset:sha256:30a6ecd37a4f3e846a72ef3cd445ba78db902fa788d45ee7cd3d73d86eb4df32\",\"state_change\":\"探春本回离京/远适；后续主要以家书、传闻出现\"},{\"chapter\":83,\"epistemic\":\"LITERARY_CONSTRUCTION_RESOURCE\",\"forbidden_note\":\"探春已远；不让夫家人物突然解释麒麟来历\",\"main_source\":\"宝玉、卫若兰、湘云\",\"natural_source\":\"袭人、宝钗\",\"source_ref\":\"asset:sha256:30a6ecd37a4f3e846a72ef3cd445ba78db902fa788d45ee7cd3d73d86eb4df32\",\"state_change\":\"卫若兰首次现实照面；湘云尚未与他共同生活\"},{\"chapter\":84,\"epistemic\":\"LITERARY_CONSTRUCTION_RESOURCE\",\"forbidden_note\":\"元春只作为死讯/回忆存在\",\"main_source\":\"贾母、王夫人、凤姐、宝玉、黛玉\",\"natural_source\":\"李纨、宝钗、袭人、麝月、紫鹃、雪雁、平儿\",\"source_ref\":\"asset:sha256:30a6ecd37a4f3e846a72ef3cd445ba78db902fa788d45ee7cd3d73d86eb4df32\",\"state_change\":\"元春死亡；全府进入丧期\"},{\"chapter\":85,\"epistemic\":\"LITERARY_CONSTRUCTION_RESOURCE\",\"forbidden_note\":\"元春只以丧期背景存在\",\"main_source\":\"黛玉、紫鹃、雪雁、宝玉、宝钗\",\"natural_source\":\"贾母、王夫人、李纨\",\"source_ref\":\"asset:sha256:30a6ecd37a4f3e846a72ef3cd445ba78db902fa788d45ee7cd3d73d86eb4df32\",\"state_change\":\"黛玉仍活且有日常；不可从开头即临终化\"},{\"chapter\":86,\"epistemic\":\"LITERARY_CONSTRUCTION_RESOURCE\",\"forbidden_note\":\"袭人可低容量出现但不抢场\",\"main_source\":\"黛玉、紫鹃、雪雁、宝玉、宝钗\",\"natural_source\":\"贾母、王夫人、李纨、麝月、袭人\",\"source_ref\":\"asset:sha256:30a6ecd37a4f3e846a72ef3cd445ba78db902fa788d45ee7cd3d73d86eb4df32\",\"state_change\":\"黛玉本回死亡；宝玉不得见最后一息\"},{\"chapter\":87,\"epistemic\":\"LITERARY_CONSTRUCTION_RESOURCE\",\"forbidden_note\":\"黛玉只通过空位、遗物、他人避谈存在\",\"main_source\":\"宝玉、宝钗、贾母、王夫人、薛姨妈\",\"natural_source\":\"袭人、麝月、李纨、平儿、紫鹃、雪雁\",\"source_ref\":\"asset:sha256:30a6ecd37a4f3e846a72ef3cd445ba78db902fa788d45ee7cd3d73d86eb4df32\",\"state_change\":\"宝玉宝钗正式成婚；宝钗妻位开始真实运行\"},{\"chapter\":88,\"epistemic\":\"LITERARY_CONSTRUCTION_RESOURCE\",\"forbidden_note\":\"迎春不正面再造受虐场；孙绍祖无需扩写\",\"main_source\":\"袭人、宝玉、宝钗、麝月\",\"natural_source\":\