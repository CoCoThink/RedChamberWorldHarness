      "equals": "character.jiang_yuhan.location",
      "value": null,
      "status": "UNKNOWN",
      "basis": [],
      "reason": "蒋玉菡有注册身份，无本场登台、教唱或同行的场级行程；候选理由不能由职业标签自行推出。"
    }
  ],
  "event_refs": [],
  "evidence_effect": "NONE",
  "exit_state": [
    {
      "equals": "character.jiang_yuhan.location",
      "value": null,
      "status": "UNKNOWN",
      "basis": [],
      "reason": "章卡要求门外不抢戏与够用的职业一层，实际同行路线和离开时刻未登记。"
    }
  ],
  "forbidden_beats": [
    {
      "id": "96-S2-F1",
      "description": "不得当场唱完整一折戏或列出戏曲知识展示；戏业是生计约束，不是客厅舞台。",
      "status": "PENDING",
      "scope": "AUTHORING_REQUIREMENT_NOT_HISTORICAL_FACT",
      "grounding": {
        "seed": {
          "path": "data/prewrite/v06.json",
          "pointer": "/omitted_scene_plans/15/candidate_scenes/1",
          "ref": "data/prewrite/v06.json#/omitted_scene_plans/15/candidate_scenes/1",
          "sha256": "caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff",
          "text_sha256": "d9e234306c912ce78501b65098813d724acfe62150e1991f16a0a6c57afd72ad",
          "value": {
            "id": "96-S2",
            "title": "蒋玉菡是否同行要有自己的理由"
          }
        },
        "chapter_card_fields": [
          {
            "citation": {
              "byte_range": [
                41668,
                41770
              ],
              "lines": [
                1042,
                1044
              ],
              "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
              "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
              "text_sha256": "c775415659cb2d13e9424decfb59ef38f379be99e3d4b0de1dc03cd235784492"
            },
            "name": "文化",
            "number": 6,
            "text": "**6｜文化**  \n96戏曲职业世界、湘云被生活切断的诗性均P-Lock；不当场唱曲。\n\n"
          },
          {
            "citation": {
              "byte_range": [
                42009,
                42137
              ],
              "lines": [
                1054,
                1056
              ],
              "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
              "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
              "text_sha256": "cb7cecc43f3a2b5a43ba6bf343f2fdc8c89be0ed0c1ec49fa0d5d9e2b26b9c0d"
            },
            "name": "职业",
            "number": 10,
            "text": "**10｜职业**  \n蒋有登台、教唱、行头、嗓子、同行和收入周期；不要把他变“旧友友情客串”。\n\n"
          },
          {
            "citation": {
              "byte_range": [
                42363,
                42440
              ],
              "lines": [
                1063,
                1065
              ],
              "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
              "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
              "text_sha256": "e6d0a4027d4c68ee2beecefa02165d4a09996fa5ffab9bfa8fa27fb589c2340e"
            },
            "name": "应删",
            "number": 13,
            "text": "**13｜应删**  \n大笔银钱；蒋唱整折戏；湘云完整婚后诗。\n\n"
          }
        ]
      }
    },
    {
      "id": "96-S2-F2",
      "description": "不得开怀旧大会、送大笔银钱或让袭人重新回府同住；故人照应不能取消贫困。",
      "status": "PENDING",
      "scope": "AUTHORING_REQUIREMENT_NOT_HISTORICAL_FACT",
      "grounding": {
        "seed": {
          "path": "data/prewrite/v06.json",
          "pointer": "/omitted_scene_plans/15/candidate_scenes/1",
