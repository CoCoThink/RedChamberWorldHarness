              "text_sha256": "5d7be63035e663b59f92a7a999e6de1ccd5453a75876ae5bac86b89480c58d3b"
            },
            "name": "最薄处",
            "number": 3,
            "text": "**3｜最薄处**  \n袭人如何知道地址、蒋为何同行、湘云信如何转递可补很轻。\n\n"
          },
          {
            "citation": {
              "byte_range": [
                41450,
                41592
              ],
              "lines": [
                1036,
                1038
              ],
              "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
              "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
              "text_sha256": "5370e9ec10523670b884650f3380fdf4820b44af93d84c66b5697264cabf11dc"
            },
            "name": "缺失情节",
            "number": 4,
            "text": "**4｜缺失情节**  \n96-S1贾芸/花家旧人转地址；S2蒋正好有现实理由同行；S3宝钗分配援助；S4信件延迟路径。\n\n"
          },
          {
            "citation": {
              "byte_range": [
                42009,
                42137
              ],
              "lines": [
                1054,
                1056
              ],
              "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
              "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
              "text_sha256": "cb7cecc43f3a2b5a43ba6bf343f2fdc8c89be0ed0c1ec49fa0d5d9e2b26b9c0d"
            },
            "name": "职业",
            "number": 10,
            "text": "**10｜职业**  \n蒋有登台、教唱、行头、嗓子、同行和收入周期；不要把他变“旧友友情客串”。\n\n"
          }
        ],
        "world_basis": [
          {
            "ref": "data/world/m3_resources.json#/resource_flows/15",
            "path": "data/world/m3_resources.json",
            "pointer": "/resource_flows/15",
            "sha256": "b823f72594d4a2af2216525cbfd3411b00d41c4ad0fa89830348933be6de7668",
            "text_sha256": "5fc4a72fc39fcc12e4293c5d4b80fbc1da8bfe02aec5e50c1bfe2661a8e0c397",
            "value": {
              "chapter": 96,
              "money_state": "有限外援，不能逆转贫困",
              "food_medicine": "一袋米、一筐炭、小包碎银；晚饭标准不变",
              "labor": "蒋玉菡搬物/出钱，袭人问日用，麝月收放",
              "object_interface": "米只倒一半、银收匣",
              "boundary": "援助应被节制使用",
              "source_ref": "asset:sha256:ffed02aee8809a8937651529048e2cc10256a0ae2e2706251c9b806a6ea6ef50",
              "epistemic": "REFERENCE_RESOURCE_FLOW"
            }
          }
        ]
      }
    },
    {
      "id": "96-S2-R3",
      "description": "援物与少量碎银受蒋袭自身生计周期限制；前门来访不等于搬入贫居或成为固定救济源。麝月收放、蒋搬物/出钱、袭人问日用是章级劳务约束，实际各人动作先后待核，不以访客角色事件冒充路线事件。",
      "status": "PENDING",
      "scope": "AUTHORING_REQUIREMENT_NOT_HISTORICAL_FACT",
      "grounding": {
        "seed": {
          "path": "data/prewrite/v06.json",
          "pointer": "/omitted_scene_plans/15/candidate_scenes/1",
          "ref": "data/prewrite/v06.json#/omitted_scene_plans/15/candidate_scenes/1",
          "sha256": "caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff",
          "text_sha256": "d9e234306c912ce78501b65098813d724acfe62150e1991f16a0a6c57afd72ad",
          "value": {
            "id": "96-S2",
            "title": "蒋玉菡是否同行要有自己的理由"
          }
        },
        "chapter_card_fields": [
          {
            "citation": {
              "byte_range": [
                40868,
                41151
              ],
              "lines": [
                1023,
                1029
              ],
              "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
              "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
              "text_sha256": "4e1dfebff884225a9db0a5e67e733e67da9491c353b277cad34eae7ed88ccaf4"
            },
            "name": "硬节点",
            "number": 1,
            "text": "**1｜硬节点**  \nR25/R26\n\n**V-INTERFACES｜**\n- V5：`后回与袭人供奉玉兄宝卿得同终始`；\n- “供奉”锁照应关系，不锁大额救济、同住或恢复阶级。：袭人蒋玉菡后期照应宝玉宝钗；O04贫寒相位开放。湘云/若兰仍O06开放。\n\n"
          },
          {
            "citation": {
              "byte_range": [
                41151,
                41347
              ],
              "lines": [
                1030,
                1032
              ],
              "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
              "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
              "text_sha256": "dc3cd383fee0133c3409d89f7e4404e402549069d08f926d39dc26f1aadc4646"
            },
            "name": "最强处",
            "number": 2,
            "text": "**2｜最强处**  \n袭人敲门、蒋玉菡站门外不抢戏；戏业生计完整；援助物多钱少；湘云长信里婚后生活与“写两句揉掉”；新旧米同淘、仍两碗半。\n\n"
          },
          {
            "citation": {
              "byte_range": [
                42137,
                42252
              ],
              "lines": [
                1057,
                1059
              ],
              "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
              "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
              "text_sha256": "c0716ef332ecc10314322c98da6de937bacc166a56c734f4e06e10aa51d7efe6"
            },
            "name": "四链",
            "number": 11,
            "text": "**11｜四链**  \nE4：援助只能缓解；米、炭、一点碎银，不赎回阶级。信件有转递时间。\n\n"
          },
          {
            "citation": {
              "byte_range": [
                42471,
                42565
              ],
              "lines": [
                1069,
                1071
              ],
              "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
              "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
              "text_sha256": "b9532267343142c18ef12257e812ac98fc0e6ff6edbb51486dc7299933e7ddbb"
            },
            "name": "前80同构",
            "number": 15,
            "text": "**15｜前80同构**  \n28汗巾/蒋袭伏线在贫困现实中回收，不写命运宣言。\n\n"
          }
        ],
