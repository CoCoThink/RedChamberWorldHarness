  "required_beats": [
    {
      "id": "96-S2-R1",
      "description": "袭人先敲门，蒋玉菡在门外略候，不抢故人相见；麝月加入互揭短，让淡茶、便宜油膏等落回具体小户日常。",
      "status": "PENDING",
      "scope": "AUTHORING_REQUIREMENT_NOT_HISTORICAL_FACT",
      "grounding": {
        "seed": {
          "path": "data/prewrite/v06.json",
          "pointer": "/omitted_scene_plans/15/candidate_scenes/1",
          "ref": "data/prewrite/v06.json#/omitted_scene_plans/15/candidate_scenes/1",
          "sha256": "caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff",
          "text_sha256": "d9e234306c912ce78501b65098813d724acfe62150e1991f16a0a6c57afd72ad",
          "value": {
            "id": "96-S2",
            "title": "蒋玉菡是否同行要有自己的理由"
          }
        },
        "chapter_card_fields": [
          {
            "citation": {
              "byte_range": [
                41151,
                41347
              ],
              "lines": [
                1030,
                1032
              ],
              "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
              "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
              "text_sha256": "dc3cd383fee0133c3409d89f7e4404e402549069d08f926d39dc26f1aadc4646"
            },
            "name": "最强处",
            "number": 2,
            "text": "**2｜最强处**  \n袭人敲门、蒋玉菡站门外不抢戏；戏业生计完整；援助物多钱少；湘云长信里婚后生活与“写两句揉掉”；新旧米同淘、仍两碗半。\n\n"
          },
          {
            "citation": {
              "byte_range": [
                41904,
                41980
              ],
              "lines": [
                1048,
                1050
              ],
              "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
              "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
              "text_sha256": "55047834fc6c02f7760cb18b54e8dca122aef24599cd40c6860b2634cd02aba6"
            },
            "name": "笑料",
            "number": 8,
            "text": "**8｜笑料**  \n淡茶、松子、两碗半、纸边沾饭气等保护。\n\n"
          },
          {
            "citation": {
              "byte_range": [
                42252,
                42363
              ],
              "lines": [
                1060,
                1062
              ],
              "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
              "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
              "text_sha256": "3ce548c361059810c314274f1dfe95d917f8127986d53f3faa0a18ddb7f4599c"
            },
            "name": "必须保留",
            "number": 12,
            "text": "**12｜必须保留**  \n袭/蒋/麝 teasing；便宜油膏；银子先收；两碗半不变；春菜叫卖。\n\n"
          }
        ]
      }
    },
    {
      "id": "96-S2-R2",
      "description": "蒋同行必须补他自己戏业/家庭现实理由：在登台、教唱、行头、嗓子和收入周期中只露够用的一两笔；具体理由和行程尚未选定。职业标签本身不构成同行原因，未选方案仍PENDING，不由袭人的邀请自动完成。",
      "status": "PENDING",
      "scope": "AUTHORING_REQUIREMENT_NOT_HISTORICAL_FACT",
