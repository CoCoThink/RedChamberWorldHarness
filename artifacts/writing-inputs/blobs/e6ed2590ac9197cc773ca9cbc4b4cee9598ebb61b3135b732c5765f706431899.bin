        "text_sha256": "b308448e5004df08dd4b3a65dd75fa40d9daa8327ddc74c606161306bb72b5aa"
      }
    },
    {
      "number": 14,
      "name": "L3候选",
      "text": "**14｜L3候选**  \n无。\n\n",
      "citation": {
        "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
