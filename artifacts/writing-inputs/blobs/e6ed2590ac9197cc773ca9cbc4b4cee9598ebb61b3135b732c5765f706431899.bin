      6835,
      8841
    ],
    "text_sha256": "d4de9fd9c2e375d333e7618e7338692bbcd2b959ba66bd72e83dd2e698a31f52"
  },
  "card_fields": [
    {
      "number": 1,
      "name": "现有硬节点",
      "text": "**1｜现有硬节点**  \nR07 / P01：探春远适必须早于后来事败；对象、地点、婚期细节仍开放。\n\n",
      "citation": {
        "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
        "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
        "lines": [
          173,
          175
        ],
        "byte_range": [
          6955,
          7076
        ],
        "text_sha256": "cff95f8cb294c884775789294dbc0b1d61f93087fc1a55f927c756e9fc5bc4e4"
      }
    },
    {
      "number": 2,
      "name": "最强处",
      "text": "**2｜最强处**  \n三分筐、箱笼清点、待书晕船、姜粥、第一封家书夹进行装册、次晨补“已能吃粥”。远嫁被写成真正行旅。\n\n",
      "citation": {
        "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
        "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
        "lines": [
          176,
          178
        ],
        "byte_range": [
          7076,
          7242
        ],
        "text_sha256": "921145cfa0690c3c2e7aff9a77c2192b1fd0ae9a3d80e4322bb7699d54ab32b2"
      }
    },
    {
      "number": 3,
      "name": "最薄处",
      "text": "**3｜最薄处**  \n随行人口、船位、费用归属可再明确一点；不需要增加悲情。\n\n",
      "citation": {
        "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
        "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
        "lines": [
          179,
          181
        ],
        "byte_range": [
          7242,
          7345
        ],
        "text_sha256": "89ed440fedb07c90e4d6a44c3519c28fbe9f454e20de10c604bffb52e4ce5a81"
      }
    },
    {
      "number": 4,
      "name": "缺失情节",
      "text": "**4｜缺失情节**  \n只补82-S1船位/随行人口确认；82-S2开船后重新点物。L1即可。\n\n",
      "citation": {
        "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
        "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
        "lines": [
          182,
          184
        ],
        "byte_range": [
          7345,
          7449
        ],
        "text_sha256": "874434b1347cfef5e9617b40c846e50debff9c6d3ee0b16644244bce31acb37f"
      }
    },
    {
      "number": 5,
      "name": "缺失人物",
      "text": "**5｜缺失人物**  \n船家、跟船婆子、挑夫/脚力已有接口；不造重要新角色。\n\n",
      "citation": {
        "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
        "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
        "lines": [
          185,
          187
        ],
        "byte_range": [
          7449,
          7550
        ],
        "text_sha256": "79a8e7064e93a09dc8ffc7bdf3cba292e1e2fefdb31ab6b2ea1dfc7f707c3c47"
      }
    },
    {
      "number": 6,
      "name": "文化",
      "text": "**6｜文化**  \n家书、箱笼题签即可；不补送别诗、琴曲。\n\n",
      "citation": {
        "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
        "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
        "lines": [
          188,
          190
        ],
        "byte_range": [
          7550,
          7626
        ],
        "text_sha256": "97c510dc9f7339dd01f759d2d675e014b700cc8197aef991c6b6db9ab2479fd6"
      }
    },
    {
      "number": 7,
      "name": "诗文身份",
      "text": "**7｜诗文身份**  \nG04：现有实用家书胜出，不新增诗。Q03“后文许多妙文”不得用来证明探春有佚诗。\n\n",
      "citation": {
        "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
        "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
        "lines": [
          191,
          193
        ],
        "byte_range": [
          7626,
          7762
        ],
        "text_sha256": "db0ec5f73cc128ec2d48ac3379409749654fb9917b966e3c921133ca1d66c900"
      }
    },
    {
      "number": 8,
      "name": "笑料",
      "text": "**8｜笑料**  \n待书晕船还嘴硬、箱笼反复拆封可保留。\n\n",
      "citation": {
        "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
        "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
        "lines": [
          194,
          196
        ],
        "byte_range": [
          7762,
          7835
        ],
        "text_sha256": "dd58f79f05f3139a59286b6715788a219e83147adc569ad3fa23bd587d983936"
      }
    },
    {
      "number": 9,
      "name": "宗教/梦",
      "text": "**9｜宗教/梦**  \n只许行旅祈安俗礼背景；不得“海外神梦”“命定远嫁”解释。\n\n",
      "citation": {
        "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
        "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
        "lines": [
          197,
          199
        ],
        "byte_range": [
          7835,
          7942
        ],
        "text_sha256": "0c79ad5d542e1fcbe64aacda2c98263fb4bee3b6def732ffe97fdab1531bad06"
      }
    },
    {
      "number": 10,
      "name": "职业",
      "text": "**10｜职业**  \n船家、婆子、码头脚力只写工序与时间，不做风俗展览。\n\n",
      "citation": {
        "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
        "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
        "lines": [
          200,
          202
        ],
        "byte_range": [
          7942,
          8037
        ],
        "text_sha256": "0cd8fae3fc3a8daf20bdf152fedd5564f39125c1f63986927b96f2d955f1e29e"
      }
    },
    {
      "number": 11,
      "name": "四链",
      "text": "**11｜四链**  \n人：探春—待书—随从—船家。钱：公家/家内行旅费与私人小包分开。物：五口箱、两包、姜、药、针线。信：信何时能交可靠船/人转递，是远适真正距离。\n\n",
      "citation": {
        "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
        "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
        "lines": [
          203,
          205
        ],
        "byte_range": [
          8037,
          8266
        ],
        "text_sha256": "b5a649fe3d0acf5022cca3166160ea13dfd9a9e947d5cc8949a5f11bd6fa4aa1"
      }
    },
    {
      "number": 12,
      "name": "保留",
      "text": "**12｜保留**  \n“三分筐”、短夹袄争论、待书晕船、补日期、船火。\n\n",
      "citation": {
        "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
        "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
        "lines": [
          206,
          208
        ],
        "byte_range": [
          8266,
          8358
        ],
        "text_sha256": "cad89eab78bb5b3ed6fb75a514e4973da91261f0bafbba1af23c444531070936"
      }
    },
    {
      "number": 13,
      "name": "应删",
      "text": "**13｜应删**  \n任何一句“此去天涯再无归日”式预判。\n\n",
      "citation": {
        "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
