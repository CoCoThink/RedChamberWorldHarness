e887f1285f6c7ccf975aed140d1515967ea925bb3bb"},{"path":"data/world/m3_body.json","sha256":"429ca248ea42aa0601e11a55d40fa446da92cee48936627a83b335ab9b18056e"},{"path":"data/world/m3_resources.json","sha256":"b823f72594d4a2af2216525cbfd3411b00d41c4ad0fa89830348933be6de7668"},{"path":"data/world/m3_knowledge.json","sha256":"d8ee374ec667317af6ef304dc4b66ad7d3ceae9f20753c1b35cf029c73dee18b"},{"path":"data/objects/m4.json","sha256":"5c2719605b0d2b78d3c06d6bb7444c5c5058fd3891879f8dcfa480cd1828b4db"},{"path":"data/knowledge/v03_slice2.json","sha256":"37db9f32aad64636f33eb70a73130160260914e8a4ca987e03f6c45170fa88e7"},{"path":"data/objects/medicine_bowl.yaml","sha256":"ad304b16d955e904b6de156bf88c38f51f0d552698bb7f2ff6ba07bb5572d361"}],"status":"BOUND"}},"chapter":96,"chapter_plan_ref":"data/planning/chapters/ch96.json","entry_checkpoint":{"chapter":null,"kind":"UNKNOWN"},"entry_from":"data/planning/contracts/agent-edited-v1/96-S1.v2.json","entry_state":[{"basis":[],"equals":"character.jiang_yuhan.location","reason":"蒋玉菡有注册身份，无本场登台、教唱或同行的场级行程；候选理由不能由职业标签自行推出。","status":"UNKNOWN","value":null}],"event_refs":[],"evidence_effect":"NONE","exit_state":[{"basis":[],"equals":"character.jiang_yuhan.location","reason":"章卡要求门外不抢戏与够用的职业一层，实际同行路线和离开时刻未登记。","status":"UNKNOWN","value":null}],"forbidden_beats":[{"description":"不得当场唱完整一折戏或列出戏曲知识展示；戏业是生计约束，不是客厅舞台。","grounding":{"chapter_card_fields":[{"citation":{"byte_range":[41668,41770],"lines":[1042,1044],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"c775415659cb2d13e9424decfb59ef38f379be99e3d4b0de1dc03cd235784492"},"name":"文化","number":6,"text":"**6｜文化**  \n96戏曲职业世界、湘云被生活切断的诗性均P-Lock；不当场唱曲。\n\n"},{"citation":{"byte_range":[42009,42137],"lines":[1054,1056],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"cb7cecc43f3a2b5a43ba6bf343f2fdc8c89be0ed0c1ec49fa0d5d9e2b26b9c0d"},"name":"职业","number":10,"text":"**10｜职业**  \n蒋有登台、教唱、行头、嗓子、同行和收入周期；不要把他变“旧友友情客串”。\n\n"},{"citation":{"byte_range":[42363,42440],"lines":[1063,1065],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"e6d0a4027d4c68ee2beecefa02165d4a09996fa5ffab9bfa8fa27fb589c2340e"},"name":"应删","number":13,"text":"**13｜应删**  \n大笔银钱；蒋唱整折戏；湘云完整婚后诗。\n\n"}],"seed":{"path":"data/prewrite/v06.json","pointer":"/omitted_scene_plans/15/candidate_scenes/1","ref":"data/prewrite/v06.json#/omitted_scene_plans/15/candidate_scenes/1","sha256":"caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff","text_sha256":"d9e234306c912ce78501b65098813d724acfe62150e1991f16a0a6c57afd72ad","value":{"id":"96-S2","title":"蒋玉菡是否同行要有自己的理由"}}},"id":"96-S2-F1","scope":"AUTHORING_REQUIREMENT_NOT_HISTORICAL_FACT","status":"PENDING"},{"description":"不得开怀旧大会、送大笔银钱或让袭人重新回府同住；故人照应不能取消贫困。","grounding":{"chapter_card_fields":[{"citation":{"byte_range":[40868,41151],"lines":[1023,1029],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"4e1dfebff884225a9db0a5e67e733e67da9491c353b277cad34eae7ed88ccaf4"},"name":"硬节点","number":1,"text":"**1｜硬节点**  \nR25/R26\n\n**V-INTERFACES｜**\n- V5：`后回与袭人供奉玉兄宝卿得同终始`；\n- “供奉”锁照应关系，不锁大额救济、同住或恢复阶级。：袭人蒋玉菡后期照应宝玉宝钗；O04贫寒相位开放。湘云/若兰仍O06开放。\n\n"},{"citation":{"byte_range":[42137,42252],"lines":[1057,1059],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"c0716ef332ecc10314322c98da6de937bacc166a56c734f4e06e10aa51d7efe6"},"name":"四链","number":11,"text":"**11｜四链**  \nE4：援助只能缓解；米、炭、一点碎银，不赎回阶级。信件有转递时间。\n\n"},{"citation":{"byte_range":[42363,42440],"lines":[1063,1065],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"e6d0a4027d4c68ee2beecefa02165d4a09996fa5ffab9bfa8fa27fb589c2340e"},"name":"应删","number":13,"text":"**13｜应删**  \n大笔银钱；蒋唱整折戏；湘云完整婚后诗。\n\n"}],"seed":{"path":"data/prewrite/v06.json","pointer":"/omitted_scene_plans/15/candidate_scenes/1","ref":"data/prewrite/v06.json#/omitted_scene_plans/15/candidate_scenes/1","sha256":"caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff","text_sha256":"d9e234306c912ce78501b65098813d724acfe62150e1991f16a0a6c57afd72ad","value":{"id":"96-S2","title":"蒋玉菡是否同行要有自己的理由"}}},"id":"96-S2-F2","scope":"AUTHORING_REQUIREMENT_NOT_HISTORICAL_FACT","status":"PENDING"}],"function":"让蒋玉菡同行出于戏业安排和家庭现实理由；故人重逢以有限职业生活和互揭短成立，不变成演出或怀旧大会。","id":"96-S2","kind":"AGENT_SCENE_CONTRACT","knowledge_binding":null,"knowledge_event_refs":[],"notes":"EDITOR96-100独立编辑阶段的新v2，status=AGENT_EDITED仅表示已编辑，不表示语义核验、合格同行审查或人工认可；authority_effect=NONE，evidence_effect=NONE。原v1、seed、章卡、packet及世界输入均保留字节绑定，不改权威。order仍是不可变种子列表索引；entry_from是编辑候选编排，不是历史顺序或可执行局部检查点，后场不继承前场快照。participants只列注册候选角色；PENDING表示到场、替代角色或完整名单未核，注册身份不等于已知localcast。KNOWN条件仅限显式chapter-1粗入口，不能投射到本场动作；局部缺口继续UNKNOWN/PENDING且value=null。章卡/seed支持待实现义务，world_basis支持所选运行资料的约束，不证明本场已发生。event_refs/object_transition_refs仅为既有章级或外框关联，不能伪装场级事件重放。96—100没有v03知识场景或获取事件；保留M3信息不对称为叙事义务，不造fact、actor或event ID。未绑定正文，prose_supported_semantic_replay=NOT_CHECKED。","object_transition_refs":[],"order":2,"participants":["xiren","jiang_yuhan","baoyu","baochai","sheyue"],"participants_status":"PENDING","preconditions":[{"basis":[],"equals":"character.xiren.location","reason":"前驱仅为声明的地址桥；没有可执行到门状态。","status":"UNKNOWN","value":null},{"basis":[],"equals":"character.sheyue.location","reason":"虽第95回粗状态在S09，本场何时迎客及门内门外位置未登记，不能传播章入口到本地检查点。","status":"UNKNOWN","value":null}],"references":{"knowledge":[],"objects":[],"participants":[{"path":"data/world/m3_core.json","pointer":"/characters/5","ref":"data/world/m3_core.json#/characters/5","sha256":"c4bf1c75fda8994fd846e570a64ae69efeb6ca17cd27e78c1bb1af4d7783d733","text_sha256":"b64f1c0390f062cb8366790030ca19afb986e82e378a7b725e3f89a737af3e53","value":{"baseline":{"body_state":"ordinary","household_role":"baoyu_attendant","legal_status":"NOT_AT_ISSUE","life_state":"ACTIVE","location":"S02","marital_status":"UNMARRIED"},"groups":["jia_household","human"],"id":"xiren","name":"花袭人"}},{"path":"data/world/m3_core.json","pointer":"/characters/22","ref":"data/world/m3_core.json#/characters/22","sha256":"c4bf1c75fda8994fd846e570a64ae69efeb6ca17cd27e78c1bb1af4d7783d733","text_sha256":"9c0f5f79ae07e5caf3cbc8cd7c9748ae3c8a1840e25edd3aa61420d31a35be97","value":{"baseline":{"body_state":"ordinary","household_role":"performer","legal_status":"NOT_AT_ISSUE","life_state":"ACTIVE","location":null,"marital_status":"UNRESOLVED"},"groups":["human","profession_performer"],"id":"jiang_yuhan","name":"蒋玉菡"}},{"path":"data/world/m3_core.json","pointer":"/characters/0","ref":"data/world/m3_core.json#/characters/0","sha256":"c4bf1c75fda8994fd846e570a64ae69efeb6ca17cd27e78c1bb1af4d7783d733","text_sha256":"c90d10be26bb276650ff292a0dc2e511347a54c0bd8bfef95a7ed588454eff94","value":{"baseline":{"body_state":"ordinary","household_role":"jia_son","legal_status":"FREE","life_state":"ACTIVE","location":"S02","marital_status":"UNMARRIED"},"groups":["jia_household","human"],"id":"baoyu","name":"贾宝玉"}},{"path":"data/world/m3_core.json","pointer":"/characters/1","ref":"data/world/m3_core.json#/characters/1","sha256":"c4bf1c75fda8994fd846e570a64ae69efeb6ca17cd27e78c1bb1af4d7783d733","text_sha256":"539bb81553f85ece6e29214a008c499290b50068e2127c17a80cc113c82ae6b5","value":{"baseline":{"body_state":"ordinary","household_role":"xue_daughter_guest","legal_status":"NOT_AT_ISSUE","life_state":"ACTIVE","location":"S02","marital_status":"UNMARRIED"},"groups":["jia_household","xue_household","human"],"id":"baochai","name":"薛宝钗"}},{"path":"data/world/m3_core.json","pointer":"/characters/6","ref":"data/world/m3_core.json#/characters/6","sha256":"c4bf1c75fda8994fd846e570a64ae69efeb6ca17cd27e78c1bb1af4d7783d733","text_sha256":"779594feec7c611f21661c22a7c613a048e7457e0503012f1f3b98a4c39b8978","value":{"baseline":{"body_state":"ordinary","household_role":"baoyu_attendant","legal_status":"NOT_AT_ISSUE","life_state":"ACTIVE","location":"S02","marital_status":"UNRESOLVED"},"groups":["jia_household","human"],"id":"sheyue","name":"麝月"}}]},"required_beats":[{"description":"袭人先敲门，蒋玉菡在门外略候，不抢故人相见；麝月加入互揭短，让淡茶、便宜油膏等落回具体小户日常。","grounding":{"chapter_card_fields":[{"citation":{"byte_range":[41151,41347],"lines":[1030,1032],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"dc3cd383fee0133c3409d89f7e4404e402549069d08f926d39dc26f1aadc4646"},"name":"最强处","number":2,"text":"**2｜最强处**  \n袭人敲门、蒋玉菡站门外不抢戏；戏业生计完整；援助物多钱少；湘云长信里婚后生活与“写两句揉掉”；新旧米同淘、仍两碗半。\n\n"},{"citation":{"byte_range":[41904,41980],"lines":[1048,1050],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"55047834fc6c02f7760cb18b54e8dca122aef24599cd40c6860b2634cd02aba6"},"name":"笑料","number":8,"text":"**8｜笑料**  \n淡茶、松子、两碗半、纸边沾饭气等保护。\n\n"},{"citation":{"byte_range":[42252,42363],"lines":[1060,1062],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"3ce548c361059810c314274f1dfe95d917f8127986d53f3faa0a18ddb7f4599c"},"name":"必须保留","number":12,"text":"**12｜必须保留**  \n袭/蒋/麝 teasing；便宜油膏；银子先收；两碗半不变；春菜叫卖。\n\n"}],"seed":{"path":"data/prewrite/v06.json","pointer":"/omitted_scene_plans/15/candidate_scenes/1","ref":"data/prewrite/v06.json#/omitted_scene_plans/15/candidate_scenes/1","sha256":"caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff","text_sha256":"d9e234306c912ce78501b65098813d724acfe62150e1991f16a0a6c57afd72ad","value":{"id":"96-S2","title":"蒋玉菡是否同行要有自己的理由"}}},"id":"96-S2-R1","scope":"AUTHORING_REQUIREMENT_NOT_HISTORICAL_FACT","status":"PENDING"},{"description":"蒋同行必须补他自己戏业/家庭现实理由：在登台、教唱、行头、嗓子和收入周期中只露够用的一两笔；具体理由和行程尚未选定。职业标签本身不构成同行原因，未选方案仍PENDING，不由袭人的邀请自动完成。","grounding":{"chapter_card_fields":[{"citation":{"byte_range":[41347,41450],"lines":[1033,1035],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"5d7be63035e663b59f92a7a999e6de1ccd5453a75876ae5bac86b89480c58d3b"},"name":"最薄处","number":3,"text":"**3｜最薄处**  \n袭人如何知道地址、蒋为何同行、湘云信如何转递可补很轻。\n\n"},{"citation":{"byte_range":[41450,41592],"lines":[1036,1038],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"5370e9ec10523670b884650f3380fdf4820b44af93d84c66b5697264cabf11dc"},"name":"缺失情节","number":4,"text":"**4｜缺失情节**  \n96-S1贾芸/花家旧人转地址；S2蒋正好有现实理由同行；S3宝钗分配援助；S4信件延迟路径。\n\n"},{"citation":{"byte_range":[42009,42137],"lines":[1054,1056],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"cb7cecc43f3a2b5a43ba6bf343f2fdc8c89be0ed0c1ec49fa0d5d9e2b26b9c0d"},"name":"职业","number":10,"text":"**10｜职业**  \n蒋有登台、教唱、行头、嗓子、同行和收入周期；不要把他变“旧友友情客串”。\n\n"}],"seed":{"path":"data/prewrite/v06.json","pointer":"/omitted_scene_plans/15/candidate_scenes/1","ref":"data/prewrite/v06.json#/omitted_scene_plans/15/candidate_scenes/1","sha256":"caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff","text_sha256":"d9e234306c912ce78501b65098813d724acfe62150e1991f16a0a6c57afd72ad","value":{"id":"96-S2","title":"蒋玉菡是否同行要有自己的理由"}},"world_basis":[{"path":"data/world/m3_resources.json","pointer":"/resource_flows/15","ref":"data/world/m3_resources.json#/resource_flows/15","sha256":"b823f72594d4a2af2216525cbfd3411b00d41c4ad0fa89830348933be6de7668","text_sha256":"5fc4a72fc39fcc12e4293c5d4b80fbc1da8bfe02aec5e50c1bfe2661a8e0c397","value":{"boundary":"援助应被节制使用","chapter":96,"epistemic":"REFERENCE_RESOURCE_FLOW","food_medicine":"一袋米、一筐炭、小包碎银；晚饭标准不变","labor":"蒋玉菡搬物/出钱，袭人问日用，麝月收放","money_state":"有限外援，不能逆转贫困","object_interface":"米只倒一半、银收匣","source_ref":"asset:sha256:ffed02aee8809a8937651529048e2cc10256a0ae2e2706251c9b806a6ea6ef50"}}]},"id":"96-S2-R2","scope":"AUTHORING_REQUIREMENT_NOT_HISTORICAL_FACT","status":"PENDING"},{"description":"援物与少量碎银受蒋袭自身生计周期限制；前门来访不等于搬入贫居或成为固定救济源。麝月收放、蒋搬物/出钱、袭人问日用是章级劳务约束，实际各人动作先后待核，不以访客角色事件冒充路线事件。","grounding":{"chapter_card_fields":[{"citation":{"byte_range":[40868,41151],"lines":[1023,1029],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"4e1dfebff884225a9db0a5e67e733e67da9491c353b277cad34eae7ed88ccaf4"},"name":"硬节点","number":1,"text":"**1｜硬节点**  \nR25/R26\n\n**V-INTERFACES｜**\n- V5：`后回与袭人供奉玉兄宝卿得同终始`；\n- “供奉”锁照应关系，不锁大额救济、同住或恢复阶级。：袭人蒋玉菡后期照应宝玉宝钗；O04贫寒相位开放。湘云/若兰仍O06开放。\n\n"},{"citation":{"byte_range":[41151,41347],"lines":[1030,1032],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"dc3cd383fee0133c3409d89f7e4404e402549069d08f926d39dc26f1aadc4646"},"name":"最强处","number":2,"text":"**2｜最强处**  \n袭人敲门、蒋玉菡站门外不抢戏；戏业生计完整；援助物多钱少；湘云长信里婚后生活与“写两句揉掉”；新旧米同淘、仍两碗半。\n\n"},{"citation":{"byte_range":[42137,42252],"lines":[1057,1059],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"c0716ef332ecc10314322c98da6de937bacc166a56c734f4e06e10aa51d7efe6"},"name":"四链","number":11,"text":"**11｜四链**  \nE4：援助只能缓解；米、炭、一点碎银，不赎回阶级。信件有转递时间。\n\n"},{"citation":{"byte_range":[42471,42565],"lines":[1069,1071