a256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"e6d0a4027d4c68ee2beecefa02165d4a09996fa5ffab9bfa8fa27fb589c2340e"},"name":"应删","number":13,"text":"**13｜应删**  \n大笔银钱；蒋唱整折戏；湘云完整婚后诗。\n\n"}],"seed":{"path":"data/prewrite/v06.json","pointer":"/omitted_scene_plans/15/candidate_scenes/2","ref":"data/prewrite/v06.json#/omitted_scene_plans/15/candidate_scenes/2","sha256":"caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff","text_sha256":"31ee937f27af00caa2d9e091c41c2f5257d6628373d23cbc77bb19d36ec652df","value":{"id":"96-S3","title":"援助被宝钗重新分配，而不是立刻消费"}}},"id":"96-S3-F1","scope":"AUTHORING_REQUIREMENT_NOT_HISTORICAL_FACT","status":"PENDING"},{"description":"不得给碎银、当铺或米炭添加未经来源支持的确切金额、数量、经手人；章级对象组不等于物目清单。","grounding":{"chapter_card_fields":[{"citation":{"byte_range":[41450,41592],"lines":[1036,1038],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"5370e9ec10523670b884650f3380fdf4820b44af93d84c66b5697264cabf11dc"},"name":"缺失情节","number":4,"text":"**4｜缺失情节**  \n96-S1贾芸/花家旧人转地址；S2蒋正好有现实理由同行；S3宝钗分配援助；S4信件延迟路径。\n\n"},{"citation":{"byte_range":[42137,42252],"lines":[1057,1059],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"c0716ef332ecc10314322c98da6de937bacc166a56c734f4e06e10aa51d7efe6"},"name":"四链","number":11,"text":"**11｜四链**  \nE4：援助只能缓解；米、炭、一点碎银，不赎回阶级。信件有转递时间。\n\n"}],"seed":{"path":"data/prewrite/v06.json","pointer":"/omitted_scene_plans/15/candidate_scenes/2","ref":"data/prewrite/v06.json#/omitted_scene_plans/15/candidate_scenes/2","sha256":"caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff","text_sha256":"31ee937f27af00caa2d9e091c41c2f5257d6628373d23cbc77bb19d36ec652df","value":{"id":"96-S3","title":"援助被宝钗重新分配，而不是立刻消费"}}},"id":"96-S3-F2","scope":"AUTHORING_REQUIREMENT_NOT_HISTORICAL_FACT","status":"PENDING"}],"function":"把有限外援转成宝钗对储米、用炭与碎银的分配动作；缓解眼前压力而不赎回旧生活。","id":"96-S3","kind":"AGENT_SCENE_CONTRACT","knowledge_binding":null,"knowledge_event_refs":[],"notes":"EDITOR96-100独立编辑阶段的新v2，status=AGENT_EDITED仅表示已编辑，不表示语义核验、合格同行审查或人工认可；authority_effect=NONE，evidence_effect=NONE。原v1、seed、章卡、packet及世界输入均保留字节绑定，不改权威。order仍是不可变种子列表索引；entry_from是编辑候选编排，不是历史顺序或可执行局部检查点，后场不继承前场快照。participants只列注册候选角色；PENDING表示到场、替代角色或完整名单未核，注册身份不等于已知localcast。KNOWN条件仅限显式chapter-1粗入口，不能投射到本场动作；局部缺口继续UNKNOWN/PENDING且value=null。章卡/seed支持待实现义务，world_basis支持所选运行资料的约束，不证明本场已发生。event_refs/object_transition_refs仅为既有章级或外框关联，不能伪装场级事件重放。96—100没有v03知识场景或获取事件；保留M3信息不对称为叙事义务，不造fact、actor或event ID。未绑定正文，prose_supported_semantic_replay=NOT_CHECKED。","object_transition_refs":["OT96-01","OT96-03","OT96-02"],"order":3,"participants":["baochai","sheyue","baoyu"],"participants_status":"PENDING","preconditions":[{"basis":[],"equals":"object.OBJ-CHARCOAL-BASKET-95.quantity_state","reason":"炭的有限补入有OT96-03章级记录，未登记本场分配时刻或各包数量。","status":"UNKNOWN","value":null}],"references":{"knowledge":[],"objects":[{"path":"data/objects/m4.json","pointer":"/objects/10","ref":"data/objects/m4.json#/objects/10","sha256":"5c2719605b0d2b78d3c06d6bb7444c5c5058fd3891879f8dcfa480cd1828b4db","text_sha256":"a1f99c276440ea457b38b14c77d2aa7dda051df6b87c737b46376064c0cf47d2","value":{"baseline":{"holder":"baochai_sheyue_household","location":"S09","quantity_state":"UNKNOWN","status":"UNINITIALIZED"},"continuity_rules":["第95回进入低量；第96回外援只部分补入，不逆转E4贫困"],"evidence_status":"REFERENCE_WORLD","id":"OBJ-RICE-JAR-95","identity_status":"C_WORLD_OBJECT","kind":"food_store","name":"贫居米瓮","source_refs":["asset:sha256:ffed02aee8809a8937651529048e2cc10256a0ae2e2706251c9b806a6ea6ef50","R19"]}},{"path":"data/objects/m4.json","pointer":"/objects/11","ref":"data/objects/m4.json#/objects/11","sha256":"5c2719605b0d2b78d3c06d6bb7444c5c5058fd3891879f8dcfa480cd1828b4db","text_sha256":"a9fb7a82396fb2fe90a763529a807bdb244bcdd91d7032ed98af165a55a79