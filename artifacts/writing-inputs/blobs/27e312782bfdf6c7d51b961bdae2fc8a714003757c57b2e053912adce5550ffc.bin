6525cbfd3411b00d41c4ad0fa89830348933be6de7668"},{"path":"data/world/m3_knowledge.json","sha256":"d8ee374ec667317af6ef304dc4b66ad7d3ceae9f20753c1b35cf029c73dee18b"},{"path":"data/objects/m4.json","sha256":"5c2719605b0d2b78d3c06d6bb7444c5c5058fd3891879f8dcfa480cd1828b4db"},{"path":"data/knowledge/v03_slice2.json","sha256":"37db9f32aad64636f33eb70a73130160260914e8a4ca987e03f6c45170fa88e7"},{"path":"data/objects/medicine_bowl.yaml","sha256":"ad304b16d955e904b6de156bf88c38f51f0d552698bb7f2ff6ba07bb5572d361"}],"status":"BOUND"}},"chapter":96,"chapter_plan_ref":"data/planning/chapters/ch96.json","entry_checkpoint":{"chapter":null,"kind":"UNKNOWN"},"entry_from":"data/planning/contracts/agent-edited-v1/96-S2.v2.json","entry_state":[{"basis":[],"equals":"object.OBJ-RICE-JAR-95.quantity_state","reason":"第95回章末LOW是实际粗值，但本场在96-S2到访后的局部补米进度未知；不把它直接当本场入口。","status":"UNKNOWN","value":null}],"event_refs":["W96-LIMITED-AID-WEIXIANG"],"evidence_effect":"NONE","exit_state":[{"basis":[],"equals":"object.OBJ-RICE-JAR-95.quantity_state","reason":"OT96-01/02只支持当前C章级部分补入及量用终点；尚未绑定本场可执行入口和半倒动作。","status":"UNKNOWN","value":null},{"basis":[],"equals":"object.OBJ-PAWNABLE-JACKET-95.status","reason":"第95回已典当有实际记录；本场当票如何收置、是否暂不赎回没有场级转移，不能由叙事要求推出对象状态。","status":"UNKNOWN","value":null}],"forbidden_beats":[{"description":"不得用米炭碎银逆转E4、赎回阶级或让全家立刻消费一空；两碗半不能随援助突然变成丰餐。","grounding":{"chapter_card_fields":[{"citation":{"byte_range":[40868,41151],"lines":[1023,1029],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"4e1dfebff884225a9db0a5e67e733e67da9491c353b277cad34eae7ed88ccaf4"},"name":"硬节点","number":1,"text":"**1｜硬节点**  \nR25/R26\n\n**V-INTERFACES｜**\n- V5：`后回与袭人供奉玉兄宝卿得同终始`；\n- “供奉”锁照应关系，不锁大额救济、同住或恢复阶级。：袭人蒋玉菡后期照应宝玉宝钗；O04贫寒相位开放。湘云/若兰仍O06开放。\n\n"},{"citation":{"byte_range":[42137,42252],"lines":[1057,1059],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"c0716ef332ecc10314322c98da6de937bacc166a56c734f4e06e10aa51d7efe6"},"name":"四链","number":11,"text":"**11｜四链**  \nE4：援助只能缓解；米、炭、一点碎银，不赎回阶级。信件有转递时间。\n\n"},{"citation":{"byte_range":[42252,42363],"lines":[1060,1062],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"3ce548c361059810c314274f1dfe95d917f8127986d53f3faa0a18ddb7f4599c"},"name":"必须保留","number":12,"text":"**12｜必须保留**  \n袭/蒋/麝 teasing；便宜油膏；银子先收；两碗半不变；春菜叫卖。\n\n"},{"citation":{"byte_range":[42363,42440],"lines":[1063,1065],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"e6d0a4027d4c68ee2beecefa02165d4a09996fa5ffab9bfa8fa27fb589c2340e"},"name":"应删","number":13,"text":"**13｜应删**  \n大笔银钱；蒋唱整折戏；湘云完整婚后诗。\n\n"}],"seed":{"path":"data/prewrite/v06.json","pointer":"/omitted_scene_plans/15/candidate_scenes/2","ref":"data/prewrite/v06.json#/omitted_scene_plans/15/candidate_scenes/2","sha256":"caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff","text_sha256":"31ee937f27af00caa2d9e091c41c2f5257d6628373d23cbc77bb19d36ec652df","value":{"id":"96-S3","title":"援助被宝钗重新分配，而不是立刻消费"}}},"id":"96-S3-F1","scope":"AUTHORING_REQUIREMENT_NOT_HISTORICAL_FACT","status":"PENDING"},{"description":"不得给碎银、当铺或米炭添加未经来源支持的确切金额、数量、经手人；章级对象组不等于物目清单。","grounding":{"chapter_card_fields":[{"citation":{"byte_range":[41450,41592],"lines":[1036,1038],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"5370e9ec10523670b884650f3380fdf4820b44af93d84c66b5697264cabf11dc"},"name":"缺失情节","number":4,"text":"**4｜缺失情节**  \n96-S1贾芸/花家旧人转地址；S2蒋正好有现实理由同行；S3宝钗分配援助；S4信件延迟路径。\n\n"},{"citation":{"byte_range":[42137,42252],"lines":[1057,1059],"pat