2cd92534fb60c1e6","value":{"id":"96-S1","title":"袭人不是凭空知道地址"}}},"id":"96-S1-F1","scope":"AUTHORING_REQUIREMENT_NOT_HISTORICAL_FACT","status":"PENDING"},{"description":"不得给花家旧人捏造已注册姓名、住址或历史传话事实，也不得把贾芸候选中介硬化为原稿确定情节。","grounding":{"chapter_card_fields":[{"citation":{"byte_range":[41347,41450],"lines":[1033,1035],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"5d7be63035e663b59f92a7a999e6de1ccd5453a75876ae5bac86b89480c58d3b"},"name":"最薄处","number":3,"text":"**3｜最薄处**  \n袭人如何知道地址、蒋为何同行、湘云信如何转递可补很轻。\n\n"},{"citation":{"byte_range":[41450,41592],"lines":[1036,1038],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"5370e9ec10523670b884650f3380fdf4820b44af93d84c66b5697264cabf11dc"},"name":"缺失情节","number":4,"text":"**4｜缺失情节**  \n96-S1贾芸/花家旧人转地址；S2蒋正好有现实理由同行；S3宝钗分配援助；S4信件延迟路径。\n\n"},{"citation":{"byte_range":[41592,41668],"lines":[1039,1041],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"818b3da12b7774ef5e1223244715c6f8f88d6f436128e34f6832fd288f8870e1"},"name":"人物","number":5,"text":"**5｜人物**  \n袭人、蒋、贾芸、宝钗麝月宝玉；送信人。\n\n"}],"seed":{"path":"data/prewrite/v06.json","pointer":"/omitted_scene_plans/15/candidate_scenes/0","ref":"data/prewrite/v06.json#/omitted_scene_plans/15/candidate_scenes/0","sha256":"caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff","text_sha256":"48b41e4dee216800a693992e026d89115caacc742446487f2cd92534fb60c1e6","value":{"id":"96-S1","title":"袭人不是凭空知道地址"}}},"id":"96-S1-F2","scope":"AUTHORING_REQUIREMENT_NOT_HISTORICAL_FACT","status":"PENDING"}],"function":"给袭人到贫居的行动补一段轻量、可传递的地址来路；旧关系只负责找门，不替家庭恢复旧主仆结构。","id":"96-S1","kind":"AGENT_SCENE_CONTRACT","knowledge_binding":null,"knowledge_event_refs":[],"notes":"EDITOR96-100独立编辑阶段的新v2，status=AGENT_EDITED仅表示已编辑，不表示语义核验、合格同行审查或人工认可；authority_effect=NONE，evidence_effect=NONE。原v1、seed、章卡、packet及世界输入均保留字节绑定，不改权威。order仍是不可变种子列表索引；entry_from是编辑候选编排，不是历史顺序或可执行局部检查点，后场不继承前场快照。participants只列注册候选角色；PENDING表示到场、替代角色或完整名单未核，注册身份不等于已知localcast。KNOWN条件仅限显式chapter-1粗入口，不能投射到本场动作；局部缺口继续UNKNOWN/PENDING且value=null。章卡/seed支持待实现义务，world_basis支持所选运行资料的约束，不证明本场已发生。event_refs/object_transition_refs仅为既有章级或外框关联，不能伪装场级事件重放。96—100没有v03知识场景或获取事件；保留M3信息不对称为叙事义务，不造fact、actor或event ID。未绑定正文，prose_supported_semantic_replay=NOT_CHECKED。","object_transition_refs":[],"order":1,"participants":["xiren","jia_yun"],"participants_status":"PENDING","preconditions":[{"basis":[],"equals":"character.xiren.location","reason":"获知地址与到门之间未登记地点、传话者和路程；不能把已婚离府状态当作到贫居状态。","status":"UNKNOWN","value":null}],"references":{"knowledge":[],"objects":[],"participants":[{"path":"data/world/m3_core.json","pointer":"/characters/5","ref":"data/world/m3_core.json#/characters/5","sha256":"c4bf1c75fda8994fd846e570a64ae69efeb6ca17cd27e78c1bb1af4d7783d733","text_sha256":"b64f1c0390f062cb8366790030ca19afb986e82e378a7b725e3f89a737af3e53","value":{"baseline":{"body_state":"ordinary","household_role":"baoyu_attendant","legal_status":"NOT_AT_ISSUE","life_state":"ACTIVE","location":"S02","marital_status":"UNMARRIED"},"groups":["jia_household","human"],"id":"xiren","name":"花袭人"}},{"path":"data/world/m3_core.json","pointer":"/characters/10","ref":"data/world/m3_core.json#/characters/10","sha256":"c4bf1c75fda8994fd846e570a64ae69efeb6ca17cd27e78c1bb1af4d7783d733","text_sha256":"340eb8abc9247bbb71dbde20970aad2d26ba92195c40678d53b29fcd43b5c3c2","value":{"baseline":{"body_state":"ordinary","household_role":"kin_runner","legal_status":"NOT_AT_ISSUE","life_state":"ACTIVE","location":null,"marital_status":"UNRESOLVED"},"groups":["jia_network","human"],"id":"jia_yun","name":"贾芸"}}]},"required_beats":[{"description":"贾芸/花家旧人仅为两条候选地址渠道；先选一条再交代谁把可追问住处线索交给袭人、转话先后和延时。贾芸身份已注册不证明在本场出镜；花家旧人仅用角色称谓，不填姓名地址。未选定之前不得把两个渠道同时写成确定事实。","grounding":{"chapter_card_fields":[{"citation":{"byte_range":[41347,41450],"lines":[1033,1035],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"5d7be63035e663b59f92a7a999e6de1ccd5453a75876ae5bac86b89480c58d3b"},"name":"最薄处","number":3,"text":"**3｜最薄处**  \n袭人如何知道地址、蒋为何同行、湘云信如何转递可补很轻。\n\n"},{"citation":{"byte_range":[41450,41592],"lines":[1036,1038],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"5370e9ec10523670b884650f3380fdf4820b44af93d84c66b5697264cabf11dc"},"name":"缺失情节","number":4,"text":"**4｜缺失情节**  \n96-S1贾芸/花家旧人转地址；S2蒋正好有现实理由同行；S3宝钗分配援助；S4信件延迟路径。\n\n"},{"citation":{"byte_range":[41592,41668],"lines":[1039,1041],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"818b3da12b7774ef5e1223244715c6f8f88d6f436128e34f6832fd288f8870e1"},"name":"人物","number":5,"text":"**5｜人物**  \n袭人、蒋、贾芸、宝钗麝月宝玉；送信人。\n\n"}],"seed":{"path":"data/prewrite/v06.json","pointer":"/omitted_scene_plans/15/candidate_scenes/0","ref":"data/prewrite/v06.json#/omitted_scene_plans/15/candidate_scenes/0","sha256":"caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff","text_sha256":"48b41e4dee216800a693992e026d89115caacc742446487f2cd92534fb60c1e6","value":{"id":"96-S1","title":"袭人不是凭空知道地址"}},"world_basis":[{"path":"data/world/m3_resources.json","pointer":"/resource_flows/15","ref":"data/world/m3_resources.json#/resource_flows/15","sha256":"b823f72594d4a2af2216525cbfd3411b00d41c4ad0fa89830348933be6de7668","text_sha256":"5fc4a72fc39fcc12e4293c5d4b80fbc1da8bfe02aec5e50c1bfe2661a8e0c397","value":{"boundary":"援助应被节制使用","chapter":96,"epistemic":"REFERENCE_RESOURCE_FLOW","food_medicine":"一袋米、一筐炭、小包碎银；晚饭标准不变","labor":"蒋玉菡搬物/出钱，袭人问日用，麝月收放","money_state":"有限外援，不能逆转贫困","object_interface":"米只倒一半、银收匣","source_ref":"asset:sha256:ffed02aee8809a8937651529048e2cc10256a0ae2e2706251c9b806a6ea6ef50"}}]},"id":"96-S1-R1","scope":"AUTHORING_REQUIREMENT_NOT_HISTORICAL_FACT","status":"PENDING"},{"description":"袭人以嫁后故人而非返府婢女身份询问住处。本桥段完成的是地址可传递性，不是已经到门或入住；实际找路、敲门接口留给96-S2，不以chapter-1已婚/离府粗状态证明本场位置。","grounding":{"chapter_card_fields":[{"citation":{"byte_range":[40868,41151],"lines":[1023,1029],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"4e1dfebff884225a9db0a5e67e733e67da9491c353b277cad34eae7ed88ccaf4"},"name":"硬节点","number":1,"text":"**1｜硬节点**  \nR25/R26\n\n**V-INTERFACES｜**\n- V5：`后回与袭人供奉玉兄宝卿得同终始`；\n- “供奉”锁照应关系，不锁大额救济、同住或恢复阶级。：袭人蒋玉菡后期照应宝玉宝钗；O04贫寒相位开放。湘云/若兰仍O06开放。\n\n"},{"citation":{"byte_range":[41151,41347],"lines":[1030,1032],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"dc3cd383fee0133c3409d89f7e4404e402549069d08f926d39dc26f1aadc4646"},"name":"最强处","number":2,"text":"**2｜最强处**  \n袭人敲门、蒋玉菡站门外不抢戏；戏业生计完整；援助物多钱少；湘云长信里婚后生活与“写两句揉掉”；新旧米同淘、仍两碗半。\n\n"},{"citation":{"byte_range":[42620,42880],"lines":[1075,1078],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"8832c9bcf625976cfbdd882062f9389a0bec721ddae393d26670e34ced117b8a"},"name":"章法 / 风险","number":18,"text":"**18｜章法 / 风险**  \n贫居春日 → 袭人到门 → 故人相见 → 蒋职业生活只露够用的一层 → 援助分配 → 湘云信到 → “两句揉掉” → 新旧米同锅。  \n**风险：**故人援助恢复阶级；文化展示过满。\n\n"}],"seed":{"path":"data/prewrite/v06.json","pointer":"/omitted_scene_plans/15/candidate_scenes/0","ref":"data/prewrite/v06.json#/omitted_scene_plans/15/candidate_scenes/0","sha256":"caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff","text_sha256":"48b41e4dee216800a693992e026d89115caacc742446487f2cd92534fb60c1e6","value":{"id":"96-S1","title":"袭人不是凭空知道地址"}},"world_basis":[{"path":"data/world/m3_resources.json","pointer":"/resource_flows/15","ref":"data/world/m3_resources.json#/resource_flows/15","sha256":"b823f72594d4a2af2216525cbfd3411b00d41c4ad0fa89830348933be6de7668","text_sha256":"5fc4a72fc39fcc12e4293c5d4b80fbc1da8bfe02aec5e50c1bfe2661a8e0c397","value":{"boundary":"援助应被节制使用","chapter":96,"epistemic":"REFERENCE_RESOURCE_FLOW","food_medicine":"一袋米、一筐炭、小包碎银；晚饭标准不变","labor":"蒋玉菡搬物/出钱，袭人问日用，麝月收放","money_state":"有限外援，不能逆转贫困","object_interface":"米只倒一半、银收匣","source_ref":"asset:sha256:ffed02aee8809a8937651529048e2cc10256a0ae2e2706251c9b806a6ea6ef50"}}]},"id":"96-S1-R2","scope":"AUTHORING_REQUIREMENT_NOT_HISTORICAL_FACT","status":"PENDING"},{"description":"桥段保持L1—2的轻度：不给贾芸另添救济、名流联络或完整查访长篇，使贫居春日与故人到门仍是主体。","grounding":{"chapter_card_fields":[{"citation":{"byte_range":[42137,42252],"lines":[1057,1059],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"c0716ef332ecc10314322c98da6de937bacc166a56c734f4e06e10aa51d7efe6"},"name":"四链","number":11,"text":"**11｜四链**  \nE4：援助只能缓解；米、炭、一点碎银，不赎回阶级。信件有转递时间。\n\n"},{"citation":{"byte_range":[42440,42471],"lines":[1066,1068],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"c6f2ac7e83d87120796bcdfad66b71be698dc35408a78deaca4ad009b60a7c42"},"name":"L3","number":14,"text":"**14｜L3**  \n无，L1—2。\n\n"},{"citation":{"byte_range":[42620,42880],"lines":[1075,1078],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"8832c9bcf625976cfbdd882062f9389a0bec721ddae393d26670e34ced117b8a"},"name":"章法 / 风险","number":18,"text":"**18｜章法 / 风险**  \n贫居春日 → 袭人到门 → 故人相见 → 蒋职业生活只露够用的一层 → 援助分配 → 湘云信到 → “两句揉掉” → 新旧米同锅。  \n*