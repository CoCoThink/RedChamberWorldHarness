_status":"UNRESOLVED"},"groups":["jia_household","human"],"id":"sheyue","name":"麝月"}},{"path":"data/world/m3_core.json","pointer":"/characters/0","ref":"data/world/m3_core.json#/characters/0","sha256":"c4bf1c75fda8994fd846e570a64ae69efeb6ca17cd27e78c1bb1af4d7783d733","text_sha256":"c90d10be26bb276650ff292a0dc2e511347a54c0bd8bfef95a7ed588454eff94","value":{"baseline":{"body_state":"ordinary","household_role":"jia_son","legal_status":"FREE","life_state":"ACTIVE","location":"S02","marital_status":"UNMARRIED"},"groups":["jia_household","human"],"id":"baoyu","name":"贾宝玉"}}]},"required_beats":[{"description":"宝钗分配米炭，麝月经手收放，碎银先压匣而非即时花光；区分96-S2来访者送物与本场家内量用，袭人/蒋是否还在场未定，不为分配动作强留访客。米炭、银收置及租用压力通过实际选择呈现。","grounding":{"chapter_card_fields":[{"citation":{"byte_range":[41450,41592],"lines":[1036,1038],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"5370e9ec10523670b884650f3380fdf4820b44af93d84c66b5697264cabf11dc"},"name":"缺失情节","number":4,"text":"**4｜缺失情节**  \n96-S1贾芸/花家旧人转地址；S2蒋正好有现实理由同行；S3宝钗分配援助；S4信件延迟路径。\n\n"},{"citation":{"byte_range":[42137,42252],"lines":[1057,1059],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"c0716ef332ecc10314322c98da6de937bacc166a56c734f4e06e10aa51d7efe6"},"name":"四链","number":11,"text":"**11｜四链**  \nE4：援助只能缓解；米、炭、一点碎银，不赎回阶级。信件有转递时间。\n\n"},{"citation":{"byte_range":[42252,42363],"lines":[1060,1062],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"3ce548c361059810c314274f1dfe95d917f8127986d53f3faa0a18ddb7f4599c"},"name":"必须保留","number":12,"text":"**12｜必须保留**  \n袭/蒋/麝 teasing；便宜油膏；银子先收；两碗半不变；春菜叫卖。\n\n"}],"seed":{"path":"data/prewrite/v06.json","pointer":"/omitted_scene_plans/15/candidate_scenes/2","ref":"data/prewrite/v06.json#/omitted_scene_plans/15/candidate_scenes/2","sha256":"caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff","text_sha256":"31ee937f27af00caa2d9e091c41c2f5257d6628373d23cbc77bb19d36ec652df","value":{"id":"96-S3","title":"援助被宝钗重新分配，而不是立刻消费"}},"world_basis":[{"path":"data/world/m3_resources.json","pointer":"/resource_flows/15","ref":"data/world/m3_resources.json#/resource_flows/15","sha256":"b823f72594d4a2af2216525cbfd3411b00d41c4ad0fa89830348933be6de7668","text_sha256":"5fc4a72fc39fcc12e4293c5d4b80fbc1da8bfe02aec5e50c1bfe2661a8e0c397","value":{"boundary":"援助应被节制使用","chapter":96,"epistemic":"REFERENCE_RESOURCE_FLOW","food_medicine":"一袋米、一筐炭、小包碎银；晚饭标准不变","labor":"蒋玉菡搬物/出钱，袭人问日用，麝月收放","money_state":"有限外援，不能逆转贫困","object_interface":"米只倒一半、银收匣","source_ref":"asset:sha256:ffed02aee8809a8937651529048e2cc10256a0ae2e2706251c9b806a6ea6ef50"}}]},"id":"96-S3-R1","scope":"AUTHORING_REQUIREMENT_NOT_HISTORICAL_FACT","status":"PENDING"},{"description":"新旧米同淘、仍两碗半，米只倒一半形成有限缓冲。既有对象顺序严格为OT96-01与OT96-03（同序35）后OT96-02（序45）；同序两笔不推出彼此时间先后。这一章级前缀不等于本场三次实际动作已执行。","grounding":{"chapter_card_fields":[{"citation":{"byte_range":[41151,41347],"lines":[1030,1032],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"dc3cd383fee0133c3409d89f7e4404e402549069d08f926d39dc26f1aadc4646"},"name":"最强处","number":2,"text":"**2｜最强处**  \n袭人敲门、蒋玉菡站门外不抢戏；戏业生计完整；援助物多钱少；湘云长信里婚后生活与“写两句揉掉”；新旧米同淘、仍两碗半。\n\n"},{"citation":{"byte_range":[41904,41980],"lines":[1048,1050],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"55047834fc6c02f7760cb18b54e8dca122aef24599cd40c6860b2634cd02aba6"},"name":"笑料","number":8,"text":"**8｜笑料**  \n淡茶、松子、两碗半、纸边沾饭气等保护。\n\n"},{"citation":{"byte_range":[42137,42252],"lines":[1057,1059],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"c0716ef332ecc10314322c98da6de937bacc166a56c734f4e06e10aa51d7efe6"},"name":"四链","number":11,"text":"**11｜四链**  \nE4：援助只能缓解；米、炭、一点碎银，不赎回阶级。信件有转递时间。\n\n"},{"citation":{"byte_range":[42252,42363],"lines":[1060,1062],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"3ce548c361059810c314274f1dfe95d917f8127986d53f3faa0a18ddb7f4599c"},"name":"必须保留","number":12,"text":"**12｜必须保留**  \n袭/蒋/麝 teasing；便宜油膏；银子先收；两碗半不变；春菜叫卖。\n\n"}],"seed":{"path":"data/prewrite/v06.json","pointer":"/omitted_scene_plans/15/candidate_scenes/2","ref":"data/prewrite/v06.json#/omitted_scene_plans/15/candidate_scenes/2","sha256":"caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff","text_sha256":"31ee937f27af00caa2d9e091c41c2f5257d6628373d23cbc77bb19d36ec652df","value":{"id":"96-S3","title":"援助被宝钗重新分配，而不是立刻消费"}},"world_basis":[{"path":"data/world/m3_resources.json","pointer":"/resource_flows/15","ref":"data/world/m3_resources.json#/resource_flows/15","sha256":"b823f72594d4a2af2216525cbfd3411b00d41c4ad0fa89830348933be6de7668","text_sha256":"5fc4a72fc39fcc12e4293c5d4b80fbc1da8bfe02aec5e50c1bfe2661a8e0c397","value":{"boundary":"援助应被节制使用","chapter":96,"epistemic":"REFERENCE_RESOURCE_FLOW","food_medicine":"一袋米、一筐炭、小包碎银；晚饭标准不变","labor":"蒋玉菡搬物/出钱，袭人问日用，麝月收放","money_state":"有限外援，不能逆转贫困","object_interface":"米只倒一半、银收匣","source_ref":"asset:sha256:ffed02aee8809a8937651529048e2cc10256a0ae2e2706251c9b806a6ea6ef50"}}]},"id":"96-S3-R2","scope":"AUTHORING_REQUIREMENT_NOT_HISTORICAL_FACT","status":"PENDING"},{"description":"旧夹袄当票不急赎，与收银、节用并置；收束仍听卖春菜声，不把援物变成新衣、新家具或阔绰宴席。","grounding":{"chapter_card_fields":[{"citation":{"byte_range":[42137,42252],"lines":[1057,1059],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b