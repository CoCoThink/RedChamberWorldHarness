最后病日、死后礼俗、遗稿多案","chapter":86,"forbidden_drift":"冷药不得被诗盖住；不得全员围哭一口声","level":"P1","must_preserve":"火箸碰茶盘；大夫被别处绊住；灯热水衣裳炉火药汁；再温一温；冷药无人再温","source_ref":"asset:sha256:626917a3603d00697ccb86e6be8d1bb5b40911ffad700436ea836cd8e6336261"}},{"path":"data/prewrite/v06.json","pointer":"/gap_cards/5","ref":"data/prewrite/v06.json#/gap_cards/5","sha256":"caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff","text_sha256":"c9cc9d96585bb46d4fbe1f45e49332d34464c7c43ca1a32cd8df00610737bf96","value":{"chapter":86,"priority":"第一批","source_ref":"asset:sha256:faae6f996071b532940ceddfdd55830df7eb60a59d98ee167f725dffd7b4f3d0","source_symbols":{"arts":"△","body":"▲","chapter_frame":"✓","comic_folk":"✓","dream_symbol":"✓","economy":"▲","main_process":"▲","metaphysics":"△","minor_agents":"✓","poetry":"▲","ritual":"▲","secondary_plot":"✓"},"states":{"arts":"THIN","body":"MISSING","chapter_frame":"SUFFICIENT","comic_folk":"SUFFICIENT","dream_symbol":"SUFFICIENT","economy":"MISSING","main_process":"MISSING","metaphysics":"THIN","minor_agents":"SUFFICIENT","poetry":"MISSING","ritual":"MISSING","secondary_plot":"SUFFICIENT"}}},{"path":"data/prewrite/v06.json","pointer":"/omitted_scene_plans/5","ref":"data/prewrite/v06.json#/omitted_scene_plans/5","sha256":"caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff","text_sha256":"73ff725669552843e460e7fefb7d3fb6f557d0e5b1b333f5737219ddc3f6e5a0","value":{"action":"重点重构","candidate_scenes":[{"id":"86-S1","title":"最后一次“明日安排”"},{"id":"86-S2","title":"医生“迟”必须有现实原因"},{"id":"86-S3","title":"临终前最后一个文人动作只做到一半"},{"id":"86-S4","title":"死亡之后先处理“身体”"},{"id":"86-S5","title":"宝玉为什么“来迟”"},{"id":"86-S6","title":"宝玉来时“冷药仍在”"}],"chapter":86,"core_process":"最后普通病日→临终→死后第一日→宝玉来迟","handoff":"39、37、36","intensity":"高","source_ref":"asset:sha256:4e1dd2a2d7669011ece72f8d7a5b93903b235042aadd528f0178f6544901dc7b"}},{"path":"data/literary_ecology/m5.json","pointer":"/author_rhyme_chapters/5","ref":"data/literary_ecology/m5.json#/author_rhyme_chapters/5","sha