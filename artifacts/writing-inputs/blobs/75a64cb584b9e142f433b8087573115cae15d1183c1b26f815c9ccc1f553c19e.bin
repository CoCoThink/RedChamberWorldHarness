","id":"daiyu","identity_record":{"id":"daiyu","name":"林黛玉"},"name":"黛玉","provenance":"COORDINATOR_EDITORIAL_CHOICE_NOT_EVIDENCE","registration":"EXISTING_IDENTITY_ONLY"},{"duty":"持续床边照护，观察突变后托雪雁报病危；死后料理身体，不翻稿。","id":"zijuan","identity_record":{"id":"zijuan","name":"紫鹃"},"name":"紫鹃","provenance":"COORDINATOR_EDITORIAL_CHOICE_NOT_EVIDENCE","registration":"EXISTING_IDENTITY_ONLY"},{"duty":"迟获病危消息才赶来，到场问药后再获知确切死时；不赶上最后一息。","id":"baoyu","identity_record":{"id":"baoyu","name":"贾宝玉"},"name":"宝玉","provenance":"COORDINATOR_EDITORIAL_CHOICE_NOT_EVIDENCE","registration":"EXISTING_IDENTITY_ONLY"},{"duty":"协助照护，受托传病危消息至宝玉；与请医跑腿分开，不捏造现存ID、路线或地点。","id":"local:ch86:xueyan","name":"雪雁","provenance":"COORDINATOR_EDITORIAL_CHOICE_NOT_EVIDENCE","registration":"NEW_LOCAL_IDENTITY"},{"duty":"承接一次米汤或热水交接，保留独立实务出场；不设置床边告别，不默认目击死亡。","id":"baochai","identity_record":{"id":"baochai","name":"薛宝钗"},"name":"宝钗","provenance":"COORDINATOR_EDITORIAL_CHOICE_NOT_EVIDENCE","registration":"EXISTING_IDENTITY_ONLY"},{"duty":"选择死后接到通知再接手热水衣物的第一轮身体料理；须补传播与到场事件。","id":"liwan","identity_record":{"id":"liwan","name":"李纨"},"name":"李纨","provenance":"COORDINATOR_EDITORIAL_CHOICE_NOT_EVIDENCE","registration":"EXISTING_IDENTITY_ONLY"},{"duty":"选择获死讯后分派第一轮后事和持续劳务；不设围哭或默认亲见死亡。","id":"wangfuren","identity_record":{"id":"wangfuren","name":"王夫人"},"name":"王夫人","provenance":"COORDINATOR_EDITORIAL_CHOICE_NOT_EVIDENCE","registration":"EXISTING_IDENTITY_ONLY"},{"duty":"别处普通事务绊住，由请医链反馈；不新增具体病家、诊断、时辰或已到床边事实。","id":"local:ch86:doctor","name":"医者","provenance":"COORDINATOR_EDITORIAL_CHOICE_NOT_EVIDENCE","registration":"NEW_LOCAL_IDENTITY"},{"duty":"请医并带回现实延误反馈；不兼作雪雁的病危报信，以免两链混淆。","id":"local:ch86:doctor-runner","name":"请医跑腿","provenance":"COORDINATOR_EDITORIAL_CHOICE_NOT_EVIDENCE","registration":"NEW_LOCAL_IDENTITY"}],"authority_effect":"NONE","before":[["ordinary_care","doctor_feedback"],["doctor_feedback","unfinished_revision"],["unfinished_revision","rapid_decline_observed"],["rapid_decline_observed","critical_message_dispatched"],["critical_message_dispatched","death_witnessed"],["death_witnessed","body_care_started"],["death_witnessed","liwan_notified"],["liwan_notified","liwan_takes_care"],["death_witnessed","wangfuren_notified"],["wangfuren_notified","wangfuren_assigns_work"],["critical_message_dispatched","baoyu_receives_critical_message"],["baoyu_receives_critical_message","baoyu_departs"],["baoyu_departs","baoyu_arrives"],["death_witnessed","baoyu_arrives"],["baoyu_arrives","baoyu_asks_rewarm"],["baoyu_asks_rewarm","baoyu_learns_death_time"],["baoyu_learns_death_time","terminal_cold_unfinished_medicine"],["ordinary_care","doctor_delay_observed"],["doctor_delay_observed","doctor_reply_sent"],["doctor_reply_sent","doctor_feedback"],["death_witnessed","runner_observes_death"],["runner_observes_death","household_notices_sent"],["household_notices_sent","liwan_notified"],["household_notices_sent","wangfuren_notified"],["liwan_notified","liwan_arrives"],["liwan_arrives","liwan_takes_care"],["body_care_started","liwan_takes_care"],["baoyu_asks_rewarm","death_time_notice_sent"],["death_time_notice_sent","baoyu_learns_death_time"],["baoyu_learns_death_time","medicine_cools"],["medicine_cools","terminal_cold_unfinished_medicine"]],"chapter":86,"containment":[{"contained":"local:ch86:pages","container":"local:ch86:folder"}],"contracts":[{"path":"data/writing/local-scenarios/ch86-v1/contracts/86-S1.v3.json","sha256":"5573e58e11b45c50de00ac4a9657a84b2e7f0b375520fa1747ff3199e64ee572"},{"path":"data/writing/local-scenarios/ch86-v1/contracts/86-S2.v3.json","sha256":"b7a941e4535d8552f220a2cf088d931449dd689f41da7de0f03de8f05dce5a73"},{"path":"data/writing/local-scenarios/ch86-v1/contracts/86-S3.v3.json","sha256":"781b3a73149d79cedbfd96d05db16e48b5cd84bd8e549bd2347e18d4973a2c12"},{"path":"data/writing/local-scenarios/ch86-v1/contracts/86-S4.v3.json","sha256":"0d5688b0cb3b28952a27962de6421f506b33263135b88b772f44b0d257ebca47"},{"path":"data/writing/local-scenarios/ch86-v1/contracts/86-S5.v3.json","sha256":"47bec2904b39757588a15a3c6249c8be47a5c810c38afca0b1c7330763f145f4"},{"path":"data/writing/local-scenarios/ch86-v1/contracts/86-S6.v3.json","sha256":"75eb2fd3861ed2ed0dbc83db2a303ec64de7b7451e80a12cfccde37314ad3ed6"}],"events":[{"description":"普通病晨仍安排明日；宝钗交接米汤/热水一次，紫鹃雪雁持续照护，不作临终告别。","effects":[{"basis":{"kind":"OBSERVATION"},"from":"NOT_KNOWN","reason":"局部计划中的观察/送达，不声明已发生或已在正文实现。","target":"actor.zijuan.knowledge.illness_severe","to":"KNOWS"},{"basis":{"kind":"OBSERVATION"},"from":"NOT_KNOWN","reason":"局部计划中的观察/送达，不声明已发生或已在正文实现。","target":"actor.local:ch86:xueyan.knowledge.illness_severe","to":"KNOWS"},{"basis":{"kind":"OBSERVATION"},"from":"NOT_KNOWN","reason":"局部计划中的观察/送达，不声明已发生或已在正文实现。","target":"actor.baochai.knowledge.illness_severe","to":"KNOWS"},{"from":"zijuan","reason":"选择放下同碗，后续不换碗。","target":"object.OBJ-MEDICINE-BOWL-86.holder","to":null},{"from":"CARE_USE","reason":"只表示相对取放，具体房间仍未知。","target":"object.OBJ-MEDICINE-BOWL-86.placement","to":"SET_ASIDE"},{"from":"warm","reason":"初次温药之后不持续观测中间药温，不能自动把warm带到到场时。","target":"object.OBJ-MEDICINE-BOWL-86.temperature","to":"UNKNOWN"}],"execution":"NOT_OBSERVED","id":"ordinary_care","observed_facts":["illness_severe"],"participants":["daiyu","zijuan","local:ch86:xueyan","baochai"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"请医跑腿在医者一端获知普通事务延误；具体病家、诊断、时长、路线不设定。","effects":[{"basis":{"kind":"OBSERVATION"},"from":"NOT_KNOWN","reason":"局部计划中的观察/送达，不声明已发生或已在正文实现。","target":"actor.local:ch86:doctor-runner.knowledge.doctor_delayed","to":"KNOWS"}],"execution":"NOT_OBSERVED","id":"doctor_delay_observed","observed_facts":["doctor_delayed"],"participants":["local:ch86:doctor","local:ch86:doctor-runner"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"请医跑腿携延误反馈返回，和雪雁病危消息分链。","effects":[],"execution":"NOT_OBSERVED","id":"doctor_reply_sent","observed_facts":[],"participants":["local:ch86:doctor-runner"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"请医反馈到达紫鹃；不表示医者已到床边。","effects":[{"basis":{"id":"doctor-reply","kind":"MESSAGE"},"from":"NOT_KNOWN","reason":"局部计划中的观察/送达，不声明已发生或已在正文实现。","target":"actor.zijuan.knowledge.doctor_delayed","to":"KNOWS"}],"execution":"NOT_OBSERVED","id":"doctor_feedback","observed_facts":[],"participants":["local:ch86:doctor-runner","zijuan"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"伸手改字而未成；G01空字不补，紫鹃不翻稿。身体能做多少仍UNKNOWN，不编中止机制。","effects":[],"execution":"NOT_OBSERVED","id":"unfinished_revision","observed_facts":[],"participants":["daiyu","zijuan"],"requires":[{"target":"actor.daiyu.life_state","value":"ACTIVE"}],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"观察最后突变后才报病危，不把长病程等同本刻预知。","effects":[{"basis":{"kind":"OBSERVATION"},"from":"NOT_KNOWN","reason":"局部计划中的观察/送达，不声明已发生或已在正文实现。","target":"actor.zijuan.knowledge.critical_decline","to":"KNOWS"},{"basis":{"kind":"OBSERVATION"},"from":"NOT_KNOWN","reason":"局部计划中的观察/送达，不声明已发生或已在正文实现。","target":"actor.local:ch86:xueyan.knowledge.critical_decline","to":"KNOWS"}],"execution":"NOT_OBSERVED","id":"rapid_decline_observed","observed_facts":["critical_decline"],"participants":["daiyu","zijuan","local:ch86:xueyan"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"雪雁受托携病危消息出发；内容不含尚未发生的死时。","effects":[],"execution":"NOT_OBSERVED","id":"critical_message_dispatched","observed_facts":[],"participants":["local:ch86:xueyan","zijuan"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"紫鹃目击死亡，生命终点来自长期病程，不归因婚姻、失玉或缺药。","effects":[{"from":"ACTIVE","reason":"新编辑模型的死亡节点，不回写Evidence Truth。","target":"actor.daiyu.life_state","to":"DEAD"},{"basis":{"kind":"OBSERVATION"},"from":"NOT_KNOWN","reason":"局部计划中的观察/送达，不声明已发生或已在正文实现。","target":"actor.zijuan.knowledge.death_occurred","to":"KNOWS"},{"basis":{"kind":"OBSERVATION"},"from":"NOT_KNOWN","reason":"局部计划中的观察/送达，不声明已发生或已在正文实现。","target":"actor.zijuan.knowledge.death_exact_moment","to":"KNOWS"}],"execution":"NOT_OBSERVED","id":"death_witnessed","observed_facts":["death_occurred","death_exact_moment"],"participants":["daiyu","zijuan"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"先处理身体、热水衣物；不追加礼俗清单或抒情长哭。","effects":[],"execution":"NOT_OBSERVED","id":"body_care_started","observed_facts":[],"participants":["zijuan"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"新增明确编辑选择：请医跑腿在返回后的劳务中看见已死身体，承担后事通知；不知确切死时。","effects":[{"basis":{"kind":"OBSERVATION"},"from":"NOT_KNOWN","reason":"局部计划中的观察/送达，不声明已发生或已在正文实现。","target":"actor.local:ch86:doctor-runner.knowledge.death_occurred","to":"KNOWS"}],"execution":"NOT_OBSERVED","id":"runner_observes_death","observed_facts":["death_occurred"],"participants":["local:ch86:doctor-runner","zijuan"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"请医跑腿携死讯通知李纨和王夫人，传播路径与时长保持未知。","effects":[],"execution":"NOT_OBSERVED","id":"household_notices_sent","observed_facts":[],"participants":["local:ch86:doctor-runner"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"李纨收到死讯，尚未据此宣称到床边。","effects":[{"basis":{"id":"liwan-death-notice","kind":"MESSAGE"},"from":"NOT_KNOWN","reason":"局部计划中的观察/送达，不声明已发生或已在正文实现。","target":"actor.liwan.knowledge.death_occurred","to":"KNOWS"}],"execution":"NOT_OBSERVED","id":"liwan_notified","observed_facts":[],"participants":["liwan","local:ch86:doctor-runner"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"显式登记李纨进入身体料理劳务；具体房间和路线未知。","effects":[],"execution":"NOT_OBSERVED","id":"liwan_arrives","observed_facts":[],"participants":["liwan"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"李纨接手热水衣物第一轮身体料理。","effects":[],"execution":"NOT_OBSERVED","id":"liwan_takes_care","observed_facts":[],"participants":["liwan","zijuan"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"王夫人获死讯，不默认亲见死亡。","effects":[{"basis":{"id":"wangfuren-death-notice","kind":"MESSAGE"},"from":"NOT_KNOWN","reason":"局部计划中的观察/送达，不声明已发生或已在正文实现。","target":"actor.wangfuren.knowledge.death_occurred","to":"KNOWS"}],"execution":"NOT_OBSERVED","id":"wangfuren_notified","observed_facts":[],"participants":["wangfuren","local:ch86:doctor-runner"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"王夫人分派后事第一轮和持续劳务；不默认已到床边。","effects":[],"execution":"NOT_OBSERVED","id":"wangfuren_assigns_work","observed_facts":[],"participants":["wangfuren"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"宝玉迟获病危消息；不含确切死时，不强定相对身体料理的顺序。","effects":[{"basis":{"id":"critical-message","kind":"MESSAGE"},"from":"NOT_KNOWN","reason":"局部计划中的观察/送达，不声明已发生或已在正文实现。","target":"actor.baoyu.knowledge.critical_decline","to":"KNOWS"}],"execution":"NOT_OBSERVED","id":"baoyu_receives_critical_message","observed_facts":[],"participants":["baoyu","local:ch86:xueyan"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"收到病危消息后赶来；未知出发地点、路线、时辰。","effects":[],"execution":"NOT_OBSERVED","id":"baoyu_departs","observed_facts":[],"participants":["baoyu"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"死亡之后到场，不赶上最后一息；到场不自动更新死时。","effects":[{"from":"NOT_ARRIVED","reason":"局部到场边界，非全局空间移动。","target":"actor.baoyu.arrival","to":"ARRIVED"}],"execution":"NOT_OBSERVED","id":"baoyu_arrives","observed_facts":[],"participants":["baoyu","zijuan"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"只问“药还没吃么？再温一温”；请求不执行，不加热、不代饮、不换碗。","effects":[],"execution":"NOT_OBSERVED","id":"baoyu_asks_rewarm","observed_facts":[],"participants":["baoyu","zijuan"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"问药后紫鹃传达她目击的死时；不用具体钟点数字填补未知。","effects":[],"execution":"NOT_OBSERVED","id":"death_time_notice_sent","observed_facts":[],"participants":["zijuan"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"到场并问药之后才获知确切死亡经过；不是预先带来的知识。","effects":[{"basis":{"id":"death-time-notice","kind":"MESSAGE"},"from":"NOT_KNOWN","reason":"局部计划中的观察/送达，不声明已发生或已在正文实现。","target":"actor.baoyu.knowledge.death_occurred","to":"KNOWS"},{"basis":{"id":"death-time-notice","kind":"MESSAGE"},"from":"NOT_KNOWN","reason":"局部计划中的观察/送达，不声明已发生或已在正文实现。","target":"actor.baoyu.knowledge.death_exact_moment","to":"KNOWS"}],"execution":"NOT_OBSERVED","id":"baoyu_learns_death_time","observed_facts":[],"participants":["baoyu","zijuan"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"新增末端检查边界：本节点核定同碗为冷；中间药温UNKNOWN，不声称现实冷却耗时或刚在本刻变冷。","effects":[{"from":"UNKNOWN","reason":"计划的末端冷药检查，不把未知的转冷时刻改成已知。","target":"object.OBJ-MEDICINE-BOWL-86.temperature","to":"cold"},{"from":"LIT","reason":"炉火熄是末端编辑安排，不推导缺药致死。","target":"object.local:ch86:stove-fire.state","to":"OUT"}],"execution":"NOT_OBSERVED","id":"medicine_cools","observed_facts":[],"participants":[],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"},{"description":"同一网络药碗：未尽且冷，无人再温；请求未执行。","effects":[],"execution":"NOT_OBSERVED","id":"terminal_cold_unfinished_medicine","observed_facts":[],"participants":["baoyu","zijuan"],"requires":[],"scope":"EDITORIAL_MODEL_ONLY_NOT_OBSERVED"}],"evidence_effect":"NONE","extra_editorial_choices":["请医跑腿观察已死身体后传后事通知；不是目击确切死时。","起始温药后中间药温UNKNOWN；末端medicine_cools核定为冷，不确定真实转冷时刻。","李纨通知与到场分开；王夫人不设床边到场。"],"facts":[{"id":"illness_severe","meaning":"病重"},{"id":"critical_decline","meaning":"最后突变已需报病危"},{"id":"death_occurred","meaning":"已死亡"},{"id":"death_exact_moment","meaning":"目击/获告具体死亡经过（不填写钟点）"},{"id":"doctor_delayed","meaning":"医者受普通事务延误"}],"initial":{"actor.baochai.knowledge.critical_decline":"UNKNOWN","actor.baochai.knowledge.death_exact_moment":"UNKNOWN","actor.baochai.knowledge.death_occurred":"UNKNOWN","actor.baochai.knowledge.doctor_delayed":"UNKNOWN","actor.baochai.knowledge.illness_severe":"NOT_KNOWN","actor.baoyu.arrival":"NOT_ARRIVED","actor.baoyu.knowledge.critical_decline":"NOT_KNOWN","actor.baoyu.knowledge.death_exact_moment":"NOT_KNOWN","acto