hihui/v3.1416/original.epub","sha256":"ef840e3ff96b056594a1388d7accfe7065ad2a940568222e4075ecb7bc0ea755"},{"path":"sources/primary/hongloumeng/zhihui/v3.1416/original.pdf","sha256":"37441da3cb438d1b3eab2b511aa6f1695f309192fa63bea842413ff91655c1d7"},{"path":"sources/primary/received/15da766c875fee0cc85ffda56f6b5aca9a70960fed444886a7f781d63e6777cc/rental.html","sha256":"15da766c875fee0cc85ffda56f6b5aca9a70960fed444886a7f781d63e6777cc"},{"path":"sources/primary/received/1798f0451e35b8383c48661fd4fe9fc94c97ba67b281498dc6a5a36ecd6d1314/npm-2024-cao-documents.pdf","sha256":"1798f0451e35b8383c48661fd4fe9fc94c97ba67b281498dc6a5a36ecd6d1314"},{"path":"sources/primary/received/5791f0fee06af35e1f5d98c0ab4f06a7c088f818f5597b4eab6f30bd519327fa/npm-2024-exhibition-official.pdf","sha256":"5791f0fee06af35e1f5d98c0ab4f06a7c088f818f5597b4eab6f30bd519327fa"},{"path":"sources/project/23861cce04acb830/81—100_二十回全幅补完卡_v2.5_稳定ACTIVE.md","sha256":"23861cce04acb8308e2d9c19a38445cddbe985b41fc8f0458d965e2379309072"},{"path":"sources/project/626917a3603d0069/81—100_保护锁与不可破坏细节表_v2.5_稳定ACTIVE.md","sha256":"626917a3603d00697ccb86e6be8d1bb5b40911ffad700436ea836cd8e6336261"},{"path":"sources/project/66508dc74b1e09e9/RCWH_文学复原能力升级计划_v1.0_评审定稿_20261007.md","sha256":"66508dc74b1e09e9b0ad69f0cb781ae881505ee4f446075d85386bfb228205b7"},{"path":"sources/project/6ab10932c4f8ae35/红楼梦八十回后全幅文学补完大工程计划_v6.0_R4最终放行版.md","sha256":"6ab10932c4f8ae3580ec1f1db3034e8ba2fee58ae038db9556204ee11aeb0d44"},{"path":"sources/project/c1946d9ff097372a/红楼梦八十回后佚稿复原_工作底稿_v2.1_最终母本.md","sha256":"c1946d9ff097372aa0583eec627a5f37ec77ec3b076fa2229c23f7f441bb7eb0"}],"kind":"WRITING_DRAFT","package":{"path":"data/writing/packages/ch86-local-scenario-v1.json","sha256":"620f62e9ecd188ce3f8e2cd29a454bfae53ca7962b1c4df9a3ce366d1083f8e9"},"parent":null,"prepared_request":{"path":"artifacts/writing-requests/25e46c98ff84293c2b3a57ef1e29ec5df14948ca6f36692acb1d7a7054d8eaf6.json","sha256":"25e46c98ff84293c2b3a57ef1e29ec5df14948ca6f36692acb1d7a7054d8eaf6"},"prompt_sha256":"6ade04063661c5853c21880aa7b0341d30b06c3144be8ebb536de8c158db9bb0","qualification":"RESEARCH_ONLY","route":"harness","run":{"path":"artifacts/author-runs/4e86038748cf391a62e10964e37c712680baef09c77254d349e83e9287d0b306.json","sha256":"4e86038748cf391a62e10964e37c712680baef09c77254d349e83e9287d0b306"},"schema_version":2,"task":{"agent_contracts":[],"chapter":86,"chapter_plan":{"authority_effect":"NONE","card_fields":[{"citation":{"byte_range":[15442,15574],"lines":[406,408],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"ba579384b0678013d16620ec834d82d7b5808820069a6e71847930743ba19c2b"},"name":"硬节点","number":1,"text":"**1｜硬节点**  \nR10/R11；死亡方式必须是长期病程终点。当前“宝玉来迟”是C级章法，不伪装硬证。\n\n"},{"citation":{"byte_range":[15574,15819],"lines":[409,411],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"6294a4b92d26277a59da7e8bc02363262507446bc5fe5720ddeb32b03006fb46"},"name":"最强处 / 最高P-Lock","number":2,"text":"**2｜最强处 / 最高P-Lock**  \n最后一个普通病日；火箸碰茶盘；米汤、药、热水、炉火；G01改字未成；大夫有现实延误；宝玉赶到只问“药还没吃么？再温一温”；末尾**冷药无人再温**。\n\n"},{"citation":{"byte_range":[15819,15973],"lines":[412,414],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"e34ce345aab8ce8482fb7b5f85e293931a8b3995005ad570602acbb4a69621e0"},"name":"最薄处","number":3,"text":"**3｜最薄处**  \n死亡前后“身体—信息—后事”三个转换还需精确校时；宝玉来迟必须由信息链而非人为阻拦成立。\n\n"},{"citation":{"byte_range":[15973,16172],"lines":[415,417],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"c8442b0289c134a0b8a563cf0f2b30ce93f402e6064b68bb05aeb4552739a40e"},"name":"缺失情节","number":4,"text":"**4｜缺失情节**  \n按35冻结六段：明日安排 → 医者迟 → 最后未成文人动作 → 身体不可逆 → 死后先处理身体/热水衣物 → 宝玉迟到 → 后事第一轮。\n\n"},{"citation":{"byte_range":[16172,16296],"lines":[418,420],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"2ea29c21f3bfc61e731799ba8a2de49a66c33b53c83f609f633d211a77f0d584"},"name":"人物","number":5,"text":"**5｜人物**  \n紫鹃、雪雁、李纨、宝钗、王夫人、医者、跑腿、宝玉。不得全家轮流说遗言。\n\n"},{"citation":{"byte_range":[16296,16373],"lines":[421,423],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"48b07313ff0a07cfdace8f9414beb70a6d9286b8fd7c2b6540f1f4c9e89f8b4f"},"name":"文化","number":6,"text":"**6｜文化**  \n旧集/稿夹只服务临终生活；不做遗稿展览。\n\n"},{"citation":{"byte_range":[16373,16663],"lines":[424,426],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"649e3bac7648c718a84c1c4362adb1d04d83e73cb986c630cd10531e175331d3"},"name":"诗文身份","number":7,"text":"**7｜诗文身份**  \nG01“小院苔痕留宿雨 / 隔帘花影 □ 新晴”永不补完。A01应已在85完成。C01《葬花吟》只由死亡事实兑现第一层；C02《芙蓉女儿诔》读者暗回声；C06“冷月葬花魂”不明引；无《黛玉诔》、无作者挽诗。\n\n"},{"citation":{"byte_range":[16663,16752],"lines":[427,429],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"064346ed111e36b35f22d852a99262c53086a8d096b8e9d4bbcebc800d5dc39e"},"name":"笑料","number":8,"text":"**8｜笑料**  \n病晨仍可有一两句小丫头/米汤口角；死亡后立即退。\n\n"},{"citation":{"byte_range":[16752,16859],"lines":[430,432],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"a8005e17d65f111ad5300ff6f9b3dc230b02dd81f04d471497f79130b4fc9ca5"},"name":"宗教/梦","number":9,"text":"**9｜宗教/梦**  \n不临终悟道、不托梦、不写冷月显灵。形而上只在旧作暗回声。\n\n"},{"citation":{"byte_range":[16859,16984],"lines":[433,435],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"ab0529d9bc6e3b749aaa00e7e393dbbd35f8427810bd84eaf0921f24ffd94bfa"},"name":"职业","number":10,"text":"**10｜职业**  \n大夫“迟”必须有普通现实原因；药铺、跑腿、厨房、热水构成真正医疗劳务。\n\n"},{"citation":{"byte_range":[16984,17170],"lines":[436,438],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"35c6a9a0cdd9c2ba9f86db12541717d70b9d68b1e86bd65d6a9c6e1f024dcd09"},"name":"四链","number":11,"text":"**11｜四链**  \n人：照护链必须持续；钱：仍非穷死；物：药、米汤、炉、衣、热水、旧稿；信：病危→雪雁/人去报→宝玉迟获消息→赶来。\n\n"},{"citation":{"byte_range":[17170,17286],"lines":[439,441],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"6d15feb53097e6205fe066b2c72adcdc0766ade8d867826e11f4f329e94c9ec9"},"name":"必须保留","number":12,"text":"**12｜必须保留**  \n“再温一温”、未成稿、药吊子、紫鹃不翻稿、炉火熄、冷药结尾。\n\n"},{"citation":{"byte_range":[17286,17433],"lines":[442,444],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"ce0fb459938c863d8d51711a9daa666372f309271941913db29597c3e6367ae3"},"name":"应删","number":13,"text":"**13｜应删**  \n任何死亡后长篇哭诉、遗言、绝命诗、作者评叹；任何“因为宝玉结婚/失玉所以死”的单因果。\n\n"},{"citation":{"byte_range":[17433,17508],"lines":[445,447],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"5b125ed24cde40f0f54050621e04df191a47b8afaf428648b3018888fd44c266"},"name":"L3候选","number":14,"text":"**14｜L3候选**  \n本回正式重排为五段压力结构，属于L3。\n\n"},{"citation":{"byte_range":[17508,17632],"lines":[448,450],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"f3799d512c03a4a5a4f316d669843ec7828a1ce222f5302538bf7fa5221d621d"},"name":"前80同构","number":15,"text":"**15｜前80同构**  \n晴雯死、秦可卿丧务的“身体与家务并行”，但黛玉必须有自己长期病史。\n\n"},{"citation":{"byte_range":[17632,17660],"lines":[451,451],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"e1c22a397f53f3d123997c31bccf5dc898e2eee9267dc54c723ff51c44ba4ad3"},"name":"回前诗","number":16,"text":"**16｜回前诗** 无。  \n"},{"citation":{"byte_range":[17660,17700],"lines":[452,453],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"44e50474767c8d9301ed3c5c77ae2942e439a0cef17b919c728501c816f9af53"},"name":"回末诗","number":17,"text":"**17｜回末诗** **强锁无诗**。\n\n"},{"citation":{"byte_range":[17700,18079],"lines":[454,457],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"ca835b9c0cc0faa57e527da203559a9747367ae96a4fd542615428deec253849"},"name":"最终章法 / 风险","number":18,"text":"**18｜最终章法 / 风险**  \n普通晨间 → 尚做明日打算 → G01改字 → 身体跨界 → 信息外传/医生迟 → 死亡与身体料理 → 宝玉来迟 → 冷药。  \n**压力测试问题：**能否在不增加哭喊强度的情况下，使“来迟”更痛；能否让死亡真实而不医学化；A01是否在85已经足够，让86不再背诗文任务。\n\n"}],"chapter":86,"entry_ref":null,"evidence_effect":"NONE","existing_contracts":[{"id":"ch86_last_night","placement_status":"PENDING","ref":"data/scenes/ch86_last_night.yaml"}],"exit_ref":null,"open_refs":[],"order_basis":"SOURCE_LIST_ORDER_NOT_VERIFIED_CHRONOLOGY","protections":["data/implementation_alignment/m6.json#/chapter_protections/5"],"scenes":[{"id":"86-S1","order":1,"ref":"data/planning/scenes/86-S1.json"},{"id":"86-S2","order":2,"ref":"data/planning/scenes/86-S2.json"},{"id":"86-S3","order":3,"ref":"data/planning/scenes/86-S3.json"},{"id":"86-S4","order":4,"ref":"data/planning/scenes/86-S4.json"},{"id":"86-S5","order":5,"ref":"data/planning/scenes/86-S5.json"},{"id":"86-S6","order":6,"ref":"data/planning/scenes/86-S6.json"}],"source":{"byte_range":[15294,18084],"lines":[401,459],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"87eb7940caece3c0a905d46c35e36b692ccf0f32921662e2640e580ef010d8cc"},"source_records":[{"path":"data/reconstruction/m2.json","pointer":"/chapters/5","ref":"data/reconstruction/m2.json#/chapters/5","sha256":"345b9572314ef414c1b4b4892126a57a89b335bdb0a756fa9d2e89a909d6939f","text_sha256":"1bede8194c30c5fa51950942064c2af6472376233257d28299fbf232cd6fea11","value":{"anchor_refs":["R10","R11","P04"],"chapter":86,"field_schema_ref":"chapter-card-18-fields-v2.5","key_constraints":["沉痼—泪尽—夭亡","普通病日与冷药链收束","不生成完整绝命诗，不靠哲理梦境解释死亡"],"pressure_test":true,"semantic_coverage":"PARTIAL_STRUCTURED","source_lines":[401,459],"source_ref":"asset:sha256:cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","title":"潇湘馆泪尽芳魂逝　痴公子来迟旧梦空","title_status":"TG_WORKING"}},{"path":"data/reconstruction/m2.json","pointer":"/timeline/5","ref":"data/reconstruction/m2.json#/timeline/5","sha256":"345b9572314ef414c1b4b4892126a57a89b335bdb0a756fa9d2e89a909d6939f","text_sha256":"78935f6ac05387f8bad1aa7fb697dafaeb8c6e4afbd90ca73796b5247bbe4c9f","value":{"chapter":86,"epistemic":"RUN_LOCK_NOT_ORIGINAL_DATING","lock_level":"R10/R11 + C","required_relation":"黛玉泪尽夭亡；不得仍写成元春死后几天内","source_line":77,"source_ref":"asset:sha256:b27e9229499cbe39f4c9339d6186fe6db113d0e7d48f3ae6b0071e1b1ca88f41","time_window":"T+约5—9个月开放窗"}},{"path":"data/reconstruction/m2.json","pointer":"/current_states_84_96/2","ref":"data/reconstruction/m2.json#/current_states_84_96/2","sha256":"345b9572314ef414c1b4b4892126a57a89b335bdb0a756fa9d2e89a909d6939f","text_sha256":"85c5b16fff08aea9c6429093afb1928ea3022341da150fc2e9d7346b8e875dcb","value":{"authority":"家庭权威仍在","baochai_status":"宝钗仍未婚","baoyu_status":"长期失落前夜","chapter":86,"end_state":"黛亡不能由缺药缺钱造成","epistemic":"RUN_CURRENT_C","residence":"原府","resources":"医药灯火米汤不匮乏","source_line":122,"source_ref":"asset:sha256:b27e9229499cbe39f4c9339d6186fe6db113d0e7d48f3ae6b0071e1b1ca88f41"}},{"path":"data/reconstruction/m2.json","pointer":"/central_state_chain/2","ref":"data/reconstruction/m2.json#/central_state_chain/2","sha256":"345b9572314ef414c1b4b4892126a57a89b335bdb0a756fa9d2e89a909d6939f","text_sha256":"b1403be734af0a877278e4bddd8ee676cf0cfeb712930699fbcbed3d5f7b1611","value":{"chapter":86,"epistemic":"REFERENCE_STATE_CHAIN","source_line":8,"source_ref":"asset:sha256:b32e45cbc0745d671b2eff2f8945316cf531fd3cd4f1af89a9ed6aaca8d06108","state":"黛玉泪尽夭亡；宝钗尚未立刻为妻"}},{"path":"data/implementation_alignment/m6.json","pointer":"/chapter_plans/5","ref":"data/implementation_alignment/m6.json#/chapter_plans/5","sha256":"f9ba473eb93d8639d2cc9639aa67a698010cee8d1da20b05ebf81eb897bf0fe1","text_sha256":"356bc58239b3d05088285ca20aa412fa66cffaa414e2403565c6554cb77b681f","value":{"chapter":86,"edit_level":"L3","hard_boundary":"黛玉死亡是长期病程终点；宝玉来迟为C级章法。","must_keep":"再温一温、未成稿、药吊子、紫鹃不翻稿、冷药结尾。","plan_class":"压力测试回","risk":"绝命诗、大哭总声、传奇同步诀别、单因果死亡。","source_ref":"asset:sha256:cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","title_source":"TG工作回目"}},{"path":"data/implementation_alignment/m6.json","pointer":"/chapter_protections/5","ref":"data/implementation_alignment/m6.json#/chapter_protections/5","sha256":"f9ba473eb93d8639d2cc9639aa67a698010cee8d1da20b05ebf81eb897bf0fe1","text_sha256":"87fed94f423bd0995cf7953cef531001c89fc39d4a80f9de290470ede2cbb5cd","value":{"allowed_additions":"最后病日、死后礼俗、遗稿多案","chapter":86,"forbidden_drift":"冷药不得被诗盖住；不得全员围哭一口声","level":"P1","must_preserve":"火箸碰茶盘；大夫被别处绊住；灯热水衣裳炉火药汁；再温一温；冷药无人再温","source_ref":"asset:sha256:626917a3603d00697ccb86e6be8d1bb5b40911ffad700436ea836cd8e6336261"}},{"path":"data/prewrite/v06.json","pointer":"/gap_cards/5","ref":"data/prewrite/v06.json#/gap_cards/5","sha256":"caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff","text_sha256":"c9cc9d96585bb46d4fbe1f45e49332d34464c7c43ca1a32cd8df00610737bf96","value":{"chapter":86,"priority":"第一批","source_ref":"asset:sha256:faae6f996071b532940ceddfdd55830df7eb60a59d98ee167f725dffd7b4f3d0","source_symbols":{"arts":"△","body":"▲","chapter_frame":"✓","comic_folk":"✓","dream_symbol":"✓","economy":"▲","main_process":"▲","metaphysics":"△","minor_agents":"✓","poetry":"▲","ritual":"▲","secondary_plot":"✓"},"states":{"arts":"THIN","body":"MISSING","chapter_frame":"SUFFICIENT","comic_folk":"SUFFICIENT","dream_symbol":"SUFFICIENT","economy":"MISSING","main_process":"MISSING","metaphysics":"THIN","minor_agents":"SUFFICIENT","poetry":"MISSING","ritual":"MISSING","secondary_plot":"SUFFICIENT"}}},{"path":"data/prewrite/v06.json","pointer":"/omitted_scene_plans/5","ref":"data/prewrite/v06.json#/omitted_scene_plans/5","sha256":"caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff","text_sha256":"73ff725669552843e460e7fefb7d3fb6f557d0e5b1b333f5737219ddc3f6e5a0","value":{"action":"重点重构","candidate_scenes":[{"id":"86-S1","title":"最后一次“明日安排”"},{"id":"86-S2","title":"医生“迟”必须有现实原因"},{"id":"86-S3","title":"临终前最后一个文人动作只做到一半"},{"id":"86-S4","title":"死亡之后先处理“身体”"},{"id":"86-S5","title":"宝玉为什么“来迟”"},{"id":"86-S6","title":"宝玉来时“冷药仍在”"}],"chapter":86,"core_process":"最后普通病日→临终→死后第一日→宝玉来迟","handoff":"39、37、36","intensity":"高","source_ref":"asset:sha256:4e1dd2a2d7669011ece72f8d7a5b93903b235042aadd528f0178f6544901dc7b"}},{"path":"data/literary_ecology/m5.json","pointer":"/author_rhyme_chapters/5","ref":"data/literary_ecology/m5.json#/author_rhyme_chapters/5","sha256":"9fbc4013d0c42c957516af85e726180441ed54548d0ec4366f832fdd9f5696e4","text_sha256":"aa3d6ae131c8227f3d9b720faa38bb504daee6a1bc4ebfb59c93c85cfd9117bb","value":{"chapter":86,"ending_anchor":"药冷透，无人再温","mode":"散文收","source_ref":"asset:sha256:fc421b406baee7946b3d3bf4291c59678bfb09a04d13939c9e80199f157e7674","winner":"C_STRONG_LOCK"}}],"status":"DRAFT_IMPORTED","threads":[],"title":"潇湘馆泪尽芳魂逝　痴公子来迟旧梦空","title_status":"TG工作回目","unresolved":["entry_ref","exit_ref","threads","open_refs","scene_chronology","existing_contract_placement"]},"exemplar_dataset_ref":"corpus:front80:v2-candidate","exemplars":[{"asset_ref":"asset:primary:hlm:zhihui:v3.1416:pdf","chapter":27,"classification":{"human_review":"PENDING","method":"DECLARED_PDF_TYPOGRAPHY_V2","reasons":["DECLARED_MAIN_FONT_SIZE_COLOR"],"styles":[{"color":2301728,"font":"SimSun-GBK-EUC-H","size":15.58}]},"dataset_ref":"corpus:front80:v2-candidate","kind":"MAIN_TEXT","locator":{"extraction_ref":"asset:sha256:1c9dee98f867ea07dade7b69b2b8d3987c5046ddb51e1e377c5e306fd26ba900","spans":[{"end":568,"start":516,"unit_ref":"pdf:page:393"}],"transforms":[]},"record_type":"SEGMENT","section_ref":"chapter:27","segment_id":"hlm80:chapter:27:p00128","selection_reason":"第27回小红回凤姐话：观察丫鬟传话时的多层称谓与回话。","text":"红玉道：“平姐姐说：我们奶奶问这里奶奶\n好。原是我们二爷不在家，虽然迟了两天，只管请奶奶放心。\n等五奶奶","text_sha256":"bb37f7c183903e29f1ca30ab22c782708924b29b9c782620ec07536238c09150"},{"asset_ref":"asset:primary:hlm:zhihui:v3.1416:pdf","chapter":24,"classification":{"human_review":"PENDING","method":"DECLARED_PDF_TYPOGRAPHY_V2","reasons":["DECLARED_MAIN_FONT_SIZE_COLOR"],"styles":[{"color":2301728,"font":"SimSun-GBK-EUC-H","size":15.58}]},"dataset_ref":"corpus:front80:v2-candidate","kind":"MAIN_TEXT","locator":{"extraction_ref":"asset:sha256:1c9dee98f867ea07dade7b69b2b8d3987c5046ddb51e1e377c5e306fd26ba900","spans":[{"end":762,"start":659,"unit_ref":"pdf:page:344"}],"transforms":[]},"record_type":"SEGMENT","section_ref":"chapter:24","segment_id":"hlm80:chapter:24:p00066","selection_reason":"第24回贾芸求舅舅赊货：观察差事、银钱与人物声口。","text":"原来卜世仁现开香料铺，方才从铺子里来，忽\n见贾芸进来，彼此见过了，因问他这早晚什么事跑了来。贾芸\n道：“有件事求舅舅帮衬帮衬。我有一件事，用些冰片麝香使\n用，好歹舅舅每样赊四两给我，八月里按数送了银子来。”","text_sha256":"add8d8d7a9b14836a9ea90a162eccde4752ba78fd1221c9006060b667c18166a"},{"asset_ref":"asset:primary:hlm:zhihui:v3.1416:pdf","chapter":74,"classification":{"human_review":"PENDING","method":"DECLARED_PDF_TYPOGRAPHY_V2","reasons":["DECLARED_MAIN_FONT_SIZE_COLOR"],"styles":[{"color":2301728,"font":"SimSun-GBK-EUC-H","size":15.58}]},"dataset_ref":"corpus:front80:v2-candidate","kind":"MAIN_TEXT","locator":{"extraction_ref":"asset:sha256:1c9dee98f867ea07dade7b69b2b8d3987c5046ddb51e1e377c5e306fd26ba900","spans":[{"end":493,"start":63,"unit_ref":"pdf:page:1013"}],"transforms":[]},"record_type":"SEGMENT","section_ref":"chapter:74","segment_id":"hlm80:chapter:74:p00079","selection_reason":"第74回抄检：观察同一事件中的身份与群像差异。","text":"遂命众丫\n鬟秉烛开门而待。一时，众人来了。探春故问何事。凤姐笑道：\n“因丢了一件东西，连日访察不出人来，恐怕旁人赖这些女孩\n子们，所以越性大家搜一搜，使人去疑，倒是洗净他们的好法\n子。”探春冷笑道：“我们的丫头自然都是些贼，我就是头一\n个窝主。既如此，先来搜我的箱柜，他们所有偷了来的都交给\n我藏着呢。”说着便命丫头们把箱柜一齐打开，将镜奁、妆盒、\n衾袱、衣包若大若小之物一齐打开，请凤姐去抄阅。凤姐陪笑\n道：“我不过是奉太太的命来，妹妹别错怪我。何必生气。”\n因命丫鬟们快快关上。 \n  平儿丰儿等忙着替待书等关的关，收的收。探春道：“我\n的东西倒许你们搜阅，要想搜我的丫头，这却不能。我原比众\n人歹毒，凡丫头所有的东西我都知道，都在我这里间收着，一\n针一线他们也没的收藏，要搜所以只来搜我。你们不依，只管\n去回太太，只说我违背了太太，该怎么处治，我去自领。你们\n别忙，自然连你们抄的日子有呢！你们今日早起不曾议论甄家，\n自己家里好好的抄家，果然今日真抄了。","text_sha256":"139d8b797c42c19fd3ff5e9d961f882631751c60bfaeebe490d77a9da83e392d"},{"asset_ref":"asset:primary:hlm:zhihui:v3.1416:pdf","chapter":61,"classification":{"human_review":"PENDING","method":"DECLARED_PDF_TYPOGRAPHY_V2","reasons":["DECLARED_MAIN_FONT_SIZE_COLOR"],"styles":[{"color":2301728,"font":"SimSun-GBK-EUC-H","size":15.58}]},"dataset_ref":"corpus:front80:v2-candidate","kind":"MAIN_TEXT","locator":{"extraction_ref":"asset:sha256:1c9dee98f867ea07dade7b69b2b8d3987c5046ddb51e1e377c5e306fd26ba900","spans":[{"end":795,"start":45,"unit_ref":"pdf:page:820"}],"transforms":[]},"record_type":"SEGMENT","section_ref":"chapter:61","segment_id":"hlm80:chapter:61:p00020","selection_reason":"第61回平儿处理失窃案：观察真相、体面与处理办法。","text":"恐次日有变，大家先起了个清早，都悄悄的来买转平儿，一面\n送些东西，一面又奉承他办事简断，一面又讲述他母亲素日许\n多不好。平儿一一的都应着，打发他们去了，却悄悄的来访袭\n人，问他可果真芳官给他露了。袭人便说：“露却是给芳官，\n芳官转给何人我却不知。”袭人于是又问芳官，芳官听了，唬\n天跳地，忙应是自己送他的。芳官便又告诉了宝玉，宝玉也慌\n了，说：“露虽有了，若勾起茯苓霜来，他自然也实供。若听\n见了是他舅舅门上得的，他舅舅又有了不是，岂不是人家的好\n意，反被咱们陷害了。”因忙和平儿计议：“露的事虽完，然\n这霜也是有不是的。好姐姐，你叫他说也是芳官给他的就完\n了。”平儿笑道：“虽如此，只是他昨晚已经同人说是他舅舅\n给的了，如何又说你给的？况且那边所丢的露也是无主儿，如\n今有赃证的白放了，又去找谁？谁还肯认？众人也未必心服。”\n晴雯走来笑道：“太太那边的露再无别人，分明是彩云偷了给\n环哥儿去了。你们可瞎乱说。”平儿笑道：“谁不知是这个原\n故，但今玉钏儿急的哭，悄悄问着他，他若应了，玉钏也罢了，\n大家也就混着不问了。难道我们好意兜揽这事不成！可恨彩云\n不但不应，他还挤玉钏儿，说他偷了去了。两个人窝里发炮，\n先吵的合府皆知，我们如何装没事人。少不得要查的。殊不知\n告失盗的就是贼，又没赃证，怎么说他。” \n  宝玉道：“也罢，这件事我也应起来，就说是我唬他们顽\n的，悄悄的偷了太太的来了。两件事都完了。”袭人道：“也\n倒是件阴骘事，保全人的贼名儿。只是太太听见又说你小孩子\n气，不知好歹了。”平儿笑道：“这也倒是小事。如今便从赵\n姨娘屋里起了赃来也容易，我只怕又伤着一个好人的体面。别\n人都别管，这一个人岂不又生气。我可怜的是他，不肯为了打\n老鼠伤了玉瓶。”说着，把三个指头一伸。袭人等听说，便知\n","text_sha256":"1f791b115b1d1a5e5b2768f3046b4dfeed1d4a2175fa8d26b04bb1d39095da98"},{"asset_ref":"asset:primary:hlm:zhihui:v3.1416:pdf","chapter":52,"classification":{"human_review":"PENDING","method":"DECLARED_PDF_TYPOGRAPHY_V2","reasons":["DECLARED_MAIN_FONT_SIZE_COLOR"],"styles":[{"color":2301728,"font":"SimSun-GBK-EUC-H","size":15.58}]},"dataset_ref":"corpus:front80:v2-candidate","kind":"MAIN_TEXT","locator":{"extraction_ref":"asset:sha256:1c9dee98f867ea07dade7b69b2b8d3987c5046ddb51e1e377c5e306fd26ba900","spans":[{"end":713,"start":37,"unit_ref":"pdf:page:709"}],"transforms":[]},"record_type":"SEGMENT","section_ref":"chapter:52","segment_id":"hlm80:chapter:52:p00052","selection_reason":"第52回雀金裘被烧、晴雯病补：观察物质动作推动场面。","text":"刚安静了些。只见宝玉回来，进门就嗐声跺脚。麝月忙问原故，\n宝玉道：“今儿老太太喜喜欢欢的给了这个褂子，谁知不防后\n襟子上烧了一块，幸而天晚了，老太太、太太都不理论。”一\n面说，一面脱下来。麝月瞧时，果见有指头大的烧眼，说：“这\n必定是手炉里的火迸上了。这不值什么，赶着叫人悄悄的拿出\n去，叫个能干织补匠人织上就是了。”说着便用包袱包了，交\n与一个妈妈送出去。说：“赶天亮就有才好。千万别给老太太、\n太太知道。”婆子去了半日，仍旧拿回来，说：“不但能干织\n补匠人，就连裁缝绣匠并作女工的问了，都不认得这是什么，\n都不敢揽。”麝月道：“这怎么样呢！明儿不穿也罢了。”宝\n玉道：“明儿是正日子，老太太、太太说了，还叫穿这个去呢。\n偏头一日烧了，岂不扫兴。” \n  晴雯听了半日，忍不住翻身说道：“拿来我瞧瞧罢。没个\n福气穿就罢了，这会子又着急。”宝玉笑道：“这话倒说的是。”\n说着，便递与晴雯，又移过灯来，细看了一会。晴雯道：“这\n是孔雀金线织的，如今咱们也拿孔雀金线就像界线似的界密了，\n只怕还可混得过去。”麝月笑道：“孔雀线现成的，但这里除\n了你，还有谁会界线？”晴雯道：“说不得，我挣命罢了。”\n宝玉忙道：“这如何使得！才好了些，如何做得活。”晴雯道：\n“不用你蝎蝎螫螫的，我自知道。”一面说，一面坐起来，挽\n了一挽头发，披了衣裳，只觉头重身轻，满眼金星乱迸，实实\n掌不住。若不做，又怕宝玉着急，少不得恨命咬牙捱着。便命\n麝月只帮着拈线。晴雯先拿了一根比一比，笑道：“这虽不很\n像，若补上，也不很显。”宝玉道：“这就很好，那里又找哦\n啰嘶国的裁缝