  "forbidden_beats": [
    {
      "id": "81-S3-F1",
      "description": "不得把香菱尸身写成仍能说话或作诗的在场人物；不能以章级W81事件推断精确死法、时刻或所有人同步知情。",
      "status": "PENDING",
      "scope": "AUTHORING_REQUIREMENT_NOT_HISTORICAL_FACT",
      "grounding": {
        "seed": {
          "path": "data/prewrite/v06.json",
          "pointer": "/omitted_scene_plans/0/candidate_scenes/2",
          "ref": "data/prewrite/v06.json#/omitted_scene_plans/0/candidate_scenes/2",
          "sha256": "caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff",
          "text_sha256": "66250193b895863e4771235b2189603178af9c07879a5aad75b9ffad234eff56",
          "value": {
            "id": "81-S3",
            "title": "死亡后的第一轮权力分配"
          }
        },
        "chapter_card_fields": [
          {
            "citation": {
              "byte_range": [
                4174,
                4390
              ],
              "lines": [
                111,
                113
              ],
              "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
              "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
              "text_sha256": "b6b8679c7fb2ec2253cea1f80a4236fa4276d15fe39299b90bb87bd6bc7c846d"
            },
            "name": "现有硬节点",
            "number": 1,
            "text": "**1｜现有硬节点**  \nR36“香魂返故乡”强约束；第80香菱已有血分亏损、干血病史，81只能承接，不得另造新病。当前死亡回次属C级施工，不把具体死法反升硬证。\n\n"
          },
          {
            "citation": {
              "byte_range": [
                4957,
                5106
              ],
              "lines": [
                123,
                125
              ],
              "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
              "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
              "text_sha256": "2b9586da6ba1c5848634b2f92bcce0d00397aa3b91c2a227aef055688b317c4c"
            },
            "name": "缺失人物",
            "number": 5,
            "text": "**5｜缺失人物**  \n药铺跑腿、旧大夫/替换大夫可一闪而过；薛姨妈、宝钗、莺儿权责要清。不得新造“名医”。\n\n"
          },
          {
            "citation": {
              "byte_range": [
                5794,
                6024
              ],
              "lines": [
                141,
                143
              ],
              "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
              "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
              "text_sha256": "c25ae2da466fd1bb06d1f27066219d885d8188bb098617b4905f0e88fd1cb22d"
            },
            "name": "人钱物信四链",
            "number": 11,
            "text": "**11｜人钱物信四链**  \n人：薛姨妈—宝钗—莺儿—医者。钱：仍属E0，薛家有钱但不是无限。物：药、米汤、甜羹、寿衣/白布、诗稿。信：病危先在内宅，死后再分头报人。\n\n"
          },
          {
            "citation": {
              "byte_range": [
                6547,
                6830
              ],
              "lines": [
                162,
                165
              ],
              "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
              "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
              "text_sha256": "4fc2d6eb3d26982bacc72a3385e0066eb197112b17d8b57d417640929e63e596"
            },
            "name": "最终章法 / 风险",
            "number": 18,
            "text": "**18｜最终章法 / 风险**  \n病日常 → 是否换医的小争执 → 短暂好转/饮食 → 病危 → 女眷处理身体 → 报信与后事 → 诗稿/袖口归置 → 无人再念。  \n**风险：**把香菱写成第二黛玉；把“诗命”写成临终才华展览。\n\n"
          }
        ]
      }
    },
    {
      "id": "81-S3-F2",
      "description": "不得让全宅停止生活、把旧稿改成临终神作、重读诗稿或用作者诗说明诗成命尽。",
      "status": "PENDING",
      "scope": "AUTHORING_REQUIREMENT_NOT_HISTORICAL_FACT",
      "grounding": {
        "seed": {
          "path": "data/prewrite/v06.json",
          "pointer": "/omitted_scene_plans/0/candidate_scenes/2",
