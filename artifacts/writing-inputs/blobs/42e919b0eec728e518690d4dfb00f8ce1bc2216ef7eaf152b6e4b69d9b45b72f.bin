          "text_sha256": "1d79de2859e794ef9b85b8cd640fd6ca85340013edb8a732fd4c1c979949e34d",
          "value": {
            "id": "83-S2",
            "title": "金麒麟不是一上场就被认作“命物”"
          }
        },
        "chapter_card_fields": [
          {
            "citation": {
              "byte_range": [
                9463,
                9560
              ],
              "lines": [
                244,
                246
              ],
              "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
              "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
              "text_sha256": "95592d01dcc7ca1d91dcbe30050eac122dbcd90f2c1393052d493d64bcc3de93"
            },
            "name": "人物",
            "number": 5,
            "text": "**5｜人物**  \n看圃老仆是好用的小人物；不得再添“神秘老人识麒麟”。\n\n"
          },
          {
            "citation": {
              "byte_range": [
                9779,
                9856
              ],
              "lines": [
                256,
                258
              ],
              "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
              "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
              "text_sha256": "16bfbd866384572757d3b84f8a15bcecf2d4b5b06d3a8f5d98eb057e10502d50"
            },
            "name": "宗教/梦",
            "number": 9,
            "text": "**9｜宗教/梦**  \n麒麟是佩物与关系伏线，不写宿命灵物。\n\n"
          },
          {
            "citation": {
              "byte_range": [
                10141,
                10221
              ],
              "lines": [
                268,
                270
              ],
              "path": "sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md",
              "sha256": "cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c",
              "text_sha256": "0afd7a254f9529d6585e834ab912cde4c229fc4b1a8845c53da83cedc715d417"
            },
            "name": "应删",
            "number": 13,
            "text": "**13｜应删**  \n任何“此物后来必主婚姻吉凶”的作者提示。\n\n"
          }
        ]
      }
    },
    {
      "id": "83-S2-F2",
      "description": "不得追造麒麟此前取得路径、把白首双星解释成确定婚期、事故或生死；不得以金麒麟为唯一焦点。",
      "status": "PENDING",
      "scope": "AUTHORING_REQUIREMENT_NOT_HISTORICAL_FACT",
      "grounding": {
        "seed": {
          "path": "data/prewrite/v06.json",
