  "required_beats": [
    {
      "id": "83-S2-R1",
      "description": "在若兰射圃活动的普通衣带或动作中，先交代宝玉实际能看见的佩物再辨出金麒麟；物的身份用OBJ-GOLDEN-QILIN-LARGE，不另造一枚，也不凭一瞥推出前主、赠受或取得路径。现场目击仍是待写要求，不冒称知识获取已登记。",
      "status": "PENDING",
      "scope": "AUTHORING_REQUIREMENT_NOT_HISTORICAL_FACT",
