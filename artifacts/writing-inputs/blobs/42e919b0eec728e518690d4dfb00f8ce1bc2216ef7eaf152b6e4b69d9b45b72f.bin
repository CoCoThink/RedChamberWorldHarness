  "forbidden_beats": [
    {
      "id": "83-S2-F1",
      "description": "不得让佩物发光、托梦、识命，或用作者旁白预告将主婚姻吉凶。",
      "status": "PENDING",
      "scope": "AUTHORING_REQUIREMENT_NOT_HISTORICAL_FACT",
      "grounding": {
        "seed": {
          "path": "data/prewrite/v06.json",
          "pointer": "/omitted_scene_plans/2/candidate_scenes/1",
