08ba6cb8b71e083908d7f6e3c99c","text_sha256":"eece0456252fc3d1e6e2c5f896a7d1fa635a40e2adc98b970074aa370d119c14"},"name":"诗文身份","number":7,"text":"**7｜诗文身份**  \nG11凤姐临终诗/忏悔文淘汰；作者挽诗无。\n\n"},{"citation":{"byte_range":[34717,34847],"lines":[858,860],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"82e58ec44e300720aa1a2725f4f03a4b9ff2f0d6fa0395c2d67f733bda98006c"},"name":"笑料","number":8,"text":"**8｜笑料**  \n麝月说“第三日我自己饿了先吃半碗”可保，形成“回家”活气；凤死后笑料退场。\n\n"},{"citation":{"byte_range":[34847,34948],"lines":[861,863],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"e01b0ebcdf52c8b45fec3c1903ab60916809614e63b39ebee8621c0cc1d6142b"},"name":"宗教/梦","number":9,"text":"**9｜宗教/梦**  \n凤姐可说怕、命、报，但不作报应裁决；不写病中审判梦。\n\n"},{"citation":{"byte_range":[35305,35394],"lines":[873,875],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"158fbb0475de9d26e0e0da1d16bf66bd596fe74f12f70bdec0deb8de8d64eff6"},"name":"应删","number":13,"text":"**13｜应删**  \n凤姐“机关算尽”自我总结、玄奇吐血、恢弘大丧。\n\n"}],"seed":{"path":"data/prewrite/v06.json","pointer":"/omitted_scene_plans/12/candidate_scenes/4","ref":"data/prewrite/v06.json#/omitted_scene_plans/12/candidate_scenes/4","sha256":"caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff","text_sha256":"a769c219a5511f87b88550b575a54595cbd3f5971f445ee8f537f6e2fe4f5dae","value":{"id":"93-S5","title":"死后首先出现的是“谁来主丧”"}}},"id":"93-S5-F1","scope":"CURRENT_IMPLEMENTATION_REQUIREMENT_NOT_HISTORICAL_FACT","status":"PENDING"},{"description":"不得让凤姐的死亡吞没宝玉恢复线，也不得让获释恢复旧资源以自动填平后事组织和钱的缺口。","grounding":{"chapter_card_fields":[{"citation":{"byte_range":[35028,35195],"lines":[867,869],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"2369b960bd77349ce3570b4f2bfdac3cb767cd2a7937d9803939fb138c0e688b"},"name":"四链","number":11,"text":"**11｜四链**  \nE2：宝玉获释不带来钱，凤死立刻要钱。物链从热饭/水转到白布/灯/棺/遗物；信息上释放小喜立即被病危压过。\n\n"},{"citation":{"byte_range":[35618,35900],"lines":[885,888],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"b024aef7267d8e0f55de72f25a39d4a76cd408f26c09300906dd304dd185b6b3"},"name":"章法 / 风险","number":18,"text":"**18｜章法 / 风险**  \n释放 → 回家吃热饭 → 看凤姐 → 最后一件具体管事 → 身体退出 → 死 → 丧务组织真空 → 平儿留下陪巧姐又被现实叫走。  \n**风险：**死亡压过宝玉获释或反之；需保持“双恢复/双退出”。\n\n"}],"seed":{"path":"data/prewrite/v06.json","pointer":"/omitted_scene_plans/12/candidate_scenes/4","ref":"data/prewrite/v06.json#/omitted_scene_plans/12/candidate_scenes/4","sha256":"caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff","text_sha256":"a769c219a5511f87b88550b575a54595cbd3f5971f445ee8f537f6e2fe4f5dae","value":{"id":"93-S5","title":"死后首先出现的是“谁来主丧”"}}},"id":"93-S5-F2","scope":"CURRENT_IMPLEMENTATION_REQUIREMENT_NOT_HISTORICAL_FACT","status":"PENDING"},{"description":"凤姐可为死亡身体/遗留事务焦点，但死后不发话管事；不执行W93再释放宝玉，也不据OT93-01补确定旧府运送史。","grounding":{"chapter_card_fields":[{"citation":{"byte_range":[33921,34043],"lines":[837,839],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"0296a869f06695cc2bf468405bca8879e9f4c3a803873c67f7decca611c6a32f"},"name":"硬节点","number":1,"text":"**1｜硬节点**  \nR29凤姐短命；当前93为凤死是C级现行排程；R37/R38巧姐线从此转由平儿保护。\n\n"},{"citation":{"byte_range":[34340,34520],"lines":[846,848],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"24c75446bbadf3e0a5a544feaa3b251e5f41cf772e5918e4ce448363682d12ea"},"name":"缺失情节","number":4,"text":"**4｜缺失情节**  \n93-S1领取随身物/仍可传问；S2回家先吃；S3凤姐在宝玉回来前已末段；S4最后只管一件事；S5她一死立刻出现组织真空。\n\n"},{"citation":{"byte_range":[35028,35195],"lines":[867,869],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"2369b960bd77349ce3570b4f2bfdac3cb767cd2a7937d9803939fb138c0e688b"},"name":"四链","number":11,"text":"**11｜四链**  \nE2：宝玉获释不带来钱，凤死立刻要钱。物链从热饭/水转到白布/灯/棺/遗物；信息上释放小喜立即被病危压过。\n\n"},{"citation":{"byte_range":[35618,35900],"lines":[885,888],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"b024aef7267d8e0f55de72f25a39d4a76cd408f26c09300906dd304dd185b6b3"},"name":"章法 / 风险","number":18,"text":"**18｜章法 / 风险**  \n释放 → 回家吃热饭 → 看凤姐 → 最后一件具体管事 → 身体退出 → 死 → 丧务组织真空 → 平儿留下陪巧姐又被现实叫走。  \n**风险：**死亡压过宝玉获释或反之；需保持“双恢复/双退出”。\n\n"}],"seed":{"path":"data/prewrite/v06.json","pointer":"/omitted_scene_plans/12/candidate_scenes/4","ref":"data/prewrite/v06.json#/omitted_scene_plans/12/candidate_scenes/4","sha256":"caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff","text_sha256":"a769c219a5511f87b88550b575a54595cbd3f5971f445ee8f537f6e2fe4f5dae","value":{"id":"93-S5","title":"死后首先出现的是“谁来主丧”"}},"world_records":[{"path":"data/world/m3_core.json","pointer":"/events/10","ref":"data/world/m3_core.json#/events/10","sha256":"c4bf1c75fda8994fd846e570a64ae69efeb6ca17cd27e78c1bb1af4d7783d733","text_sha256":"d680d4cba780dc6f288c27e8d9c10919b42b5b7d41e9bc211eee23ffe30948fd","value":{"chapter":93,"effects":[{"set":"characters.baoyu.legal_status","value":"RELEASED_NO_RESTORATION"},{"set":"characters.baoyu.location","value":"S06"},{"set":"characters.baoyu.body_state","value":"post_detention_recovery"},{"set":"characters.fengjie.life_state","value":"DEAD"},{"set":"characters.fengjie.body_state","value":"DEAD_AFTER_CHRONIC_DECLINE"},{"set":"relations.rel:fengjie_ping.status","value":"ENDED_BY_DEATH"},{"set":"relations.rel:fengjie_qiaojie.status","value":"ENDED_BY_DEATH"},{"set":"characters.ping_er.household_role","value":"qiaojie_protection_executor"}],"epistemic":"CURRENT_C_WORLD","id":"W93-RELEASE-FENGJIE-DEATH","sequence":70,"source_refs":["R29"]}},{"path":"data/objects/m4.json","pointer":"/transitions/11","ref":"data/objects/m4.json#/transitions/11","sha256":"5c2719605b0d2b78d3c06d6bb7444c5c5058fd3891879f8dcfa480cd1828b4db","text_sha256":"c8df689a0658c548757bbfa25ad901e842e343034f7a74ccd8281f2610b80cf4","value":{"action":"HANDOFF","chapter":93,"epistemic":"C_WORLD_INFERENCE","from":{"holder":"fengjie","location":"S02","status":"HOUSEHOLD_CONTROL_ITEMS"},"id":"OT93-01","movement":"OPEN_BOUNDARY","note":"以旧账/钥匙/衣物束承接后事和巧姐保护；不锁具体清单","object_id":"OBJ-FENGJIE-LEGACY-BUNDLE","sequence":80,"source_refs":["asset:sha256:ffed02aee8809a8937651529048e2cc10256a0ae2e2706251c9b806a6ea6ef50"],"to":{"holder":"ping_er","location":"S06","status":"POSTHUMOUS_PROTECTION_INTERFACE"}}}]},"id":"93-S5-F3","scope":"CURRENT_IMPLEMENTATION_REQUIREMENT_NOT_HISTORICAL_FACT","status":"PENDING"}],"function":"使凤姐的身体退出立刻暴露“谁来主丧”的组织真空；平儿留陪巧姐又被白布和日用后事叫走，保护线由此转手。","id":"93-S5","kind":"AGENT_SCENE_CONTRACT","knowledge_binding":null,"knowledge_event_refs":[],"notes":"EDITOR91–95模型只编辑实际v1和绑定源包/章卡/世界引用，未读其他editor提交或reviews。AGENT_EDITED不证明历史事实、正文语义、同行语义PASS、人类或独立盲审资格。participants均PENDING；原entry/pre/exit逐项原样保留，新增状态均UNKNOWN/null且不造basis。源列表只为声明次序；世界/对象/知识绑定不变，不从粗章级接口补场内检查点、知识、身份、人物、物或事件。场别before/after+packet/issues/rationale/unresolved见独占新提交contract-editor-91-95.json；原v1/包/种子/章卡/世界/旧合同字节不变。","object_transition_refs":["OT93-01"],"order":5,"participants":["fengjie","ping_er","qiaojie"],"participants_status":"PENDING","preconditions":[{"basis":[],"equals":"object.OBJ-FENGJIE-LEGACY-BUNDLE.status","reason":"遗物束从临终交代到死后经手的具体状态未有局部桥。","status":"UNKNOWN","value":null}],"references":{"knowledge":[],"objects":[{"path":"data/objects/m4.json","pointer":"/objects/8","ref":"data/objects/m4.