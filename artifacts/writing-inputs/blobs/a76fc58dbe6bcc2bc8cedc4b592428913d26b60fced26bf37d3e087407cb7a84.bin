el:fengjie_ping.status","value":"ENDED_BY_DEATH"},{"set":"relations.rel:fengjie_qiaojie.status","value":"ENDED_BY_DEATH"},{"set":"characters.ping_er.household_role","value":"qiaojie_protection_executor"}],"epistemic":"CURRENT_C_WORLD","id":"W93-RELEASE-FENGJIE-DEATH","sequence":70,"source_refs":["R29"]}}]},"id":"93-S5-R3","scope":"CURRENT_IMPLEMENTATION_REQUIREMENT_NOT_HISTORICAL_FACT","status":"PENDING"},{"description":"“谁来主丧”先是组织缺口，再落实谁决定、谁跑白事、谁照看巧姐；未注册执行者和白布/灯/棺只留义务，不让平儿一人自动填满职能。","grounding":{"chapter_card_fields":[{"citation":{"byte_range":[34225,34340],"lines":[843,845],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"d260746d432ea4ea17f3e8ce6844e215bca76547ca9f02df20e9306c25c6f783"},"name":"最薄处","number":3,"text":"**3｜最薄处**  \n释放手续、凤姐死前“最后一件管事”、死后“谁来主丧”可以更清。\n\n"},{"citation":{"byte_range":[34340,34520],"lines":[846,848],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"24c75446bbadf3e0a5a544feaa3b251e5f41cf772e5918e4ce448363682d12ea"},"name":"缺失情节","number":4,"text":"**4｜缺失情节**  \n93-S1领取随身物/仍可传问；S2回家先吃；S3凤姐在宝玉回来前已末段；S4最后只管一件事；S5她一死立刻出现组织真空。\n\n"},{"citation":{"byte_range":[34520,34607],"lines":[849,851],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"bbf552991c41fb791958c2408cc605faeb7a360a78f0e85e97bc015a375c6d57"},"name":"人物","number":5,"text":"**5｜人物**  \n宝玉/宝钗/麝月A线；凤姐/平儿/巧姐/医者/婆子B线。\n\n"},{"citation":{"byte_range":[34948,35028],"lines":[864,866],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"65a580973cae786f4633de0eed353709abd035ec95c00ad4d68f728844547fc5"},"name":"职业","number":10,"text":"**10｜职业**  \n医者、抓药、白事执行者；丧务比过去简陋。\n\n"},{"citation":{"byte_range":[35028,35195],"lines":[867,869],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"2369b960bd77349ce3570b4f2bfdac3cb767cd2a7937d9803939fb138c0e688b"},"name":"四链","number":11,"text":"**11｜四链**  \nE2：宝玉获释不带来钱，凤死立刻要钱。物链从热饭/水转到白布/灯/棺/遗物；信息上释放小喜立即被病危压过。\n\n"},{"citation":{"byte_range":[35445,35563],"lines":[879,881],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"a3f050b8e1f75ff0e201fe5105312169d4f8bb57508df29c5f98acf4aa9a7e39"},"name":"前80同构","number":15,"text":"**15｜前80同构**  \n凤姐过去主持他人丧礼；本回用“她自己的丧事没有凤姐可找”反打。\n\n"},{"citation":{"byte_range":[35618,35900],"lines":[885,888],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"b024aef7267d8e0f55de72f25a39d4a76cd408f26c09300906dd304dd185b6b3"},"name":"章法 / 风险","number":18,"text":"**18｜章法 / 风险**  \n释放 → 回家吃热饭 → 看凤姐 → 最后一件具体管事 → 身体退出 → 死 → 丧务组织真空 → 平儿留下陪巧姐又被现实叫走。  \n**风险：**死亡压过宝玉获释或反之；需保持“双恢复/双退出”。\n\n"}],"seed":{"path":"data/prewrite/v06.json","pointer":"/omitted_scene_plans/12/candidate_scenes/4","ref":"data/prewrite/v06.json#/omitted_scene_plans/12/candidate_scenes/4","sha256":"caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff","text_sha256":"a769c219a5511f87b88550b575a54595cbd3f5971f445ee8f537f6e2fe4f5dae","value":{"id":"93-S5","title":"死后首先出现的是“谁来主丧”"}},"world_records":[{"path":"data/world/m3_resources.json","pointer":"/resource_flows/12","ref":"data/world/m3_resources.json#/resource_flows/12","sha256":"b823f72594d4a2af2216525cbfd3411b00d41c4ad0fa89830348933be6de7668","text_sha256":"c16e6b0f2139e70eb0fb525488de583b3e9468e1cff0bfc715130360222eeae8","value":{"boundary":"不以大葬恢复排场","chapter":93,"epistemic":"REFERENCE_RESOURCE_FLOW","food_medicine":"日常恢复但钱更紧","labor":"平儿转巧姐照料；丧事劳务增加","money_state":"释放不改善家计；凤姐丧事另耗","object_interface":"凤姐旧账/钥匙/衣物","source_ref":"asset:sha256:ffed02aee8809a8937651529048e2cc10256a0ae2e2706251c9b806a6ea6ef50"}}]},"id":"93-S5-R4","scope":"CURRENT_IMPLEMENTATION_REQUIREMENT_NOT_HISTORICAL_FACT","status":"PENDING"}],"required_objects":["OBJ-FENGJIE-LEGACY-BUNDLE"],"revision":"v2","schema_version":1,"status":"AGENT_EDITED","unresolved":["agent_edit_and_semantics: AGENT_EDITED仅表示基于实际v1及绑定包完成当前模型编辑；非人类、非独立盲审、非合资格历史鉴定，正文/同行语义NOT_CHECKED，authority/evidence均NONE。","scene_chronology: 前驱只声明SOURCE_LIST_ORDER_NOT_VERIFIED_CHRONOLOGY的源列表次序，不证明历史原稿或场内时序。","entry_checkpoint: 后续场无可执行局部入口；不从相邻合同或章末快照注入前场结果。","participants: 主丧决策人与白事执行者未有注册ID，不能用无名凤姐替身自动完成组织缺口。","implementation_gap: W93是释放/死亡合并事件，只作涉及死亡与保护的章级接口，不在本场重演宝玉释放。","implementation_gap: 白布、灯、棺和经办钱未有对象ID；遗物束由S02至S06为OPEN_BOUNDARY，不锁补造具体旧府运送史。","entry_state: character.fengjie.life_state — 前场最后管事未有经核定的结束检查点，不能自动推出本场已死或未死的时刻。","preconditions: object.OBJ-FENGJIE-LEGACY-BUNDLE.status — 遗物束从临终交代到死后经手的具体状态未有局部桥。","exit_state: character.fengjie.life_state — W93确有死亡效果，但该章级混合事件同时包含更早的释放，不能据此宣称本场死亡时刻已验证。","exit_state: character.ping_er.household_role — W93的qiaojie_protection_executor是当前章级角色接口；平儿实际承接保护与丧务尚待场级核定。","exit_state: object.OBJ-FENGJIE-LEGACY-BUNDLE.holder — OT93-01将后事接口交平儿，但移交物目、地点与时间的场内映射仍未核定。","registered_event_placement: 已引用的世界/物件事件仅为义务涉及的现行章级接口，不证明这些事件在此种子场逐项执行；局部条件保持UNKNOWN。","death_body_casting: fengjie为死亡身体/遗事焦点非死后活体角色；W93/OT93仍粗粒度涉及接口。"]}],"chapter":93,"chapter_plan":{"authority_effect":"NONE","card_fields":[{"citation":{"byte_range":[33921,34043],"lines":[837,839],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"0296a869f06695cc2bf468405bca8879e9f4c3a803873c67f7decca611c6a32f"},"name":"硬节点","number":1,"text":"**1｜硬节点**  \nR29凤姐短命；当前93为凤死是C级现行排程；R37/R38巧姐线从此转由平儿保护。\n\n"},{"citation":{"byte_range":[34043,34225],"lines":[840,842],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"efa37f4b209fe5a191064f129e6a0b8ee8b28df41dedd5cf00f176dc9873bc75"},"name":"最强处","number":2,"text":"**2｜最强处**  \n宝玉回家第一件事是热饭、洗手、换衣；凤姐死后两张纸仍是买米/巧姐药钱；钥匙有些已无柜可开；平儿被叫去补白布。\n\n"},{"citation":{"byte_range":[34225,34340],"lines":[843,845],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"d260746d432ea4ea17f3e8ce6844e215bca76547ca9f02df20e9306c25c6f783"},"name":"最薄处","number":3,"text":"**3｜最薄处**  \n释放手续、凤姐死前“最后一件管事”、死后“谁来主丧”可以更清。\n\n"},{"citation":{"byte_range":[34340,34520],"lines":[846,848],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"24c75446bbadf3e0a5a544feaa3b251e5f41cf772e5918e4ce448363682d12ea"},"name":"缺失情节","number":4,"text":"**4｜缺失情节**  \n93-S1领取随身物/仍可传问；S2回家先吃；S3凤姐在宝玉回来前已末段；S4最后只管一件事；S5她一死立刻出现组织真空。\n\n"},{"citation":{"byte_range":[34520,34607],"lines":[849,851],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"bbf552991c41fb791958c2408cc605faeb7a360a78f0e85e97bc015a375c6d57"},"name":"人物","number":5,"text":"**5｜人物**  \n宝玉/宝钗/麝月A线；凤姐/平儿/巧姐/医者/婆子B线。\n\n"},{"citation":{"byte_range":[34607,34637],"lines":[852,854],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"d7207cfdc40358c5b738d63c52fd413318c96c4148be864cd4c0cc0d7d889a5c"},"name":"文化","number":6,"text":"**6｜文化**  \n38禁补。\n\n"},{"citation":{"byte_range":[34637,34717],"lines":[855,857],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"eece0456252fc3d1e6e2c5f896a7d1fa635a40e2adc98b970074aa370d119c14"},"name":"诗文身份","number":7,"text":"**7｜诗文身份**  \nG11凤姐临终诗/忏悔文淘汰；作者挽诗无。\n\n"},{"citation":{"byte_range":[34717,34847],"lines":[858,860],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"82e58ec44e300720aa1a2725f4f03a4b9ff2f0d6fa0395c2d67f733bda98006c"},"name":"笑料","number":8,"text":"**8｜笑料**  \n麝月说“第三日我自己饿了先吃半碗”可保，形成“回家”活气；凤死后笑料退场。\n\n"},{"citation":{"byte_range":[34847,34948],"lines":[861,863],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"e01b0ebcdf52c8b45fec3c1903ab60916809614e63b39ebee8621c0cc1d6142b"},"name":"宗教/梦","number":9,"text":"**9｜宗教/梦**  \n凤姐可说怕、命、报，但不作报应裁决；不写病中审判梦。\n\n"},{"citation":{"byte_range":[34948,35028],"lines":[864,866],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"65a580973cae786f4633de0eed353709abd035ec95c00ad4d68f728844547fc5"},"name":"职业","number":10,"text":"**10｜职业**  \n医者、抓药、白事执行者；丧务比过去简陋。\n\n"},{"citation":{"byte_range":[35028,35195],"lines":[867,869],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"2369b960bd77349ce3570b4f2bfdac3cb767cd2a7937d9803939fb138c0e688b"},"name":"四链","number":11,"text":"**11｜四链**  \nE2：宝玉获释不带来钱，凤死立刻要钱。物链从热饭/水转到白布/灯/棺/遗物；信息上释放小喜立即被病危压过。\n\n"},{"citation":{"byte_range":[35195,35305],"lines":[870,872],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"83d1dcf9f335e7fa03c6553c1d6649d486aea624c3973611c3d120a4f5894663"},"name":"必须保留","number":12,"text":"**12｜必须保留**  \n热粥、巧姐问薄不薄、空药吊子、白布短一截、平儿起身去办。\n\n"},{"citation":{"byte_range":[35305,35394],"lines":[873,875],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"158fbb0475de9d26e0e0da1d16bf66bd596fe74f12f70bdec0deb8de8d64eff6"},"name":"应删","number":13,"text":"**13｜应删**  \n凤姐“机关算尽”自我总结、玄奇吐血、恢弘大丧。\n\n"},{"citation":{"byte_range":[35394,35445],"lines":[876,878],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"019ff5d1e235bce6ecfb239647a302ec5892b5e2c8e69d9f2316858f95988937"},"name":"L3","number":14,"text":"**14｜L3**  \n双线可更紧交叉，仍属L2。\n\n"},{"citation":{"byte_range":[35445,35563],"lines":[879,881],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"a3f050b8e1f75ff0e201fe5105312169d4f8bb57508df29c5f98acf4aa9a7e39"},"name":"前80同构","number":15,"text":"**15｜前80同构**  \n凤姐过去主持他人丧礼；本回用“她自己的丧事没有凤姐可找”反打。\n\n"},{"citation":{"byte_range":[35563,35591],"lines":[882,882],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"e1c22a397f53f3d123997c31bccf5dc898e2eee9267dc54c723ff51c44ba4ad3"},"name":"回前诗","number":16,"text":"**16｜回前诗** 无。  \n"},{"citation":{"byte_range":[35591,35618],"lines":[883,884],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"4ce526aecba789d8fb664d11031ea1dcfb21bf96efab2e4510b2cee0f78d282d"},"name":"回末诗","number":17,"text":"**17｜回末诗** 无。\n\n"},{"citation":{"byte_range":[35618,35900],"lines":[885,888],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"b024aef7267d8e0f55de72f25a39d4a76cd408f26c09300906dd304dd185b6b3"},"name":"章法 / 风险","number":18,"text":"**18｜章法 / 风险**  \n释放 → 回家吃热饭 → 看凤姐 → 最后一件具体管事 → 身体退出 → 死 → 丧务组织真空 → 平儿留下陪巧姐又被现实叫走。  \n**风险：**死亡压过宝玉获释或反之；需保持“双恢复/双退出”。\n\n"}],"chapter":93,"entry_ref":null,"evidence_effect":"NONE","existing_contracts":[],"exit_ref":null,"open_refs":[],"order_basis":"SOURCE_LIST_ORDER_NOT_VERIFIED_CHRONOLOGY","protections":["data/implementation_alignment/m6.json#/chapter_protections/12"],"scenes":[{"id":"93-S1","order":1,"ref":"data/planning/scenes/93-S1.json"},{"id":"93-S2","order":2,"ref":"data/planning/scenes/93-S2.json"},{"id":"93-S3","order":3,"ref":"data/planning/scenes/93-S3.json"},{"id":"93-S4","order":4,"ref":"data/planning/scenes/93-S4.json"},{"id":"93-S5","order":5,"ref":"data/planning/scenes/93-S5.json"}],"source":{"byte_range":[33800,35905],"lines":[832,890],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"73414569d9140f8a1b5bc92024765bf91fa7d94e9303bf92fef7b0337e1e0758"},"source_records":[{"path":"data/reconstruction/m2.json","pointer":"/chapters/12","ref":"data/reconstruction/m2.json#/chapters/12","sha256":"345b9572314ef414c1b4b4892126a57a89b335bdb0a756fa9d2e89a909d6939f","text_sha256":"5744661592c357b71e4bddd02e8a3e8f780308f6f93660f8bde0d4f84910c20c","value":{"anchor_refs":["R29"],"chapter":93,"field_schema_ref":"chapter-card-18-fields-v2.5","key_constraints":["宝玉正常释放但身份财产家运不恢复","凤姐死亡完成保护网退出","获释不得写成翻案复荣"],"pressure_test":false,"semantic_coverage":"PARTIAL_STRUCTURED","source_lines":[832,890],"source_ref":"asset:sha256:cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","title":"贾宝玉候讯归寒舍　王熙凤病笃辞人世","title_status":"TG_WORKING"}},{"path":"data/reconstruction/m2.json","pointer":"/timeline/12","ref":"data/reconstruction/m2.json#/timeline/12","sha256":"345b9572314ef414c1b4b4892126a57a89b335bdb0a756fa9d2e89a909d6939f","text_sha256":"6d8c50c4aa7695d90568c9dacfd3de4ed7d5c4dc2eb45f9a3a01006cb90194f4","value":{"chapter":93,"epistemic":"RUN_LOCK_NOT_ORIGINAL_DATING","lock_level":"RUN-CURRENT(C)","required_relation":"宝玉正常获释返临时住处；凤姐死亡","source_line":84,"source_ref":"asset:sha256:b27e9229499cbe39f4c9339d6186fe6db113d0e7d48f3ae6b0071e1b1ca88f41","time_window":"第一冬末/次春"}},{"path":"data/reconstruction/m2.json","pointer":"/current_states_84_96/9","ref":"data/reconstruction/m2.json#/current_states_84_96/9","sha256":"345b9572314ef414c1b4b4892126a57a89b335bdb0a756fa9d2e89a909d6939f","text_sha256":"da3623aeb5f050037768a1ce87c425c2e5335abfff61bc4e431cfde7c6945d49","value":{"authority":"凤姐临终退出；平儿转巧姐保护核心","baochai_status":"妻","baoyu_status":"正常获释但身份/财产不恢复","chapter":93,"end_state":"家庭保护网再失一层","epistemic":"RUN_CURRENT_C","residence":"回同一小巷寒舍","resources":"获释不恢复家计；丧务再耗损","source_line":135,"source_ref":"asset:sha256:b27e9229499cbe39f4c9339d6186fe6db113d0e7d48f3ae6b0071e1b1ca88f41"}},{"path":"data/reconstruction/m2.json","pointer":"/central_state_chain/9","ref":"data/reconstruction/m2.json#/central_state_chain/9","sha256":"345b9572314ef414c1b4b4892126a57a89b335bdb0a756fa9d2e89a909d6939f","text_sha256":"442110ce79cc9cdf1adf64f125a562a86c4a9d98d0f0bf38234d6d1abbc64a6d","value":{"chapter":93,"epistemic":"REFERENCE_STATE_CHAIN","source_line":15,"source_ref":"asset:sha256:b32e45cbc0745d671b2eff2f8945316cf531fd3cd4f1af89a9ed6aaca8d06108","state":"正常释放而家运不复；凤姐死亡"}},{"path":"data/implementation_alignment/m6.json","pointer":"/chapter_plans/12","ref":"data/implementation_alignment/m6.json#/chapter_plans/12","sha256":"f9ba473eb93d8639d2cc9639aa67a698010cee8d1da20b05ebf81eb897bf0fe1","text_sha256":"85aa1c2bb2e232d890d47212a87725fdf4fc8631ba3adae539d7bb41bfa6c3bd","value":{"chapter":93,"edit_level":"L2","hard_boundary":"凤姐短命；当前93死亡为C排程；平儿接巧姐保护。","must_keep":"热粥、巧姐问瘦、空药吊子、白布短一截、平儿去办事。","plan_class":"B级补桥","risk":"凤姐自我总结、玄奇吐血、豪华大葬。","source_ref":"asset:sha256:cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","title_source":"TG工作回目"}},{"path":"data/implementation_alignment/m6.json","pointer":"/chapter_protections/12","ref":"data/implementation_alignment/m6.json#/chapter_protections/12","sha256":"f9ba473eb93d8639d2cc9639aa67a698010cee8d1da20b05ebf81eb897bf0fe1","text_sha256":"387f509a826253ac6a23d90537de43df47fea2786181b7c87a1b44b7a7627431","value":{"allowed_additions":"凤姐医疗—债务—丧务链","chapter":93,"forbidden_drift":"不长篇忏悔；不豪华大葬恢复排场","level":"P1","must_preserve":"宝玉归先热水吃饭；巧姐只问叔叔怎么瘦；空药吊子；白布炭火软饭继续逼人办","source_ref":"asset:sha256:626917a3603d00697ccb86e6be8d1bb5b40911ffad700436ea836cd8e6336261"}},{"path":"data/prewrite/v06.json","pointer":"/gap_cards/12","ref":"data/prewrite/v06.json#/gap_cards/12","sha256":"caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff","text_sha256":"8ff18e777d04037b0f4e3d0d57ece1445915125c1e418686c1c9d82e4705d084","value":{"chapter":93,"priority":"第二批","source_ref":"asset:sha256:faae6f996071b532940ceddfdd55830df7eb60a59d98ee167f725dffd7b4f3d0","source_symbols":{"arts":"—","body":"▲","chapter_frame":"✓","comic_folk":"✓","dream_symbol":"✓","economy":"▲","main_process":"△","metaphysics":"△","minor_agents":"✓","poetry":"△","ritual":"▲","secondary_plot":"✓"},"states":{"arts":"NOT_APPLICABLE","body":"MISSING","chapter_frame":"SUFFICIENT","comic_folk":"SUFFICIENT","dream_symbol":"SUFFICIENT","economy":"MISSING","main_process":"THIN","metaphysics":"THIN","minor_agents":"SUFFICIENT","poetry":"THIN","ritual":"MISSING","secondary_plot":"SUFFICIENT"}}},{"path":"data/prewrite/v06.json","pointer":"/omitted_scene_plans/12","ref":"data/prewrite/v06.json#/omitted_scene_plans/12","sha256":"caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff","text_sha256":"c0e9fe2970e570cff1afad2fcef27878cd3476b83b82ee1c924ede2aec2b0175","value":{"action":"加厚","candidate_scenes":[{"id":"93-S1","title":"释放有手续，不是开门就走"},{"id":"93-S2","title":"回家第一件事不是谈案，是吃饭洗手换衣"},{"id":"93-S3","title":"凤姐病势在宝玉回来前已进入末段"},{"id":"93-S4","title":"凤姐最后一次“管事”"},{"id":"93-S5","title":"死后首先出现的是“谁来主丧”"}],"chapter":93,"core_process":"宝玉获释→归家；凤姐病势→临终→丧务启动","handoff":"39、40","intensity":"中","source_ref":"asset:sha256:4e1dd2a2d7669011ece72f8d7a5b93903b235042aadd528f0178f6544901dc7b"}},{"path":"data/literary_ecology/m5.json","pointer":"/author_rhyme_chapters/12","ref":"data/literary_ecology/m5.json#/author_rhyme_chapters/12","sha256":"9fbc4013d0c42c957516af85e726180441ed54548d0ec4366f832fdd9f5696e4","text_sha256":"fa25b1a174c1fac7747186421f1ea963f5cb67c54abaf935b2852ad2895c8319","value":{"chapter":93,"ending_anchor":"平儿补白布","mode":"散文收","source_ref":"asset:sha256:fc421b406baee7946b3d3bf4291c59678bfb09a04d13939c9e80199f157e7674","winner":"C"}}],"status":"DRAFT_IMPORTED","threads":[],"title":"贾宝玉候讯归寒舍　王熙凤病笃辞人世","title_status":"TG工作回目","unresolved":["entry_ref","exit_ref","threads","open_refs","scene_chronology","existing_contract_placement"]},"exemplar_dataset_ref":"corpus:front80:v2-candidate","exemplars":[{"asset_ref":"asset:primary:hlm:zhihui:v3.1416:pdf","chapter":27,"classification":{"human_review":"PENDING","method":"DECLARED_PDF_TYPOGRAPHY_V2","reasons":["DECLARED_MAIN_FONT_SIZE_COLOR"],"styles":[{"color":2301728,"font":"SimSun-GBK-EUC-H","size":15.58}]},"dataset_ref":"corpus:front80:v2-candidate","kind":"MAIN_TEXT","locator":{"extraction_ref":"asset:sha256:1c9dee98f867ea07dade7b69b2b8d3987c5046ddb51e1e377c5e306fd26ba900","spans":[{"end":568,"start":516,"unit_ref":"pdf:page:393"}],"transforms":[]},"record_type":"SEGMENT","section_ref":"chapter:27","segment_id":"hlm80:chapter:27:p00128","selection_reason":"第27回小红回凤姐话：观察丫鬟传话时的多层称谓与回话。","text":"红玉道：“平姐姐说：我们奶奶问这里奶奶\n好。原是我们二爷不在家，虽然迟了两天，只管请奶奶放心。\n等五奶奶","text_sha256":"bb37f7c183903e29f1ca30ab22c782708924b29b9c782620ec07536238c09150"},{"asset_ref":"asset:primary:hlm:zhihui:v3.1416:pdf","chapter":24,"classification":{"human_review":"PENDING","method":"DECLARED_PDF_TYPOGRAPHY_V2","reasons":["DECLARED_MAIN_FONT_SIZE_COLOR"],"styles":[{"color":2301728,"font":"SimSun-GBK-EUC-H","size":15.58}]},"dataset_ref":"corpus:front80:v2-candidate","kind":"MAIN_TEXT","locator":{"extraction_ref":"asset:sha256:1c9dee98f867ea07dade7b69b2b8d3987c5046ddb51e1e377c5e306fd26ba900","spans":[{"end":762,"start":659,"unit_ref":"pdf:page:344"}],"transforms":[]},"record_type":"SEGMENT","section_ref":"chapter:24","segment_id":"hlm80:chapter:24:p00066","selection_reason":"第24回贾芸求舅舅赊货：观察差事、银钱与人物声口。","text":"原来卜世仁现开香料铺，方才从铺子里来，忽\n见贾芸进来，彼此见过了，因问他这早晚什么事跑了来。贾芸\n道：“有件事求舅舅帮衬帮衬。我有一件事，用些冰片麝香使\n用，好歹舅舅每样赊四两给我，八月里按数送了银子来。”","text_sha256":"add8d8d7a9b14836a9ea90a162eccde4752ba78fd1221c9006060b667c18166a"},{"asset_ref":"asset:primary:hlm:zhihui:v3.1416:pdf","chapter":74,"classification":{"human_review":"PENDING","method":"DECLARED_PDF_TYPOGRAPHY_V2","reasons":["DECLARED_MAIN_FONT_SIZE_COLOR"],"styles":[{"color":2301728,"font":"SimSun-GBK-EUC-H","size":15.58}]},"dataset_ref":"corpus:front80:v2-candidate","kind":"MAIN_TEXT","locator":{"extraction_ref":"asset:sha256:1c9dee98f867ea07dade7b69b2b8d3987c5046ddb51e1e377c5e306fd26ba900","spans":[{"end":493,"start":63,"unit_ref":"pdf:page:1013"}],"transforms":[]},"record_type":"SEGMENT","section_ref":"chapter:74","segment_id":"hlm80:chapter:74:p00079","selection_reason":"第74回抄检：观察同一事件中的身份与群像差异。","text":"遂命众丫\n鬟秉烛开门而待。一时，众人来了。探春故问何事。凤姐笑道：\n“因丢了一件东西，连日访察不出人来，恐怕旁人赖这些女孩\n子们，所以越性大家搜一搜，使人去疑，倒是洗净他们的好法\n子。”探春冷笑道：“我们的丫头自然都是些贼，我就是头一\n个窝主。既如此，先来搜我的箱柜，他们所有偷了来的都交给\n我藏着呢。”说着便命丫头们把箱柜一齐打开，将镜奁、妆盒、\n衾袱、衣包若大若小之物一齐打开，请凤姐去抄阅。凤姐陪笑\n道：“我不过是奉太太的命来，妹妹别错怪我。何必生气。”\n因命丫鬟们快快关上。 \n  平儿丰儿等忙着替待书等关的关，收的收。探春道：“我\n的东西倒许你们搜阅，要想搜我的丫头，这却不能。我原比众\n人歹毒，凡丫头所有的东西我都知道，都在我这里间收着，一\n针一线他们也没的收藏，要搜所以只来搜我。你们不依，只管\n去回太太，只说我违背了太太，该怎么处治，我去自领。你们\n别忙，自然连你们抄的日子有呢！你们今日早起不曾议论甄家，\n自己家里好好的抄家，果然今日真抄了。","text_sha256":"139d8b797c42c19fd3ff5e9d961f882631751c60bfaeebe490d77a9da83e392d"},{"asset_ref":"asset:primary:hlm:zhihui:v3.1416:pdf","chapter":61,"classification":{"human_review":"PENDING","method":"DECLARED_PDF_TYPOGRAPHY_V2","reasons":["DECLARED_MAIN_FONT_SIZE_COLOR"],"styles":[{"color":2301728,"font":"SimSun-GBK-EUC-H","size":15.58}]},"dataset_ref":"corpus:front80:v2-candidate","kind":"MAIN_TEXT","locator":{"extraction_ref":"asset:sha256:1c9dee98f867ea07dade7b69b2b8d3987c5046ddb51e1e377c5e306fd26ba900","spans":[{"end":795,"start":45,"unit_ref":"pdf:page:820"}],"transforms":[]},"record_type":"SEGMENT","section_ref":"chapter:61","segment_id":"hlm80:chapter:61:p00020","selection_reason":"第61回平儿处理失窃案：观察真相、体面与处理办法。","text":"恐次日有变，大家先起了个清早，都悄悄的来买转平儿，一面\n送些东西，一面又奉承他办事简断，一面又讲述他母亲素日许\n多不好。平儿一一的都应着，打发他们去了，却悄悄的来访袭\n人，问他可果真芳官给他露了。袭人便说：“露却是给芳官，\n芳官转给何人我却不知。”袭人于是又问芳官，芳官听了，唬\n天跳地，忙应是自己送他的。芳官便又告诉了宝玉，宝玉也慌\n了，说：“露虽有了，若勾起茯苓霜来，他自然也实供。若听\n见了是他舅舅门上得的，他舅舅又有了不是，岂不是人家的好\n意，反被咱们陷害了。”因忙和平儿计议：“露的事虽完，然\n这霜也是有不是的。好姐姐，你叫他说也是芳官给他的就完\n了。”平儿笑道：“虽如此，只是他昨晚已经同人说是他舅舅\n给的了，如何又说你给的？况且那边所丢的露也是无主儿，如\n今有赃证的白放了，又去找谁？谁还肯认？众人也未必心服。”\n晴雯走来笑道：“太太那边的露再无别人，分明是彩云偷了给\n环哥儿去了。你们可瞎乱说。”平儿笑道：“谁不知是这个原\n故，但今玉钏儿急的哭，悄悄问着他，他若应了，玉钏也罢了，\n大家也就混着不问了。难道我们好意兜揽这事不成！可恨彩云\n不但不应，他还挤玉钏儿，说他偷了去了。两个人窝里发炮，\n先吵的合府皆知，我们如何装没事人。少不得要查的。殊不知\n告失盗的就是贼，又没赃证，怎么说他。” \n  宝玉道：“也罢，这件事我也应起来，就说是我唬他们顽\n的，悄悄的偷了太太的来了。两件事都完了。”袭人道：“也\n倒是件阴骘事，保全人的贼名儿。只是太太听见又说你小孩子\n气，不知好歹了。”平儿笑道：“这也倒是小事。如今便从赵\n姨娘屋里起了赃来也容易，我只怕又伤着一个好人的体面。别\n人都别管，这一个人岂不又生气。我可怜的是他，不肯为了打\n老鼠伤了玉瓶。”说着，把三个指头一伸。袭人等听说，便知\n","text_sha256":"1f791b115b1d1a5e5b2768f3046b4dfeed1d4a2175fa8d26b04bb1d39095da98"},{"asset_ref":"asset:primary:hlm:zhihui:v3.1416:pdf","chapter":52,"classification":{"human_review":"PENDING","method":"DECLARED_PDF_TYPOGRAPHY_V2","reasons":["DECLARED_MAIN_FONT_SIZE_COLOR"],"styles":[{"color":2301728,"font":"SimSun-GBK-EUC-H","size":15.58}]},"dataset_ref":"corpus:front80:v2-candidate","kind":"MAIN_TEXT","locator":{"extraction_ref":"asset:sha256:1c9dee98f867ea07dade7b69b2b8d3987c5046ddb51e1e377c5e306fd26ba900","spans":[{"end":713,"start":37,"unit_ref":"pdf:page:709"}],"transforms":[]},"record_type":"SEGMENT","section_ref":"chapter:52","segment_id":"hlm80:chapter:52:p00052","selection_reason":"第52回雀金裘被烧、晴雯病补：观察物质动作推动场面。","text":"刚安静了些。只见宝玉回来，进门就嗐声跺脚。麝月忙问原故，\n宝玉道：“今儿老太太喜喜欢欢的给了这个褂子，谁知不防后\n襟子上烧了一块，幸而天晚了，老太太、太太都不理论。”一\n面说，一面脱下来。麝月瞧时，果见有指头大的烧眼，说：“这\n必定是手炉里的火迸上了。这不值什么，赶着叫人悄悄的拿出\n去，叫个能干织补匠人织上就是了。”说着便用包袱包了，交\n与一个妈妈送出去。说：“赶天亮就有才好。千万别给老太太、\n太太知道。”婆子去了半日，仍旧拿回来，说：“不但能干织\n补匠人，就连裁缝绣匠并作女工的问了，都不认得这是什么，\n都不敢揽。”麝月道：“这怎么样呢！明儿不穿也罢了。”宝\n玉道：“明儿是正日子，老太太、太太说了，还叫穿这个去呢。\n偏头一日烧了，岂不扫兴。” \n  晴雯听了半日，忍不住翻身说道：“拿来我瞧瞧罢。没个\n福气穿就罢了，这会子又着急。”宝玉笑道：“这话倒说的是。”\n说着，便递与晴雯，又移过灯来，细看了一会。晴雯道：“这\n是孔雀金线织的，如今咱们也拿孔雀金线就像界线似的界密了，\n只怕还可混得过去。”麝月笑道：“孔雀线现成的，但这里除\n了你，还有谁会界线？”晴雯道：“说不得，我挣命罢了。”\n宝玉忙道：“这如何使得！才好了些，如何做得活。”晴雯道：\n“不用你蝎蝎螫螫的，我自知道。”一面说，一面坐起来，挽\n了一挽头发，披了衣裳，只觉头重身轻，满眼金星乱迸，实实\n掌不住。若不做，又怕宝玉着急，少不得恨命咬牙捱着。便命\n麝月只帮着拈线。晴雯先拿了一根比一比，笑道：“这虽不很\n像，若补上，也不很显。”宝玉道：“这就很好，那里又找哦\n啰嘶国的裁缝去。”","text_sha256":"919dfdc9482c1dfa76b40d1ce9ff0cd53ae2738cea6d354fc47d381d3e04c525"}],"guidance":"Organize scene obligations and check entry/exit constraints before writing.","operation_scope":"RESEARCH","package":{"assets":[{"asset_ref":"asset:sha256:23861cce04acb8308e2d9c19a38445cddbe985b41fc8f0458d965e2379309072","sha256":"23861cce04acb8308e2d9c19a38445cddbe985b41fc8f0458d965e2379309072"},{"asset_ref":"asset:sha256:626917a3603d00697ccb86e6be8d1bb5b40911ffad700436ea836cd8e6336261","sha256":"626917a3603d00697ccb86e6be8d1bb5b40911ffad700436ea836cd8e6336261"},{"asset_ref":"asset:sha256:66508dc74b1e09e9b0ad69f0cb781ae881505ee4f446075d85386bfb228205b7","sha256":"66508dc74b1e09e9b0ad69f0cb781ae881505ee4f446075d85386bfb228205b7"},{"asset_ref":"asset:sha256:6ab10932c4f8ae3580ec1f1db3034e8ba2fee58ae038db9556204ee11aeb0d44","sha256":"6ab10932c4f8ae3580ec1f1db3034e8ba2fee58ae038db9556204ee11aeb0d44"},{"asset_ref":"asset:sha256:c1946d9ff097372aa0583eec627a5f37ec77ec3b076fa2229c23f7f441bb7eb0","sha256":"c1946d9ff097372aa0583eec627a5f37ec77ec3b076fa2229c23f7f441bb7eb0"}],"authority_effect":"NONE","chapter":93,"exemplar_set":{"path":"data/writing/exemplars/ch89-research-v3.json","sha256":"2989c8f10355a541e3388b5d3aad23e6c96e03ca2ccc6fe2ab9bfe0ab19f6b49"},"id":"writing-package:ch93:agent-research:v5","operation_scope":"RESEARCH","plan":[{"path":"data/project/plan_constraints_v1.json","sha256":"8f3ca1572c57e6440d94eb151680f189994b6c2097a5c02609b55e35a32b94cd"},{"path":"data/planning/chapters/ch93.json","sha256":"515ed9ce4f4aa83ba37ed0124f4ac31303b4fb375279500a0951cf74019301ce"},{"path":"data/planning/contracts/agent-final-v1/93-S1.v2.json","sha256":"6f307365aa8b0ef816563f836ad19cd3d024edb39353fd7bd3d30dda0eb39ccf"},{"path":"data/planning/contracts/agent-final-v1/93-S2.v3.json","sha256":"e082616c1a4a291fa5e0773e7b7e9919ad89d3811b3f6fed7180c26693671c2c"},{"path":"data/planning/contracts/agent-final-v1/93-S3.v2.json","sha256":"900143d4b35364ff415cbc3be696e746bfb91389c068d94d209ec0b649b0994f"},{"path":"data/planning/contracts/agent-final-v1/93-S4.v2.json","sha256":"42f8e5bf5596eb763fdc467fa7af33d256e24a3a7518ec7e6a49653c78884fb9"},{"path":"data/planning/contracts/agent-final-v1/93-S5.v2.json","sha256":"8b09a9cd4e5fad38a332b6784e22fc86df571fd43a5e1dc62144e4df04d42b66"}],"purpose":"第93回全书会话研究试写：显式选择经模型编辑的场景合同版本。未知状态仍未验收，史料/语料/文学资格未授予；不修改稳定版。 v4研究编辑：显式选择局部合同新版本，将原92末唯一二句迁入93实际归家热粥之后；原章卡不变，新落位为协调者C层编辑选择，非新增史料许可。","schema_version":1,"sources":[],"world":[{"path":"data/world/m3_body.json","sha256":"429ca248ea42aa0601e11a55d40fa446da92cee48936627a83b335ab9b18056e"},{"path":"data/world/m3_core.json","sha256":"c4bf1c75fda8994fd846e570a64ae69efeb6ca17cd27e78c1bb1af4d7783d733"},{"path":"data/world/m3_knowledge.json","sha256":"d8ee374ec667317af6ef304dc4b66ad7d3ceae9f20753c1b35cf029c73dee18b"},{"path":"data/world/m3_locations.json","sha256":"ed1a4053f1459193777f486b3a9743c5aec28afb7d027dee12684da6e3a9d81b"},{"path":"data/world/m3_presence.json","sha256":"7880480b001c321e50056e887f1285f6c7ccf975aed140d1515967ea925bb3bb"},{"path":"data/world/m3_resources.json","sha256":"b823f72594d4a2af2216525cbfd3411b00d41c4ad0fa89830348933be6de7668"}]},"plan":{"data/planning/chapters/ch93.json":{"authority_effect":"NONE","card_fields":[{"citation":{"byte_range":[33921,34043],"lines":[837,839],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"0296a869f06695cc2bf468405bca8879e9f4c3a803873c67f7decca611c6a32f"},"name":"硬节点","number":1,"text":"**1｜硬节点**  \nR29凤姐短命；当前93为凤死是C级现行排程；R37/R38巧姐线从此转由平儿保护。\n\n"},{"citation":{"byte_range":[34043,34225],"lines":[840,842],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"efa37f4b209fe5a191064f129e6a0b8ee8b28df41dedd5cf00f176dc9873bc75"},"name":"最强处","number":2,"text":"**2｜最强处**  \n宝玉回家第一件事是热饭、洗手、换衣；凤姐死后两张纸仍是买米/巧姐药钱；钥匙有些已无柜可开；平儿被叫去补白布。\n\n"},{"citation":{"byte_range":[34225,34340],"lines":[843,845],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"d260746d432ea4ea17f3e8ce6844e215bca76547ca9f02df20e9306c25c6f783"},"name":"最薄处","number":3,"text":"**3｜最薄处**  \n释放手续、凤姐死前“最后一件管事”、死后“谁来主丧”可以更清。\n\n"},{"citation":{"byte_range":[34340,34520],"lines":[846,848],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"24c75446bbadf3e0a5a544feaa3b251e5f41cf772e5918e4ce448363682d12ea"},"name":"缺失情节","number":4,"text":"**4｜缺失情节**  \n93-S1领取随身物/仍可传问；S2回家先吃；S3凤姐在宝玉回来前已末段；S4最后只管一件事；S5她一死立刻出现组织真空。\n\n"},{"citation":{"byte_range":[34520,34607],"lines":[849,851],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"bbf552991c41fb791958c2408cc605faeb7a360a78f0e85e97bc015a375c6d57"},"name":"人物","number":5,"text":"**5｜人物**  \n宝玉/宝钗/麝月A线；凤姐/平儿/巧姐/医者/婆子B线。\n\n"},{"citation":{"byte_range":[34607,34637],"lines":[852,854],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"d7207cfdc40358c5b738d63c52fd413318c96c4148be864cd4c0cc0d7d889a5c"},"name":"文化","number":6,"text":"**6｜文化**  \n38禁补。\n\n"},{"citation":{"byte_range":[34637,34717],"lines":[855,857],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"eece0456252fc3d1e6e2c5f896a7d1fa635a40e2adc98b970074aa370d119c14"},"name":"诗文身份","number":7,"text":"**7｜诗文身份**  \nG11凤姐临终诗/忏悔文淘汰；作者挽诗无。\n\n"},{"citation":{"byte_range":[34717,34847],"lines":[858,860],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"82e58ec44e300720aa1a2725f4f03a4b9ff2f0d6fa0395c2d67f733bda98006c"},"name":"笑料","number":8,"text":"**8｜笑料**  \n麝月说“第三日我自己饿了先吃半碗”可保，形成“回家”活气；凤死后笑料退场。\n\n"},{"citation":{"byte_range":[34847,34948],"lines":[861,863],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"e01b0ebcdf52c8b45fec3c1903ab60916809614e63b39ebee8621c0cc1d6142b"},"name":"宗教/梦","number":9,"text":"**9｜宗教/梦**  \n凤姐可说怕、命、报，但不作报应裁决；不写病中审判梦。\n\n"},{"citation":{"byte_range":[34948,35028],"lines":[864,866],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"65a580973cae786f4633de0eed353709abd035ec95c00ad4d68f728844547fc5"},"name":"职业","number":10,"text":"**10｜职业**  \n医者、抓药、白事执行者；丧务比过去简陋。\n\n"},{"citation":{"byte_range":[35028,35195],"lines":[867,869],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"2369b960bd77349ce3570b4f2bfdac3cb767cd2a7937d9803939fb138c0e688b"},"name":"四链","number":11,"text":"**11｜四链**  \nE2：宝玉获释不带来钱，凤死立刻要钱。物链从热饭/水转到白布/灯/棺/遗物；信息上释放小喜立即被病危压过。\n\n"},{"citation":{"byte_range":[35195,35305],"lines":[870,872],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"83d1dcf9f335e7fa03c6553c1d6649d486aea624c3973611c3d120a4f5894663"},"name":"必须保留","number":12,"text":"**12｜必须保留**  \n热粥、巧姐问薄不薄、空药吊子、白布短一截、平儿起身去办。\n\n"},{"citation":{"byte_range":[35305,35394],"lines":[873,875],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"158fbb0475de9d26e0e0da1d16bf66bd596fe74f12f70bdec0deb8de8d64eff6"},"name":"应删","number":13,"text":"**13｜应删**  \n凤姐“机关算尽”自我总结、玄奇吐血、恢弘大丧。\n\n"},{"citation":{"byte_range":[35394,35445],"lines":[876,878],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"019ff5d1e235bce6ecfb239647a302ec5892b5e2c8e69d9f2316858f95988937"},"name":"L3","number":14,"text":"**14｜L3**  \n双线可更紧交叉，仍属L2。\n\n"},{"citation":{"byte_range":[35445,35563],"lines":[879,881],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"a3f050b8e1f75ff0e201fe5105312169d4f8bb57508df29c5f98acf4aa9a7e39"},"name":"前80同构","number":15,"text":"**15｜前80同构**  \n凤姐过去主持他人丧礼；本回用“她自己的丧事没有凤姐可找”反打。\n\n"},{"citation":{"byte_range":[35563,35591],"lines":[882,882],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"e1c22a397f53f3d123997c31bccf5dc898e2eee9267dc54c723ff51c44ba4ad3"},"name":"回前诗","number":16,"text":"**16｜回前诗** 无。  \n"},{"citation":{"byte_range":[35591,35618],"lines":[883,884],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"4ce526aecba789d8fb664d11031ea1dcfb21bf96efab2e4510b2cee0f78d282d"},"name":"回末诗","number":17,"text":"**17｜回末诗** 无。\n\n"},{"citation":{"byte_range":[35618,35900],"lines":[885,888],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"b024aef7267d8e0f55de72f25a39d4a76cd408f26c09300906dd304dd185b6b3"},"name":"章法 / 风险","number":18,"text":"**18｜章法 / 风险**  \n释放 → 回家吃热饭 → 看凤姐 → 最后一件具体管事 → 身体退出 → 死 → 丧务组织真空 → 平儿留下陪巧姐又被现实叫走。  \n**风险：**死亡压过宝玉获释或反之；需保持“双恢复/双退出”。\n\n"}],"chapter":93,"entry_ref":null,"evidence_effect":"NONE","existing_contracts":[],"exit_ref":null,"open_refs":[],"order_basis":"SOURCE_LIST_ORDER_NOT_VERIFIED_CHRONOLOGY","protections":["data/implementation_alignment/m6.json#/chapter_protections/12"],"scenes":[{"id":"93-S1","order":1,"ref":"data/planning/scenes/93-S1.json"},{"id":"93-S2","order":2,"ref":"data/planning/scenes/93-S2.json"},{"id":"93-S3","order":3,"ref":"data/planning/scenes/93-S3.json"},{"id":"93-S4","order":4,"ref":"data/planning/scenes/93-S4.json"},{"id":"93-S5","order":5,"ref":"data/planning/scenes/93-S5.json"}],"source":{"byte_range":[33800,35905],"lines":[832,890],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"73414569d9140f8a1b5bc92024765bf91fa7d94e9303bf92fef7b0337e1e0758"},"source_records":[{"path":"data/reconstruction/m2.json","pointer":"/chapters/12","ref":"data/reconstruction/m2.json#/chapters/12","sha256":"345b9572314ef414c1b4b4892126a57a89b335bdb0a756fa9d2e89a909d6939f","text_sha256":"5744661592c357b71e4bddd02e8a3e8f780308f6f93660f8bde0d4f84910c20c","value":{"anchor_refs":["R29"],"chapter":93,"field_schema_ref":"chapter-card-18-fields-v2.5","key_constraints":["宝玉正常释放但身份财产家运不恢复","凤姐死亡完成保护网退出","获释不得写成翻案复荣"],"pressure_test":false,"semantic_coverage":"PARTIAL_STRUCTURED","source_lines":[832,890],"source_ref":"asset:sha256:cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","title":"贾宝玉候讯归寒舍　王熙凤病笃辞人世","title_status":"TG_WORKING"}},{"path":"data/reconstruction/m2.json","pointer":"/timeline/12","ref":"data/reconstruction/m2.json#/timeline/12","sha256":"345b9572314ef414c1b4b4892126a57a89b335bdb0a756fa9d2e89a909d6939f","text_sha256":"6d8c50c4aa7695d90568c9dacfd3de4ed7d5c4dc2eb45f9a3a01006cb90194f4","value":{"chapter":93,"epistemic":"RUN_LOCK_NOT_ORIGINAL_DATING","lock_level":"RUN-CURRENT(C)","required_relation":"宝玉正常获释返临时住处；凤姐死亡","source_line":84,"source_ref":"asset:sha256:b27e9229499cbe39f4c9339d6186fe6db113d0e7d48f3ae6b0071e1b1ca88f41","time_window":"第一冬末/次春"}},{"path":"data/reconstruction/m2.json","pointer":"/current_states_84_96/9","ref":"data/reconstruction/m2.json#/current_states_84_96/9","sha256":"345b9572314ef414c1b4b4892126a57a89b335bdb0a756fa9d2e89a909d6939f","text_sha256":"da3623aeb5f050037768a1ce87c425c2e5335abfff61bc4e431cfde7c6945d49","value":{"authority":"凤姐临终退出；平儿转巧姐保护核心","baochai_status":"妻","baoyu_status":"正常获释但身份/财产不恢复","chapter":93,"end_state":"家庭保护网再失一层","epistemic":"RUN_CURRENT_C","residence":"回同一小巷寒舍","resources":"获释不恢复家计；丧务再耗损","source_line":135,"source_ref":"asset:sha256:b27e9229499cbe39f4c9339d6186fe6db113d0e7d48f3ae6b0071e1b1ca88f41"}},{"path":"data/reconstruction/m2.json","pointer":"/central_state_chain/9","ref":"data/reconstruction/m2.json#/central_state_chain/9","sha256":"345b9572314ef414c1b4b4892126a57a89b335bdb0a756fa9d2e89a909d6939f","text_sha256":"442110ce79cc9cdf1adf64f125a562a86c4a9d98d0f0bf38234d6d1abbc64a6d","value":{"chapter":93,"epistemic":"REFERENCE_STATE_CHAIN","source_line":15,"source_ref":"asset:sha256:b32e45cbc0745d671b2eff2f8945316cf531fd3cd4f1af89a9ed6aaca8d06108","state":"正常释放而家运不复；凤姐死亡"}},{"path":"data/implementation_alignment/m6.json","pointer":"/chapter_plans/12","ref":"data/implementation_al