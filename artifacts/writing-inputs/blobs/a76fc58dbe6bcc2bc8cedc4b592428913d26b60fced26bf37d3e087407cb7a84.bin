n","pointer":"/events/10","ref":"data/world/m3_core.json#/events/10","sha256":"c4bf1c75fda8994fd846e570a64ae69efeb6ca17cd27e78c1bb1af4d7783d733","text_sha256":"d680d4cba780dc6f288c27e8d9c10919b42b5b7d41e9bc211eee23ffe30948fd","value":{"chapter":93,"effects":[{"set":"characters.baoyu.legal_status","value":"RELEASED_NO_RESTORATION"},{"set":"characters.baoyu.location","value":"S06"},{"set":"characters.baoyu.body_state","value":"post_detention_recovery"},{"set":"characters.fengjie.life_state","value":"DEAD"},{"set":"characters.fengjie.body_state","value":"DEAD_AFTER_CHRONIC_DECLINE"},{"set":"relations.rel:fengjie_ping.status","value":"ENDED_BY_DEATH"},{"set":"relations.rel:fengjie_qiaojie.status","value":"ENDED_BY_DEATH"},{"set":"characters.ping_er.household_role","value":"qiaojie_protection_executor"}],"epistemic":"CURRENT_C_WORLD","id":"W93-RELEASE-FENGJIE-DEATH","sequence":70,"source_refs":["R29"]}},{"path":"data/world/m3_presence.json","pointer":"/presence_matrix/12","ref":"data/world/m3_presence.json#/presence_matrix/12","sha256":"7880480b001c321e50056e887f1285f6c7ccf975aed140d1515967ea925bb3bb","text_sha256":"cb90885aabcd46c87ed3a26ea18146efc688dfd1f9b8a77aa263351adcaa60f3","value":{"chapter":93,"epistemic":"LITERARY_CONSTRUCTION_RESOURCE","forbidden_note":"小红茜雪退回正常生活，不长期挂在主线","main_source":"宝玉、凤姐、平儿、麝月、宝钗","natural_source":"贾琏、巧姐、贾芸、王夫人、贾母","source_ref":"asset:sha256:30a6ecd37a4f3e846a72ef3cd445ba78db902fa788d45ee7cd3d73d86eb4df32","state_change":"宝玉回家；凤姐死亡；平儿转入巧姐保护位"}}]},"id":"93-S3-R3","scope":"CURRENT_IMPLEMENTATION_REQUIREMENT_NOT_HISTORICAL_FACT","status":"PENDING"}],"required_objects":[],"revision":"v2","schema_version":1,"status":"AGENT_EDITED","unresolved":["agent_edit_and_semantics: AGENT_EDITED仅表示基于实际v1及绑定包完成当前模型编辑；非人类、非独立盲审、非合资格历史鉴定，正文/同行语义NOT_CHECKED，authority/evidence均NONE。","scene_chronology: 前驱只声明SOURCE_LIST_ORDER_NOT_VERIFIED_CHRONOLOGY的源列表次序，不证明历史原稿或场内时序。","entry_checkpoint: 后续场无可执行局部入口；不从相邻合同或章末快照注入前场结果。","participants: 医者、抓药者与照料婆子未有实体ID，不能造具名医案权威。","implementation_gap: 空药吊子、药与药钱凭据未注册；不能冒用第86回药碗，死亡时刻与末段医学细目仍未决。","entry_state: character.fengjie.body_state — W90仅有old_illness_worsening_under_labor；未注册临终末段的场级入口，不能从死亡结果反填。","preconditions: character.fengjie.life_state — 本场前驱是宝玉回家线，未提供凤姐的同步入口记录；历史基线ACTIVE不代替本场已核实存活。","exit_state: character.fengjie.body_state — 医者判断、空药吊子与末段照料没有独立状态效果；不把待写病危宣告当作已验证身体值。","parallel_body_scope: 医者/末段判断和宝玉回家相对時点无新事件，原life_state/body_state未知保留。"]},"data/planning/contracts/agent-final-v1/93-S4.v2.json":{"authority_effect":"NONE","bindings":{"chapter_plan":{"path":"data/planning/chapters/ch93.json","sha256":"515ed9ce4f4aa83ba37ed0124f4ac31303b4fb375279500a0951cf74019301ce"},"seed":{"path":"data/planning/scenes/93-S4.json","sha256":"d875ac76864928e3968c940719fe0a879a2bf01cc1ddabf5de96c34e9a036731"},"source_packet":{"path":"artifacts/agent_research/phase5/inputs/contract-packet-91-95.json","sha256":"7a044fc4b0b30b9fa3f694714dbe79519af88ff6318819e74a3f38a2e0016816"},"world":{"inputs":[{"path":"data/project/scope.json","sha256":"ecd0c76ea442f5538a3bd5d12f1f3e33d0243318032b5c0446789fb5fdb91dbe"},{"path":"data/world/m3_core.json","sha256":"c4bf1c75fda8994fd846e570a64ae69efeb6ca17cd27e78c1bb1af4d7783d733"},{"path":"data/world/m3_locations.json","sha256":"ed1a4053f1459193777f486b3a9743c5aec28afb7d027dee12684da6e3a9d81b"},{"path":"data/world/m3_presence.json","sha256":"7880480b001c321e50056e887f1285f6c7ccf975aed140d1515967ea925bb3bb"},{"path":"data/world/m3_body.json","sha256":"429ca248ea42aa0601e11a55d40fa446da92cee48936627a83b335ab9b18056e"},{"path":"data/world/m3_resources.json","sha256":"b823f72594d4a2af2216525cbfd3411b00d41c4ad0fa89830348933be6de7668"},{"path":"data/world/m3_knowledge.json","sha256":"d8ee374ec667317af6ef304dc4b66ad7d3ceae9f20753c1b35cf029c73dee18b"},{"path":"data/objects/m4.json","sha256":"5c2719605b0d2b78d3c06d6bb7444c5c5058fd3891879f8dcfa480cd1828b4db"},{"path":"data/knowledge/v03_slice2.json","sha256":"37db9f32aad64636f33eb70a73130160260914e8a4ca987e03f6c45170fa88e7"},{"p