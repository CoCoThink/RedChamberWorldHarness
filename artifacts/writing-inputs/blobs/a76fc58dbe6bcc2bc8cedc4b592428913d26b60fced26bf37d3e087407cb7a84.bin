ter":91,"epistemic":"REFERENCE_RESOURCE_FLOW","food_medicine":"冬衣、靠褥等有许可才可取","labor":"平儿/守物人清点；凤姐短时亲往","money_state":"只能按名目取旧府物","object_interface":"雪中遗玉、旧箱/布包","source_ref":"asset:sha256:ffed02aee8809a8937651529048e2cc10256a0ae2e2706251c9b806a6ea6ef50"},{"boundary":"禁止重金打点万能","chapter":92,"epistemic":"REFERENCE_RESOURCE_FLOW","food_medicine":"监中粗饭；外送酱菜/炒米/厚袜","labor":"贾芸跑腿；小红问规则；茜雪送实物","money_state":"家中仍能筹小额送物费用","object_interface":"送物单、包裹、厚袜","source_ref":"asset:sha256:ffed02aee8809a8937651529048e2cc10256a0ae2e2706251c9b806a6ea6ef50"},{"boundary":"不以大葬恢复排场","chapter":93,"epistemic":"REFERENCE_RESOURCE_FLOW","food_medicine":"日常恢复但钱更紧","labor":"平儿转巧姐照料；丧事劳务增加","money_state":"释放不改善家计；凤姐丧事另耗","object_interface":"凤姐旧账/钥匙/衣物","source_ref":"asset:sha256:ffed02aee8809a8937651529048e2cc10256a0ae2e2706251c9b806a6ea6ef50"},{"boundary":"刘姥姥不能变现金大救星","chapter":94,"epistemic":"REFERENCE_RESOURCE_FLOW","food_medicine":"刘姥姥带干菜/提供乡居，属实物与空间救助","labor":"平儿识别风险；刘家承担照看","money_state":"丧后更弱；王仁把亲事与钱捆绑","object_interface":"巧姐包袱、纺车、粗饭","source_ref":"asset:sha256:ffed02aee8809a8937651529048e2cc10256a0ae2e2706251c9b806a6ea6ef50"},{"boundary":"至少有一次外出经济行为","chapter":95,"epistemic":"REFERENCE_RESOURCE_FLOW","food_medicine":"典衣买米、少买炭、酸齑、破毡","labor":"宝钗核日用；麝月做饭补衣；典当/米炭外部劳务","money_state":"进入稳定低现金状态","object_interface":"米瓮、夹袄、炭筐、旧毡","source_ref":"asset:sha256:ffed02aee8809a8937651529048e2cc10256a0ae2e2706251c9b806a6ea6ef50"},{"boundary":"援助应被节制使用","chapter":96,"epistemic":"REFERENCE_RESOURCE_FLOW","food_medicine":"一袋米、一筐炭、小包碎银；晚饭标准不变","labor":"蒋玉菡搬物/出钱，袭人问日用，麝月收放","money_state":"有限外援，不能逆转贫困","object_interface":"米只倒一半、银收匣","source_ref":"asset:sha256:ffed02aee8809a8937651529048e2cc10256a0ae2e2706251c9b806a6ea6ef50"},{"boundary":"不能把所有人都写成同一贫困","chapter":97,"epistemic":"REFERENCE_RESOURCE_FLOW","food_medicine":"湘云家仍能维持仆妇；妙玉依赖小庵米油；惜春尼庵生活简化","labor":"各空间自己的劳动系统","money_state":"各人物进入不同经济处境","object_interface":"若兰衣箱、米油、灰衣、灯油","source_ref":"asset:sha256:ffed02aee8809a8937651529048e2cc10256a0ae2e2706251c