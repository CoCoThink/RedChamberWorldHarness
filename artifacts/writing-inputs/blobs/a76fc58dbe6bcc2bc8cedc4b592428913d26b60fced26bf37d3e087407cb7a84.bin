note":"小红掌握监外规则与可办路径，不掌握全案","source_ref":"asset:sha256:bc6bf7cb5e60a47ff8a60fe348fc816c060d39901714efb1006695da81a68823","targets":["xiaohong"]},{"chapter":94,"epistemic":"REFERENCE_INFORMATION_ASYMMETRY","fact":"qiaojie_marriage_risk","kind":"LIMITED_KNOWLEDGE","note":"刘姥姥无需知道坏亲事全部细节即可实施接纳/转移","source_ref":"asset:sha256:bc6bf7cb5e60a47ff8a60fe348fc816c060d39901714efb1006695da81a68823","targets":["liulaolao"]},{"chapter":97,"epistemic":"REFERENCE_INFORMATION_ASYMMETRY","fact":"parallel_endgame_lines","kind":"MUTUAL_NONKNOWLEDGE","note":"三条线互不知情，不建立全知串联","source_ref":"asset:sha256:bc6bf7cb5e60a47ff8a60fe348fc816c060d39901714efb1006695da81a68823","targets":["xiangyun","miaoyu","xichun"]},{"chapter":98,"epistemic":"REFERENCE_INFORMATION_ASYMMETRY","fact":"mistaken_jade_package","kind":"EARLY_KNOWLEDGE","note":"甄家一侧先发现误拿，贾家最初不知道发生了什么","source_ref":"asset:sha256:bc6bf7cb5e60a47ff8a60fe348fc816c060d39901714efb1006695da81a68823","targets":["zhen_baoyu"]},{"chapter":99,"epistemic":"REFERENCE_INFORMATION_ASYMMETRY","fact":"baoyu_departure_intent","kind":"EARLY_INTENT","note":"宝玉最早知道自己要走，其他人分层后知","source_ref":"asset:sha256:bc6bf7cb5e60a47ff8a60fe348fc816c060d39901714efb1006695da81a68823","targets":["baoyu"]},{"chapter":100,"epistemic":"REFERENCE_INFORMATION_ASYMMETRY","fact":"outer_frame_emotion_register","kind":"FORBIDDEN_KNOWLEDGE","note":"太虚/情榜层的信息绝不倒灌给人间人物","source_ref":"asset:sha256:bc6bf7cb5e60a47ff8a60fe348fc816c060d39901714efb1006695da81a68823","targets":["human"]}],"longlines":[{"active_range":"84—90、95、99","epistemic":"REFERENCE_LONG_LINE","forbidden":"不用现代婚姻心理分析；不把黛亡直接变成金婚触发器","id":"L01","name":"宝玉—黛玉—宝钗情感与婚姻","source_ref":"asset:sha256:56727d17b5588cdecac3d0cf66b0030a6673ace47d532937d7988141e9cc41cd"},{"active_range":"84、89—100","epistemic":"REFERENCE_LONG_LINE","forbidden":"不一回抄完；败落必须通过居所、钱粮、劳务持续","id":"L02","name":"贾府败落 / 官面 / 钱粮","source_ref":"asset:sha256:56727d17b5588cdecac3d0cf66b0030a6673ace47d532937d7988141e9cc41cd"},{"active_range":"84、89—94","epistemic":"REFERENCE_LONG_LINE","forbidden":"凤姐死后线仍由平儿/巧姐继续","id":"L03","name":"凤姐—平儿—巧姐","source_ref":"asset:sha256:56727d17b5588cdecac3d0cf66b0030a6673ace47d532937d7988141e9cc41cd"},{"active_range":"83、87—88、90、95—96、99","epistemic":"REFERENCE_LONG_LINE","forbidden":"袭人嫁后不复位；麝月长期稳定","id":"L04","name":"袭人—麝月—蒋玉菡","source_ref":"asset:sha256:56727d17b5588cdecac3d0cf66b0030a6673ace47d532937d7988141e9cc41cd"},{"active_range":"89、92、96、98、99","epistemic":"REFERENCE_LONG_LINE","forbidden":"三人功能必须分开","id":"L05","name":"贾芸—小红—茜雪旧人回流","source_ref":"asset:sha256:56727d17b5588cdecac3d0cf66b0030a6673ace47d532937d7988141e9cc41cd"},{"active_range":"82起低频延续","epistemic":"REFERENCE_LONG_LINE","forbidden":"不临时召回；不锁夫家与政治任务","id":"L06","name":"探春远适","source_ref":"asset:sha256:56727d17b5588cdecac3d0cf66b0030a6673ace47d532937d7988141e9cc41cd"},{"active_range":"83、96、97、100","epistemic":"REFERENCE_LONG_LINE","forbidden":"不锁若兰死；先有真实乐再有悲","id":"L07","name":"湘云—卫若兰","source_ref":"asset:sha256:56727d17b5588cdecac3d0cf66b0030a6673ace47d532937d7988141e9cc41cd"},{"active_range":"89前置、97、100","epistemic":"REFERENCE_LONG_LINE","forbidden":"妙玉失自主，惜春主动断返","id":"L08","name":"妙玉—惜春","source_ref":"asset:sha256:56727d17b5588cdecac3d0cf66b0030a6673ace47d532937d7988141e9cc41cd"},{"active_range":"91、98、99开放、100外框","epistemic":"REFERENCE_LONG_LINE","forbidden":"91遗玉不自动等于通灵玉；99不以玉触发撒手","id":"L09","name":"玉线—甄宝玉","source_ref":"asset:sha256:56727d17b5588cdecac3d0cf66b0030a6673ace47d532937d7988141e9cc41cd"},{"active_range":"84/87/89背景，100总收","epistemic":"REFERENCE_LONG_LINE","forbidden":"贾兰功名不等于家族中兴；情榜不擅造完整评语","id":"L10","name":"李纨—贾兰—情榜—石头","source_ref":"asset:sha256:56727d17b5588cdecac3d0cf66b0030a6673ace47d532937d7988141e9cc41cd"}]},"data/world/m3_locations.json":{"locations":[{"access_rule":"内外房、药饭进入路径","anchors":"旧诗稿、针线、药气","chapters":"81","epistemic":"REFERENCE_WORLD_SPACE","id":"S01","name":"薛家内宅/香菱病房","social_state":"病床、药炉、宝钗/莺儿往返；金桂一侧仍构成心理环境","source_ref":"asset:sha256:92749de3e62e80c89611bf1b19081bbb56e4d025df981092451682333dd2b6bb"},{"access_rule":"主仆等级仍完整","anchors":"箱笼、花木、旧房、送别路线","chapters":"82—88","epistemic":"REFERENCE_WORLD_SPACE","id":"S02","name":"贾府/大观园末期空间","social_state":"尚未抄没；人物可在房、园、二门、长辈处移动","source_ref":"asset:sha256:92749de3e62e80c89611bf1b19081bbb56e4d025df981092451682333dd2b6bb"},{"access_rule":"入场需随相熟子弟","anchors":"弓箭、小厮、衣带、大金麒麟","chapters":"83","epistemic":"REFERENCE_WORLD_SPACE","id":"S03","name":"城外射圃","social_state":"男性社交场；宝玉非主场中心","source_ref":"asset:sha256:92749de3e62e80c89611bf1b19081bbb56e4d025df981092451682333dd2b6bb"},{"access_rule":"每换一处，陪同人物减少","anchors":"箱笼、车、码头、风、水声","chapters":"82","epistemic":"REFERENCE_WORLD_SPACE","id":"S04","name":"探春远行路线：二门—车—江岸—船","social_state":"从内宅逐步脱离家族控制的空间链","source_ref":"asset:sha256:92749de3e62e80c89611bf1b19081bbb56e4d025df981092451682333dd2b6bb"},{"access_rule":"谁能进、能停多久、能拿什么都受限","anchors":"封条、账册、箱柜、积雪、遗玉","chapters":"89、91","epistemic":"REFERENCE_WORLD_SPACE","id":"S05","name":"受控旧府","social_state":"官面接管后只能按名目进入/取物","source_ref":"asset:sha256:92749de3e62e80c89611bf1b19081bbb56e4d025df981092451682333dd2b6bb"},{"access_rule":"家内权威尚存但实际执行靠少数人","anchors":"铺盖、米瓮、药包、破窗前身","chapters":"89—94","epistemic":"REFERENCE_WORLD_SPACE","id":"S06","name":"第一处借住院落","social_state":"两三间屋、人员压缩、临时性强","source_ref":"asset:sha256:92749de3e62e80c89611bf1b19081bbb56e4d025df981092451682333dd2b6bb"},{"access_rule":"门、栏、送物、探视均受控","anchors":"铺位、粗饭、门声、灯、厚袜","chapters":"92","epistemic":"REFERENCE_WORLD_SPACE","id":"S07","name":"监所/狱神庙空间","social_state":"真实羁押空间，宝玉非自由访客","source_ref":"asset:sha256:92749de3e62e80c89611bf1b19081bbb56e4d025df981092451682333dd2b6bb"},{"access_rule":"巧姐作为寄住者，刘家承担实际照看","anchors":"土炕/床、粗饭、鸡犬、纺车、线","chapters":"94及后续消息","epistemic":"REFERENCE_WORLD_SPACE","id":"S08","name":"刘姥姥乡居","social_state":"有鸡犬、纺车、饭食、劳作的完整世界","source_ref":"asset:sha256:92749de3e62e80c89611bf1b19081bbb56e4d025df981092451682333dd2b6bb"},{"access_rule":"宝钗管日用，麝月承担实际家务","anchors":"米瓮、炭、旧毡、针线、灶、旧衣","chapters":"95—99","epistemic":"REFERENCE_WORLD_SPACE","id":"S09","name":"第二处低成本住处","social_state":"又迁一次后的稳定贫居","source_ref":"asset:sha256:92749de3e62e80c89611bf1b19081bbb56e4d025df981092451682333dd2b6bb"},{"access_rule":"住持可决定对外佛事","anchors":"米油、经卷、外衣、佛案","chapters":"97","epistemic":"REFERENCE_WORLD_SPACE","id":"S10","name":"妙玉寄居小庵","social_state":"失去栊翠庵独立性，与他人共食用","source_ref":"asset:sha256:92749de3e62e80c89611bf1b19081bbb56e4d025df981092451682333dd2b6bb"},{"access_rule":"老尼可日常管理但不能成为命运导师","anchors":"灰衣、灯油、经书","chapters":"97","epistemic":"REFERENCE_WORLD_SPACE","id":"S11","name":"惜春尼庵","social_state":"惜春主动留下，不是临时做客","source_ref":"asset:sha256:92749de3e62e80c89611bf1b19081bbb56e4d025df981092451682333dd2b6bb"},{"access_rule":"麝月送茶、包裹临时摆放","anchors":"茶、书札包、旧帕、通灵玉","chapters":"98","epistemic":"REFERENCE_WORLD_SPACE","id":"S12","name":"甄家来访—贫居客座","social_state":"仍在S09内，但客人进入暴露贫居待客能力","source_ref":"asset:sha256:92749de3e62e80c89611bf1b19081bbb56e4d025df981092451682333dd2b6bb"},{"access_rule":"家人可探访但不能强制带回","anchors":"柴、粗布衣、僧舍/院落","chapters":"99","epistemic":"REFERENCE_WORLD_SPACE","id":"S13","name":"城外寺院","social_state":"宝玉自行留下，非囚禁","source_ref":"asset:sha256:92749de3e62e80c89611bf1b19081bbb56e4d025df981092451682333dd2b6bb"},{"access_rule":"可接待少量亲友、报喜、吊客","anchors":"几桌茶饭、公服、冠帔、旧箱柜","chapters":"100","epistemic":"REFERENCE_WORLD_SPACE","id":"S14","name":"多年后的李纨/贾兰旧居","social_state":"空间仍狭小，官身并未恢复旧府","source_ref":"asset:sha256:92749de3e62e80c89611bf1b19081bbb56e4d025df981092451682333dd2b6bb"},{"access_rule":"与人间层严格分文体","anchors":"榜文、册籍、石上文字","chapters":"100","epistemic":"REFERENCE_WORLD_SPACE","id":"S15","name":"太虚幻境—青埂峰外框","social_state":"非人间现实空间；只在末回打开","source_ref":"asset:sha256:92749de3e62e80c89611bf1b19081bbb56e4d025df981092451682333dd2b6bb"}]},"data/world/m3_presence.json":{"presence_matrix":[{"chapter":81,"epistemic":"LITERARY_CONSTRUCTION_RESOURCE","forbidden_note":"宝玉等贾府人物只可由消息轻触","main_source":"香菱、宝钗、薛姨妈","natural_source":"莺儿、薛蟠","source_ref":"asset:sha256:30a6ecd37a4f3e846a72ef3cd445ba78db902fa788d45ee7cd3d73d86eb4df32","state_change":"香菱本回死亡；此后仅可被回忆/列榜"},{"chapter":82,"epistemic":"LITERARY_CONSTRUCTION_RESOURCE","forbidden_note":"夫家、丈夫保持场外；不命名","main_source":"探春、侍书、宝玉","natural_source":"贾母、王夫人、赵姨娘、贾环","source_ref":"asset:sha256:30a6ecd37a4f3e846a72ef3cd445ba78db902fa788d45ee7cd3d73d86eb4df32","state_change":"探春本回离京/远适；后续主要以家书、传闻出现"},{"chapter":83,"epistemic":"LITERARY_CONSTRUCTION_RESOURCE","forbidden_note":"探春已远；不让夫家人物突然解释麒麟来历","main_source":"宝玉、卫若兰、湘云","natural_source":"袭人、宝钗","source_ref":"asset:sha256:30a6ecd37a4f3e846a72ef3cd445ba78db902fa788d45ee7cd3d73d86eb4df32","state_change":"卫若兰首次现实照面；湘云尚未与他共同生活"},{"chapter":84,"epistemic":"LITERARY_CONSTRUCTION_RESOURCE","forbidden_note":"元春只作为死讯/回忆存在","main_source":"贾母、王夫人、凤姐、宝玉、黛玉","natural_source":"李纨、宝钗、袭人、麝月、紫鹃、雪雁、平儿","source_ref":"asset:sha256:30a6ecd37a4f3e846a72ef3cd445ba78db902fa788d45ee7cd3d73d86eb4df32","state_change":"元春死亡；全府进入丧期"},{"chapter":85,"epistemic":"LITERARY_CONSTRUCTION_RESOURCE","forbidden_note":"元春只以丧期背景存在","main_source":"黛玉、紫鹃、雪雁、宝玉、宝钗","natural_source":"贾母、王夫人、李纨","source_ref":"asset:sha256:30a6ecd37a4f3e846a72ef3cd445ba78db902fa788d45ee7cd3d73d86eb4df32","state_change":"黛玉仍活且有日常；不可从开头即临终化"},{"chapter":86,"epistemic":"LITERARY_CONSTRUCTION_RESOURCE","forbidden_note":"袭人可低容量出现但不抢场","main_source":"黛玉、紫鹃、雪雁、宝玉、宝钗","natural_source":"贾母、王夫人、李纨、麝月、袭人","source_ref":"asset:sha256:30a6ecd37a4f3e846a72ef3cd445ba78db902fa788d45ee7cd3d73d86eb4df32","state_change":"黛玉本回死亡；宝玉不得见最后一息"},{"chapter":87,"epistemic":"LITERARY_CONSTRUCTION_RESOURCE","forbidden_note":"黛玉只通过空位、遗物、他人避谈存在","main_source":"宝玉、宝钗、贾母、王夫人、薛姨妈","natural_source":"袭人、麝月、李纨、平儿、紫鹃、雪雁","source_ref":"asset:sha256:30a6ecd37a4f3e846a72ef3cd445ba78db902fa788d45ee7cd3d73d86eb4df32","state_change":"宝玉宝钗正式成婚；宝钗妻位开始真实运行"},{"chapter":88,"epistemic":"LITERARY_CONSTRUCTION_RESOURCE","forbidden_note":"迎春不正面再造受虐场；孙绍祖无需扩写","main_source":"袭人、宝玉、宝钗、麝月","natural_source":"王夫人、蒋玉菡","source_ref":"asset:sha256:30a6ecd37a4f3e846a72ef3cd445ba78db902fa788d45ee7cd3d73d86eb4d