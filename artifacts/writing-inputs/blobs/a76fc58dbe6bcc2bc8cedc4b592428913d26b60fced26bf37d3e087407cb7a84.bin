cd3c7003b671db97190fcf395e6087df19ad31f3c0254b4ec62835ce7b241","value":{"epistemic":"CURRENT_SCENE_UNKNOWN","id":"baoyu_detention_whole_case","label":"宝玉羁押案全部案情与官面判断"}}],"objects":[],"participants":[{"path":"data/world/m3_core.json","pointer":"/characters/0","ref":"data/world/m3_core.json#/characters/0","sha256":"c4bf1c75fda8994fd846e570a64ae69efeb6ca17cd27e78c1bb1af4d7783d733","text_sha256":"c90d10be26bb276650ff292a0dc2e511347a54c0bd8bfef95a7ed588454eff94","value":{"baseline":{"body_state":"ordinary","household_role":"jia_son","legal_status":"FREE","life_state":"ACTIVE","location":"S02","marital_status":"UNMARRIED"},"groups":["jia_household","human"],"id":"baoyu","name":"贾宝玉"}},{"path":"data/world/m3_core.json","pointer":"/characters/10","ref":"data/world/m3_core.json#/characters/10","sha256":"c4bf1c75fda8994fd846e570a64ae69efeb6ca17cd27e78c1bb1af4d7783d733","text_sha256":"340eb8abc9247bbb71dbde20970aad2d26ba92195c40678d53b29fcd43b5c3c2","value":{"baseline":{"body_state":"ordinary","household_role":"kin_runner","legal_status":"NOT_AT_ISSUE","life_state":"ACTIVE","location":null,"marital_status":"UNRESOLVED"},"groups":["jia_network","human"],"id":"jia_yun","name":"贾芸"}}]},"required_beats":[{"description":"正常释放须先核手续、清点领取随身物，再离开；说明仍可传问，而不是开门就走。","grounding":{"chapter_card_fields":[{"citation":{"byte_range":[34225,34340],"lines":[843,845],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"d260746d432ea4ea17f3e8ce6844e215bca76547ca9f02df20e9306c25c6f783"},"name":"最薄处","number":3,"text":"**3｜最薄处**  \n释放手续、凤姐死前“最后一件管事”、死后“谁来主丧”可以更清。\n\n"},{"citation":{"byte_range":[34340,34520],"lines":[846,848],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"24c75446bbadf3e0a5a544feaa3b251e5f41cf772e5918e4ce448363682d12ea"},"name":"缺失情节","number":4,"text":"**4｜缺失情节**  \n93-S1领取随身物/仍可传问；S2回家先吃；S3凤姐在宝玉回来前已末段；S4最后只管一件事；S5她一死立刻出现组织真空。\n\n"},{"citation":{"byte_range":[35618,35900],"lines":[885,888],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"b024aef7267d8e0f55de72f25a39d4a76cd408f26c09300906dd304dd185b6b3"},"name":"章法 / 风险","number":18,"text":"**18｜章法 / 风险**  \n释放 → 回家吃热饭 → 看凤姐 → 最后一件具体管事 → 身体退出 → 死 → 丧务组织真空 → 平儿留下陪巧姐又被现实叫走。  \n**风险：**死亡压过宝玉获释或反之；需保持“双恢复/双退出”。\n\n"}],"seed":{"path":"data/prewrite/v06.json","pointer":"/omitted_scene_plans/12/candidate_scenes/0","ref":"data/prewrite/v06.json#/omitted_scene_plans/12/candidate_scenes/0","sha256":"caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff","text_sha256":"33a62fe06ad9520b4eb4b0d4152c7adaf5a56f573882baf94c534b1ff6e9f8b3","value":{"id":"93-S1","title":"释放有手续，不是开门就走"}}},"id":"93-S1-R1","scope":"CURRENT_IMPLEMENTATION_REQUIREMENT_NOT_HISTORICAL_FACT","status":"PENDING"},{"description":"获释只恢复有限行动自由，不带来钱或旧产业；以回家热饭的需要承接后场。","grounding":{"chapter_card_fields":[{"citation":{"byte_range":[34043,34225],"lines":[840,842],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"efa37f4b209fe5a191064f129e6a0b8ee8b28df41dedd5cf00f176dc9873bc75"},"name":"最强处","number":2,"text":"**2｜最强处**  \n宝玉回家第一件事是热饭、洗手、换衣；凤姐死后两张纸仍是买米/巧姐药钱；钥匙有些已无柜可开；平儿被叫去补白布。\n\n"},{"citation":{"byte_range":[35028,35195],"lines":[867,869],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"2369b960bd77349ce3570b4f2bfdac3cb767cd2a7937d9803939fb138c0e688b"},"name":"四链","number":11,"text":"**11｜四链**  \nE2：宝玉获释不带来钱，凤死立刻要钱。物链从热饭/水转到白布/灯/棺/遗物；信息上释放小喜立即被病危压过。\n\n"},{"citation":{"byte_range":[35618,35900],"lines":[885,888],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"b024aef7267d8e0f55de72f25a39d4a76cd408f26c09300906dd304dd185b6b3"},"name":"章法 / 风险","number":18,"text":"**18｜章法 / 风险**  \n释放 → 回家吃热饭 → 看凤姐 → 最后一件具体管事 → 身体退出 → 死 → 丧务组织真空 → 平儿留下陪巧姐又被现实叫走。  \n**风险：**死亡压过宝玉获释或反之；需保持“双恢复/双退出”。\n\n"}],"seed":{"path":"data/prewrite/v06.json","pointer":"/omitted_scene_plans/12/candidate_scenes/0","ref":"data/prewrite/v06.json#/omitted_scene_plans/12/candidate_scenes/0","sha256":"caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff","text_sha256":"33a62fe06ad9520b4eb4b0d4152c7adaf5a56f573882baf94c534b1ff6e9f8b3","value":{"id":"93-S1","title":"释放有手续，不是开门就走"}}},"id":"93-S1-R2","scope":"CURRENT_IMPLEMENTATION_REQUIREMENT_NOT_HISTORICAL_FACT","status":"PENDING"},{"description":"释放决定、可再传问告知、领回随身物及离监分开经手；无ID的随身物清单待核，不把发还物、案情知悉及产权恢复合成完成结果。","grounding":{"chapter_card_fields":[{"citation":{"byte_range":[34225,34340],"lines":[843,845],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"d260746d432ea4ea17f3e8ce6844e215bca76547ca9f02df20e9306c25c6f783"},"name":"最薄处","number":3,"text":"**3｜最薄处**  \n释放手续、凤姐死前“最后一件管事”、死后“谁来主丧”可以更清。\n\n"},{"citation":{"byte_range":[34340,34520],"lines":[846,848],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"24c75446bbadf3e0a5a544feaa3b251e5f41cf772e5918e4ce448363682d12ea"},"name":"缺失情节","number":4,"text":"**4｜缺失情节**  \n93-S1领取随身物/仍可传问；S2回家先吃；S3凤姐在宝玉回来前已末段；S4最后只管一件事；S5她一死立刻出现组织真空。\n\n"},{"citation":{"byte_range":[35028,35195],"lines":[867,869],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"2369b960bd77349ce3570b4f2bfdac3cb767cd2a7937d9803939fb138c0e688b"},"name":"四链","number":11,"text":"**11｜四链**  \nE2：宝玉获释不带来钱，凤死立刻要钱。物链从热饭/水转到白布/灯/棺/遗物；信息上释放小喜立即被病危压过。\n\n"},{"citation":{"byte_range":[35618,35900],"lines":[885,888],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"b024aef7267d8e0f55de72f25a39d4a76cd408f26c09300906dd304dd185b6b3"},"name":"章法 / 风险","number":18,"text":"**18｜章法 / 风险**  \n释放 → 回家吃热饭 → 看凤姐 → 最后一件具体管事 → 身体退出 → 死 → 丧务组织真空 → 平儿留下陪巧姐又被现实叫走。  \n**风险：**死亡压过宝玉获释或反之；需保持“双恢复/双退出”。\n\n"}],"seed":{"path":"data/prewrite/v06.json","pointer":"/omitted_scene_plans/12/candidate_scenes/0","ref":"data/prewrite/v06.json#/omitted_scene_plans/12/candidate_scenes/0","sha256":"caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff","text_sha256":"33a62fe06ad9520b4eb4b0d4152c7adaf5a56f573882baf94c534b1ff6e9f8b3","value":{"id":"93-S1","title":"释放有手续，不是开门就走"}},"world_records":[{"path":"data/world/m3_core.json","pointer":"/events/10","ref":"data/world/m3_core.json#/events/10","sha256":"c4bf1c75fda8994fd846e570a64ae69efeb6ca17cd27e78c1bb1af4d7783d733","text_sha256":"d680d4cba780dc6f288c27e8d9c10919b42b5b7d41e9bc211eee23ffe30948fd","value":{"chapter":93,"effects":[{"set":"characters.baoyu.legal_status","value":"RELEASED_NO_RESTORATION"},{"set":"characters.baoyu.location","value":"S06"},{"set":"characters.baoyu.body_state","value":"post_detention_recovery"},{"set":"characters.fengjie.life_state","value":"DEAD"},{"set":"characters.fengjie.body_state","value":"DEAD_AFTER_CHRONIC_DECLINE"},{"set":"relations.rel:fengjie_ping.status","value":"ENDED_BY_DEATH"},{"set":"relations.rel:fengjie_qiaojie.status","value":"ENDED_BY_DEATH"},{"set":"characters.ping_er.household_role","value":"qiaojie_protection_executor"}],"epistemic":"CURRENT_C_WORLD","id":"W93-RELEASE-FENGJIE-DEATH","sequence":70,"source_refs":["R29"]}}]},"id":"93-S1-R3","scope":"CURRENT_IMPLEMENTATION_REQUIREMENT_NOT_HISTORICAL_FACT","status":"PENDING"}],"required_objects":[],"revision":"v2","schema_version":1,"status":"AGENT_EDITED","unresolved":["agent_edit_and_semantics: AGENT_EDITED仅表示基于实际v1及绑定包完成当前模型编辑；非人类、非独立盲审、非合资格历史鉴定，正文/同行语义NOT_CHECKED，authority/evidence均NONE。","scene_chronology: 前驱只声明SOURCE_LIST_ORDER_NOT_VERIFIED_CHRONOLOGY的源列表次序，不证明历史原稿或场内时序。","participants: 释放书办、看守和随身物清点人未有ID，贾芸不能代替官面手续。","implementation_gap: 随身物和领物凭据没有对象ID；仍可传问的通知形式、92末与93初时间边界待核定。","implementation_gap: W93-RELEASE-FENGJIE-DEATH为混合章级事件，故不在本场绑定执行；只以UNKNOWN出口保留释放义务。","exit_state: character.baoyu.legal_status — W93确有RELEASED_NO_RESTORATION，但同时包含凤姐死亡；没有本场独立释放事件，不能整包执行制造早死。","exit_state: character.baoyu.knowledge.baoyu_detention_whole_case — 领物获释不证明宝玉已知全案及最终官面判断，知识接口无此场更新。","knowledge_binding_scope: 事实ID或旧送物场记录不自动授权任何角色知情；种子场的实际获得、传话与未知范围须独立落实。","exit_state: character.baoyu.location — 离监、领物及实到借院是不同动作；W93同时给回院和凤姐死亡，无本场可单独执行到达检查点。","coarse_release_only: event_refs仍空；释放待写不建立已核release-only事件，末病不从章末死亡倒推。"]},"data/planning/contracts/agent-final-v1/93-S2.v3.json":{"authority_effect":"NONE","bindings":{"chapter_plan":{"path":"data/planning/chapters/ch93.json","sha256":"515ed9ce4f4aa83ba37ed0124f4ac31303b4fb375279500a0951cf74019301ce"},"seed":{"path":"data/planning/scenes/93-S2.json","sha256":"43b0c48d2421b1e73227fec329df9fa0cc1ceb07491ce9eb273ab9775e447484"},"source_packet":{"path":"artifacts/agent_research/phase5/inputs/contract-packet-91-95.json","sha256":"7a044fc4b0b30b9fa3f694714dbe79519af88ff6318819e74a3f38a2e0016816"},"world":{"inputs":[{"path":"data/project/scope.json","sha256":"ecd0c76ea442f5538a3bd5d12f1f3e33d0243318032b5c0446789fb5fdb91dbe"},{"path":"data/world/m3_core.json","sha256":"c4bf1c75fda8994fd846e570a64ae69efeb6ca17cd27e78c1bb1af4d7783d733"},{"path":"data/world/m3_locations.json","sha256":"ed1a4053f1459193777f486b3a9743c5aec28afb7d027dee12684da6e3a9d81b"},{"path":"data/world/m3_presence.json","sha256":"7880480b001c321e50056e887f1285f6c7ccf975aed140d1515967ea925bb3bb"},{"path":"data/world/m3_body.json","sha256":"429ca248ea42aa0601e11a55d40fa446da92cee48936627a83b335ab9b18056e"},{"path":"data/world/m3_resources.json","sha256":"b823f72594d4a2af2216525cbfd3411b00d41c4ad0fa89830348933be6de7668"},{"path":"data/world/m3_knowledge.json","sha256":"d8ee374ec667317af6ef304dc4b66ad7d3ceae9f20753c1b35cf029c73dee18b"},{"path":"data/objects/m4.json","sha256":"5c2719605b0d2b78d3c06d6bb7444c5c5058fd3891879f8dcfa480cd1828b4db"},{"path":"data/knowledge/v03_slice2.json","sha256":"37db9f32aad64636f33eb70a73130160260914e8a4ca987e03f6c45170fa88e7"},{"path":"data/objects/medicine_bowl.yaml","sha256":"ad304b16d955e904b6de156bf88c38f51f0d552698bb7f2ff6ba07bb5572d361"}],"status":"BOUND"}},"chapter":93,"chapter_plan_ref":"data/planning/chapters/ch93.json","entry_checkpoint":{"chapter":null,"kind":"UNKNOWN"},"entry_from":"data/planning/scenes/93-S1.json","entry_state":[{"basis":[],"equals":"character.baoyu.location","reason":"前场释放手续与到S06借院的实际走行未建立本场入口记录。","status":"UNKNOWN","value":null}],"event_refs":[],"evidence_effect":"NONE","exit_state":[{"basis":[],"equals":"character.baoyu.body_state","reason":"吃热粥洗手换衣是恢复过程，不等于W93的post_detention_recovery已在本场验证或完全康复。","status":"UNKNOWN","value":null},{"basis":[],"equals":"character.baoyu.knowledge.baoyu_detention_whole_case","reason":"回院生活动作和家人接待不是完整案情来源；无本场知识更新，不由获释叙述补全知。","status":"UNKNOWN","value":null}],"forbidden_beats":[{"description":"不得把回家第一件事改成法律总结、全案叙述或宏大庆贺；热饭不意味着资源恢复。","grounding":{"chapter_card_fields":[{"citation":{"byte_range":[34043,34225],"lines":[840,842],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"efa37f4b209fe5a191064f129e6a0b8ee8b28df41dedd5cf00f176dc9873bc75"},"name":"最强处","number":2,"text":"**2｜最强处**  \n宝玉回家第一件事是热饭、洗手、换衣；凤姐死后两张纸仍是买米/巧姐药钱；钥匙有些已无柜可开；平儿被叫去补白布。\n\n"},{"citation":{"byte_range":[34340,34520],"lines":[846,848],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"24c75446bbadf3e0a5a544feaa3b251e5f41cf772e5918e4ce448363682d12ea"},"name":"缺失情节","number":4,"text":"**4｜缺失情节**  \n93-S1领取随身物/仍可传问；S2回家先吃；S3凤姐在宝玉回来前已末段；S4最后只管一件事；S5她一死立刻出现组织真空。\n\n"},{"citation":{"byte_range":[35028,35195],"lines":[867,869],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"2369b960bd77349ce3570b4f2bfdac3cb767cd2a7937d9803939fb138c0e688b"},"name":"四链","number":11,"text":"**11｜四链**  \nE2：宝玉获释不带来钱，凤死立刻要钱。物链从热饭/水转到白布/灯/棺/遗物；信息上释放小喜立即被病危压过。\n\n"}],"seed":{"path":"data/prewrite/v06.json","pointer":"/omitted_scene_plans/12/candidate_scenes/1","ref":"data/prewrite/v06.json#/omitted_scene_plans/12/candidate_scenes/1","sha256":"caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff","text_sha256":"5f7b76e98e5b1bb3596972268105a9bdace1cdafe6f011c259f32ebc1f208a4a","value":{"id":"93-S2","title":"回家第一件事不是谈案，是吃饭洗手换衣"}}},"id":"93-S2-F1","scope":"CURRENT_IMPLEMENTATION_REQUIREMENT_NOT_HISTORICAL_FACT","status":"PENDING"},{"description":"不得以获释喜讯抹掉凤姐早已进入末段的病势，也不得把饭桌笑话延续到死亡后的丧务。","grounding":{"chapter_card_fields":[{"citation":{"byte_range":[34340,34520],"lines":[846,848],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"24c75446bbadf3e0a5a544feaa3b251e5f41cf772e5918e4ce448363682d12ea"},"name":"缺失情节","number":4,"text":"**4｜缺失情节**  \n93-S1领取随身物/仍可传问；S2回家先吃；S3凤姐在宝玉回来前已末段；S4最后只管一件事；S5她一死立刻出现组织真空。\n\n"},{"citation":{"byte_range":[34717,34847],"lines":[858,860],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"82e58ec44e300720aa1a2725f4f03a4b9ff2f0d6fa0395c2d67f733bda98006c"},"name":"笑料","number":8,"text":"**8｜笑料**  \n麝月说“第三日我自己饿了先吃半碗”可保，形成“回家”活气；凤死后笑料退场。\n\n"},{"citation":{"byte_range":[35618,35900],"lines":[885,888],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"b024aef7267d8e0f55de72f25a39d4a76cd408f26c09300906dd304dd185b6b3"},"name":"章法 / 风险","number":18,"text":"**18｜章法 / 风险**  \n释放 → 回家吃热饭 → 看凤姐 → 最后一件具体管事 → 身体退出 → 死 → 丧务组织真空 → 平儿留下陪巧姐又被现实叫走。  \n**风险：**死亡压过宝玉获释或反之；需保持“双恢复/双退出”。\n\n"}],"seed":{"path":"data/prewrite/v06.json","pointer":"/omitted_scene_plans/12/candidate_scenes/1","ref":"data/prewrite/v06.json#/omitted_scene_plans/12/candidate_scenes/1","sha256":"caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff","text_sha256":"5f7b76e98e5b1bb3596972268105a9bdace1cdafe6f011c259f32ebc1f208a4a","value":{"id":"93-S2","title":"回家第一件事不是谈案，是吃饭洗手换衣"}}},"id":"93-S2-F2","scope":"CURRENT_IMPLEMENTATION_REQUIREMENT_NOT_HISTORICAL_FACT","status":"PENDING"},{"description":"热饭/洗手/换衣不等于完全恢复或知全案；饭桌笑话只在相应死亡消息之前保留，不凭源列表场序断言全家同步得知。","grounding":{"chapter_card_fields":[{"citation":{"byte_range":[34043,34225],"lines":[840,842],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"efa37f4b209fe5a191064f129e6a0b8ee8b28df41dedd5cf00f176dc9873bc75"},"name":"最强处","number":2,"text":"**2｜最强处**  \n宝玉回家第一件事是热饭、洗手、换衣；凤姐死后两张纸仍是买米/巧姐药钱；钥匙有些已无柜可开；平儿被叫去补白布。\n\n"},{"citation":{"byte_range":[34340,34520],"lines":[846,848],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"24c75446bbadf3e0a5a544feaa3b251e5f41cf772e5918e4ce448363682d12ea"},"name":"缺失情节","number":4,"text":"**4｜缺失情节**  \n93-S1领取随身物/仍可传问；S2回家先吃；S3凤姐在宝玉回来前已末段；S4最后只管一件事；S5她一死立刻出现组织真空。\n\n"},{"citation":{"byte_range":[34717,34847],"lines":[858,860],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"82e58ec44e300720aa1a2725f4f03a4b9ff2f0d6fa0395c2d67f733bda98006c"},"name":"笑料","number":8,"text":"**8｜笑料**  \n麝月说“第三日我自己饿了先吃半碗”可保，形成“回家”活气；凤死后笑料退场。\n\n"},{"citation":{"byte_range":[35028,35195],"lines":[867,869],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"2369b960bd77349ce3570b4f2bfdac3cb767cd2a7937d9803939fb138c0e688b"},"name":"四链","number":11,"text":"**11｜四链**  \nE2：宝玉获释不带来钱，凤死立刻要钱。物链从热饭/水转到白布/灯/棺/遗物；信息上释放小喜立即被病危压过。\n\n"},{"citation":{"byte_range":[35618,35900],"lines":[885,888],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"b024aef7267d8e0f55de72f25a39d4a76cd408f26c09300906dd304dd185b6b3"},"name":"章法 / 风险","number":18,"text":"**18｜章法 / 风险**  \n释放 → 回家吃热饭 → 看凤姐 → 最后一件具体管事 → 身体退出 → 死 → 丧务组织真空 → 平儿留下陪巧姐又被现实叫走。  \n**风险：**死亡压过宝玉获释或反之；需保持“双恢复/双退出”。\n\n"}],"seed":{"path":"data/prewrite/v06.json","pointer":"/omitted_scene_plans/12/candidate_scenes/1","ref":"data/prewrite/v06.json#/omitted_scene_plans/12/candidate_scenes/1","sha256":"caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff","text_sha256":"5f7b76e98e5b1bb3596972268105a9bdace1cdafe6f011c259f32ebc1f208a4a","value":{"id":"93-S2","title":"回家第一件事不是谈案，是吃饭洗手换衣"}},"world_records":[{"path":"data/world/m3_core.json","pointer":"/events/10","ref":"data/world/m3_core.json#/events/10","sha256":"c4bf1c75fda8994fd846e570a64ae69efeb6ca17cd27e78c1bb1af4d7783d733","text_sha256":"d680d4cba780dc6f288c27e8d9c10919b42b5b7d41e9bc211eee23ffe30948fd","value":{"chapter":93,"effects":[{"set":"characters.baoyu.legal_status","value":"RELEASED_NO_RESTORATION"},{"set":"characters.baoyu.location","value":"S06"},{"set":"characters.baoyu.body_state","value":"post_detention_recovery"},{"set":"characters.fengjie.life_state","value":"DEAD"},{"set":"characters.fengjie.body_state","value":"DEAD_AFTER_CHRONIC_DECLINE"},{"set":"relations.rel:fengjie_ping.status","value":"ENDED_BY_DEATH"},{"set":"relations.rel:fengjie_qiaojie.status","value":"ENDED_BY_DEATH"},{"set":"characters.ping_er.household_role","value":"qiaojie_protection_executor"}],"epistemic":"CURRENT_C_WORLD","id":"W93-RELEASE-FENGJIE-DEATH","sequence":70,"source_refs":["R29"]}}]},"id":"93-S2-F3","scope":"CURRENT_IMPLEMENTATION_REQUIREMENT_NOT_HISTORICAL_FACT","status":"PENDING"}],"function":"让宝玉先吃热饭、洗手和换衣，借麝月的有限笑话恢复回家活气；再与凤姐末病交叉，不作获释案情大会。","id":"93-S2","kind":"AGENT_SCENE_CONTRACT","knowledge_binding":null,"knowledge_event_refs":[],"notes":"EDITOR91–95模型只编辑实际v1和绑定源包/章卡/世界引用，未读其他editor提交或reviews。AGENT_EDITED不证明历史事实、正文语义、同行语义PASS、人类或独立盲审资格。participants均PENDING；原entry/pre/exit逐项原样保留，新增状态均UNKNOWN/null且不造basis。源列表只为声明次序；世界/对象/知识绑定不变，不从粗章级接口补场内检查点、知识、身份、人物、物或事件。场别before/after+packet/issues/rationale/unresolved见独占新提交contract-editor-91-95.json；原v1/包/种子/章卡/世界/旧合同字节不变。 ROOT_V4_C_EDITORIAL_PLACEMENT: 原章卡把唯一正是二句置于92；本轮因实际离监及归家发生在93，将同一原句迁至93-S2吃热粥后、凤姐死亡前。不是原章卡已有此安排，不新增诗、不更改W93、世界入口或历史证据。","object_transition_refs":[],"order":2,"participants":["baoyu","baochai","sheyue"],"participants_status":"PENDING","preconditions":[{"basis":[],"equals":"character.baoyu.legal_status","reason":"本场不是章初；上场待写释放出口未通过独立场级核验。","status":"UNKNOWN","value":null}],"references":{"knowledge":[{"path":"data/knowledge/v03_slice2.json","pointer":"/facts/8","ref":"data/knowledge/v03_slice2.json#/facts/8","sha256":"37db9f32aad64636f33eb70a73130160260914e8a4ca987e03f6c45170fa88e7","text_sha256":"376cd3c7003b671db97190fcf395e6087df19ad31f3c0254b4ec62835ce7b241","value":{"epistemic":"CURRENT_SCENE_UNKNOWN","id":"baoyu_detention_whole_case","label":"宝玉羁押案全部案情与官面判断"}}],"objects":[],"participants":[{"path":"data/world/m3_core.json","pointer":"/characters/0","ref":"data/world/m3_core.json#/characters/0","sha256":"c4bf1c75fda8994fd846e570a64ae69efeb6ca17cd27e78c1bb1af4d7783d733","text_sha256":"c90d10be26bb276650ff292a0dc2e511347a54c0bd8bfef95a7ed588454eff94","value":{"baseline":{"body_state":"ordinary","household_role":"jia_son","legal_status":"FREE","life_state":"ACTIVE","location":"S02","marital_status":"UNMARRIED"},"groups":["jia_household","human"],"id":"baoyu","name":"贾宝玉"}},{"path":"data/world/m3_core.json","pointer":"/characters/1","ref":"data/world/m3_core.json#/characters/1","sha256":"c4bf1c75fda8994fd846e570a64ae69efeb6ca17cd27e78c1bb1af4d7783d733","text_sha256":"539bb81553f85ece6e29214a008c499290b50068e2127c17a80cc113c82ae6b5","value":{"baseline":{"body_state":"ordinary","household_role":"xue_daughter_guest","legal_status":"NOT_AT_ISSUE","life_state":"ACTIVE","location":"S02","marital_status":"UNMARRIED"},"groups":["jia_household","xue_household","human"],"id":"baochai","name":"薛宝钗"}},{"path":"data/world/m3_core.json","pointer":"/characters/6","ref":"data/world/m3_core.json#/characters/6","sha256":"c4bf1c75fda8994fd846e570a64ae69efeb6ca17cd27e78c1bb1af4d7783d733","text_sha256":"779594feec7c611f21661c22a7c613a048e7457e0503012f1f3b98a4c39b8978","value":{"baseline":{"body_state":"ordinary","household_role":"baoyu_attendant","legal_status":"NOT_AT_ISSUE","life_state":"ACTIVE","location":"S02","marital_status":"UNRESOLVED"},"groups":["jia_household","human"],"id":"sheyue","name":"麝月"}}]},"required_beats":[{"description":"宝玉进门先有热饭/热粥、洗手、换衣，不先谈案；宝钗与麝月在这些实际事上接他回家。","grounding":{"chapter_card_fields":[{"citation":{"byte_range":[34043,34225],"lines":[840,842],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"efa37f4b209fe5a191064f129e6a0b8ee8b28df41dedd5cf00f176dc9873bc75"},"name":"最强处","number":2,"text":"**2｜最强处**  \n宝玉回家第一件事是热饭、洗手、换衣；凤姐死后两张纸仍是买米/巧姐药钱；钥匙有些已无柜可开；平儿被叫去补白布。\n\n"},{"citation":{"byte_range":[34340,34520],"lines":[846,848],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"24c75446bbadf3e0a5a544feaa3b251e5f41cf772e5918e4ce448363682d12ea"},"name":"缺失情节","number":4,"text":"**4｜缺失情节**  \n93-S1领取随身物/仍可传问；S2回家先吃；S3凤姐在宝玉回来前已末段；S4最后只管一件事；S5她一死立刻出现组织真空。\n\n"},{"citation":{"byte_range":[34520,34607],"lines":[849,851],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"bbf552991c41fb791958c2408cc605faeb7a360a78f0e85e97bc015a375c6d57"},"name":"人物","number":5,"text":"**5｜人物**  \n宝玉/宝钗/麝月A线；凤姐/平儿/巧姐/医者/婆子B线。\n\n"},{"citation":{"byte_range":[35028,35195],"lines":[867,869],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"2369b960bd77349ce3570b4f2bfdac3cb767cd2a7937d9803939fb138c0e688b"},"name":"四链","number":11,"text":"**11｜四链**  \nE2：宝玉获释不带来钱，凤死立刻要钱。物链从热饭/水转到白布/灯/棺/遗物；信息上释放小喜立即被病危压过。\n\n"},{"citation":{"byte_range":[35195,35305],"lines":[870,872],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"83d1dcf9f335e7fa03c6553c1d6649d486aea624c3973611c3d120a4f5894663"},"name":"必须保留","number":12,"text":"**12｜必须保留**  \n热粥、巧姐问薄不薄、空药吊子、白布短一截、平儿起身去办。\n\n"}],"seed":{"path":"data/prewrite/v06.json","pointer":"/omitted_scene_plans/12/candidate_scenes/1","ref":"data/prewrite/v06.json#/omitted_scene_plans/12/candidate_scenes/1","sha256":"caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff","text_sha256":"5f7b76e98e5b1bb3596972268105a9bdace1cdafe6f011c259f32ebc1f208a4a","value":{"id":"93-S2","title":"回家第一件事不是谈案，是吃饭洗手换衣"}}},"id":"93-S2-R1","scope":"CURRENT_IMPLEMENTATION_REQUIREMENT_NOT_HISTORICAL_FACT","status":"PENDING"},{"description":"保留麝月“第三日我自己饿了先吃半碗”的小话，让饭和回家的活气存在；凤姐死后此类笑料要退场。","grounding":{"chapter_card_fields":[{"citation":{"byte_range":[34717,34847],"lines":[858,860],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"82e58ec44e300720aa1a2725f4f03a4b9ff2f0d6fa0395c2d67f733bda98006c"},"name":"笑料","number":8,"text":"**8｜笑料**  \n麝月说“第三日我自己饿了先吃半碗”可保，形成“回家”活气；凤死后笑料退场。\n\n"},{"citation":{"byte_range":[35618,35900],"lines":[885,888],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"b024aef7267d8e0f55de72f25a39d4a76cd408f26c09300906dd304dd185b6b3"},"name":"章法 / 风险","number":18,"text":"**18｜章法 / 风险**  \n释放 → 回家吃热饭 → 看凤姐 → 最后一件具体管事 → 身体退出 → 死 → 丧务组织真空 → 平儿留下陪巧姐又被现实叫走。  \n**风险：**死亡压过宝玉获释或反之；需保持“双恢复/双退出”。\n\n"}],"seed":{"path":"data/prewrite/v06.json","pointer":"/omitted_scene_plans/12/candidate_scenes/1","ref":"data/prewrite/v06.json#/omitted_scene_plans/12/candidate_scenes/1","sha256":"caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff","text_sha256":"5f7b76e98e5b1bb3596972268105a9bdace1cdafe6f011c259f32ebc1f208a4a","value":{"id":"93-S2","title":"回家第一件事不是谈案，是吃饭洗手换衣"}}},"id":"93-S2-R2","scope":"CURRENT_IMPLEMENTATION_REQUIREMENT_NOT_HISTORICAL_FACT","status":"PENDING"},{"description":"回家先有有限热饭/洗手/换衣，再经实际来报或探视得知凤姐既已病危，双线交叉不让喜讯致病。谁听见病情、何时听见不由W93代全家预先知晓。","grounding":{"chapter_card_fields":[{"citation":{"byte_range":[34340,34520],"lines":[846,848],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"24c75446bbadf3e0a5a544feaa3b251e5f41cf772e5918e4ce448363682d12ea"},"name":"缺失情节","number":4,"text":"**4｜缺失情节**  \n93-S1领取随身物/仍可传问；S2回家先吃；S3凤姐在宝玉回来前已末段；S4最后只管一件事；S5她一死立刻出现组织真空。\n\n"},{"citation":{"byte_range":[35028,35195],"lines":[867,869],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"2369b960bd77349ce3570b4f2bfdac3cb767cd2a7937d9803939fb138c0e688b"},"name":"四链","number":11,"text":"**11｜四链**  \nE2：宝玉获释不带来钱，凤死立刻要钱。物链从热饭/水转到白布/灯/棺/遗物；信息上释放小喜立即被病危压过。\n\n"},{"citation":{"byte_range":[35618,35900],"lines":[885,888],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"b024aef7267d8e0f55de72f25a39d4a76cd408f26c09300906dd304dd185b6b3"},"name":"章法 / 风险","number":18,"text":"**18｜章法 / 风险**  \n释放 → 回家吃热饭 → 看凤姐 → 最后一件具体管事 → 身体退出 → 死 → 丧务组织真空 → 平儿留下陪巧姐又被现实叫走。  \n**风险：**死亡压过宝玉获释或反之；需保持“双恢复/双退出”。\n\n"}],"seed":{"path":"data/prewrite/v06.json","pointer":"/omitted_scene_plans/12/candidate_scenes/1","ref":"data/prewrite/v06.json#/omitted_scene_plans/12/candidate_scenes/1","sha256":"caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff","text_sha256":"5f7b76e98e5b1bb3596972268105a9bdace1cdafe6f011c259f32ebc1f208a4a","value":{"id":"93-S2","title":"回家第一件事不是谈案，是吃饭洗手换衣"}},"world_records":[{"path":"data/world/m3_core.json","pointer":"/events/10","ref":"data/world/m3_core.json#/events/10","sha256":"c4bf1c75fda8994fd846e570a64ae69efeb6ca17cd27e78c1bb1af4d7783d733","text_sha256":"d680d4cba780dc6f288c27e8d9c10919b42b5b7d41e9bc211eee23ffe30948fd","value":{"chapter":93,"effects":[{"set":"characters.baoyu.legal_status","value":"RELEASED_NO_RESTORATION"},{"set":"characters.baoyu.location","value":"S06"},{"set":"characters.baoyu.body_state","value":"post_detention_recovery"},{"set":"characters.fengjie.life_state","value":"DEAD"},{"set":"characters.fengjie.body_state","value":"DEAD_AFTER_CHRONIC_DECLINE"},{"set":"relations.rel:fengjie_ping.status","value":"ENDED_BY_DEATH"},{"set":"relations.rel:fengjie_qiaojie.status","value":"ENDED_BY_DEATH"},{"set":"characters.ping_er.household_role","value":"qiaojie_protection_executor"}],"epistemic":"CURRENT_C_WORLD","id":"W93-RELEASE-FENGJIE-DEATH","sequence":70,"source_refs":["R29"]}},{"path":"data/world/m3_presence.json","pointer":"/presence_matrix/12","ref":"data/world/m3_presence.json#/presence_matrix/12","sha256":"7880480b001c321e50056e887f1285f6c7ccf975aed140d1515967ea925bb3bb","text_sha256":"cb90885aabcd46c87ed3a26ea18146efc688dfd1f9b8a77aa263351adcaa60f3","value":{"chapter":93,"epistemic":"LITERARY_CONSTRUCTION_RESOURCE","forbidden_note":"小红茜雪退回正常生活，不长期挂在主线","main_source":"宝玉、凤姐、平儿、麝月、宝钗","natural_source":"贾琏、巧姐、贾芸、王夫人、贾母","source_ref":"asset:sha256:30a6ecd37a4f3e846a72ef3cd445ba78db902fa788d45ee7cd3d73d86eb4df32","state_change":"宝玉回家；凤姐死亡；平儿转入巧姐保护位"}}]},"id":"93-S2-R3","scope":"CURRENT_IMPLEMENTATION_REQUIREMENT_NOT_HISTORICAL_FACT","status":"PENDING"},{"description":"实际放行过门、到借院并先吃热粥后、凤姐死亡前，承接从92迁入的唯一原二句：“门里十日，只知饭冷灯昏；门外一程，才觉人间路窄。”不新增人物诗或作者韵文，不当作获释颂、全案结论或凤姐挽诗。","editorial_override":{"authority_effect":"NONE","decision":{"path":"artifacts/agent_research/v4-revision-20261026/design-decisions.json","sha256":"e313f1fa19d9f48322ced01e1dc8fdd277c1aab112c73a16a6cdab0e2474af83"},"original_placement":"92-S6-R2及其原章卡grounding，未将原章卡伪称为93位置依据"},"id":"93-S2-R4","scope":"CURRENT_IMPLEMENTATION_REQUIREMENT_NOT_HISTORICAL_FACT","status":"PENDING"}],"required_objects":[],"revision":"v3","schema_version":1,"status":"AGENT_EDITED","unresolved":["agent_edit_and_semantics: AGENT_EDITED仅表示基于实际v1及绑定包完成当前模型编辑；非人类、非独立盲审、非合资格历史鉴定，正文/同行语义NOT_CHECKED，authority/evidence均NONE。","scene_chronology: 前驱只声明SOURCE_LIST_ORDER_NOT_VERIFIED_CHRONOLOGY的源列表次序，不证明历史原稿或场内时序。","entry_checkpoint: 后续场无可执行局部入口；不从相邻合同或章末快照注入前场结果。","implementation_gap: 热粥、洗手水、换下衣物没有对象ID；不把监所送物包当成家中饭食或凭空补钱。","entry_state: character.baoyu.location — 前场释放手续与到S06借院的实际走行未建立本场入口记录。","preconditions: character.baoyu.legal_status — 本场不是章初；上场待写释放出口未通过独立场级核验。","exit_state: character.baoyu.body_state — 吃热粥洗手换衣是恢复过程，不等于W93的post_detention_recovery已在本场验证或完全康复。","exit_state: character.baoyu.knowledge.baoyu_detention_whole_case — 回院生活动作和家人接待不是完整案情来源；无本场知识更新，不由获释叙述补全知。","parallel_message_timing: 病危来源/来报与各人听闻時点未注册；笑话与死亡消息切换待核。","participants_scope: 具名角色为待写集合非已验证实际在场，v1的KNOWN集合降为PENDING。","ROOT_V4_C_EDITORIAL_PLACEMENT: 原章卡把唯一正是二句置于92；本轮因实际离监及归家发生在93，将同一原句迁至93-S2吃热粥后、凤姐死亡前。不是原章卡已有此安排，不新增诗、不更改W93、世界入口或历史证据。"]},"data/planning/contracts/agent-final-v1/93-S3.v2.json":{"authority_effect":"NONE","bindings":{"chapter_plan":{"path":"data/planning/chapters/ch93.json","sha256":"515ed9ce4f4aa83ba37ed0124f4ac31303b4fb375279500a0951cf74019301ce"},"seed":{"path":"data/planning/scenes/93-S3.json","sha256":"653b3f35e1a53d795316e9d845907667dd5508f7be78b932923a11a69a6e9732"},"source_packet":{"path":"artifacts/agent_research/phase5/inputs/contract-packet-91-95.json","sha256":"7a044fc4b0b30b9fa3f694714dbe79519af88ff6318819e74a3f38a2e0016816"},"world":{"inputs":[{"path":"data/project/scope.json","sha256":"ecd0c76ea442f5538a3bd5d12f1f3e33d0243318032b5c0446789fb5fdb91dbe"},{"path":"data/world/m3_core.json","sha256":"c4bf1c75fda8994fd846e570a64ae69efeb6ca17cd27e78c1bb1af4d7783d733"},{"path":"data/world/m3_locations.json","sha256":"ed1a4053f1459193777f486b3a9743c5aec28afb7d027dee12684da6e3a9d81b"},{"path":"data/world/m3_presence.json","sha256":"7880480b001c321e50056e887f1285f6c7ccf975aed140d1515967ea925bb3bb"},{"path":"data/world/m3_body.json","sha256":"429ca248ea42aa0601e11a55d40fa446da92cee48936627a83b335ab9b18056e"},{"path":"data/world/m3_resources.json","sha256":"b823f72594d4a2af2216525cbfd3411b00d41c4ad0fa89830348933be6de7668"},{"path":"data/world/m3_knowledge.json","sha256":"d8ee374ec667317af6ef304dc4b66ad7d3ceae9f20753c1b35cf029c73dee18b"},{"path":"data/objects/m4.json","sha256":"5c2719605b0d2b78d3c06d6bb7444c5c5058fd3891879f8dcfa480cd1828b4db"},{"path":"data/knowledge/v03_slice2.json","sha256":"37db9f32aad64636f33eb70a73130160260914e8a4ca987e03f6c45170fa88e7"},{"path":"data/objects/medicine_bowl.yaml","sha256":"ad304b16d955e904b6de156bf88c38f51f0d552698bb7f2ff6ba07bb5572d361"}],"status":"BOUND"}},"chapter":93,"chapter_plan_ref":"data/planning/chapters/ch93.json","entry_checkpoint":{"chapter":null,"kind":"UNKNOWN"},"entry_from":"data/planning/scenes/93-S2.json","entry_state":[{"basis":[],"equals":"character.fengjie.body_state","reason":"W90仅有old_illness_worsening_under_labor；未注册临终末段的场级入口，不能从死亡结果反填。","status":"UNKNOWN","value":null}],"event_refs":[],"evidence_effect":"NONE","exit_state":[{"basis":[],"equals":"character.fengjie.body_state","reason":"医者判断、空药吊子与末段照料没有独立状态效果；不把待写病危宣告当作已验证身体值。","status":"UNKNOWN","value":null}],"forbidden_beats":[{"description":"不得玄奇吐血、另造绝症、病中审判梦或报应裁决；怕、命、报只可作人物有限言语。","grounding":{"chapter_card_fields":[{"citation":{"byte_range":[34847,34948],"lines":[861,863],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"e01b0ebcdf52c8b45fec3c1903ab60916809614e63b39ebee8621c0cc1d6142b"},"name":"宗教/梦","number":9,"text":"**9｜宗教/梦**  \n凤姐可说怕、命、报，但不作报应裁决；不写病中审判梦。\n\n"},{"citation":{"byte_range":[35305,35394],"lines":[873,875],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256":"158fbb0475de9d26e0e0da1d16bf66bd596fe74f12f70bdec0deb8de8d64eff6"},"name":"应删","number":13,"text":"**13｜应删**  \n凤姐“机关算尽”自我总结、玄奇吐血、恢弘大丧。\n\n"}],"seed":{"path":"data/prewrite/v06.json","pointer":"/omitted_scene_plans/12/candidate_scenes/2","ref":"data/prewrite/v06.json#/omitted_scene_plans/12/candidate_scenes/2","sha256":"caaa49d2f61760be27df0c9cbbc00433b6d54999199e08caec8260c8b15287ff","text_sha256":"f5987f8a4544b4f1f3ad54a53c6171a89dc2dd1c6b222efb75c3c13cf1fa5e99","value":{"id":"93-S3","title":"凤姐病势在宝玉回来前已进入末段"}}},"id":"93-S3-F1","scope":"CURRENT_IMPLEMENTATION_REQUIREMENT_NOT_HISTORICAL_FACT","status":"PENDING"},{"description":"不得加入凤姐临终诗、忏悔文、作者挽诗或文化补景。","grounding":{"chapter_card_fields":[{"citation":{"byte_range":[34607,34637],"lines":[852,854],"path":"sources/project/cea77d0ec8777a39/81—100_二十回全幅补完卡_v2.6_引用标识修复版.md","sha256":"cea77d0ec8777a39b5a36f77c1eebf9638c208ba6cb8b71e083908d7f6e3c99c","text_sha256"