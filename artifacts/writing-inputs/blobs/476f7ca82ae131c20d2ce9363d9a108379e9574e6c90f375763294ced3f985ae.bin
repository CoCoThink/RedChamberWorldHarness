{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ExtractionConfig",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "encoding", "normalization", "newline_conversion", "markup_breaks"],
  "properties": {
    "format": {"enum": ["PDF", "EPUB", "HTML", "TEXT"]},
    "encoding": {"const": "utf-8"},
    "normalization": {"const": "NONE"},
    "newline_conversion": {"const": "NONE"},
    "markup_breaks": {"const": "BR_TO_LF"},
    "pdf_pages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}}
  },
  "allOf": [{"if": {"required": ["pdf_pages"]}, "then": {"properties": {"format": {"const": "PDF"}}}}]
}
