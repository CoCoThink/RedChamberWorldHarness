          }
        ]
      }
    },
    {
      "id": "85-S3-R3",
      "description": "照护之间仍容黛玉闲谈、嫌闷与普通明日看旧集的语气，紫鹃起居纸和夜醒继续，不能让全场只剩医生与病人。",
      "status": "PENDING",
      "scope": "AUTHORING_REQUIREMENT_NOT_HISTORICAL_FACT",
