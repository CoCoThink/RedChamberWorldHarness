十九回"},{"end":32,"raw_start":439,"start":15,"tag":"h2","text":"享福人福深还祷福　痴情女情重愈斟情"}],"member_sha256":"da13fbb1ebe0d975b10f64438e0f7154d2a2ce54ddfd12fce00f8b08de82378b","order":35,"unit_ref":"epub:OEBPS/Text/part0033.xhtml"},{"chapter":30,"headings":[{"end":10,"raw_start":379,"start":6,"tag":"h3","text":"第三十回"},{"end":31,"raw_start":437,"start":14,"tag":"h2","text":"宝钗借扇机带双敲　龄官划蔷痴及局外"}],"member_sha256":"488d573932d120dafb5dc8935821e63afebe3838fbefb18bc9fb80d865653706","order":36,"unit_ref":"epub:OEBPS/Text/part0034.xhtml"},{"chapter":31,"headings":[{"end":11,"raw_start":380,"start":6,"tag":"h3","text":"第三十一回"},{"end":32,"raw_start":439,"start":15,"tag":"h2","text":"撕扇子作千金一笑　因麒麟伏白首双星"}],"member_sha256":"2afc7fbb006868d54c69862bb5726fde73ad9c32c332d08de828b77f41366fd7","order":37,"unit_ref":"epub:OEBPS/Text/part0035.xhtml"},{"chapter":32,"headings":[{"end":11,"raw_start":380,"start":6,"tag":"h3","text":"第三十二回"},{"end":32,"raw_start":439,"start":15,"tag":"h2","text":"诉肺腑心迷活宝玉　含耻辱情烈死金钏"}],"member_sha256":"3464983cc9f0b46e67c2e3063033d4a5f184179f6b4fb083a34d5408c7743822","order":38,"unit_ref":"epub:OEBPS/Text/part0036.xhtml"},{"chapter":33,"headings":[{"end":11,"raw_start":380,"start":6,"tag":"h3","text":"第三十三回"},{"end":32,"raw_start":439,"start":15,"tag":"h2","text":"手足耽耽小动唇舌　不肖种种大承笞挞"}],"member_sha256":"b5565ba4eae952a9a75d174023b422caa21839e7c86ab501348b0ea8ffc4f2aa","order":39,"unit_ref":"epub:OEBPS/Text/part0037.xhtml"},{"chapter":34,"headings":[{"end":11,"raw_start":380,"start":6,"tag":"h3","text":"第三十四回"},{"end":32,"raw_start":439,"start":15,"tag":"h2","text":"情中情因情感妹妹　错里错以错劝哥哥"}],"member_sha256":"bd2008a5b01c5e0773d4a66e217311bfaf82121b7a99ab5774a4417d1787b3c0","order":40,"unit_ref":"epub:OEBPS/Text/part0038.xhtml"},{"chapter":35,"headings":[{"end":11,"raw_start":380,"start":6,"tag":"h3","text":"第三十五回"},{"end":32,"raw_start":439,"start":15,"tag":"h2","text":"白玉钏亲尝莲叶羹　黄金莺巧结梅花络"}],"member_sha256":"4bace666c6db869b64e6771acc86b1a0823b9878e94c923c49c172ed9ee4c178","orde