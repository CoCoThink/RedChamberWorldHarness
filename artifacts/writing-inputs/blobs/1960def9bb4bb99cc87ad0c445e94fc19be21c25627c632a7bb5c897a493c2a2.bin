start":6,"tag":"h3","text":"第十六回"},{"end":31,"raw_start":437,"start":14,"tag":"h2","text":"贾元春才选凤藻宫　秦鲸卿夭逝黄泉路"}],"member_sha256":"1c1667daef4b8a4968d3a7fd359493a877cb99a6fc36ed6efcd9f3b173e0b41c","order":22,"unit_ref":"epub:OEBPS/Text/part0020.xhtml"},{"chapter":17,"headings":[{"end":10,"raw_start":379,"start":6,"tag":"h3","text":"第十七回"},{"end":31,"raw_start":437,"start":14,"tag":"h2","text":"大观园试才题对额　荣国府归省庆元宵"}],"member_sha256":"3b7fd2ce70fd49d509bd2d432aa0bbb380fbbaa49f7e08413d548336c0a71e26","order":23,"unit_ref":"epub:OEBPS/Text/part0021.xhtml"},{"chapter":18,"headings":[{"end":10,"raw_start":382,"start":6,"tag":"h3","text":"第十八回"},{"end":34,"raw_start":440,"start":14,"tag":"h2","text":"大观园试才题对额　荣国府归省庆元宵（续）"}],"member_sha256":"4d9b71c025373e2111ecddf45d0d4a3f9ada6b647161dc1a900e8207b366222f","order":24,"unit_ref":"epub:OEBPS/Text/part0022.xhtml"},{"chapter":19,"headings":[{"end":10,"raw_start":379,"start":6,"tag":"h3","text":"第十九回"},{"end":32,"raw_start":437,"start":14,"tag":"h2","text":"情切切良宵花解语　意绵绵静日玉生香①"}],"member_sha256":"f9b2ec5c704e25bbb68623a9b6db81f29759f7f9b9e237001758d577342807ac","order":25,"unit_ref":"epub:OEBPS/Text/part0023.xhtml"},{"chapter":20,"headings":[{"end":10,"raw_start":379,"start":6,"tag":"h3","text":"第二十回"},{"end":31,"raw_start":437,"start":14,"tag":"h2","text":"王熙凤正言弹妒意　林黛玉俏语谑娇音"}],"member_sha256":"4fdb07e18b04e85550aea18902412b330665a513422c93358d62f4b86ff30bfe","order":26,"unit_ref":"epub:OEBPS/Text/part0024.xhtml"},{"chapter":21,"headings":[{"end":11,"raw_start":380,"start":6,"tag":"h3","text":"第二十一回"},{"end":36,"raw_start":439,"start":15,"tag":"h2","text":"贤袭人当得起。娇嗔箴宝玉　俏平儿软语救贾琏"}],"member_sha256":"f7b1b1bda1e8a654027a01423049aca955d70d6c3acfc5d9d6987861bbac6589","order":27,"unit_ref":"epub:OEBPS/Text/part0025.xhtml"},{"chapter":22,"headings":[{"end":11,"raw_start":380,"start":6,"tag":"h3","text":"第二十二回"},{"end":32,"raw_start":439,"start":15,"tag":"h2","text":"听曲文宝玉悟禅机　制灯谜贾政悲谶语"}],"member_sha256":"8632b46383c52d71dcdb1989dc0aae36a0627