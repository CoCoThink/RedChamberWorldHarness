t/part0006.xhtml"},{"chapter":3,"headings":[{"end":9,"raw_start":379,"start":6,"tag":"h3","text":"第三回"},{"end":31,"raw_start":436,"start":13,"tag":"h2","text":"金陵城起复贾雨村　荣国府收养*林黛玉"}],"member_sha256":"6ccd05831a814d394e812abef92d59d7d62f6aaf8bba64cd907bd3a88e9ff85f","order":9,"unit_ref":"epub:OEBPS/Text/part0007.xhtml"},{"chapter":4,"headings":[{"end":9,"raw_start":378,"start":6,"tag":"h3","text":"第四回"},{"end":30,"raw_start":435,"start":13,"tag":"h2","text":"薄命女偏逢薄命郎　葫芦僧乱判葫芦案"}],"member_sha256":"4752d187a1583bc8eecd8a182b4a722a3941dbf7a759425dcdb57be8e8b3ba3b","order":10,"unit_ref":"epub:OEBPS/Text/part0008.xhtml"},{"chapter":5,"headings":[{"end":9,"raw_start":378,"start":6,"tag":"h3","text":"第五回"},{"end":30,"raw_start":435,"start":13,"tag":"h2","text":"开生面梦演红楼梦　立新场情传幻境情"}],"member_sha256":"39554e4ef128d57918725571ce201ac0e9b3586b908f61848cd112c85a6ba8a8","order":11,"unit_ref":"epub:OEBPS/Text/part0009.xhtml"},{"chapter":6,"headings":[{"end":9,"raw_start":378,"start":6,"tag":"h3","text":"第六回"},{"end":30,"raw_start":435,"start":13,"tag":"h2","text":"贾宝玉初试云雨情　刘姥姥一进荣国府"}],"member_sha256":"c27466bb439c5baeb813397caec29c7d8dc3b915a8b2ae63752f64f90268c1dd","order":12,"unit_ref":"epub:OEBPS/Text/part0010.xhtml"},{"chapter":7,"headings":[{"end":9,"raw_start":378,"start":6,"tag":"h3","text":"第七回"},{"end":30,"raw_start":435,"start":13,"tag":"h2","text":"送宫花周瑞叹英莲　谈肄业秦钟结宝玉"}],"member_sha256":"5e39f40917e682020afd29bd937cf6a8d7578baf4151702b59e4308e2b9c219b","order":13,"unit_ref":"epub:OEBPS/Text/part0011.xhtml"},{"chapter":8,"headings":[{"end":9,"raw_start":378,"start":6,"tag":"h3","text":"第八回"},{"end":30,"raw_start":435,"start":13,"tag":"h2","text":"薛宝钗小恙梨香院　贾宝玉大醉绛芸轩"}],"member_sha256":"6c4462304190bbfd398f6ff5637e89b719f1c7f5ce8da32fd2631368b36a53e9","order":14,"unit_ref":"epub:OEBPS/Text/part0012.xhtml"},{"chapter":9,"headings":[{"end":9,"raw_start":378,"start":6,"tag":"h3","text":"第九回"},{"end":30,"raw_start":435,"start":13,"tag":"h2","text":"恋风流情友入家塾　起嫌疑顽童闹学堂"}],"member_sha25