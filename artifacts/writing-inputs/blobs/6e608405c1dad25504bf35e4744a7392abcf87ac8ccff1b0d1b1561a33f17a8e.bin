schema_version: 1
decisions:
- id: decision:future-title:baochai-fengjie:wording
  statement: 未来完整题目“薛宝钗借词含讽谏，王熙凤知命强英雄”作为T0硬锚保留原字。
  based_on:
  - claim:future-title:baochai-fengjie:full-heading
  status: LOCKED
  constraint: MUST
  reversible: false
  implementation_refs:
  - impl:active:ch90:title
- id: decision:future-title:baochai-fengjie:placement
  statement: 当前100回工作模型将该T0题目安置在第90回；回次是PC工作安置。
  based_on:
  - claim:future-title:baochai-fengjie:full-heading
  - claim:future-title:baochai-fengjie:chapter-90
  status: CURRENT
  constraint: MAY
  reversible: true
  implementation_refs:
  - impl:active:ch90:title
- id: decision:xiren:heading-part
  statement: “花袭人有始有终”作为T1正文标目局部原字必须保留。
  based_on:
  - claim:xiren:future-heading-part
  status: LOCKED
  constraint: MUST
  reversible: false
  implementation_refs:
  - impl:active:ch88:title
- id: decision:xiren:full-heading
  statement: “花袭人有始有终”所在回目的另一半及完整正式回目保持开放。
  based_on:
  - claim:xiren:full-heading
  status: OPEN
  constraint: OPEN
  reversible: true
- id: decision:xiren:placement
  statement: 当前将“花袭人有始有终”安置在第88回；具体回次不是源证。
  based_on:
  - claim:xiren:future-heading-part
  - claim:xiren:chapter-88
  status: CURRENT
  constraint: MAY
  reversible: true
  implementation_refs:
  - impl:active:ch88:title
- id: decision:prison:comfort-baoyu:formal-title
  statement: “狱神庙慰宝玉”只按T2稿件称呼保存；是否为正式原回目保持开放。
  based_on:
  - claim:prison:comfort-baoyu:formal-title
  status: OPEN
  constraint: OPEN
  reversible: true
- id: decision:prison:comfort-baoyu:placement
  statement: 当前相关狱中功能安置在第92回；该回次是工作安置。
  based_on:
  - claim:prison:comfort-baoyu:draft-label
  - claim:prison:comfort-baoyu:chapter-92
  status: CURRENT
  constraint: MAY
  reversible: true
  implementation_refs:
  - impl:active:ch92:title
- id: decision:mistaken-theft:interface
  statement: 当前复原必须保留“误窃”这一未来回称所指的误取/误窃功能接口。
  based_on:
  - claim:mistaken-theft:chapter-call
  status: LOCKED
  constraint: MUST
  reversible: false
- id: decision:mistaken-theft:formal-title
  statement: “误窃”是否为正式原回目文字保持开放。
  based_on:
  - claim:mistaken-theft:formal-title
  status: OPEN
  constraint: OPEN
  reversible: true
- id: decision:mistaken-theft:placement
  statement: 当前将“误窃”功能与第98回送玉线复合实现；具体回次不是源证。
  based_on:
  - claim:mistaken-theft:chapter-call
  - claim:mistaken-theft:chapter-98
  status: CURRENT
  constraint: MAY
  reversible: true
  implementation_refs:
  - impl:active:ch98:title
- id: decision:cold-winter-torn-felt:event
  statement: 当前复原必须兑现“寒冬噎酸虀，雪夜围破毡”所指的后部贫寒生活功能。
  based_on:
  - claim:cold-winter-torn-felt:event
  status: LOCKED
  constraint: MUST
  reversible: false
- id: decision:cold-winter-torn-felt:formal-title
  statement: “寒冬噎酸虀，雪夜围破毡”不是由现有证据锁定的正式原回目，标题身份保持开放。
  based_on:
  - claim:cold-winter-torn-felt:formal-title
  status: OPEN
  constraint: OPEN
  reversible: true
- id: decision:cold-winter-torn-felt:placement
  statement: 当前100回工作模型将该贫寒功能集中安置在第95回；回次是工作安置。
  based_on:
  - claim:cold-winter-torn-felt:event
  - claim:cold-winter-torn-felt:chapter-95
  status: CURRENT
  constraint: MAY
  reversible: true
  implementation_refs:
  - impl:active:ch95:title
