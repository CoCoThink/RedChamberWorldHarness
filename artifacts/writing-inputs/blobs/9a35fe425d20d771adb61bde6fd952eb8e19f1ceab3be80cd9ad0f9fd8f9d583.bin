{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AssetReadingCollection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "purpose",
    "members"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "pattern": "^collection:[a-zA-Z0-9._:-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "purpose": {
      "type": "string",
      "minLength": 1
    },
    "members": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^asset:[a-zA-Z0-9._:-]+$"
      }
    }
  }
}
