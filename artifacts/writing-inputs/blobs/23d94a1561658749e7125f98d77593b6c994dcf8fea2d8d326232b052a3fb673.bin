  "required_beats": [
    {
      "id": "97-S4-R1",
      "description": "本v2选定待实现编排接口：先三线饭段（湘云份饭／妙玉粥／惜春菜），再三线衣段（若兰旧衣／灰衣／退衣），再三线纸段（信／经卷／黄纸）。复用97-S1—S3已列动作，不新造第四次联合场景；种子order保留索引，不将三线完整块线性执行后补一段总结。",
      "status": "PENDING",
      "scope": "AUTHORING_REQUIREMENT_NOT_HISTORICAL_FACT",
      "grounding": {
