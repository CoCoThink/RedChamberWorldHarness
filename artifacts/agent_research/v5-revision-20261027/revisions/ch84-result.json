257ea420d7fbc06222fbb782454c5"},"draft":{"path":"data/writing/drafts/ch84/d2fbab28f849c9f39876b5e3d9c7eded00587f5ef076c9dd9e0b792b4a4532ca.json","sha256":"d2fbab28f849c9f39876b5e3d9c7eded00587f5ef076c9dd9e0b792b4a4532ca"},"package":{"path":"data/writing/packages/ch84-agent-research-v4.json","sha256":"2ea6eba0a2e431124e77e9f03ee3fa093ca60376e525d7f7ee1471ddc7a961ea"},"role":"REVISER","run":{"path":"artifacts/author-runs/c8dca32f55cf64b8ccf61abd85133a611fa9ad3f77235f0338c146f681e218ac.json","sha256":"c8dca32f55cf64b8ccf61abd85133a611fa9ad3f77235f0338c146f681e218ac"}}],"verification":"RETAINED_RECORD_BYTES_AND_AUTHOR_RUN_BINDINGS"},"chapter":84,"current":{"candidate":{"path":"artifacts/candidates/ch84/74c7f20069286df42dc4fbee3558420ea84ed99b304782d90b00a45446fe7c4a.txt","sha256":"74c7f20069286df42dc4fbee3558420ea84ed99b304782d90b00a45446fe7c4a"},"chapter":84,"draft":{"path":"data/writing/drafts/ch84/33568dafafcda1f2629395f5f7e824ddcebfbfd660ea7df24c904869a74f3019.json","sha256":"33568dafafcda1f2629395f5f7e824ddcebfbfd660ea7df24c904869a74f3019"},"minimum_baseline_ratio":0.8,"minimum_body_characters":7000,"plock_ref":"NONE","policy":{"path":"data/promotion/policies/agent/ch84.v1.json","sha256":"7659b162ddf548285bb7c53f6062407bdba710f3185a4b1e406a7792d962a866"},"rebind_receipt":{"path":"data/agent_release/rebind-v4/receipts/ch84.json","sha256":"2a9939b4c6b8b1d4b7b29455818f1b70714863e7a96d9612fd6e368078cd7e48"},"writing_package":{"path":"data/writing/packages/ch84-agent-research-v4.json","sha256":"2ea6eba0a2e431124e77e9f03ee3fa093ca60376e525d7f7ee1471ddc7a961ea"}},"diff":"--- v4-r4\n+++ v5\n@@ -86,7 +86,7 @@\n \n 过了数日，家里办差的人渐渐知道该往哪里问，门上不再一听有人来便几路往里跑。偏厅仍留接话的地方，客人到了，先将来意回明；先前预备的宴席始终没再摆，厨下每日照常开火，另将各房要的清淡饭食分好。凤姐仍不许经手人把家中安排全说成宫令。一天有人拿着传话来问细服制，她叫先把来路说明，听是旁人看邻府怎样便跟着学的，便让退回去等，莫替全家凭空定礼。\n \n-宫中正式服制的条目，府里还在候可照办的交代；谁在什么时辰亲接、应服到何时，来回问的人并没有带进一套明白话。王夫人问过，凤姐便将门上回的照实说，不拿已经换上的素衣作答。平儿把经手衣料的人叫来，也只让按家中现需接着做，若有正式新话，须另传，不许从旧吩咐里自己添。有人想把做喜活的旧单找出来，问先定在后头的事还排不排，凤姐抬手让收回，道：“眼下丧里，旧的先搁下，别照原日子催。到该再议的时候，再回主子。”那张纸便又压回别单下面，没有换上一个新日子。\n+宫中正式服制的条目，起初还没有送齐。王夫人问过，凤姐便将门上回的照实说，不拿已经换上的素衣作答。又过两日，贾政从外头带回本家应守的服次，叫跟出去的人在王夫人跟前读明白，才交各处照办。针线房原来拿不准的几件衣裳，领回去重做；王夫人翻着历，将各人应守到的日子记在旁边。有人拿做喜活的旧单来问，凤姐抬手叫收回，道：“服还没守完，就照旧日子催起来了？先搁着。”那张纸便压回别单下面，没有换上一个新日子。\n \n 白布素料从库里领出，掌针线的媳妇亲点给接手的人，剩下的折妥还回，不让散在各房自行裁剪。管事回说须添的仍能置办，只问由谁领，凤姐叫平儿同原经手的接清，钱仍从家里支，不许一件衣裳让几个人各买一遍。平儿往针线房走时，那个曾把整盒封起的小丫头正收红线，见她来，先把余下要用的针包拿到明处。平儿瞧见，没再提那一回，只让她把送太太的衣裳另包，自己等着带走。\n ","editorial_notes":{"path":"artifacts/agent_research/v5-revision-20261027/revisions/ch84-editorial-notes.json","sha256":"ccfab22cc5b11ad5a0bc3dd0d8c6cdf7f31b08b817a3fa2fe5af554bd0a73bba"},"import":{"authority_effect":"NONE","candidate":{"path":"artifacts/candidates/ch84/74c7f20069286df42dc4fbee3558420ea84ed99b304782d90b00a45446fe7c4a.txt","sha256":"74c7f20069286df42dc4fbee3558420ea84ed99b304782d90b00a45446fe7c4a"},"draft":{"path":"data/writing/drafts/ch84/33568dafafcda1f2629395f5f7e824ddcebfbfd660ea7df24c904869a74f3019.json","sha256":"33568dafafcda1f2629395f5f7e824ddcebfbfd660ea7df24c904869a74f3019"},"execution_basis":"SESSION_AUTHORED_NOT_PROVIDER_VERIFIED","formal_eligibility":false,"human_qualification":false,"input_snapshot":{"path":"artifacts/writing-inputs/manifests/8b96de9258fb47342f10c5c0e32fd28863d66752c3fe22590dd06d3ffa0aa753.json","sha256":"8b96de9258fb47342f10c5c0e32fd28863d66752c3fe22590dd06d3ffa0aa753"},"prepared_request":{"path":"artifacts/writing-requests/c454d395eb5e5e675a40ea8ea184d33f57b7a0ac46900b60452d1906089b53d2.json","sha256":"c454d395eb5e5e675a40ea8ea184d33f57b7a0ac46900b60452d1906089b53d2"},"qualification":"RESEARCH_ONLY","run":{"path":"artifacts/author-runs/6fbe4d15d8a474a74f46fd16a23a0c8a56568761ddb2f29c979c6a9943e62342.json","sha256":"6fbe4d15d8a474a74f46fd16a23a0c8a56568761ddb2f29c979c6a9943e62342"},"session_configured_model":{"basis":"UNVERIFIED_DECLARATION","label":"current agent environment; root actual v5 editor"},"status":"PASS"},"peer_review":"PENDING_NEW_INPUT_CI_AND_NEW_READERS","previous":{"candidate":{"path":"artifacts/candi