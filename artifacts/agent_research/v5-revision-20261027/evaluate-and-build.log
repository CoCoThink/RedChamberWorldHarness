n                \"subject_id\": \"contract-86-4\",\n                \"subject_sha256\": \"3e1ee138428507bf37bd6a71a4c915f6c1a9b06dc1e2c35423653cf72434bac8\",\n                \"verdict\": \"PASS\",\n                \"severity\": \"INFO\"\n              }\n            ],\n            \"findings\": [],\n            \"advisories\": [],\n            \"superseded_opinions\": [],\n            \"prior_context_opinions\": [\n              {\n                \"record\": {\n                  \"path\": \"data/agent_panel/records/81bf63b4bc4e43dc52ab39f23b4493f5a14213b9ab78b0fb0babe0c545c81b92.json\",\n                  \"sha256\": \"81bf63b4bc4e43dc52ab39f23b4493f5a14213b9ab78b0fb0babe0c545c81b92\"\n                },\n                \"raw_output\": {\n                  \"path\": \"data/agent_panel/raw/67d41ba2898273cc5aa4c616137fce76b356fec0a90fc44919c0a8349f56a756.json\",\n                  \"sha256\": \"67d41ba2898273cc5aa4c616137fce76b356fec0a90fc44919c0a8349f56a756\"\n                },\n                \"packet\": {\n                  \"path\": \"data/agent_release/review-packets/481ed26abbef59e7bbd614c98662be63cc3890f55ba557e4ed6bb924e9275a1f.json\",\n                  \"sha256\": \"481ed26abbef59e7bbd614c98662be63cc3890f55ba557e4ed6bb924e9275a1f\"\n                },\n                \"same_packet_context\": false,\n                \"reviewer\": {\n                  \"context_isolation\": {\n                    \"asserted\": true,\n                    \"verification\": \"NOT_PROVEN\"\n                  },\n                  \"id\": \"14b2b99a3a10:CHAPTER-86-011-r2\",\n                  \"kind\": \"MODEL_SUBAGENT\",\n                  \"model\": {\n                    \"label\": \"current agent environment (declared)\",\n                    \"verification\": \"DECLARED_NOT_VERIFIED\"\n                  },\n                  \"session_id\": \"review:14b2b99a3a10:CHAPTER-86-011-r2:1\"\n                },\n                \"notes\": \"已完整读取86-S4.v2并核对分派哈希；entry_from所指86-