-v4.json\",\n                    \"sha256\": \"c7c047c2d707e1686bc07395f5ef2ea2023d5367ff07a24e060ddd2d6d75c8a8\"\n                  },\n                  {\n                    \"path\": \"data/promotion/policies/agent/ch97.v1.json\",\n                    \"sha256\": \"d3fa729bf41a9938e8a25a441c840e04285f4ee714631983bfebc2ece32053a7\"\n                  }\n                ]\n              },\n              {\n                \"record\": {\n                  \"path\": \"data/agent_panel/records/e9029898d7d19c300a78d74a16b6f51439c0e6228df69ae18b49811ab3241676.json\",\n                  \"sha256\": \"e9029898d7d19c300a78d74a16b6f51439c0e6228df69ae18b49811ab3241676\"\n                },\n                \"raw_output\": {\n                  \"path\": \"data/agent_panel/raw/0cb543a945ab4d1b2a2bc4b2da12593e192f2e2bdb26420c18a5b995998c01df.json\",\n                  \"sha256\": \"0cb543a945ab4d1b2a2bc4b2da12593e192f2e2bdb26420c18a5b995998c01df\"\n                },\n                \"packet\": {\n                  \"path\": \"data/agent_release/review-packets/ca7776b23c8ef932938942a4225495c2efe23a8712a2e408d8d57bdc3ac7e587.json\",\n                  \"sha256\": \"ca7776b23c8ef932938942a4225495c2efe23a8712a2e408d8d57bdc3ac7e587\"\n                },\n                \"same_packet_context\": false,\n                \"reviewer\": {\n                  \"context_isolation\": {\n                    \"asserted\": true,\n                    \"verification\": \"NOT_PROVEN\"\n                  },\n                  \"id\": \"14b2b99a3a10:CHAPTER-97-045-r2\",\n                  \"kind\": \"MODEL_SUBAGENT\",\n                  \"model\": {\n                    \"label\": \"current agent environment (declared)\",\n                    \"verification\": \"DECLARED_NOT_VERIFIED\"\n                  },\n                  \"session_id\": \"review:14b2b99a3a10:CHAPTER-97-045-r2:1\"\n                },\n                \"notes\": \"完整读取97-S3.v2，文件SHA256符合分派。R1已住惯在宝玉到访前成立：15行识砖路、17行惯常碗位、19行抄经，