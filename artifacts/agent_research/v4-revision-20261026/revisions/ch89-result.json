"authors":[{"kind":"MODEL","principal_id":"session:coordinator-edit-20261025:ch89","run":{"path":"artifacts/author-runs/4e99bf438ac525e4d1c7c9fbb71cafeff3bb65f1f3bd2d274f1f4b5223ac0362.json","sha256":"4e99bf438ac525e4d1c7c9fbb71cafeff3bb65f1f3bd2d274f1f4b5223ac0362"},"source_id":"session-author:4e99bf438ac525e4d1c7c9fbb71cafeff3bb65f1f3bd2d274f1f4b5223ac0362"}],"candidate":{"path":"artifacts/candidates/ch89/5e785850e44d5cd53f7a48582ff0939625d045f8861cd973b5e6d8cb9c93e3af.txt","sha256":"5e785850e44d5cd53f7a48582ff0939625d045f8861cd973b5e6d8cb9c93e3af"},"draft":{"path":"data/writing/drafts/ch89/a637e9fe016ca4ce842faa0b4b0c3957387c140f98072328ceac4f49a6c0d284.json","sha256":"a637e9fe016ca4ce842faa0b4b0c3957387c140f98072328ceac4f49a6c0d284"},"package":{"path":"data/writing/packages/ch89-agent-research-v4.json","sha256":"7398fd59bc43c949c4dca161d49c043b6f8b8726065daaaca1a8c1e0e6e1d824"},"role":"REVISER","run":{"path":"artifacts/author-runs/4e99bf438ac525e4d1c7c9fbb71cafeff3bb65f1f3bd2d274f1f4b5223ac0362.json","sha256":"4e99bf438ac525e4d1c7c9fbb71cafeff3bb65f1f3bd2d274f1f4b5223ac0362"}}],"verification":"RETAINED_RECORD_BYTES_AND_AUTHOR_RUN_BINDINGS"},"chapter":89,"current":{"candidate":{"path":"artifacts/candidates/ch89/08301f3e028512bfddb77e20043875974b77cdd0e1a43423ce395e650ef5c5e4.txt","sha256":"08301f3e028512bfddb77e20043875974b77cdd0e1a43423ce395e650ef5c5e4"},"chapter":89,"draft":{"path":"data/writing/drafts/ch89/ef554f3c63a9c01ff68dc49746777694b63d95e8cead6d66492b349c6dd107fe.json","sha256":"ef554f3c63a9c01ff68dc49746777694b63d95e8cead6d66492b349c6dd107fe"},"minimum_baseline_ratio":0.8,"minimum_body_characters":7000,"plock_ref":"plock:ch89:small-life-after-confiscation","policy":{"path":"data/promotion/policies/agent/ch89.v1.json","sha256":"f0dc4bb3de96a10d6b5090c169834a17e97916dd6ad95fc95abaa71787ce1033"},"rebind_receipt":{"path":"data/agent_release/rebind-v4/receipts/ch89.json","sha256":"19be99db3b8c53f963e7b59c24ad16362d362d05d75bcfec73bdddf5f9e71513"},"writing_package":{"path":"data/writing/packages/ch89-agent-research-v4.json","sha256":"7398fd59bc43c949c4dca161d49c043b6f8b8726065daaaca1a8c1e0e6e1d824"}},"diff":"--- v3\n+++ v4\n@@ -60,7 +60,7 @@\n \n 仆妇低着头看他蹲着，想自己弯腰，手却碰不到鞋跟，只得任他提正。她问：“这便走了？”贾芸道：“先上车。”仆妇又问那边有没有地方坐，他已被人叫着让路，只答到那里再铺，转身扶住车沿，等她两脚稳了才撤手。车夫看众人这样上一个停一个，问究竟还要多久，王夫人身旁的丫头恼他催促，贾芸先道都是老病的，急不得。车夫道自己知道，拿绳子把后头铺盖再束一束，等得手都凉了，便在腋下夹着暖。\n \n-宝玉得以回房取日用时，看屋内已经开过箱，原在窗下的东西多移到一边，自己反倒不知道该拿什么。麝月替他取了换洗，宝钗将药包与日用放在前头，问还有没有急用的。他从桌角拿起一本薄书，夹到衣包里。麝月道这时候还拿书，他说：“因为薄。”宝钗没翻，也没叫另换一本，只将衣包的结系得松些，免得压坏。他低头理衣领，旧日带着的玉仍在颈下，麝月替他将外衣搭好，随后只顾把那件留在椅上的短褂送到他臂上。\n+宝玉得以回房取日用时，看屋内已经开过箱，原在窗下的东西多移到一边，自己反倒不知道该拿什么。麝月替他取了换洗，宝钗将药包与日用放在前头，问还有没有急用的。他从桌角拿起那本薄薄的《庄子》，夹到衣包里。麝月道这时候还拿书，他说：“因为薄。”宝钗没翻，也没叫另换一本，只将衣包的结系得松些，免得压坏。他低头理衣领，旧日带着的玉仍在颈下，麝月替他将外衣搭好，随后只顾把那件留在椅上的短褂送到他臂上。\n \n 贾琏仍要留着应问，没有随头一拨走，临到门边嘱贾芸照应到借处，自己回头再去。贾芸应了，又说那边只借几间，共井共灶，仍得有人先问清如何用，贾琏听到一半，身后叫他，便道：“你先去。”贾芸没有再追他，转向管事问跟去的人可全有去处，名单上仍有一行只记暂候，后头留着空。他在那一行旁留了空，仍将名单折在袖中；那留下等欠薪的仆人提着一卷被，问能否也去，他便叫他在车后跟着，不许丢开原交的差事。\n ","editorial_notes":{"path":"artifacts/agent_research/v4-revision-20261026/revisions/ch89-editorial-notes.json","sha256":"8953673e722544cffddb37a6f55e438c323ebf4c6b35f7314ca969dd466c7185"},"import":{"authority_effect":"NONE","candidate":{"path":"artifacts/candidates/ch89/08301f3e028512bfddb77e20043875974b77cdd0e1a43423ce395e650ef5c5e4.txt","sha256":"08301f3e028512bfddb77e20043875974b77cdd0e1a43423ce395e650ef5c5e4"},"draft":{"path":"data/writing/drafts/ch89/ef554f3c63a9c01ff68dc49746777694b63d95e8cead6d66492b349c6dd107fe.json","sha256":"ef554f3c63a9c01ff68dc49746777694b63d95e8cead6d66492b349c6dd107fe"},"execution_basis":"SESSION_AUTHORED_NOT_PROVIDER_VERIFIED","formal_eligibility":false,"human_qualification":false,"input_snapshot":{"path":"artifacts/writing-inputs/manifests/2cd7936373ff85f20b8ef2cc951cf0001509b5a97f692607205bd3589baf1a40.json","sha256":"2cd7936373ff85f20b8ef2cc951cf0001509b5a97f692607205bd3589baf1a40"},"prepared_request":{"path":"artifacts/writing-requests/d47f305283ba9c500af4129a2531c4d070174473e35eb93