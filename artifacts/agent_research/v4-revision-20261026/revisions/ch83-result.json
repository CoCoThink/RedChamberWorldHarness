"authors":[{"kind":"MODEL","principal_id":"session:coordinator-edit-20261025:ch83","run":{"path":"artifacts/author-runs/c6cba3cbfdec27a7e9181ba8ec841125a62bca5b5e6e920251758859eb42e1dd.json","sha256":"c6cba3cbfdec27a7e9181ba8ec841125a62bca5b5e6e920251758859eb42e1dd"},"source_id":"session-author:c6cba3cbfdec27a7e9181ba8ec841125a62bca5b5e6e920251758859eb42e1dd"}],"candidate":{"path":"artifacts/candidates/ch83/07d1802811e6c8325293be1ba5d5c2781f5b690b4362536f488f109bae1f0d12.txt","sha256":"07d1802811e6c8325293be1ba5d5c2781f5b690b4362536f488f109bae1f0d12"},"draft":{"path":"data/writing/drafts/ch83/d479fbccfc696deec994d5bb55ab5aaef4f3e0824f6168204d4114cbc7183322.json","sha256":"d479fbccfc696deec994d5bb55ab5aaef4f3e0824f6168204d4114cbc7183322"},"package":{"path":"data/writing/packages/ch83-agent-research-v4.json","sha256":"03e33a42a355c763b00400852373429163fb2674d3cb91e451e588eacc6e3391"},"role":"REVISER","run":{"path":"artifacts/author-runs/c6cba3cbfdec27a7e9181ba8ec841125a62bca5b5e6e920251758859eb42e1dd.json","sha256":"c6cba3cbfdec27a7e9181ba8ec841125a62bca5b5e6e920251758859eb42e1dd"}}],"verification":"RETAINED_RECORD_BYTES_AND_AUTHOR_RUN_BINDINGS"},"chapter":83,"current":{"candidate":{"path":"artifacts/candidates/ch83/e63e338c6d8831cc2fdb0110484374fe0adcaf2a36bb8469fd29d7528010b68d.txt","sha256":"e63e338c6d8831cc2fdb0110484374fe0adcaf2a36bb8469fd29d7528010b68d"},"chapter":83,"draft":{"path":"data/writing/drafts/ch83/5496e61e7d279fd54c5aca773a3fc089af353076453775bf0a9c0f7471f70aba.json","sha256":"5496e61e7d279fd54c5aca773a3fc089af353076453775bf0a9c0f7471f70aba"},"minimum_baseline_ratio":0.8,"minimum_body_characters":7000,"plock_ref":"NONE","policy":{"path":"data/promotion/policies/agent/ch83.v1.json","sha256":"7d090b6d8776c311b61956d86d41e5f453e9b0b858e139e3fb7e31c5b8981ebf"},"rebind_receipt":{"path":"data/agent_release/rebind-v4/receipts/ch83.json","sha256":"de770dfe3eec7a4380f4eb32180028fc8c5ddb9fd260cb449f868f2fa18a4a24"},"writing_package":{"path":"data/writing/packages/ch83-agent-research-v4.json","sha256":"03e33a42a355c763b00400852373429163fb2674d3cb91e451e588eacc6e3391"}},"diff":"--- v3\n+++ v4\n@@ -78,11 +78,9 @@\n \n 宝玉还想细看那边的足，湘云已将帕角拢回，道：“你记你的，我收我的。等你自己看清了再说。”她说得爽快，手下合匣却比方才慢，丫头才伸手，便先将匣盖扶住，叫放回原处，不要同外头新拿来的东西混着。宝玉正要说回头再问若兰，有人在门外回：“三姑娘的信带来了，太太那边先收着了，叫二爷过去。”湘云手一放，抬头问：“可是船上的？”来人说送信的还候着，有话可以当面问。宝玉便站起，湘云跟着道：“我也去。”\n \n-这信原不是探春初写那一日便交出去的。后来船上遇着肯往回捎带的人，船家来回话，跟船婆子先出去见了，问清到了家门如何传给里头，才回舱请探春。探春从行装册中抽出那封信，末尾的日期与待书今晨能吃粥的话都还在。她没有改作交信这一日，只另外折了外纸，亲手封妥，交给婆子道：“当面给他，别夹在别人的包里忘了。”婆子接着，叫待书替姑娘把册子收回，自己抱信出了舱。\n+门上接信时，带信的人说，这信并不是初写便交出的，自己后来才同那船遇着。是船家将他引给跟船婆子，婆子先问到了家门如何传进，又问可否回带消息。他只答应往回送，不敢应回信，便听见舱里吩咐，叫先送到，别忙许下一趟。过了一会儿，婆子将封好的信交到他手上，还不松手，道：“当面给他们，别夹在别人的包里忘了。”他便另用布裹好，贴身收在行囊里。说到这里，他指着信面，道：“上头的日期，我不曾拆看。交信时舱里还叫人把姑娘的册子收回，别的就不知道了。”\n \n-船家站在外头，将那愿带信的人招近。婆子不忙松手，先问到了若找不着回话的人怎么办。那人道寻门上人说明白是三姑娘船上托的，等接了才走。婆子又问能否回带消息，他说这一趟只往回走，不敢应回信。她回头向舱里说过，探春道：“叫他先把这封送到，回信不忙许。”婆子这才将信递到那人手里，看他另用布裹好，放在自己贴身的行囊内。待人走开，她回舱告诉探春信已交下，探春伸手到行装册里，触到原来夹信的空页，停了片刻，才合上册子。\n-\n-其间候船、行路，并非一日里就能接上。带信的人到了贾府门前，从行囊里取出那一包，亲交门上管事，说是三姑娘船上带回的。管事问可有别物，他说只有这封，船上说起的话也不过饮食起居；又问了家里的人是否安好，未敢替谁许回信。管事将信接过，叫他在外头候，先使人传到内宅。里头的婆子出来接，问送到谁跟前，管事说先给太太，信面写着的，不可只当普通包裹搁下。婆子应声接好，用袖子护着往里走。\n+管事又问可有别物，他说只有这封，船上说起的话也不过饮食起居；又问了家里的人是否安好，未敢替谁许回信。管事将信接过，叫他在外头候，先使人传到内宅。里头的婆子出来接，问送到谁跟前，管事说先给太太，信面写着的，不可只当普通包裹搁下。婆子应声接好，用袖子护着往里走。\n \n 王夫人接到信时，先问带信的可曾见着探春。婆子说自己才从门上接来，话还未问全，便要再出去。王夫人道：“不必你跑，让外头问了传进来。先给送信的人茶饭，该给的脚费问明白，别让人把信送到，倒饿着等。”说着将外纸拆开，看见探春的字，手就在纸边按住了。宝玉同湘云来到门外，里面正叫拿灯前的那只剪子，湘云便进去帮着取，宝玉跟在后头，见信已放在桌上，伸手又缩了回来。\n ","editorial_notes":{"path":"artifacts/agent_research/v4-revision-20261026/revisions/ch83-editorial-notes.json","sha256":"ccc1839a6be76499be07719efb22549c5d49a422bbed93532ab99cf8b39b0147"},"import":{"authority_effect":"NONE","candidate":{"path":"artifacts/candidates/ch83/e63e338c6d8831cc2fdb0110484374fe0adcaf2a36bb8469fd29d7528010b68d.txt","sha256":"e63e338c6d8831cc2fdb0110484374fe0adcaf2a36bb8469fd29d7528010b68d"},"draft":{"path":"data/writing/drafts/ch83/5496e61e7d279fd54c5aca773a3fc089af353076453775bf0a9c0f7471f70aba.json","sha