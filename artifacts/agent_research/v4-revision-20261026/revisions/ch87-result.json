"authors":[{"kind":"MODEL","principal_id":"session:coordinator-edit-20261025:ch87","run":{"path":"artifacts/author-runs/dd2426f2e15d523a3daf9b69ed195622ea92f88cb472e94c3ac42c13aadbaa07.json","sha256":"dd2426f2e15d523a3daf9b69ed195622ea92f88cb472e94c3ac42c13aadbaa07"},"source_id":"session-author:dd2426f2e15d523a3daf9b69ed195622ea92f88cb472e94c3ac42c13aadbaa07"}],"candidate":{"path":"artifacts/candidates/ch87/fdee0217343a5352c487c4634c3797d0395652d642231f6312ec9b6b3bd95542.txt","sha256":"fdee0217343a5352c487c4634c3797d0395652d642231f6312ec9b6b3bd95542"},"draft":{"path":"data/writing/drafts/ch87/4afdcb0c2bfc452669bc78e9a8c0b65edef49c6956cfe3cd0988f5095357f3fc.json","sha256":"4afdcb0c2bfc452669bc78e9a8c0b65edef49c6956cfe3cd0988f5095357f3fc"},"package":{"path":"data/writing/packages/ch87-agent-research-v4.json","sha256":"e99eddb7771c296fb916a9ecf36d0f08790d45f5e2d3e024ff06bdd0fa5bb556"},"role":"REVISER","run":{"path":"artifacts/author-runs/dd2426f2e15d523a3daf9b69ed195622ea92f88cb472e94c3ac42c13aadbaa07.json","sha256":"dd2426f2e15d523a3daf9b69ed195622ea92f88cb472e94c3ac42c13aadbaa07"}}],"verification":"RETAINED_RECORD_BYTES_AND_AUTHOR_RUN_BINDINGS"},"chapter":87,"current":{"candidate":{"path":"artifacts/candidates/ch87/23c00a612d8e5bc5148c80765e63edf2456b163db3bcfc9804e3fde3b4dfd318.txt","sha256":"23c00a612d8e5bc5148c80765e63edf2456b163db3bcfc9804e3fde3b4dfd318"},"chapter":87,"draft":{"path":"data/writing/drafts/ch87/e7296d2631c91ee0ad14df94b376f57dbc6758a4e59e1ad80f4c57e8ac103a39.json","sha256":"e7296d2631c91ee0ad14df94b376f57dbc6758a4e59e1ad80f4c57e8ac103a39"},"minimum_baseline_ratio":0.8,"minimum_body_characters":7000,"plock_ref":"NONE","policy":{"path":"data/promotion/policies/agent/ch87.v1.json","sha256":"2cd81312b3362a3bfcfc1e38966de361a4922b0fc27c44a21abc6c6fd2ee609b"},"rebind_receipt":{"path":"data/agent_release/rebind-v4/receipts/ch87.json","sha256":"214d481912562b136af23d616e305d0303bc73966bc22e2cbb9e3389984f1005"},"writing_package":{"path":"data/writing/packages/ch87-agent-research-v4.json","sha256":"e99eddb7771c296fb916a9ecf36d0f08790d45f5e2d3e024ff06bdd0fa5bb556"}},"diff":"--- v3\n+++ v4\n@@ -22,7 +22,13 @@\n \n 平儿将引枕往前扶，叫她先别说。王夫人见了，也道：“你身子这样，叫底下人来回就是，别自己出去张罗。”凤姐缓过气，仍将纸交回平儿：“太太的事不在我这里等。针线房听太太分派，厨房另有人看着。零碎接不上了，你来问我，不必把每样都送来。”平儿应下。王夫人拿了那纸，原想让凤姐总理一遭的话，也只得不提，临走另叫个管事媳妇到自己房中，先分清来回话的地方。\n \n-这番话以后，内宅尚谈了几回。媒与礼务的回话各送到王夫人、薛姨妈跟前，服用、往来和可办的规模也分别问过，宫中正式服制的回话却仍未齐。原来棚、满廊彩灯和戏的单子没有放行，两家先理衣被与住处。贾母只在听说两边愿意后，叫王夫人照商量妥的做。底下人知道婚事，已经是针线房来取尺寸的时候。廊下一个婆子说老太太要借喜事冲一冲，平儿走过听见，便问她几时得了老太太这句话。婆子含糊一笑，平儿道：“太太叫办哪样，你办哪样，别另给老太太添话。”婆子便低头收起手里的样子。\n+媒与礼务的回话陆续送来，衣饰、席面各有着落，宫中正式服制的回话却还未齐。王夫人将已回和未回的分开，又来见贾政。贾政翻了翻，道：“既还有未齐的，何妨再候？”王夫人道：“我也这样回过老太太。老太太只问我，候到哪一日。宝玉如今肯吃饭了，日里却仍坐着发怔，我想叫他们早有个家常过的日子。”贾政将纸搁下，道：“他坐着发怔，倒要靠娶亲来治？”王夫人脸上热起来，半晌道：“不敢说治得好。我是他母亲，只盼他回来有个肯说话的人。”\n+\n+贾政没有接这句，叫她把未回的也拿给贾母看，莫只回内宅已备齐了。到了贾母跟前，王夫人便将纸仍分作两处，说老爷的意思是再候。贾母听罢，手炉放在膝上，许久才道：“先前我说愿意，原不算定了。今日还有这一层，我也听见了。”王夫人问是否先把日子搁下，贾母望着她，道：“我年纪到了，等得一日是一日。宝玉这样，我还想亲眼看他两口子过起来。你去同姨太太说，我是要早办；她若为难，别拿我压她。”\n+\n+薛姨妈听了，却先问贾政怎样说。王夫人没说老爷已许，只将再候的话照说了。薛姨妈将手里的针插回去，道：“我把女儿嫁过来，不是叫她替宝玉治病的。往后他有不好的，你可别说是成婚不中用。”王夫人急道：“我哪里这样想！”见姊妹只望着自己，才缓下声道：“这句话我记着。外头回话还缺，我也不能说已齐。我仍想办，不独为老太太。”薛姨妈坐了一阵，才道：“住处和她跟前的人，照前头商量的，不再往她手里添家务。我应的是这个。”\n+\n+王夫人再将两人的话回给贾政。贾政听见贾母催办，眉头皱着，问姨太太是否知道未齐，王夫人答知道。他将桌上婚期的纸推回来，道：“既两边仍要定，你便照这张去回母亲。未齐的照实记着，别到我跟前又说成已问妥了。”王夫人接了，才叫管事媳妇照定下的日子分派。棚、满廊彩灯和戏的单子仍压着，谁也没拿这几张未放行的单子去充那份尚缺的回话。廊下一个婆子说老太太要借喜事冲一冲，平儿问她几时得了这句话，婆子含糊一笑，便低头收起手里的样子。\n \n 宝钗先从母亲那里知道。那天薛姨妈留她在房中，打发旁人出去，自己却还把针线笸箩留在膝上。说到宝玉，宝钗的手指在缠线的小轴上停住。薛姨妈道：“老太太是这个意思，你姨母也来问过，我同她谈了几回。”宝钗低头将线轴放回去，道：“母亲已想妥了？”薛姨妈说：“该商量的总要商量。我只怕你有话不说。”宝钗不答，过了一会儿，才问：“母亲往后一个人，夜里腰疼，谁替你拿热手巾？”薛姨妈眼圈立刻红了，勉强笑道：“倒叫你先想起这个。”\n \n@@ -42,7 +48,7 @@\n \n 凤姐那边并没有全然不问。平儿拿了回话去，她听说还有人想把廊下都挂满，笑了一声，随即道：“挂给夜里看路的么？有灯便是。丧中本不宜闹，他们偏在这上面逞能。”平儿说太太已驳回了，只来问缺的绸料可再添。凤姐想了想，道：“屋里用的先问薛姨太太，免得两边都买。外头那一些，既说不用，就别又拿少几段来试。”她说完，将头靠回枕上，平儿把剩下的纸折起来。凤姐道：“还没说完呢。”平儿道：“这几桩已经够他们做了。”她便不再强撑，手一松，纸角从指间落了下去。\n \n-两家在一回回往来后议定了日子，那套正式服制的回话却始终未齐，原先压下的几张单子也没有再放行。成婚那日，没有搭起接连几院的彩棚，原拟的戏也未办，来往只留必要的亲眷。门上有的红绸比旧时少，屋内该用的衣饰却已分别送妥。王夫人叫人看着迎送，不许底下拿缩礼当作怠慢，薛姨妈那里也有人送着妆奁与箱被进来。麝月接被褥时认得是自己送去收边的那床，手摸了一下缝口，便叫抬到里间。厨房按前日改定的数送饭，先后错开，不在一处等齐。一个婆子要另开一桌，被管事媳妇叫住，领到王夫人那里问过，才又回来搬椅子。\n+到了定下的日子，宫中那套正式服制的回话仍未齐。王夫人天未亮便起来，先问薛家的人可已动身，再叫把家中留下的几席逐一看过。原先压下的棚、灯、戏并没添回去。成婚那日，没有搭起接连几院的彩棚，原拟的戏也未办，来往只留必要的亲眷。门上有的红绸比旧时少，屋内该用的衣饰却已分别送妥。王夫人叫人看着迎送，不许底下拿缩礼当作怠慢，薛姨妈那里也有人送着妆奁与箱被进来。麝月接被褥时认得是自己送去收边的那床，手摸了一下缝口，便叫抬到里间。厨房按前日改定的数送饭，先后错开，不在一处等齐。一个婆子要另开一桌，被管事媳妇叫住，领到王夫人那里问过，才又回来搬椅子。\n \n 宝玉穿上衣裳，袭人替他理襟，麝月在旁边寻原先放下的一条带子。她找遍椅背，最后从自己搭着的衣裳里抽出来，袭人道：“方才就说在你那里。”麝月道：“你也没少看这两眼。”宝玉低头让她们系好，抬手时袖子擦到桌上的茶，盏子晃了一下，袭人先扶住了。宝玉便把手放下来。外头催请，他问是否都齐了，袭人说齐了，向旁一让。他走到门边，又回身将搭歪的衣角扯正，才跨出去。麝月拢着余下的衣物，站在帘后看了一眼，便回去收拾床上的零碎。\n ","editorial_notes":{"path":"artifacts/agent_research/v4-revision-20261026/revisions/ch87-editorial-notes.json","sha256":"33a4db0feb476a31189bfe6fc47e6670823667af8a6e2f7152b0266f2dbbf306"},"import":{"authority_effect":"NONE","candidate":{"path":"artifacts/candidates/ch87/23c00a612d8e5bc5148c80765e63edf2456b163db3bcfc9804e3fde3b4dfd318.txt","sha256":"23c00a612d8e5bc5148c80765e63edf2456b163db3bcfc9804e3fde3b4dfd318"},"draft":{"path":"data/writing/drafts/ch87/e7296d2631c91ee0ad14df94b376f57dbc6758a4e59e1ad80f4c57e8ac103a39.json","sha256":"e7296d2631c91ee0ad14df94b376f57dbc6758a4e59e1ad80f4c57e8ac103a39"},"execution_basis":"SESSION_AUTHORED_NOT_PROVIDER_VERIFIED","formal_eligibility":false,"human_qualification":false,"input_snapshot":{"path":"artifacts/writing-inputs/manifests/5ee084a6148fbe0224f2c06f4012c21473a0ff72525e1bbc32ecbc55da03ae7e.json","sha256":"5ee084a6148fbe0224f2c06f4012c21473a0ff72525e1bbc32ecbc55da03ae7e"},"prepared_request":{"path":"artifacts/writing-requests/53cd946bb187110ed9df5a8db8faa7838639cc992ab898adc47cfe51176246f5.json","sha256":"53cd946bb187110ed9df5a8db8faa7838639cc992ab898adc47cfe51176246f5"},"qualification":"RESEARCH_ONLY","run":{"path":"artifacts/author-runs/bad7a388627935ecd93c20c0a11cbbc08983a3eb6464c32409bfdbac231f0c97.json","sha256":"bad7a388627935ecd93c20c0a11cbbc08983a3eb6464c32409bfdbac231f0c97"},"session_configured_model":{"basis":"UNVERIFIED_DECLARATION","label":"current age