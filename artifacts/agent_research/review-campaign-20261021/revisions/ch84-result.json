00587f5ef076c9dd9e0b792b4a4532ca.json","sha256":"d2fbab28f849c9f39876b5e3d9c7eded00587f5ef076c9dd9e0b792b4a4532ca"},"minimum_baseline_ratio":0.8,"minimum_body_characters":7000,"plock_ref":"NONE","policy":{"path":"data/promotion/policies/agent/ch84.v1.json","sha256":"7659b162ddf548285bb7c53f6062407bdba710f3185a4b1e406a7792d962a866"},"rebind_receipt":{"path":"data/agent_release/rebind-v4/receipts/ch84.json","sha256":"2a9939b4c6b8b1d4b7b29455818f1b70714863e7a96d9612fd6e368078cd7e48"},"writing_package":{"path":"data/writing/packages/ch84-agent-research-v4.json","sha256":"2ea6eba0a2e431124e77e9f03ee3fa093ca60376e525d7f7ee1471ddc7a961ea"}},"diff":"--- previous\n+++ current\n@@ -40,7 +40,7 @@\n \n 厨娘把粥面搅匀，见平儿还站着，便问若席面都停，先前备下的东西怎样办。平儿说尚能留用的好好收着，不必为求做完今日的单子全下锅，已做的也回明如何分，不可白倒。厨娘松了口气，道：“只怕那边说停，这边又催做，做了又说我糟践。”平儿道：“今儿有话就回，别替人猜。”她说完，自己也在灶旁扶了一下桌沿，才让小丫头盛些温水。水接到手上，她只喝一口，针线房又使人来问太太那件素衣的领边要不要改。\n \n-平儿一时无力笑，只道先拿来给太太试，别都在嘴里改好了。她把水杯还了，跟着那人出去。才到廊下，凤姐已使人来寻，说老太太那里安顿些了，问各处如何。平儿回说误停的饭已送，衣裳已找，素料也有经手去领，凤姐听见饭迟了，眉头一皱，随即问哪一房，叫再去问送到了没有。平儿说丫头跟过去了，自己回来就问。凤姐没有再骂，只让她慢些走，见她鞋边沾了灰，又道：“今儿若都跑坏了脚，明儿谁替你们跑？”\n+平儿一时无力笑，只道先拿来给太太试，别都在嘴里改好了。她把水杯还了，跟着那人出去。才到廊下，凤姐已使人来寻，说老太太那里安顿些了，问各处如何。平儿随那人回到屋里，回说误停的饭已送，衣裳已找，素料也有经手去领，凤姐听见饭迟了，眉头一皱，随即问哪一房，叫再去问送到了没有。平儿说丫头跟过去了，自己回来就问。凤姐没有再骂，只让她慢些走，见她鞋边沾了灰，又道：“今儿若都跑坏了脚，明儿谁替你们跑？”\n \n 门上那边也有人来回，问临时等客的人怎样答。凤姐让先将自家的宴请停下，来客的缘由问明白再回；不许将“暂缓”说成任何人一概不见。管事应了，待要走，又问是否宫里已经有这几条。凤姐把声音压得更低，道：“宫里的话有了自会传。方才是我管家里，叫你们别趁乱放人进来，并没叫你替宫里传令。”管事忙说记住，回到门上，恰见有人还想探听偏厅里的事，便将先前那半扇门掩得更严。\n ","import":{"authority_effect":"NONE","candidate":{"path":"artifacts/candidates/ch84/0acaef1e5b52113c8514d5724526dc30982257ea420d7fbc06222fbb782454c5.txt","sha256":"0acaef1e5b52113c8514d5724526dc30982257ea420d7fbc06222fbb782454c5"},"draft":{"path":"data/writing/drafts/ch84/d2fbab28f849c9f39876b5e3d9c7eded00587f5ef076c9dd9e0b792b4a4532ca.json","sha256":"d2fbab28f849c9f39876b5e3d9c7eded00587f5ef076c9dd9e0b792b4a4532ca"},"execution_basis":"SESSION_AUTHORED_NOT_PROVIDER_VERIFIED","formal_eligibility":false,"human_qualification":false,