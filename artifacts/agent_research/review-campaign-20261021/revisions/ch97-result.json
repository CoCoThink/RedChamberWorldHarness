24ccba38222ceb0c7e3c16f9a13b9d18.json","sha256":"e76d039edd5b684f4e9abcfdf854fce224ccba38222ceb0c7e3c16f9a13b9d18"},"minimum_baseline_ratio":0.8,"minimum_body_characters":7000,"plock_ref":"plock:ch97:miaoyu-object-progression","policy":{"path":"data/promotion/policies/agent/ch97.v1.json","sha256":"d3fa729bf41a9938e8a25a441c840e04285f4ee714631983bfebc2ece32053a7"},"rebind_receipt":{"path":"data/agent_release/rebind-v4/receipts/ch97.json","sha256":"e83455731c597008c7b1650f726be720cb033264c917b4ff7519c4581c6dd646"},"writing_package":{"path":"data/writing/packages/ch97-agent-research-v4.json","sha256":"c7c047c2d707e1686bc07395f5ef2ea2023d5367ff07a24e060ddd2d6d75c8a8"}},"diff":"--- previous\n+++ current\n@@ -72,7 +72,7 @@\n \n 到了晚些，老尼过来看抄成的页数，妙玉尚未写完。老尼说外头的人还等着，若今日取不齐，剩下的便要另约。妙玉看着未干的墨，道这几页可先带走，其余待她抄完。老尼点数时，特意将边上沾水那张抽开晾着，叫小徒不能卷紧，免得墨粘。小徒抱纸出去，妙玉便问盆可洗了。老尼说厨房还在收拾，等灰移好才洗，她只得把未用的盏又往布里挪了挪，案上原放盆的一块地方空着，露出些旧水印。\n \n-湘云家里的瓦匠却已经把三片新瓦递上房。仆妇扶着梯子，邻妇在外头看，湘云站在屋内，听上头挪瓦的声响。瓦匠叫把床再往旁边移些，免得落泥，她同仆妇抬了一头，才挪开，檐上便落下些碎屑。她一时忘了刚放在床上的旧衣，回身去拿，衣襟上已沾着灰。仆妇说先等人下来再拍，她偏拿到门边抖，灰便飘回自己脸上。她呛了一下，邻妇笑道：“你这样急，倒是替匠人催着做。”湘云也笑，拿袖子掩着口，说总不能让自己的衣裳先住到房顶上去。\n+湘云家里的瓦匠却已经把三片新瓦递上房。仆妇扶着梯子，邻妇在外头看，湘云站在屋内，听上头挪瓦的声响。瓦匠叫把床再往旁边移些，免得落泥，她同仆妇抬了一头，才挪开，檐上便落下些碎屑。她一时忘了搭在椅背上的旧衣，回身去拿，衣襟上已沾着灰。仆妇说先等人下来再拍，她偏拿到门边抖，灰便飘回自己脸上。她呛了一下，邻妇笑道：“你这样急，倒是替匠人催着做。”湘云也笑，拿袖子掩着口，说总不能让自己的衣裳先住到房顶上去。\n \n 瓦压稳后，瓦匠下来问谁结工钱。湘云叫他坐一坐，自己把预先分开的包取来。那人接过，又说挪瓦时顺手压过旁边松处，湘云问这也另算么。他说并不另算，只是告诉她，免得下回谁又说没动。她这才知道自己听急了，向他笑道：“你慢慢说，我正想问那边。”瓦匠又朝外指，叫她雨来时留心墙根，若还是潮，再找房东看外头。他还要赶去别处，不肯久坐，仆妇将梯子旁的盆搬开，腾出门来让他走。\n \n@@ -84,7 +84,7 @@\n \n 惜春那庵里，宝玉在门内站得久了，手上的伞换过一回。小尼送灯壶回去，还想留他喝水，惜春已把让出的凳子挪来，他这才坐下。水端到眼前，杯底压着一点水渍，他伸手去扶，怕弄湿纸，惜春便将纸提开，让他放在那块空处。他问经簿里夹那么多小条是做什么，她只说等对字。宝玉俯身要看缺处，小尼在旁道有的还能猜，惜春把经簿合起来，叫她去取那本全的，今日还没取来。小尼说师父忙，不好问，惜春便不再催，把纸条夹牢。\n \n-宝玉喝了水，抬眼见她鬓边短发伏在耳旁，本想问落发时的话，刚唤一声妹妹，她却正拿布擦桌，问他的伞是不是漏。原来伞头滴下的一点水，已落在凳脚。他道不是漏，是方才在檐边蹭湿的，随后将伞提起，摆到门外。待转回来，那一句便不好再接。他另问住处可缺什么，惜春道有要用的便同师父说，又将布拧了拧，搭在绳上。他望着那包被退回去的旧衣已不在，手往椅背摸了一下，椅背空着，只有她挂的一件灰衣。\n+宝玉喝了水，抬眼见她鬓边短发伏在耳旁，本想问落发时的话，刚唤一声妹妹，她却正拿布擦桌，问他的伞是不是漏。原来伞头滴下的一点水，已落在凳脚。他道不是漏，是方才在檐边蹭湿的，随后将伞提起，摆到门外。待转回来，那一句便不好再接。他另问住处可缺什么，惜春道有要用的便同师父说，又将布拧了拧，搭在绳上。他望见她挂的一件灰衣，手往旁边的椅背摸了一下，那里空着，便将手收回来。\n \n 临走时他想帮着把黄纸送进屋，惜春说放着，她待会儿仍要裁。小尼却趁他空手，叫帮着将浅筐放到高处，那里不怕风。宝玉抱过去，架子上挤不下，惜春叫他先取下空篮，再搁筐，他照着做了，纸条还是有一根搭在外面，她伸手压回去。他笑道：“这才算帮了一点。”惜春没有答这一句，只叫他回去看路，外头阴着。宝玉带伞出了门，小尼望望纸筐，说今日还剩许多未裁，惜春已经坐回案前，叫把剪子拿来。\n \n@@ -100,7 +100,7 @@\n \n 门外妇人叫小徒帮着搬米，昨日裂的粗钵已搁在墙根，底下垫了一片废纸。妙玉看了一眼，掬水洗盏，袖口被水溅湿一小片，她立即往上捋，指腹的凉水顺着腕内流进去。她用干布按住，桌上新摊的经卷却被卷起的袖子带动，页角折了。小徒已走远，她只得自己将经页一层层理平，按住那一角，等纸不再翘起，再去捞盆中的盏。盏沿洗过之后，她仍凑近闻了闻，放在布上，屋外的米袋落地，灰尘从门槛外轻轻扬进来。\n \n-惜春是在宝玉走后接着裁纸的。小尼取来的剪子沾了一线菜汁，她在水中涮过，擦干，剪口却比先前钝了些，厚纸须分开裁。她把原来叠好的几张拆散，一张张按平，小尼嫌这样慢，拿起一条去比宽窄，偏比的那条是先前有豁口的。惜春将它抽回，换一条齐整的给她，让照这个包灯芯。小尼搓了几下，纸口松着，她接来重裹，搁在手边，余下仍让那人做。\n+昨日宝玉走后，惜春接着裁纸。小尼取来的剪子沾了一线菜汁，她在水中涮过，擦干，剪口却比先前钝了些，厚纸须分开裁。她把原来叠好的几张拆散，一张张按平，小尼嫌这样慢，拿起一条去比宽窄，偏比的那条是先前有豁口的。惜春将它抽回，换一条齐整的给她，让照这个包灯芯。小尼搓了几下，纸口松着，她接来重裹，搁在手边，余下仍让那人做。\n \n 师父叫看灯油够不够，二人抬灯到亮处，油在底下晃，惜春把灯壶放回，先将露在外头的灯芯拨短些。灯焰低了一截，小尼说这样抄经不亮，她道缺字还未对好，今晚先裁纸。小尼便将经簿收起，纸条掉下来一片，惜春叫别扫走，自己拾起夹回原处。旧梳子又碍着纸角，她这次拿到床边，却找不到空处，旧画袋占着半边床脚，笔匣也在那里。她把梳子搁在袋旁，转身回来，袖口勾住一根线，又退回去解。\n ","import":{"authority_effect":"NONE","candidate":{"path":"artifacts/candidates/ch97/725968258aa811ec276749f99817222cf883376638e9a378ad4668bb130b4e72.txt","sha256":"725968258aa811ec276749f99817222cf883376638e9a378ad4668bb130b4e72"},"draft":{"path":"data/writing/drafts/ch97/e76d039edd5b684f4e9abcfdf854fce224ccba38222ceb0c7e3c16f9a13b9d18.json","sha256":"e76d039edd5b684f4e9abcfdf854fce224ccba38222ceb0c7e3c16f9a13b9d18"},"execution_basis":"SESSION_AUTHORED_NOT_PROVIDER_VERIFIED","formal_eligibility":false,"human_qualification":false,"input_snapshot":{"path":"artifacts/writing-inputs/manifests/df4a0f50689f31f3122429fed92ee72d1b9fab2b79414c6cf5b141a8fd095466.json","sha256":"df4a0f50689f31f3122429fed92ee72d1b9fab2b79414c6cf5b141a8fd095466"},"prepared_request":{"path":"artifacts/writing-requests/98dedc9136e373310e9afcfd673f6450b2b6263920304fe8586e5fd5e5c06352.json","sha256":"98dedc9136e373310e9afcfd673f6450b2b6263920304fe8586e5fd5e5c06352"},"qualification":"RESEARCH_ONLY","run":{"