[{"authors":[{"kind":"MODEL","principal_id":"session:coordinator-edit-20261023:ch91","run":{"path":"artifacts/author-runs/4ac2b26a89ca6b294c4b10038d9bc4449984ee3736820e50031b1b1e8a357cfa.json","sha256":"4ac2b26a89ca6b294c4b10038d9bc4449984ee3736820e50031b1b1e8a357cfa"},"source_id":"session-author:4ac2b26a89ca6b294c4b10038d9bc4449984ee3736820e50031b1b1e8a357cfa"}],"candidate":{"path":"artifacts/candidates/ch91/e22f85b4333ae6ebc9c936cfda0dadb704f2b113225aa5fa2ed539f4a10fc414.txt","sha256":"e22f85b4333ae6ebc9c936cfda0dadb704f2b113225aa5fa2ed539f4a10fc414"},"draft":{"path":"data/writing/drafts/ch91/212fb57bbe1d808ad6563bac979b3a0cee7613ada0771f8fd0281efc19d89e56.json","sha256":"212fb57bbe1d808ad6563bac979b3a0cee7613ada0771f8fd0281efc19d89e56"},"package":{"path":"data/writing/packages/ch91-agent-research-v4.json","sha256":"8d8ec7489698b86a0b72a70a7bc4b079e538fb064e5e2902bd8573eba265e6ce"},"role":"REVISER","run":{"path":"artifacts/author-runs/4ac2b26a89ca6b294c4b10038d9bc4449984ee3736820e50031b1b1e8a357cfa.json","sha256":"4ac2b26a89ca6b294c4b10038d9bc4449984ee3736820e50031b1b1e8a357cfa"}}],"verification":"RETAINED_RECORD_BYTES_AND_AUTHOR_RUN_BINDINGS"},"chapter":91,"current":{"candidate":{"path":"artifacts/candidates/ch91/e22f85b4333ae6ebc9c936cfda0dadb704f2b113225aa5fa2ed539f4a10fc414.txt","sha256":"e22f85b4333ae6ebc9c936cfda0dadb704f2b113225aa5fa2ed539f4a10fc414"},"chapter":91,"draft":{"path":"data/writing/drafts/ch91/212fb57bbe1d808ad6563bac979b3a0cee7613ada0771f8fd0281efc19d89e56.json","sha256":"212fb57bbe1d808ad6563bac979b3a0cee7613ada0771f8fd0281efc19d89e56"},"minimum_baseline_ratio":0.8,"minimum_body_characters":7000,"plock_ref":"NONE","policy":{"path":"data/promotion/policies/agent/ch91.v1.json","sha256":"6e3df61f326892cf3b5cef20ad590a22055383f0559319ecbc4ad7289592bebf"},"rebind_receipt":{"path":"data/agent_release/rebind-v4/receipts/ch91.json","sha256":"12c9a68aab4371b6afd282d963475c6112a7e4846d2a6d80db25e327daab4480"},"writing_package":{"path":"data/writing/packages/ch91-agent-research-v4.json","sha256":"8d8ec7489698b86a0b72a70a7bc4b079e538fb064e5e2902bd8573eba265e6ce"}},"diff":"--- previous\n+++ current\n@@ -64,9 +64,9 @@\n \n 麝月低头扶毡，膝头越来越沉，想站直，又怕毡滚下去。平儿看见了，便将衣包放在干砖上，替她接住一头。书办问还有谁碰过，麝月道：“我没碰那东西，只扶奶奶。”平儿说簪子也没落下去。书办把话记了，将纸转给凤姐看。凤姐视线有些模糊，向亮处挪了挪，忽然问道：“那一行写我拿走了？”书办道：“写你拾起，没写领走。”她又俯近些，才点头，随即扶住自己的腰，再也站不久了。\n \n-守物的人拿来干纸，要收拢那小物，麝月以为事情完了，抱起毡就催平儿走。书办却叫她们等一等，说还须接着交回处理。平儿问交给谁，书办未给出名字，只说这边尚待接办，叫她们别混在冬衣里。凤姐道：“我也没要它。既拾出来，别再丢进雪里。”她把包在外层的湿纸抽开一点，推向待接的那边，待看清那物稳稳落在干纸中，方才松手。书办去催接办，她们仍只能在廊下候着。\n+守物的人拿来干纸，要收拢那小物，麝月以为事情完了，抱起毡就催平儿走。书办却叫她们等一等，说还须接着交回处理。平儿问交给谁，书办未给出名字，只说这边尚待接办，叫她们别混在冬衣里。凤姐道：“我也没要它。既拾出来，别再丢进雪里。”她把包在外层的湿纸抽开一点，推向待接的那边，待看清那物稳稳落在干纸中，方才松手。书办去催接办，她们仍只能在廊下候着。过了一会儿，里头出来一人，先接过那张记录，照着念了“玉样物一”，再将干纸连物一并收妥。书办问他收着了么，那人答收着了，方让她们离开；平儿仍没听见他的名字。\n \n-廊外的风卷来细雪，凤姐将手藏进袖中，手指却伸不直。平儿轻轻替她揉开，说道：“今儿衣裳倒没冷着，冷着的是你。”凤姐想驳，忽然喘得说不出话，靠住她的肩，片刻方道：“先出去。”麝月看向那边，方才拾物的纸还未收毕，便问：“这个还带不带话回去？”书办回来道：“只说已记，交回的事还待接着办。”平儿应了，把副单收好，没有再伸手。凤姐回头看了一眼，干纸已折起一边，余下的一边还张着；她转身时，麝月赶紧将毡移到身后，让出地方来扶她。\n+廊外的风卷来细雪，凤姐将手藏进袖中，手指却伸不直。平儿轻轻替她揉开，说道：“今儿衣裳倒没冷着，冷着的是你。”凤姐想驳，忽然喘得说不出话，靠住她的肩，片刻方道：“先出去。”麝月看向那边，方才拾物的纸已随小物交进去，便问：“这个还带不带话回去？”书办回来道：“只说已记，纸与物都已收妥。”平儿应了，把副单收好，没有再伸手。凤姐回头看了一眼，方才放小物的地方已经空了；她转身时，麝月赶紧将毡移到身后，让出地方来扶她。\n \n 门房这边尚要看所领的衣物。平儿将两件棉衣和靠褥解开，青灰袄搁在上头，短袖的一件翻出右襟。看守按书办所记，一件件看过，麝月抱着毡在旁等。看守对照书办记下的名目，问毡角如何湿了，麝月道：“从架上抽出来，碰着雪。”那人叫她展开焦孔的一角，她脚已经麻了，蹲不下，便伸腿托住卷毡。平儿见毡又要落，赶忙过去帮她，凤姐失了扶手，倚着墙站着，脸偏向一旁。看守核过，让她们领出，麝月这才把毡重新卷牢。纸能收进怀里，靠褥却比进来时显得更宽，挡住平儿的肘。凤姐试着走了一步，便停下来。\n \n@@ -100,7 +100,7 @@\n \n 平儿将那句面询的话说了。宝玉盯着她手中小纸，问道：“原单就是这个？”平儿道：“我写的，原单我没带。”他接过去看，读到自己的名字，手指沿纸边停了一会，说道：“衣裳都认了，还叫我认什么？”平儿答不上来。麝月进来将烤得半干的鞋摆在墙边，听见这问，便道：“我们只去了那一处。连一个空匣子都没领出来，你倒问得像我们把府里逛遍了。”\n \n-宝玉抬头道：“匣子还在么？”麝月道：“在，也空着。你问这个有什么用？”宝玉张了张嘴，才道：“原来装在里面的……”麝月已经蹲下整鞋，宝钗又将冷茶换去，他的话便没有说完。平儿提了一句残雪里拾起的小物，宝玉问在何处拾的，她说廊外扫出的雪边，写的是“玉样物一”，仍待那边接着处理。宝玉低头看手中的纸，这上面只有旧单问话，并没有那四个字，遂将纸还给平儿，道：“我明日去认就是了。”\n+宝玉抬头道：“匣子还在么？”麝月道：“在，也空着。你问这个有什么用？”宝玉张了张嘴，才道：“原来装在里面的……”麝月已经蹲下整鞋，宝钗又将冷茶换去，他的话便没有说完。平儿先说青灰袄已经认回，左袖里面有奶奶亲自认过的白布，又提了一句残雪里拾起的小物，宝玉问在何处拾的，她说廊外扫出的雪边，写的是“玉样物一”，纸与物都交给那边的人收妥了。宝玉低头看手中的纸，这上面只有旧单问话，并没有那四个字，遂将纸还给平儿，道：“我明日去认就是了。”\n \n 天黑以后，院门上另有人来传。贾芸先到门边，原是来问是否还有东西要搬，看见官面传话的人，便退开，让家里出来接话。李纨先听了，叫宝玉到门内候着；宝钗从屋里出来时，只听见说是认旧单，明早须去，旁的留待当面问。她问今日带来的话算不算已经告知，那人说自己此来就是再传认单，不替书办答旧物的事。\n \n@@ -108,7 +108,7 @@\n \n 宝玉到了门边，问传话的人明日是不是可以顺便见旧府里的人。那人道：“先认单。”他又问须带哪张纸，平儿拿出今日领物的副单，传话人看了一眼，道：“不是叫你领衣。有手边记的话可以带着，旧单在那里。”宝玉还想问叫他认的究竟是哪件物，门外已有人催这人走。他只得收口。贾芸跟出去几步，问明早可要自己送到外头，回来告诉宝钗，说等宝玉出来，他可帮着跑一段路；到门里该怎么办，自己还不知。\n \n-王夫人又让人叫贾芸进来。他刚到门外，便听见问道：“你常在外头跑，可知道认单能不能当日回来？”贾芸低头道：“侄儿没有问得这句话，不敢混说。”王夫人叹了一声，叫他明早先来，别耽误。贾芸应了，退出去时，宝玉却扯住他的袖子，说自己还有一件要问，停了停，又不知该从哪里问起。贾芸道：“二叔有话只管说。”宝玉摇头，将手放开：“明早见罢。”\n+王夫人又让人叫贾芸进来。他刚到门外，便听见问道：“你常在外头跑，可知道认单能不能当日回来？”贾芸低头道：“没有问得这句话，不敢混说。”王夫人叹了一声，叫他明早先来，别耽误。贾芸应了，退出去时，宝玉却扯住他的袖子，说自己还有一件要问，停了停，又不知该从哪里问起。贾芸道：“二叔有话只管说。”宝玉摇头，将手放开：“明早见罢。”\n \n 宝钗回屋替他拣外衣，麝月拿起今日取回的那件短袖棉衣，说自己穿着去门口也好。宝钗说鞋还须烤干，不能再踩水。麝月摸摸鞋里，尚有潮意，便坐回火边。宝玉看着两人忙，忽然道：“不用弄这些，我只是认一张单。”宝钗将他的袖口翻出来，里头裂了一条，便递给麝月看：“这一处不缝，出门勾住了，再扯坏一片。”宝玉把手伸进去，确实勾着线，只得由她们拿去缝。\n ","import":{"authority_effect":"NONE","candidate":{"path":"artifacts/candidates/ch91/e22f85b4333ae6ebc9c936cfda0dadb704f2b113225aa5fa2ed539f4a10fc414.txt","sha256":"e22f85b4333ae6ebc9c936cfda0dadb704f2b113225aa5fa2ed539f4a10fc414"},"draft":{"path":"data/writing/drafts/ch91/212fb57bbe1d808ad6563bac979b3a0cee7613ada0771f8fd0281efc19d89e56.json","sha256":"212fb57bbe1d808ad6563bac979b3a0cee7613ada0771f8fd0281efc19d89e56"},"execution_basis":"SESSION_AUTHORED_NOT_PROVIDER_VERIFIED","formal_eligibility":false,"human_qualification":false,"input_snapshot":{"path":"artifacts/writing-inputs/manifests/3ade8da98585caf417dabe56a2622e3b4e2553124e116cdd015f2f743ce4d438.json","sha256":"3ade8da98585caf417dabe56a2622e3b4e2553124e116cdd015f2f743ce4d438"},"prepared_request":{"path":"artifacts/writing-requests/49bd8fa36e77b75e8df63d578688d83001f11afa3c68bbb043630c99e7a24d41.json","sha256":"49bd8fa36e77b75e8df63d578688d83001f11afa3c68bbb043630c99e7a24d41"},"qualification":"RESEARCH_ONLY","run":{"path":"artifacts/author-runs/4ac2b26a89ca6b294c4b10038d9bc4449984ee3736820e50031b1b1e8a357cfa.json","sha256":"4ac