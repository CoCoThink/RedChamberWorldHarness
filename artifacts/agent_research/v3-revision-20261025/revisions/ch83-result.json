f4f3e0824f6168204d4114cbc7183322.json","sha256":"d479fbccfc696deec994d5bb55ab5aaef4f3e0824f6168204d4114cbc7183322"},"minimum_baseline_ratio":0.8,"minimum_body_characters":7000,"plock_ref":"NONE","policy":{"path":"data/promotion/policies/agent/ch83.v1.json","sha256":"7d090b6d8776c311b61956d86d41e5f453e9b0b858e139e3fb7e31c5b8981ebf"},"rebind_receipt":{"path":"data/agent_release/rebind-v4/receipts/ch83.json","sha256":"de770dfe3eec7a4380f4eb32180028fc8c5ddb9fd260cb449f868f2fa18a4a24"},"writing_package":{"path":"data/writing/packages/ch83-agent-research-v4.json","sha256":"03e33a42a355c763b00400852373429163fb2674d3cb91e451e588eacc6e3391"}},"diff":"--- v2\n+++ v3\n@@ -42,13 +42,13 @@\n \n 宝玉想起那篮菜，将手里的糕点递向老仆，道：“这个先请你吃，菜的事回头叫人来。”老仆摇手，说自己手上有泥，先收拾靶子。宝玉便叫小厮另取干净纸包一包，等散时留下。那少年拿糕点打趣，问赔菜可会算在今日输赢里。若兰道：“你若连这个也要赢，得先问他肯不肯让你往菜地射。”少年忙说不敢，老仆这才笑了一下，提着茶壶去添水。\n \n-风到午后仍不肯停，小厮们收弓，老仆看着他们把箭一枝枝归拢。借来的弓套已交还，另有临时包弓的一块布却找不着，若兰自己到凳后拾起，抖去草屑，递给经手的小厮，说别又落下一件，回去还得来寻。宝玉站在一旁，等同来的子弟去取马，手指向靶后那棵葱，叫自己人记着。小厮说记着了，又问食盒是不是也带回。宝玉原要说都带，却看见下层的碟子还在旁人手里，便道等碟子收齐，别只拿个空壳回去。\n+风到午后仍不肯停，小厮们收弓，老仆看着他们把箭一枝枝归拢。若兰借来的那只弓套早已交给老仆，另有临时包弓的一块布却找不着，若兰自己到凳后拾起，抖去草屑，递给经手的小厮，说别又落下一件，回去还得来寻。宝玉站在一旁，等同来的子弟去取马，手指向靶后那棵葱，叫自己人记着。小厮说记着了，又问食盒是不是也带回。宝玉原要说都带，却看见下层的碟子还在旁人手里，便道等碟子收齐，别只拿个空壳回去。\n \n-同来的子弟到门边叫他，宝玉过去道别，若兰也走到圃门，向老仆说弓已还，叫别忘记里头的衬布。老仆答应，仍弯腰扣食盒上的搭扣，没有抬头。宝玉回身看了一眼，若兰正避开牵过来的马，衣摆给风掀起，自己伸手按住，随后便和旁人说起出门的事。宝玉也就随同来的子弟出去，圃里又响起小厮叫收箭的声音。\n+同来的子弟到门边叫他，宝玉过去道别，若兰也走到圃门，向老仆说弓套早已交还，叫别忘记里头的衬布。老仆答应，仍弯腰扣食盒上的搭扣，没有抬头。宝玉回身看了一眼，若兰正避开牵过来的马，衣摆给风掀起，自己伸手按住，随后便和旁人说起出门的事。宝玉也就随同来的子弟出去，圃里又响起小厮叫收箭的声音。\n \n 宝玉回到府中，先往里头回过了话，才进自己屋里换衣。袭人见他鞋边有泥，问走到哪里去了。他坐在榻沿，指着鞋笑道：“差一点带一篮菜回来。”袭人原以为又在哪里摘了东西，追问几句，他才说是试箭射到了菜边，已经叫小厮去回管事。袭人听了，道：“你嘴里答应得容易，底下人若只听见要菜，反去讨一篮来，岂不又添一场话？”宝玉忙叫人出去，说自己赔人家的菜，别听反了。传话的人走后，他才将外衣脱下，手腕上还留着袖边勒的印子。\n \n-跟着取食盒的小厮却比他晚回来，到了门外先找管事，回过赔菜的话，又说替人送还弓套的那名仆人也一同到了，问脚费该找谁。管事正忙着别事，只叫他将盒子交下再说。小厮提进去，收盒的媳妇揭盖一看，见里头空着一格，便问少的碟子在哪里。他说散时已经等过，后来是人家拿去分糕，自己急着跟宝二爷回。媳妇将盖子扣回，道：“你既等过，怎么还有这一句？这盒子有去有回，碟子倒不要了？”\n+跟着取食盒的小厮却比他晚回来，到了门外先找管事，回过赔菜的话，又说另替人送还一只弓套到圃里的那名仆人也一同到了，问脚费该找谁。管事正忙着别事，只叫他将盒子交下再说。小厮提进去，收盒的媳妇揭盖一看，见里头空着一格，便问少的碟子在哪里。他说散时已经等过，后来是人家拿去分糕，自己急着跟宝二爷回。媳妇将盖子扣回，道：“你既等过，怎么还有这一句？这盒子有去有回，碟子倒不要了？”\n \n 小厮一听还得再跑，脸便苦了，说外头那个人等着回话，自己也还没吃饭。媳妇道：“谁不让你吃？你先说清那碟子交给谁，省得我替你担着。”他想了想，说是站在老仆身旁那个管茶的小厮接的，等会儿去寻。媳妇这才让他把空盒搁下，叫先回宝二爷一声，别待晚间又问为什么多出一趟脚费。他到帘外候着，听见宝玉在里头说若兰的箭稳，便接话道：“可不是，卫公子腰上那件大金麒麟一动，跟前好几个人都看见了。”\n \n@@ -56,7 +56,7 @@\n \n 那仆人原只想交了弓套便走，如今又听说碟子须去取，站在门边道：“这不是我的差事。我只替你带到圃里，回来怎么又多一趟？”小厮说顺路一道去，取了便回。仆人把弓套的旧包布卷紧，道：“顺路也得先说。我家里还等我，你在这里听公子们说话，倒忘了我。”来收外头东西的婆子听见，劝他先喝口水，帮着问管事，别在门前争。仆人这才坐到一旁，手里的包布仍不放下。\n \n-婆子问他今日射得如何，他说也没有瞧全，自己守在门边候弓套，进去取时见几个公子正收箭，老仆还念着菜地。小厮在旁补道卫公子后来又中了，婆子笑着说宝玉回来只说赔菜，没说别的。那仆人便道：“宝二爷倒记得该记的。卫公子腰上的大金麒麟，他们问了没有？”小厮说自己不曾听见，婆子也没当大事，只说天热了衣裳薄，佩的东西就显了些。说完有人叫她进去，她应着起身，才走两步又回头，叫小厮别只管说闲话，盒子那边还候着他答应。\n+婆子问他今日射得如何，他说也没有瞧全，自己送的那只也已交给老仆，后来守在门边等这小厮同回，进去寻他时见几个公子正收箭，老仆还念着菜地。小厮在旁补道卫公子后来又中了，婆子笑着说宝玉回来只说赔菜，没说别的。那仆人便道：“宝二爷倒记得该记的。卫公子腰上的大金麒麟，他们问了没有？”小厮说自己不曾听见，婆子也没当大事，只说天热了衣裳薄，佩的东西就显了些。说完有人叫她进去，她应着起身，才走两步又回头，叫小厮别只管说闲话，盒子那边还候着他答应。\n \n 湘云正在里头，见那婆子抱了个空食盒进来，便问从哪里来。婆子把盒子往桌边一放，道：“外头回来的，里头还少着碟子，不知谁又得跑一趟。姑娘别拿，才从外头搬来，还没擦。”湘云原伸出的手收回去，笑道：“你抱着空的还这样小心，若装满了，岂不更重？”婆子道：“空了也得交代，今儿为这只盒子，外头说了好半天。”湘云问都说什么，婆子便讲宝玉射箭赔菜，讲到卫公子佩麒麟，她的手停在盒盖上，抬头道：“什么麒麟？”\n ","editorial_notes":{"path":"artifacts/agent_research/v3-revision-20261025/revisions/ch83-editorial-notes.json","sha256":"31a3764d3f0d8b75ea6dc6c0a5ecbd4ed900b4abe8e2783dfd75995aee6496dd"},"import":{"authority_effect":"NONE","candidate":{"path":"artifacts/candidates/ch83/07d1802811e6c8325293be1ba5d5c2781f5b690b4362536f488f109bae1f0d12.txt","sha256":"07d1802811e6c8325293be1ba5d5c2781f5b690b4362536f488f109bae1f0d12"},"draft":{"path":"data/writing/drafts/ch83/d479fbccfc696deec994d5bb55ab5aaef4f3e0824f6168204d4114cbc7183322.json","sha256":"d479fbccfc696deec994d5bb55ab5aaef4f3e0824f6168204d4114cbc7183322"},"execution_basis":"SESSION_AUTHORED_NOT_PROVIDER_VERIFIED","formal_eligibility":false,"human_qualification":false,"input_snapshot":{"path":"artifacts/writing-inputs/manifests/846ea403733f0a1ee90cafa4a62461b12dcc1ac12f3fc72bbb10805cf4827198.json","sha256":"846ea403733f0a1ee90caf