def49c6956cfe3cd0988f5095357f3fc.json","sha256":"4afdcb0c2bfc452669bc78e9a8c0b65edef49c6956cfe3cd0988f5095357f3fc"},"minimum_baseline_ratio":0.8,"minimum_body_characters":7000,"plock_ref":"NONE","policy":{"path":"data/promotion/policies/agent/ch87.v1.json","sha256":"2cd81312b3362a3bfcfc1e38966de361a4922b0fc27c44a21abc6c6fd2ee609b"},"rebind_receipt":{"path":"data/agent_release/rebind-v4/receipts/ch87.json","sha256":"214d481912562b136af23d616e305d0303bc73966bc22e2cbb9e3389984f1005"},"writing_package":{"path":"data/writing/packages/ch87-agent-research-v4.json","sha256":"e99eddb7771c296fb916a9ecf36d0f08790d45f5e2d3e024ff06bdd0fa5bb556"}},"diff":"--- v2\n+++ v3\n@@ -1,6 +1,6 @@\n 第八十七回 贾宝玉成婚谐金玉　薛宝钗随分理新家\n \n-自黛玉去后，又过了几个月。贾母房里的饭桌照旧摆着，人却比先前坐得疏了些；有时说起一个人的口味，说到半句，便换了话。元春的丧事早过了当初奔走传唤的忙乱，服用、往来仍各循着丧中的常例。王夫人遇到外头送来的应酬帖，还叫人先放下，不能像往年一般接着便回。府里的针线房也照旧做活，亮颜色的料子存着，取出来又收进去，管事的人须得多问一声。\n+自黛玉去后，又过了几个月。贾母房里的饭桌照旧摆着，人却比先前坐得疏了些；有时说起一个人的口味，说到半句，便换了话。元春的丧事早过了当初奔走传唤的忙乱，服用、往来仍照家中先前的丧中安排。王夫人遇到外头送来的应酬帖，还叫人先放下，不能像往年一般接着便回。府里的针线房也照旧做活，亮颜色的料子存着，取出来又收进去，管事的人须得多问一声。\n \n 一日薛姨妈来看贾母，见她吃过饭，正叫鸳鸯寻眼镜，便坐在一旁替她将手炉挪近。贾母说：“才说着你，你倒来了。宝丫头这两日做什么？”薛姨妈道：“不过陪我坐坐，做些针线。叫她出来走走，她说我这两日腰疼，放不下。”贾母听了，点头道：“她是个有心的。”说罢又向鸳鸯道：“那东西别找了，越找越没有。”鸳鸯把眼镜放到她手边，笑说原在枕旁。贾母戴上看了一眼，半晌才问王夫人：“前儿说的话，你可同姨太太商量了？”\n \n@@ -22,7 +22,7 @@\n \n 平儿将引枕往前扶，叫她先别说。王夫人见了，也道：“你身子这样，叫底下人来回就是，别自己出去张罗。”凤姐缓过气，仍将纸交回平儿：“太太的事不在我这里等。针线房听太太分派，厨房另有人看着。零碎接不上了，你来问我，不必把每样都送来。”平儿应下。王夫人拿了那纸，原想让凤姐总理一遭的话，也只得不提，临走另叫个管事媳妇到自己房中，先分清来回话的地方。\n \n-这番话以后，内宅尚谈了几回。媒与礼务的回话各送到王夫人、薛姨妈跟前，服用、往来和可办的规模也分别问过；有的事答了，有的又搁下，另等一回。贾母只在听说两边愿意后，叫王夫人照商量妥的做。底下人知道婚事，已经是针线房来取尺寸的时候。廊下一个婆子说老太太要借喜事冲一冲，平儿走过听见，便问她几时得了老太太这句话。婆子含糊一笑，平儿道：“太太叫办哪样，你办哪样，别另给老太太添话。”婆子便低头收起手里的样子。\n+这番话以后，内宅尚谈了几回。媒与礼务的回话各送到王夫人、薛姨妈跟前，服用、往来和可办的规模也分别问过，宫中正式服制的回话却仍未齐。原来棚、满廊彩灯和戏的单子没有放行，两家先理衣被与住处。贾母只在听说两边愿意后，叫王夫人照商量妥的做。底下人知道婚事，已经是针线房来取尺寸的时候。廊下一个婆子说老太太要借喜事冲一冲，平儿走过听见，便问她几时得了老太太这句话。婆子含糊一笑，平儿道：“太太叫办哪样，你办哪样，别另给老太太添话。”婆子便低头收起手里的样子。\n \n 宝钗先从母亲那里知道。那天薛姨妈留她在房中，打发旁人出去，自己却还把针线笸箩留在膝上。说到宝玉，宝钗的手指在缠线的小轴上停住。薛姨妈道：“老太太是这个意思，你姨母也来问过，我同她谈了几回。”宝钗低头将线轴放回去，道：“母亲已想妥了？”薛姨妈说：“该商量的总要商量。我只怕你有话不说。”宝钗不答，过了一会儿，才问：“母亲往后一个人，夜里腰疼，谁替你拿热手巾？”薛姨妈眼圈立刻红了，勉强笑道：“倒叫你先想起这个。”\n \n@@ -42,7 +42,7 @@\n \n 凤姐那边并没有全然不问。平儿拿了回话去，她听说还有人想把廊下都挂满，笑了一声，随即道：“挂给夜里看路的么？有灯便是。丧中本不宜闹，他们偏在这上面逞能。”平儿说太太已驳回了，只来问缺的绸料可再添。凤姐想了想，道：“屋里用的先问薛姨太太，免得两边都买。外头那一些，既说不用，就别又拿少几段来试。”她说完，将头靠回枕上，平儿把剩下的纸折起来。凤姐道：“还没说完呢。”平儿道：“这几桩已经够他们做了。”她便不再强撑，手一松，纸角从指间落了下去。\n \n-日子在一回回往来之后方才定下。成婚那日，没有搭起接连几院的彩棚，原拟的戏也未办，来往只留必要的亲眷。门上有的红绸比旧时少，屋内该用的衣饰却已分别送妥。王夫人叫人看着迎送，不许底下拿缩礼当作怠慢，薛姨妈那里也有人送着妆奁与箱被进来。麝月接被褥时认得是自己送去收边的那床，手摸了一下缝口，便叫抬到里间。厨房按前日改定的数送饭，先后错开，不在一处等齐。一个婆子要另开一桌，被管事媳妇叫住，领到王夫人那里问过，才又回来搬椅子。\n+两家在一回回往来后议定了日子，那套正式服制的回话却始终未齐，原先压下的几张单子也没有再放行。成婚那日，没有搭起接连几院的彩棚，原拟的戏也未办，来往只留必要的亲眷。门上有的红绸比旧时少，屋内该用的衣饰却已分别送妥。王夫人叫人看着迎送，不许底下拿缩礼当作怠慢，薛姨妈那里也有人送着妆奁与箱被进来。麝月接被褥时认得是自己送去收边的那床，手摸了一下缝口，便叫抬到里间。厨房按前日改定的数送饭，先后错开，不在一处等齐。一个婆子要另开一桌，被管事媳妇叫住，领到王夫人那里问过，才又回来搬椅子。\n \n 宝玉穿上衣裳，袭人替他理襟，麝月在旁边寻原先放下的一条带子。她找遍椅背，最后从自己搭着的衣裳里抽出来，袭人道：“方才就说在你那里。”麝月道：“你也没少看这两眼。”宝玉低头让她们系好，抬手时袖子擦到桌上的茶，盏子晃了一下，袭人先扶住了。宝玉便把手放下来。外头催请，他问是否都齐了，袭人说齐了，向旁一让。他走到门边，又回身将搭歪的衣角扯正，才跨出去。麝月拢着余下的衣物，站在帘后看了一眼，便回去收拾床上的零碎。\n ","editorial_notes":{"path":"artifacts/agent_research/v3-revision-20261025/revisions/ch87-editorial-notes.json","sha256":"e0fcc64fe9f281ea62f7058d7ee06a9baf8876283849b6cfdf12ccab8a079ece"},"import":{"authority_effect":"NONE","candidate":{"path":"artifacts/candidates/ch87/fdee0217343a5352c487c4634c3797d0395652d642231f6312ec9b6b3bd95542.txt","sha256":"fdee0217343a5352c487c4634c3797d0395652d642231f6312ec9b6b3bd95542"},"draft":{"path":"data/writing/drafts/ch87/4afdcb0c2bfc452669bc78e9a8c0b65edef49c6956cfe3cd0988f5095357f3fc.json","sha256":"4afdcb0c2bfc452669bc78e9a8c0b65edef49c6956cfe3cd0988f5095357f3fc"},"execution_basis":"SESSION_AUTHORED_NOT_PROVIDER_VERIFIED","formal_eligibility":false,"human_qualification":false,"input_snapshot":{"path":"artifacts/writing-inputs/manifests/4c68c7ab7082a2ba9d472aaa19eff7cde306b0bb16d0ea04639b7c0903aa2abb.json","sha256":"4c68c7ab7082a2ba9d472aaa19eff7cde306b0bb16d0ea04639b7c0903aa2abb"},"prepared_request":{"path":"artifacts/writing-requests/1ba7ed2ab7