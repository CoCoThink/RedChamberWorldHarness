  "issues": [
    {
      "id": "E83-BOW-SLEEVES",
      "chapters": [
        83
      ],
      "findings": "若兰7行已亲交弓套，45行再确认已还；51—59行跑腿者又送还、候取，缺少是否另一物及接手者。选择明确为两只普通弓套，两路均交老仆经手；不指定法定所有人、托送者姓名或麒麟来历。这是v3叙事选择，不声称v2已证明两物。",
      "evidence": [
        {
          "path": "artifacts/candidates/ch83/b219396269ed1f5b1781e7d8e0fedc636c06f21e0fe1e76134c3eeec4948daa8.txt",
          "line": 7,
          "quote": "他将弓套递过去"
        },
        {
          "path": "artifacts/candidates/ch83/b219396269ed1f5b1781e7d8e0fedc636c06f21e0fe1e76134c3eeec4948daa8.txt",
          "line": 45,
          "quote": "借来的弓套已交还"
        },
        {
          "path": "artifacts/candidates/ch83/b219396269ed1f5b1781e7d8e0fedc636c06f21e0fe1e76134c3eeec4948daa8.txt",
          "line": 51,
          "quote": "替人送还弓套的那名仆人"
        },
        {
          "path": "artifacts/candidates/ch83/b219396269ed1f5b1781e7d8e0fedc636c06f21e0fe1e76134c3eeec4948daa8.txt",
          "line": 59,
          "quote": "自己守在门边候弓套，进去取时见几个公子正收箭"
        }
      ],
      "choice": "EDIT_PROSE",
      "rationale": "用另一只及交给老仆解决实际交付链。老仆的经管身份已在射圃出现；物件最终所有权与委托人继续未命名，不倒认若兰、宝玉或某位少年为主人。",
      "acceptance": [
        "读者可分辨若兰亲还的一只与仆人代送的另一只；后者无再次取回已归还之物的动作。",
        "仆人随小厮回府等脚费，而不是把若兰已还之物带回；空食盒、缺碟、脚费及目击转述仍成立。",
        "两只弓套的所有人仍未确证；不把此处身份补叙转用为金麒麟来源证据。"
      ],
      "edits": [
        {
          "chapter": 83,
          "before": "借来的弓套已交还，另有临时包弓的一块布却找不着",
          "after": "若兰借来的那只弓套早已交给老仆，另有临时包弓的一块布却找不着",
          "reason": "前路明确到经手人，保留临时包布。"
        },
        {
          "chapter": 83,
          "before": "向老仆说弓已还，叫别忘记里头的衬布",
          "after": "向老仆说弓套早已交还，叫别忘记里头的衬布",
          "reason": "衬布属于弓套；散场只提醒，不再制造第二次亲交。"
        },
        {
          "chapter": 83,
          "before": "又说替人送还弓套的那名仆人也一同到了",
          "after": "又说另替人送还一只弓套到圃里的那名仆人也一同到了",
          "reason": "明示另一只，不给托送人或所有人安名。"
        },
        {
          "chapter": 83,
          "before": "自己守在门边候弓套，进去取时见几个公子正收箭",
          "after": "自己送的那只也已交给老仆，后来守在门边等这小厮同回，进去寻他时见几个公子正收箭",
          "reason": "补明另一只交付对象，将候物/取物改为等同行人，保留进入圃内时可目见收箭。"
        }
      ]
    },
    {
      "id": "E84-87-MOURNING-UNANSWERED",
      "chapters": [
        84,
        87
      ],
      "findings": "84明置正式服制未回；87只写问过便定日。正文没有足以新增正式许可、豁免或法定届满的材料。可落实的是把未答状态延续到实际筹备，标明哪些旧安排受阻；婚姻仍发生，历史适法性仍未解决。",
      "evidence": [
        {
          "path": "artifacts/candidates/ch84/0acaef1e5b52113c8514d5724526dc30982257ea420d7fbc06222fbb782454c5.txt",
          "line": 89,
          "quote": "宫中正式服制的条目，府里还在候可照办的交代"
        },
        {
          "path": "artifacts/candidates/ch87/86f74726ea7d3819dbc7251350d6ac46f22c14d9d3cff6751940e628edb3e401.txt",
          "line": 25,
          "quote": "服用、往来和可办的规模也分别问过；有的事答了，有的又搁下，另等一回"
        },
        {
          "path": "artifacts/candidates/ch87/86f74726ea7d3819dbc7251350d6ac46f22c14d9d3cff6751940e628edb3e401.txt",
          "line": 45,
          "quote": "日子在一回回往来之后方才定下。"
        },
        {
          "path": "data/planning/contracts/agent-final-v1/87-S3.v2.json",
          "line": 504,
          "quote": "名义认可不等于丧制万能豁免，具体礼法规程不得伪造。"
        }
      ],
      "choice": "EDIT_PROSE",
      "rationale": "选择显式悬置而非虚构回文：正式服制始终未齐，棚、满廊彩灯、戏的旧单未放行；日子由两家议定，不冒称礼务回话给出准婚许可。87初段也标出常例是家中先前安排。84的未回证据保持。",
      "acceptance": [
        "84→87仍能读到同一正式问询未齐，筹备上至少有一项确定未放行的后果。",
        "不得增加制度日期、服满、特许、奉准、权威承诺或婚礼合法/违法结论；家内定日与正式许可分开。",
        "保留黛亡后数月、多次婚议、实婚与夫妻生活；缩礼不能充当已证明合规的替代证据。",
        "此项只能改善未知状态和实际影响的可读性，不能宣称已解决史制适用及婚期合规缺证。"
      ],
      "edits": [
        {
          "chapter": 87,
          "before": "服用、往来仍各循着丧中的常例。",
          "after": "服用、往来仍照家中先前的丧中安排。",
          "reason": "不让常例暗中补成已经取得正式服制。"
        },
        {
          "chapter": 87,
          "before": "服用、往来和可办的规模也分别问过；有的事答了，有的又搁下，另等一回。",
          "after": "服用、往来和可办的规模也分别问过，宫中正式服制的回话却仍未齐。原来棚、满廊彩灯和戏的单子没有放行，两家先理衣被与住处。",
          "reason": "明确未答及具体停办项目，衔接19、43、45行既有缩礼。"
        },
        {
          "chapter": 87,
          "before": "日子在一回回往来之后方才定下。",
          "after": "两家在一回回往来后议定了日子，那套正式服制的回话却始终未齐，原先压下的几张单子也没有再放行。",
          "reason": "定日为两家实际决定；明示成礼前仍未知，而非用定日自动补许可。"
        }
      ]
    },
    {
