      "chapter": 98,
      "draft": {
        "path": "/mnt/d/Code/RedChamberWorldHarness/artifacts/agent_research/phase5/authored/fullbook-ch98-v1.txt",
        "sha256": "2b7fc01ec002c3d687b004d5cbe6ad6bbf5f71c3bb64ecc4cb41e1354a8dc866"
      },
      "notes": [
        {
          "issue": "可选时间指示修正：拜帖约定明日来，叙述已进入“次日一早”并吃过早饭，紧接着又用“次日贾芸”，字面上将约定的来访推到第三日。这是正文自身的时间提示冲突，不是来源UNKNOWN。",
          "quotes": [
            "今日替他送这张帖，明儿带他走一趟。",
            "次日一早，宝玉仍不肯让那把坏椅子靠在客人伸手可及处。",
            "早饭吃过，麝月拿茶末出来，用小匙拨到盏里",
            "次日贾芸果然在前头领路，甄宝玉随后"
          ],
          "proposed_edit": "可把到门段起首的“次日”换成“这时”或“午前”，让备座、早饭、贾芸领客落在同一日；不必补一整天等待，也不必增加新时间制度。",
          "retain": "保留贾芸先问能否接待、宝钗安排饭时和贾芸实际领路；这些已经使会面不靠偶然找门。"
        },
        {
          "issue": "坏椅子的预备写得可信，但“摇验—想钉—再劝停—客到再告诫”在真正相晤前占了多轮同功能停顿。风险是把麝月的声口缩成不断纠正宝玉，而非这几处动作本身有错。",
          "quotes": [
            "宝玉便去看，摇了两下，果然不稳。",
            "宝玉低头见横木旧榫裂了一缝，这才知道不是添一个钉便可了结，将钉收回，没有硬敲。",
            "那里不能坐，横木动了。"
          ],
          "proposed_edit": "可将前夜摇验和次晨试钉的一轮劝阻收拢，留下“旧榫裂了，收回钉子”的具体失败及客到时的提醒。这样木桶真正被坐、茶末真正待客能更早发生，麝月不必在相近动作上连续赢三次口舌。",
          "retain": "保留木桶坐客后装柴、座布折叠、提水不混用客座桶和无钱赠；不要删成抽象的“家贫待客”。"
        },
        {
          "issue": "校书段有几处由叙述者替人物认证“不推年代、不谈真幻、不传播异手”，读者已能从问缺叶、让出纸、回到对书看见这些限度；连用否定说明会使人物像在完成编辑审计。",
          "quotes": [
            "宝玉看见上头有个日期，却不拿日期去推旧册的年头，只问缺叶在什么地方。",
            "并不因此谈起人世真幻，也不说自己可以替他解文章",
            "那张异手零叶没有传到外间，也没有谁再问写字的人。"
          ],
          "proposed_edit": "可择一两处收掉“没有做什么”的旁白，保留实际问缺叶、甄宝玉停抄折断的字、宝玉把异手叶放到自己一侧等可见动作。认字时的停手和嘴角一动足以承担迟见，不需增添解释，更不需凭记忆补出四句。",
          "retain": "保留续庄文字先被看见、异手随后露出、短促反应后回校书和红绳叫卖。原四句未核实，不重构、不改写、不写答诗；此C级亲见不变成黛玉遗言或99出家的原因。"
        },
        {
          "issue": "单次误取的物信链已可追踪，但路上未拆未换、纸仍是哪张、册帕仍是哪件连续由全知旁白背书，末尾认绦头的触觉反而不如这些保证醒目。可读的物理连续性不等于来源层同玉身份已获认证。",
          "quotes": [
            "小厮抱的始终是方才所取的一包，路上并不曾拆，亦没有再换。",
            "纸仍是从贾家桌上抱走的那张，里头仍是那本零册和裹玉旧帕，不另换一个好看的包皮。",
            "玉仍在帕的折里，绦头起毛的地方也还勾着。"
          ],
          "proposed_edit": "可减弱一处全知运输保证，把小厮的自述、甄宝玉打开后发现错册、来人只知受托和宝玉摸到毛绦的先后留作主要支点。故事仍采用同一物包送回的C方案，但反馈不把“始终”“仍是”当作O03或与雪玉同一性的独立证据。",
          "retain": "保留两只相邻包与一次错取的区别、旧帕裹玉、错册暴露错误、甄家先发现而贾家后知，以及收到后换绦、抄字、吃饭；不加第二次掉包。"
        },
        {
          "issue": "运输接口确实未解决：本稿明确由送信人返包，甄宝玉留在甄家；“须亲交屋里收件的人”只是信使当面交付，不是章卡四链的甄宝玉“亲送”。这不是把委托解释成亲送就能抹去的差别，也不是未注册角色本身构成文学失败。",
          "quotes": [
            "叫一个送信的人立即送还，嘱咐到了门口先说明是甄家退还误取的书包，须亲交屋里收件的人，不能放下就走。",
            "来人只知甄宝玉叫他送这包，不曾在客座上看见怎么取",
            "写完给来人，来人问可有另包要带，宝玉说眼下不带"
          ],
          "proposed_edit": "可将“运输接口待裁定”保留为稿外协调事项，而非在人物嘴里加辩护。未获上游选择前，不建议仅换一个“亲”字、增添陪送或声称已兼容；若将来另获明确授权选择本人送回，才按该选择重接返家与交付的动作。此意见不要求当前强改，也不改章卡或OT来源。",
          "retain": "保留甄宝玉承认自己指包不清的责任、来人不替小厮编经过、验收回札及无钱物。当前选择沿messenger流，但card亲送与OT信使路线继续UNRESOLVED。"
        }
      ],
