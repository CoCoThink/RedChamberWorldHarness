{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChapterPlan",
  "type": "object",
  "required": [
    "chapter",
    "title",
    "title_status",
    "status",
    "authority_effect",
    "scenes",
    "entry_ref",
    "exit_ref",
    "threads",
    "protections",
    "open_refs",
    "unresolved"
  ],
  "properties": {
    "chapter": {
      "type": "integer",
      "minimum": 1
    },
    "title": {
      "type": "string"
    },
    "title_status": {
      "type": "string"
    },
    "status": {
      "enum": [
        "DRAFT_IMPORTED",
        "DRAFT_GENERATED",
        "AGENT_EDITED",
        "EDITED"
      ]
    },
    "authority_effect": {
      "const": "NONE"
    },
    "evidence_effect": {
      "const": "NONE"
    },
    "source": {
      "$ref": "#/$defs/citation"
    },
    "card_fields": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "number",
          "name",
          "text",
          "citation"
        ],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 18
          },
          "name": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "citation": {
            "$ref": "#/$defs/citation"
          }
        },
        "additionalProperties": false
      }
    },
    "source_records": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "scenes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "order",
          "ref"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "ref": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      }
    },
    "existing_contracts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "entry_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "exit_ref": {
      "type": [
        "string",
        "null"
      ]
    },
    "threads": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "protections": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "open_refs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "citation": {
      "type": "object",
      "required": [
        "path",
        "sha256",
        "lines",
        "byte_range",
        "text_sha256"
      ],
      "properties": {
        "path": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "text_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "lines": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 1
          }
        },
        "byte_range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "integer",
            "minimum": 0
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
