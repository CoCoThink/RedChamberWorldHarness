{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceClaim",
  "type": "object",
  "required": ["id", "statement", "kind", "support", "status"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "statement": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "minLength": 1},
    "role": {
      "enum": [
        "TITLE_FULL",
        "TITLE_PART",
        "DRAFT_LABEL",
        "CHAPTER_CALL",
        "WORK_TITLE",
        "FUTURE_LINE",
        "FUTURE_SPEECH",
        "EVENT",
        "SCENE_DESCRIPTION",
        "STRUCTURE",
        "CRITIC_DESCRIPTION",
        "W2_HINT",
        "FORMAL_TITLE",
        "OTHER"
      ]
    },
    "modality": {
      "enum": [
        "DIRECT_ASSERTION",
        "SEEN_COPY",
        "TRANSCRIPT_WEAK",
        "INFERENCE",
        "NEGATIVE"
      ]
    },
    "literal_targets": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "NOVEL_EXACT",
          "NAME_EXACT",
          "SOURCE_EXACT",
          "SEM",
          "BOUNDARY",
          "NEG"
        ]
      }
    },
    "t_axis": {
      "type": ["string", "null"],
      "enum": ["T0", "T1", "T2", "T2_W2", "T3", "TG", null]
    },
    "support": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "relation"],
        "properties": {
          "source": {"type": "string"},
          "relation": {
            "enum": ["DIRECT", "SEMANTIC", "CONTEXTUAL", "ANALOGICAL", "SECONDARY"]
          },
          "note": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "status": {
      "enum": ["SUPPORTED", "CONTESTED", "NOT_ESTABLISHED", "REFUTED"]
    },
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
