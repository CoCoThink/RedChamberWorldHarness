{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RCWH M8 Completion Gate State",
  "type": "object",
  "required": [
    "milestone",
    "status",
    "migration_release",
    "milestone_status",
    "coverage_signoff",
    "required_query_surfaces",
    "boundary_invariants",
    "traceability",
    "completion_gate",
    "literature"
  ],
  "properties": {
    "milestone": {
      "const": "M8"
    },
    "status": {
      "type": "string"
    },
    "migration_release": {
      "type": "object"
    },
    "milestone_status": {
      "type": "object"
    },
    "coverage_signoff": {
      "type": "object",
      "required": [
        "signed",
        "p0_total",
        "p0_full",
        "p0_partial",
        "p0_minimal",
        "p0_none",
        "current_documents",
        "current_full",
        "current_markdown_islands",
        "unresolved_authority_conflicts"
      ],
      "properties": {
        "signed": {
          "const": true
        },
        "p0_total": {
          "const": 249
        },
        "p0_full": {
          "const": 249
        },
        "p0_partial": {
          "const": 0
        },
        "p0_minimal": {
          "const": 0
        },
        "p0_none": {
          "const": 0
        },
        "current_documents": {
          "const": 15
        },
        "current_full": {
          "const": 15
        },
        "current_markdown_islands": {
          "const": 0
        },
        "unresolved_authority_conflicts": {
          "const": 0
        }
      },
      "additionalProperties": false
    },
    "required_query_surfaces": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "uniqueItems": true
    },
    "boundary_invariants": {
      "type": "object"
    },
    "traceability": {
      "type": "object"
    },
    "completion_gate": {
      "type": "object"
    },
    "literature": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
