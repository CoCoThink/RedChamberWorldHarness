{
 "$schema":"https://json-schema.org/draft/2020-12/schema", "type":"object", "additionalProperties":false,
 "required":["schema_version","status","authority_effect","scope","entry_after_chapter","characters","facts","unknowns"],
 "properties":{
  "schema_version":{"const":1},"status":{"const":"DRAFT_UNREVIEWED"},"authority_effect":{"const":"NONE"},
  "scope":{"const":"ISOLATED_BACKTEST_ONLY"},"entry_after_chapter":{"const":78},
  "characters":{"type":"array","uniqueItems":true,"items":{"type":"string","minLength":1}},
  "facts":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["description","source_refs"],"properties":{"description":{"type":"string","minLength":1},"source_refs":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/source"}}}}},
  "unknowns":{"type":"array","items":{"type":"string","minLength":1}}
 },
 "$defs":{"source":{"type":"object","additionalProperties":false,"required":["segment_id","text_sha256"],"properties":{"segment_id":{"type":"string","minLength":1},"text_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}}
}
