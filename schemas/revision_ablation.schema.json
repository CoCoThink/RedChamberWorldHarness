{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RCWH Cross-route Revision Ablation v0.14",
  "type": "object",
  "required": [
    "id",
    "authority",
    "output_authority",
    "source_basis",
    "design",
    "anti_pattern_rules",
    "strict_reduction_tokens",
    "lexical_equivalence",
    "thresholds",
    "pairs",
    "policy",
    "next_gate",
    "schema_version"
  ],
  "properties": {
    "id": {
      "const": "cross-route-revision-ablation:v0.14"
    },
    "authority": {
      "const": "SHADOW_ONLY"
    },
    "output_authority": {
      "const": "EXPERIMENTAL_REVISION_ONLY"
    },
    "source_basis": {
      "type": "object",
      "required": [
        "p6_ref",
        "p7_ref",
        "p5_ref",
        "p6_snapshot_sha256",
        "p7_snapshot_sha256"
      ],
      "properties": {
        "p6_ref": {
          "const": "controlled-microdraft:v0.12"
        },
        "p7_ref": {
          "const": "blind-microdraft-review:v0.13"
        },
        "p5_ref": {
          "const": "narrative-discourse:v0.11"
        },
        "p6_snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "p7_snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "design": {
      "type": "object"
    },
    "anti_pattern_rules": {
      "type": "object"
    },
    "strict_reduction_tokens": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "lexical_equivalence": {
      "type": "object"
    },
    "thresholds": {
      "type": "object"
    },
    "pairs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "baseline_token",
          "revised_token",
          "applied_targets",
          "revised_artifact"
        ],
        "properties": {
          "baseline_token": {
            "type": "string"
          },
          "revised_token": {
            "type": "string"
          },
          "applied_targets": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "revised_artifact": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "policy": {
      "type": "object",
      "properties": {
        "competition_effect": {
          "const": "NONE"
        }
      },
      "required": [
        "competition_effect"
      ]
    },
    "next_gate": {
      "enum": [
        "P8_CI_THEN_P9_PAIRED_BLIND_REVISION_REVIEW",
        "P9_PAIRED_BLIND_REVISION_REVIEW"
      ]
    },
    "schema_version": {
      "const": 1
    }
  },
  "additionalProperties": false
}
