{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RCWH Migration Registry Extension",
  "type": "object",
  "required": [
    "milestone",
    "document_additions",
    "document_overrides",
    "current_authority_override",
    "content_hash_additions"
  ],
  "properties": {
    "milestone": {
      "const": "M2"
    },
    "document_additions": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8
    },
    "content_hash_additions": {
      "type": "array",
      "minItems": 8,
      "maxItems": 8
    },
    "document_overrides": {
      "type": "object",
      "minProperties": 1
    },
    "current_authority_override": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
