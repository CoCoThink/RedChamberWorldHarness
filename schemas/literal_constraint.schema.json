{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LiteralConstraint",
  "type": "object",
  "required": ["id","text","targets","scope","claim_refs","decision_refs","required_in_active_prose","implementation_refs"],
  "properties": {
    "id":{"type":"string","minLength":1},
    "text":{"type":"string","minLength":1},
    "targets":{"type":"array","minItems":1,"uniqueItems":true,"items":{"enum":["NOVEL_EXACT","NAME_EXACT","SOURCE_EXACT","SEM","BOUNDARY","NEG"]}},
    "scope":{"enum":["PROSE","WORK_NAME","SOURCE_ONLY","SEMANTIC"]},
    "claim_refs":{"type":"array","minItems":1,"items":{"type":"string"},"uniqueItems":true},
    "decision_refs":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "required_in_active_prose":{"type":"boolean"},
    "implementation_refs":{"type":"array","items":{"type":"string"},"uniqueItems":true},
    "boundary":{"type":"object","required":["description","claim_ref"],"properties":{"description":{"type":"string","minLength":1},"claim_ref":{"type":"string","minLength":1}},"additionalProperties":false},
    "notes":{"type":["string","null"]}
  },
  "additionalProperties": true
}
