{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RCWH M7 Registry Extension",
  "type": "object",
  "required": [
    "milestone",
    "document_additions",
    "content_hash_additions",
    "document_overrides",
    "current_authority_override"
  ],
  "properties": {
    "milestone": {
      "const": "M7"
    },
    "document_additions": {
      "type": "array",
      "maxItems": 0
    },
    "content_hash_additions": {
      "type": "array",
      "maxItems": 0
    },
    "document_overrides": {
      "type": "object",
      "minProperties": 5,
      "maxProperties": 5
    },
    "current_authority_override": {
      "type": "object",
      "required": [
        "coverage_runtime",
        "p0_total",
        "p0_full",
        "p0_partial",
        "p0_minimal",
        "p0_none",
        "semantic_coverage_counts",
        "current_markdown_islands",
        "unresolved_authority_conflicts",
        "coverage_report_signed_off",
        "completion_gate_ready"
      ],
      "properties": {
        "coverage_runtime": {
          "type": "string"
        },
        "p0_total": {
          "const": 249
        },
        "p0_full": {
          "const": 249
        },
        "p0_partial": {
          "const": 0
        },
        "p0_minimal": {
          "const": 0
        },
        "p0_none": {
          "const": 0
        },
        "current_markdown_islands": {
          "const": 0
        },
        "unresolved_authority_conflicts": {
          "const": 0
        },
        "coverage_report_signed_off": {
          "const": false
        },
        "completion_gate_ready": {
          "const": false
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
