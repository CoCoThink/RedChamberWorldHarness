{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "layout", "assets", "origins"],
  "properties": {
    "schema_version": {"const": 2}, "layout": {"const": "ID_SHA256_PREFIX_V1"},
    "assets": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^data/catalog/assets/[0-9a-f]{2}\\.yaml$"}},
    "origins": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^data/catalog/origins/[0-9a-f]{2}\\.jsonl$"}}
  }
}
