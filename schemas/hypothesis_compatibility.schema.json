{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"RCWH Hypothesis Compatibility v0.7",
  "type":"object",
  "required":["id","status","authority","rule","mutually_exclusive_groups","conditional_relations","evidence_effect","stable_active_effect"],
  "properties":{
    "id":{"const":"hypothesis-compatibility:v0.7"},
    "status":{"enum":["PASS_CANDIDATE","PASS"]},
    "authority":{"const":"SHADOW_ONLY"},
    "rule":{"type":"string","minLength":1},
    "mutually_exclusive_groups":{"type":"array","items":{"type":"array","minItems":2,"uniqueItems":true,"items":{"type":"string"}}},
    "conditional_relations":{"type":"array","items":{"type":"object","required":["left","right","relation","note"],"properties":{"left":{"type":"string"},"right":{"type":"string"},"relation":{"enum":["CONDITIONAL","COMPATIBLE","W2_ONLY"]},"note":{"type":"string"}},"additionalProperties":false}},
    "evidence_effect":{"const":"NONE"},
    "stable_active_effect":{"const":"NONE"}
  },
  "additionalProperties":false
}
