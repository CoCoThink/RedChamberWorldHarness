{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "protocol_sha256",
    "packet_sha256",
    "reviewer",
    "raw_review",
    "pairs",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "protocol_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "packet_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "independent_of_authors",
        "mapping_unseen_during_review"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "INDEPENDENT_HUMAN"
        },
        "independent_of_authors": {
          "const": true
        },
        "mapping_unseen_during_review": {
          "const": true
        }
      }
    },
    "raw_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_ref",
        "sha256"
      ],
      "properties": {
        "asset_ref": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "pairs": {
      "type": "array",
      "uniqueItems": true,
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "pair_id",
          "preference",
          "scores",
          "reason"
        ],
        "properties": {
          "pair_id": {
            "type": "string",
            "minLength": 1
          },
          "preference": {
            "enum": [
              "A",
              "B",
              "TIE",
              "NEITHER"
            ]
          },
          "scores": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "A",
                "B"
              ],
              "properties": {
                "A": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                },
                "B": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 5
                }
              }
            }
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "authority_effect": {
      "const": "NONE"
    }
  }
}
