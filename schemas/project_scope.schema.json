{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["schema_version", "chapters"],
  "properties": {
    "schema_version": {"const": 1},
    "chapters": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "integer", "minimum": 1}
    }
  },
  "additionalProperties": false
}
