{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RCWH M6 Implementation Alignment",
  "type": "object",
  "required": [
    "epistemic_rule",
    "sources",
    "stable_release",
    "chapter_plans",
    "implementation_facts",
    "chapter_protections",
    "cross_chapter_protections",
    "specialized_plocks",
    "invariants",
    "schema_version",
    "object_query_locations"
  ],
  "properties": {
    "epistemic_rule": {
      "type": "string",
      "minLength": 50
    },
    "sources": {
      "type": "object",
      "minProperties": 1
    },
    "stable_release": {
      "type": "object",
      "required": [
        "release_id",
        "file_ref",
        "asset_ref",
        "sha256",
        "line_count",
        "mutable",
        "authority",
        "chapters"
      ],
      "properties": {
        "release_id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "line_count": {
          "type": "integer",
          "minimum": 1
        },
        "chapters": {
          "type": "array",
          "minItems": 1
        },
        "mutable": {
          "const": false
        }
      },
      "additionalProperties": true
    },
    "chapter_plans": {
      "type": "array",
      "minItems": 1
    },
    "implementation_facts": {
      "type": "array",
      "minItems": 1
    },
    "chapter_protections": {
      "type": "array",
      "minItems": 1
    },
    "cross_chapter_protections": {
      "type": "array",
      "minItems": 1
    },
    "specialized_plocks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "chapter"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "chapter": {
            "type": "integer",
            "minimum": 1
          }
        },
        "additionalProperties": false
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 1
    },
    "schema_version": {
      "const": 1
    },
    "object_query_locations": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[1-9][0-9]*$"
      },
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "additionalProperties": false
}
