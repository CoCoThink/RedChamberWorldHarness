{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RCWH Blind Microdraft Review v0.13",
  "type": "object",
  "required": [
    "id",
    "status",
    "authority",
    "output_authority",
    "source_basis",
    "reviews",
    "cell_rankings",
    "scenario_summary",
    "cross_cell_findings",
    "interpretation_policy",
    "revision_targets",
    "policy",
    "next_gate",
    "schema_version",
    "verdict_categories"
  ],
  "properties": {
    "id": {
      "const": "blind-microdraft-review:v0.13"
    },
    "status": {
      "enum": [
        "PASS_CANDIDATE",
        "PASS"
      ]
    },
    "authority": {
      "const": "SHADOW_ONLY"
    },
    "output_authority": {
      "const": "BLIND_REVIEW_SIGNAL_ONLY"
    },
    "source_basis": {
      "type": "object",
      "required": [
        "microdraft_ref",
        "raw_review_asset_ref",
        "reviewer_provenance",
        "independence_verification",
        "mapping_unsealed_after_review",
        "microdraft_snapshot_sha256"
      ],
      "properties": {
        "microdraft_ref": {
          "const": "controlled-microdraft:v0.12"
        },
        "reviewer_provenance": {
          "const": "USER_SUPPLIED_AS_INDEPENDENT_BLIND_REVIEW"
        },
        "independence_verification": {
          "const": "USER_ATTESTED_NOT_SYSTEM_VERIFIED"
        },
        "mapping_unsealed_after_review": {
          "const": true
        },
        "raw_review_asset_ref": {
          "type": "string",
          "pattern": "^asset:"
        },
        "microdraft_snapshot_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "token",
          "verdict",
          "engineering_feel"
        ],
        "properties": {
          "token": {
            "type": "string"
          },
          "verdict": {
            "type": "string"
          },
          "engineering_feel": {
            "enum": [
              "低",
              "中",
              "高"
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "cell_rankings": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "type": "string"
        }
      },
      "minProperties": 1
    },
    "scenario_summary": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "status",
          "note"
        ],
        "properties": {
          "status": {
            "enum": [
              "ROBUST_KEEP",
              "ROBUST_KEEP_WITH_W4_REPAIR",
              "KEEP_FOR_TARGETED_REPAIR"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "cross_cell_findings": {
      "type": "object"
    },
    "interpretation_policy": {
      "type": "object"
    },
    "revision_targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "policy": {
      "type": "object",
      "required": [
        "evidence_effect",
        "open_interface_effect",
        "stable_active_effect",
        "canonical_prose_effect",
        "automatic_winner",
        "automatic_route_elimination",
        "competition_effect"
      ],
      "properties": {
        "evidence_effect": {
          "const": "NONE"
        },
        "open_interface_effect": {
          "const": "NONE"
        },
        "stable_active_effect": {
          "const": "NONE"
        },
        "canonical_prose_effect": {
          "const": "NONE"
        },
        "automatic_winner": {
          "const": false
        },
        "automatic_route_elimination": {
          "const": false
        },
        "competition_effect": {
          "const": "NONE"
        }
      },
      "additionalProperties": false
    },
    "next_gate": {
      "enum": [
        "P7_CI_THEN_P8_CROSS_ROUTE_REVISION_ABLATION",
        "P8_CROSS_ROUTE_REVISION_ABLATION"
      ]
    },
    "schema_version": {
      "const": 1
    },
    "verdict_categories": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "enum": [
          "PASS",
          "EDGE",
          "FAIL"
        ]
      }
    }
  },
  "additionalProperties": false
}
