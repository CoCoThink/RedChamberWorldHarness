{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RCWH Blind Microdraft Review v0.13",
  "type": "object",
  "required": [
    "id",
    "milestone",
    "status",
    "authority",
    "output_authority",
    "source_basis",
    "reviews",
    "cell_rankings",
    "scenario_summary",
    "cross_cell_findings",
    "interpretation_policy",
    "revision_targets",
    "policy",
    "next_gate"
  ],
  "properties": {
    "id": {
      "const": "blind-microdraft-review:v0.13"
    },
    "milestone": {
      "const": "P7"
    },
    "status": {
      "enum": [
        "PASS_CANDIDATE",
        "PASS"
      ]
    },
    "authority": {
      "const": "SHADOW_ONLY"
    },
    "output_authority": {
      "const": "BLIND_REVIEW_SIGNAL_ONLY"
    },
    "source_basis": {
      "type": "object",
      "required": [
        "microdraft_ref",
        "raw_review_path",
        "sealed_mapping_path",
        "reviewer_provenance",
        "independence_verification",
        "mapping_unsealed_after_review"
      ],
      "properties": {
        "microdraft_ref": {
          "const": "controlled-microdraft:v0.12"
        },
        "raw_review_path": {
          "type": "string"
        },
        "sealed_mapping_path": {
          "type": "string"
        },
        "reviewer_provenance": {
          "const": "USER_SUPPLIED_AS_INDEPENDENT_BLIND_REVIEW"
        },
        "independence_verification": {
          "const": "USER_ATTESTED_NOT_SYSTEM_VERIFIED"
        },
        "mapping_unsealed_after_review": {
          "const": true
        }
      },
      "additionalProperties": false
    },
    "reviews": {
      "type": "array",
      "minItems": 20,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": [
          "token",
          "cell_id",
          "verdict",
          "engineering_feel",
          "top2",
          "rank"
        ],
        "properties": {
          "token": {
            "type": "string"
          },
          "cell_id": {
            "type": "string",
            "pattern": "^W[1-5]$"
          },
          "verdict": {
            "type": "string"
          },
          "engineering_feel": {
            "enum": [
              "低",
              "中",
              "高"
            ]
          },
          "top2": {
            "type": "boolean"
          },
          "rank": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4
          }
        },
        "additionalProperties": false
      }
    },
    "cell_rankings": {
      "type": "object",
      "required": [
        "W1",
        "W2",
        "W3",
        "W4",
        "W5"
      ],
      "additionalProperties": {
        "type": "array",
        "minItems": 4,
        "maxItems": 4,
        "uniqueItems": true,
        "items": {
          "type": "string"
        }
      }
    },
    "scenario_summary": {
      "type": "object",
      "minProperties": 4,
      "additionalProperties": {
        "type": "object",
        "required": [
          "rank_sum",
          "mean_rank",
          "first_place_count",
          "top2_count",
          "verdict_counts",
          "engineering_counts",
          "status",
          "note"
        ],
        "properties": {
          "rank_sum": {
            "type": "integer"
          },
          "mean_rank": {
            "type": "number"
          },
          "first_place_count": {
            "type": "integer"
          },
          "top2_count": {
            "type": "integer"
          },
          "verdict_counts": {
            "type": "object"
          },
          "engineering_counts": {
            "type": "object"
          },
          "status": {
            "enum": [
              "ROBUST_KEEP",
              "ROBUST_KEEP_WITH_W4_REPAIR",
              "KEEP_FOR_TARGETED_REPAIR"
            ]
          },
          "note": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "cross_cell_findings": {
      "type": "object"
    },
    "interpretation_policy": {
      "type": "object"
    },
    "revision_targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "policy": {
      "type": "object",
      "required": [
        "evidence_effect",
        "open_interface_effect",
        "stable_active_effect",
        "canonical_prose_effect",
        "chapter89_competition_effect",
        "automatic_winner",
        "automatic_route_elimination"
      ],
      "properties": {
        "evidence_effect": {
          "const": "NONE"
        },
        "open_interface_effect": {
          "const": "NONE"
        },
        "stable_active_effect": {
          "const": "NONE"
        },
        "canonical_prose_effect": {
          "const": "NONE"
        },
        "chapter89_competition_effect": {
          "const": "NONE"
        },
        "automatic_winner": {
          "const": false
        },
        "automatic_route_elimination": {
          "const": false
        }
      },
      "additionalProperties": false
    },
    "next_gate": {
      "enum": [
        "P7_CI_THEN_P8_CROSS_ROUTE_REVISION_ABLATION",
        "P8_CROSS_ROUTE_REVISION_ABLATION"
      ]
    }
  },
  "additionalProperties": false
}
