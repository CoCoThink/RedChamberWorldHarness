{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "R4RegressionManifest",
  "type": "object",
  "required": [
    "id",
    "stable_active",
    "axis_expectations",
    "literal_expectations",
    "mechanism_verdicts",
    "locked_decisions",
    "current_decisions",
    "open_decisions",
    "legacy_hard_evidence_requires_source"
  ],
  "properties": {
    "id": {
      "const": "R4_EVIDENCE_CORE_V0_2_BETA"
    },
    "stable_active": {
      "type": "object",
      "required": [
        "file_ref",
        "sha256"
      ],
      "properties": {
        "file_ref": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "axis_expectations": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "T0",
          "T1",
          "T2",
          "T2_W2",
          "T3",
          "TG"
        ]
      }
    },
    "literal_expectations": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "minItems": 1,
        "uniqueItems": true,
        "items": {
          "enum": [
            "NOVEL_EXACT",
            "NAME_EXACT",
            "SOURCE_EXACT",
            "SEM",
            "BOUNDARY",
            "NEG"
          ]
        }
      }
    },
    "mechanism_verdicts": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "PASS",
          "PASS-WITH-CAUTION",
          "PASS-BOUNDARY",
          "PASS-SOFT"
        ]
      }
    },
    "locked_decisions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "current_decisions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "open_decisions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "legacy_hard_evidence_requires_source": {
      "const": true
    }
  },
  "additionalProperties": true
}
