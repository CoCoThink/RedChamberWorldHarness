{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "id", "status", "authority_effect", "dataset_ref", "manifest_sha256", "edition_asset_ref", "holdout_chapters", "original_chapter_units", "retrieval_exclude_chapters", "style_exclude_chapters", "shared_task", "world", "exemplar_segment_ids", "samples_per_workflow", "budget", "limitations"],
  "properties": {
    "schema_version": {"const": 1}, "id": {"type": "string", "minLength": 1},
    "status": {"const": "DRAFT_UNREVIEWED"}, "authority_effect": {"const": "NONE"},
    "dataset_ref": {"type": "string", "minLength": 1}, "manifest_sha256": {"$ref": "#/$defs/sha"},
    "edition_asset_ref": {"type": "string", "minLength": 1},
    "holdout_chapters": {"const": [79, 80]}, "original_chapter_units": {"const": 1},
    "retrieval_exclude_chapters": {"const": [79, 80]}, "style_exclude_chapters": {"const": [79, 80]},
    "shared_task": {"$ref": "#/$defs/binding"}, "world": {"$ref": "#/$defs/binding"},
    "exemplar_segment_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "samples_per_workflow": {"type": "integer", "minimum": 2},
    "budget": {
      "type": "object", "additionalProperties": false,
      "required": ["model", "max_total_tokens_per_sample", "max_requests_per_sample", "max_output_tokens_per_request", "revision_reserve_tokens", "revision_reserve_requests", "minimum_characters", "maximum_characters"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "max_total_tokens_per_sample": {"type": "integer", "minimum": 2},
        "max_requests_per_sample": {"type": "integer", "minimum": 2},
        "max_output_tokens_per_request": {"type": "integer", "minimum": 1},
        "revision_reserve_tokens": {"type": "integer", "minimum": 1},
        "revision_reserve_requests": {"type": "integer", "minimum": 1},
        "minimum_characters": {"type": "integer", "minimum": 1},
        "maximum_characters": {"type": "integer", "minimum": 1}
      }
    },
    "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "binding": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/sha"}}}
  }
}
