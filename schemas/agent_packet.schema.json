{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research Agent Packet",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "packet_kind", "id", "coordinator_session_id", "subjects", "authority_effect", "usage"],
  "properties": {
    "schema_version": {"const": 1},
    "packet_kind": {"const": "AGENT_REVIEW_PACKET"},
    "id": {"$ref": "#/$defs/label"},
    "coordinator_session_id": {"$ref": "#/$defs/label"},
    "subjects": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/subject"}},
    "authority_effect": {"const": "NONE"},
    "usage": {"const": "RESEARCH_ONLY"}
  },
  "$defs": {
    "label": {"type": "string", "minLength": 1, "pattern": "\\S"},
    "binding": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*\\\\)(?!.*:)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*/$).*\\S.*$"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    },
    "sample": {
      "type": "object", "additionalProperties": false, "required": ["id", "binding"],
      "properties": {"id": {"$ref": "#/$defs/label"}, "binding": {"$ref": "#/$defs/binding"}}
    },
    "subject": {
      "type": "object", "additionalProperties": false, "required": ["id", "scope", "binding"],
      "properties": {
        "id": {"$ref": "#/$defs/label"},
        "scope": {"enum": ["SOURCE", "CORPUS", "CANDIDATE", "SCENE", "CONTRACT", "BACKTEST", "PLAN", "PROVENANCE", "ASSET", "PACKAGE", "BOOK"]},
        "review_policy": {"const": "ADVISORY"},
        "chapters": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
        "binding": {"$ref": "#/$defs/binding"},
        "source_ref": {"$ref": "#/$defs/label"},
        "evidence": {"$ref": "#/$defs/binding"},
        "context": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/binding"}},
        "dataset_ref": {"$ref": "#/$defs/label"},
        "samples": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sample"}}
      },
      "allOf": [
        {"if": {"required": ["chapters"]}, "then": {"properties": {"scope": {"const": "BOOK"}}}},
        {"if": {"properties": {"scope": {"const": "BOOK"}}}, "then": {"required": ["review_policy"]}, "else": {"not": {"required": ["review_policy"]}}},
        {"if": {"properties": {"scope": {"const": "SOURCE"}}}, "then": {"required": ["source_ref"]}},
        {"if": {"properties": {"scope": {"const": "CORPUS"}}}, "then": {"required": ["dataset_ref", "samples"]}}
      ]
    }
  }
}
