{
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "minimum_reviewers",
    "questions",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "minimum_reviewers": {
      "type": "integer",
      "minimum": 2
    },
    "questions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "authority_effect": {
      "const": "NONE"
    }
  },
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
