{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReconstructionDecision",
  "type": "object",
  "required": ["id", "statement", "based_on", "status", "constraint", "reversible"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "statement": {"type": "string", "minLength": 1},
    "based_on": {"type": "array", "items": {"type": "string"}},
    "domain": {"enum": ["NARRATIVE_RECONSTRUCTION", "HISTORICAL_BOUNDARY"]},
    "status": {"enum": ["LOCKED", "CURRENT", "OPEN", "REJECTED"]},
    "constraint": {"enum": ["MUST", "MUST_NOT", "MAY", "OPEN", "NONE"]},
    "reversible": {"type": "boolean"},
    "reasoning": {"type": "array", "items": {"type": "string"}},
    "implementation_refs": {"type": "array", "items": {"type": "string"}},
    "project_refs": {"type": "array", "items": {"type": "string"}},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": true
}
