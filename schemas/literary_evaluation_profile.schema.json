{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LiteraryEvaluationProfile",
  "type": "object",
  "required": ["id", "plock_ref", "blocker_checks", "feature_signals", "manual_review_required"],
  "properties": {
    "id": {"type": "string", "pattern": "^leval:ch(86|89|92|97|100):[a-z0-9-]+$"},
    "plock_ref": {"type": "string", "minLength": 1},
    "blocker_checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "any_text", "reason"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "any_text": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "reason": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "feature_signals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["feature_ref", "groups"],
        "properties": {
          "feature_ref": {"type": "string", "minLength": 1},
          "groups": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "minLength": 1}
            }
          },
          "notes": {"type": ["string", "null"]}
        },
        "additionalProperties": false
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "terms", "label"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "terms": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "label": {"type": "string", "minLength": 1}
        },
        "additionalProperties": false
      }
    },
    "manual_review_required": {"const": true},
    "notes": {"type": ["string", "null"]}
  },
  "additionalProperties": false
}
