{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "kind", "request", "current_request_path", "review_basis_sha256", "batch_size", "max_attempts", "max_read_bytes", "jobs", "authority_effect", "usage"],
  "properties": {
    "schema_version": {"const": 1}, "kind": {"const": "AGENT_REVIEW_CAMPAIGN"},
    "request": {"$ref": "#/$defs/binding"}, "batch_size": {"type": "integer", "minimum": 1, "maximum": 6},
    "current_request_path": {"type": "string", "minLength": 1}, "review_basis_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "max_attempts": {"type": "integer", "minimum": 1, "maximum": 5}, "max_read_bytes": {"type": "integer", "minimum": 1},
    "jobs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/job"}},
    "authority_effect": {"const": "NONE"}, "usage": {"const": "RESEARCH_ONLY"}
  },
  "$defs": {
    "binding": {"type": "object", "additionalProperties": false, "required": ["path", "sha256"], "properties": {
      "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}},
    "job": {"type": "object", "additionalProperties": false,
      "required": ["id", "kind", "chapter", "packet", "subjects", "read_in_full", "samples", "reading_bytes", "exceeds_budget", "severity", "gate_effect"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9-]+$"}, "kind": {"enum": ["CHAPTER", "SOURCE", "CORPUS", "BOOK"]},
        "chapter": {"type": ["integer", "null"]}, "packet": {"$ref": "#/$defs/binding"},
        "subjects": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
        "read_in_full": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/binding"}},
        "samples": {"type": "array", "items": {"type": "object", "additionalProperties": false,
          "required": ["subject_id", "id", "binding"], "properties": {
            "subject_id": {"type": "string"}, "id": {"type": "string"}, "binding": {"$ref": "#/$defs/binding"}, "reading": {"$ref": "#/$defs/binding"}}}},
        "reading_bytes": {"type": "integer", "minimum": 0}, "exceeds_budget": {"type": "boolean"},
        "severity": {"enum": ["ADVISORY", "EVIDENCE_FLOOR"]}, "gate_effect": {"enum": ["NONE", "EXISTING_PEER_GATES"]}
      }
    }
  }
}
