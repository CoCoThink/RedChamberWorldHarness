{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "protocol_sha256",
    "reviewer",
    "raw_review",
    "results",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "protocol_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "reviewer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "independent_of_corrections"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "const": "INDEPENDENT_HUMAN"
        },
        "independent_of_corrections": {
          "const": true
        }
      }
    },
    "raw_review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "asset_ref",
        "sha256"
      ],
      "properties": {
        "asset_ref": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "results": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_ref",
          "carrier_edition_confirmed",
          "excerpt_valid",
          "witness_tier_unchanged",
          "claim_impact_reviewed",
          "notes"
        ],
        "properties": {
          "source_ref": {
            "type": "string",
            "minLength": 1
          },
          "carrier_edition_confirmed": {
            "type": "boolean"
          },
          "excerpt_valid": {
            "type": "boolean"
          },
          "witness_tier_unchanged": {
            "type": "boolean"
          },
          "claim_impact_reviewed": {
            "type": "boolean"
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "authority_effect": {
      "const": "NONE"
    }
  }
}
