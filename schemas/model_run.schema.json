{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "provider",
    "sdk_version",
    "request",
    "request_sha256",
    "response",
    "response_sha256",
    "request_id",
    "usage",
    "stop_reason",
    "started_at",
    "finished_at",
    "template",
    "inputs",
    "budget",
    "extraction",
    "output",
    "output_sha256",
    "status",
    "findings",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "MODEL_RUN"
    },
    "provider": {
      "type": "string",
      "minLength": 1
    },
    "sdk_version": {
      "type": "string",
      "minLength": 1
    },
    "request": {
      "type": "object",
      "required": [
        "model",
        "system",
        "messages",
        "max_tokens"
      ],
      "properties": {
        "model": {
          "type": "string",
          "minLength": 1
        },
        "system": {
          "type": "string",
          "minLength": 1
        },
        "messages": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "role",
              "content"
            ]
          }
        },
        "max_tokens": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": true
    },
    "request_sha256": {
      "$ref": "#/$defs/sha"
    },
    "response": {
      "type": "object",
      "required": [
        "id",
        "model",
        "content",
        "stop_reason",
        "usage"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "content": {
          "type": "array"
        },
        "stop_reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "usage": {
          "type": "object"
        }
      },
      "additionalProperties": true
    },
    "response_sha256": {
      "$ref": "#/$defs/sha"
    },
    "request_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "usage": {
      "type": "object"
    },
    "stop_reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "started_at": {
      "type": "string",
      "minLength": 1
    },
    "finished_at": {
      "type": "string",
      "minLength": 1
    },
    "template": {
      "$ref": "#/$defs/binding"
    },
    "inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "budget": {
      "type": "object",
      "required": [
        "max_tokens",
        "timeout_seconds",
        "max_retries",
        "max_requests",
        "max_output_tokens",
        "max_input_bytes"
      ],
      "properties": {
        "max_tokens": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128000
        },
        "timeout_seconds": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 600
        },
        "max_retries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        },
        "max_requests": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_input_bytes": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "extraction": {
      "const": "CONCAT_TEXT_BLOCKS_UTF8_NO_SEPARATOR"
    },
    "output": {
      "type": "string"
    },
    "output_sha256": {
      "$ref": "#/$defs/sha"
    },
    "status": {
      "enum": [
        "PASS",
        "FAIL"
      ]
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "authority_effect": {
      "const": "NONE"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "binding": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha"
        }
      },
      "additionalProperties": false
    }
  }
}
