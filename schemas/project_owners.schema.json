{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "CurrentProjectOwners",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "owners",
    "plan_constraints_binding"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "id": {
      "const": "project:rcwh"
    },
    "owners": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "capability",
        "literary",
        "competitions",
        "release",
        "implementation",
        "plan_constraints"
      ],
      "properties": {
        "capability": {
          "type": "string",
          "minLength": 1
        },
        "literary": {
          "type": "string",
          "minLength": 1
        },
        "competitions": {
          "type": "string",
          "minLength": 1
        },
        "release": {
          "type": "string",
          "minLength": 1
        },
        "implementation": {
          "type": "string",
          "minLength": 1
        },
        "plan_constraints": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "plan_constraints_binding": {
      "type": "object",
      "required": [
        "id",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    }
  }
}
