{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RCWH Pareto Evaluation v0.9",
  "type": "object",
  "required": [
    "id",
    "authority",
    "rule",
    "axes",
    "mechanism_axes",
    "full_axes",
    "historical_cost_mapping",
    "world_pressure_kinds",
    "hypothesis_burdens",
    "scenario_expert_axes",
    "pareto_policy",
    "effects",
    "next_gate",
    "schema_version"
  ],
  "properties": {
    "id": {
      "const": "pareto-evaluation:v0.9"
    },
    "authority": {
      "const": "SHADOW_ONLY"
    },
    "rule": {
      "type": "string",
      "minLength": 1
    },
    "axes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": [
          "metric",
          "direction",
          "source",
          "description"
        ],
        "properties": {
          "metric": {
            "type": "string"
          },
          "direction": {
            "enum": [
              "MINIMIZE",
              "MAXIMIZE"
            ]
          },
          "source": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "mechanism_axes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "full_axes": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "historical_cost_mapping": {
      "type": "object",
      "required": [
        "LOW",
        "MEDIUM",
        "HIGH",
        "UNKNOWN"
      ],
      "properties": {
        "LOW": {
          "type": "integer",
          "minimum": 0
        },
        "MEDIUM": {
          "type": "integer",
          "minimum": 0
        },
        "HIGH": {
          "type": "integer",
          "minimum": 0
        },
        "UNKNOWN": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "world_pressure_kinds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "hypothesis_burdens": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "hypothesis_id",
          "evidence_distance",
          "open_consumption",
          "chapter_economy",
          "rationale"
        ],
        "properties": {
          "hypothesis_id": {
            "type": "string",
            "pattern": "^HYP-[A-Z0-9-]+$"
          },
          "evidence_distance": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "open_consumption": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "chapter_economy": {
            "type": "integer",
            "minimum": 0,
            "maximum": 5
          },
          "rationale": {
            "type": "object",
            "required": [
              "evidence_fit",
              "open_consumption",
              "chapter_economy"
            ],
            "properties": {
              "evidence_fit": {
                "type": "string"
              },
              "open_consumption": {
                "type": "string"
              },
              "chapter_economy": {
                "type": "string"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "scenario_expert_axes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "scenario_id",
          "front80_structural_echo",
          "literary_fertility",
          "rationale",
          "basis_refs"
        ],
        "properties": {
          "scenario_id": {
            "type": "string",
            "pattern": "^SCN-[A-Z0-9-]+$"
          },
          "front80_structural_echo": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "literary_fertility": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "rationale": {
            "type": "string",
            "minLength": 1
          },
          "basis_refs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^LE-D\\d{2}$"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "pareto_policy": {
      "type": "object",
      "required": [
        "no_total_score",
        "no_automatic_winner",
        "dominance_rule",
        "mechanism_frontier",
        "full_frontier"
      ],
      "properties": {
        "no_total_score": {
          "const": true
        },
        "no_automatic_winner": {
          "const": true
        },
        "dominance_rule": {
          "type": "string"
        },
        "mechanism_frontier": {
          "type": "string"
        },
        "full_frontier": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "effects": {
      "type": "object",
      "required": [
        "evidence",
        "open_interfaces",
        "stable_active",
        "competitions"
      ],
      "properties": {
        "evidence": {
          "const": "NONE"
        },
        "open_interfaces": {
          "const": "NONE"
        },
        "stable_active": {
          "const": "NONE"
        },
        "competitions": {
          "const": "NONE"
        }
      },
      "additionalProperties": false
    },
    "next_gate": {
      "enum": [
        "P3_CI_THEN_P4_SCENARIO_LITERARY_STRESS_TEST",
        "P4_SCENARIO_LITERARY_STRESS_TEST"
      ]
    },
    "schema_version": {
      "const": 1
    }
  },
  "additionalProperties": false
}
