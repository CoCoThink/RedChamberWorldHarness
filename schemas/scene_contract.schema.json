{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SceneContract",
  "type": "object",
  "required": [
    "id",
    "chapter",
    "preconditions",
    "participants",
    "required_beats",
    "forbidden_beats",
    "exit_state"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "chapter": {
      "type": "integer"
    },
    "preconditions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_objects": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_beats": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "forbidden_beats": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "p_locks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "historical_adapters": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exit_state": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "knowledge_checkpoint": {
      "type": "string"
    },
    "knowledge_guards": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "actor",
          "fact",
          "modes",
          "any_text"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "actor": {
            "type": "string"
          },
          "fact": {
            "type": "string"
          },
          "checkpoint": {
            "type": "string"
          },
          "allowed_status": {
            "type": "array",
            "items": {
              "enum": [
                "knows",
                "believes",
                "suspects",
                "does_not_know",
                "UNSPECIFIED"
              ]
            }
          },
          "modes": {
            "type": "array",
            "items": {
              "enum": [
                "DIALOGUE",
                "ACTION",
                "ANY"
              ]
            }
          },
          "any_text": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "voice_profile_hooks": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "historical_adapter_requirements": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "required_any": {
            "type": "array",
            "items": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            }
          },
          "forbidden_any": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
