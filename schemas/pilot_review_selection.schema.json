{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "export_root", "packet_sha256", "mapping_sha256", "reviews", "authority_effect"],
  "properties": {
    "schema_version": {"const": 1},
    "export_root": {"$ref": "#/$defs/repository_path"},
    "packet_sha256": {"$ref": "#/$defs/sha256"},
    "mapping_sha256": {"$ref": "#/$defs/sha256"},
    "reviews": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": {"$ref": "#/$defs/repository_path"},
          "sha256": {"$ref": "#/$defs/sha256"}
        }
      }
    },
    "authority_effect": {"const": "NONE"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "repository_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.{1,2}(?:/|$))(?!.*[\\\\:])(?!.*//)(?!.*?/$).+$"
    }
  }
}
