{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RCWH Literary Evaluator Suite v0.5",
  "type": "object",
  "required": [
    "id",
    "issue",
    "status",
    "authority",
    "automatic_literary_pass",
    "principles",
    "culture_not_museum",
    "exposition",
    "ambiguity",
    "structure",
    "poetry",
    "blind_read",
    "completion"
  ],
  "properties": {
    "id": {
      "const": "literary-evaluator-suite:v0.5"
    },
    "issue": {
      "const": 5
    },
    "status": {
      "type": "string"
    },
    "authority": {
      "const": "LITERARY_SCREENING_ONLY"
    },
    "automatic_literary_pass": {
      "const": false
    },
    "principles": {
      "type": "object"
    },
    "culture_not_museum": {
      "type": "object"
    },
    "exposition": {
      "type": "object"
    },
    "ambiguity": {
      "type": "object"
    },
    "structure": {
      "type": "object"
    },
    "poetry": {
      "type": "object"
    },
    "blind_read": {
      "type": "object"
    },
    "completion": {
      "type": "object",
      "required": [
        "culture_not_museum_deletion_test",
        "explicit_exposition_detector",
        "ambiguity_preservation",
        "structural_variation_checks",
        "poetry_abc_lane",
        "blind_output_evidence_separated"
      ],
      "properties": {
        "culture_not_museum_deletion_test": {
          "const": true
        },
        "explicit_exposition_detector": {
          "const": true
        },
        "ambiguity_preservation": {
          "const": true
        },
        "structural_variation_checks": {
          "const": true
        },
        "poetry_abc_lane": {
          "const": true
        },
        "blind_output_evidence_separated": {
          "const": true
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
