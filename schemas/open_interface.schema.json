{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenInterface",
  "type": "object",
  "required": [
    "id",
    "title",
    "state",
    "uncertainty",
    "current_model",
    "forbidden_hardening",
    "reopen_triggers"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^OL-[0-9]{3,}$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "const": "OPEN_LOCKED"
    },
    "uncertainty": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "current_model": {
      "type": "object",
      "required": [
        "status",
        "summary"
      ],
      "properties": {
        "status": {
          "enum": [
            "CURRENT_C_HIGH",
            "CURRENT_C_MAIN",
            "CURRENT_C",
            "CURRENT_PC",
            "CURRENT_C_H",
            "CURRENT_FORMAT",
            "CURRENT_PROJECT",
            "NONE"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "hard_anchor_decision_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "open_decision_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "current_decision_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "literal_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "mechanism_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^H[0-9]{2,}$"
      }
    },
    "implementation_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "forbidden_hardening": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "reopen_triggers": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "NEW_DIRECT_WITNESS",
          "PROVENANCE_REGRADE",
          "ROLE_REGRADE",
          "MODALITY_REGRADE",
          "TARGET_REGRADE",
          "PLACEMENT_REGRADE",
          "NEW_PRIMARY_HISTORY_CONTRADICTION",
          "DOWNSTREAM_VIOLATION"
        ]
      }
    },
    "project_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": true
}
