{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "draft",
    "input_snapshot",
    "compatibility_basis",
    "validation",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "WRITING_HISTORY_MIGRATION"
    },
    "draft": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "input_snapshot": {
      "type": "object",
      "required": [
        "path",
        "sha256"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "additionalProperties": false
    },
    "compatibility_basis": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "renderer_version",
            "context",
            "task",
            "inputs",
            "dependency_records"
          ],
          "properties": {
            "renderer_version": {
              "const": 2
            },
            "context": {
              "type": "object"
            },
            "task": {
              "type": "object"
            },
            "inputs": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "path",
                  "sha256"
                ],
                "properties": {
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "additionalProperties": false
              }
            },
            "dependency_records": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "kind",
                  "id",
                  "sha256",
                  "value"
                ],
                "properties": {
                  "kind": {
                    "enum": [
                      "SOURCE",
                      "CLAIM",
                      "ASSET"
                    ]
                  },
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "value": {
                    "type": "object"
                  }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      ]
    },
    "validation": {
      "const": "V1_FRESH_RENDERER_AND_EXACT_INPUT_BYTES"
    },
    "authority_effect": {
      "const": "NONE"
    }
  },
  "additionalProperties": false
}
