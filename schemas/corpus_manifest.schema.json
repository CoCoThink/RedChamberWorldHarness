{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "dataset_ref",
    "scope",
    "build_config",
    "builder",
    "dependencies",
    "products",
    "readiness",
    "authority_effect",
    "source_record_digest"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "dataset_ref": {
      "type": "string",
      "pattern": "^corpus:front80:[a-zA-Z0-9:_-]+$"
    },
    "scope": {
      "enum": [
        "PILOT",
        "FRONT80_CANDIDATE"
      ]
    },
    "build_config": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "document"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "document": {
          "type": "object"
        }
      }
    },
    "builder": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "code_sha256"
      ],
      "properties": {
        "name": {
          "const": "rcwh-corpus"
        },
        "version": {
          "const": 1
        },
        "code_sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      }
    },
    "dependencies": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_ref",
          "sha256"
        ],
        "properties": {
          "asset_ref": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "products": {
      "type": "object",
      "minProperties": 7,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "asset_ref",
          "sha256",
          "bytes"
        ],
        "properties": {
          "asset_ref": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "readiness": {
      "const": "CANDIDATE_PENDING_HUMAN_AUDIT"
    },
    "authority_effect": {
      "const": "NONE"
    },
    "source_record_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
