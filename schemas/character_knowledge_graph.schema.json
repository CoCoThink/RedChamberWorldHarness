{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RCWH Character Knowledge Graph v0.3 Slice 1",
  "type": "object",
  "required": [
    "id",
    "epistemic_rule",
    "sources",
    "facts",
    "characters",
    "scenes",
    "schema_version",
    "policy"
  ],
  "properties": {
    "id": {
      "const": "character-truth:v0.3:slice1"
    },
    "epistemic_rule": {
      "type": "string",
      "minLength": 40
    },
    "sources": {
      "type": "object"
    },
    "facts": {
      "type": "array",
      "minItems": 1
    },
    "characters": {
      "type": "array",
      "minItems": 1
    },
    "scenes": {
      "type": "array",
      "minItems": 1
    },
    "schema_version": {
      "const": 1
    },
    "policy": {
      "type": "object",
      "required": [
        "automatic_voice_identity"
      ],
      "properties": {
        "automatic_voice_identity": {
          "const": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
