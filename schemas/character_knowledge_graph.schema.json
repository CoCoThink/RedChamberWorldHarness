{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RCWH Character Knowledge Graph v0.3 Slice 1",
  "type": "object",
  "required": [
    "id",
    "issue",
    "status",
    "epistemic_rule",
    "sources",
    "facts",
    "characters",
    "scenes",
    "completion"
  ],
  "properties": {
    "id": {
      "const": "character-truth:v0.3:slice1"
    },
    "issue": {
      "const": 3
    },
    "status": {
      "type": "string"
    },
    "epistemic_rule": {
      "type": "string",
      "minLength": 40
    },
    "sources": {
      "type": "object"
    },
    "facts": {
      "type": "array",
      "minItems": 1
    },
    "characters": {
      "type": "array",
      "minItems": 6,
      "maxItems": 6
    },
    "scenes": {
      "type": "array",
      "minItems": 3
    },
    "completion": {
      "type": "object",
      "required": [
        "characters",
        "scenes",
        "event_driven_updates",
        "omniscience_validator",
        "voice_masking_hooks",
        "automatic_voice_identity"
      ],
      "properties": {
        "characters": {
          "const": 6
        },
        "scenes": {
          "const": 3
        },
        "event_driven_updates": {
          "const": true
        },
        "omniscience_validator": {
          "const": true
        },
        "voice_masking_hooks": {
          "const": true
        },
        "automatic_voice_identity": {
          "const": false
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
