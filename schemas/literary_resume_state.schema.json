{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RCWH Literary Workflow Selection",
  "type": "object",
  "required": [
    "phase",
    "status",
    "stable_active",
    "literary_resume_started",
    "sequence",
    "authority_rule"
  ],
  "properties": {
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "const": "ACTIVE"
    },
    "stable_active": {
      "type": "object",
      "required": [
        "sha256"
      ],
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "literary_resume_started": {
      "const": true
    },
    "sequence": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "authority_rule": {
      "type": "string",
      "minLength": 20
    }
  },
  "additionalProperties": false
}
