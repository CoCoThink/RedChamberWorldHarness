{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "competition",
    "chapter",
    "inputs",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {
      "const": 2
    },
    "kind": {
      "const": "REVIEW_SEMANTIC_INPUT_MANIFEST"
    },
    "competition": {
      "type": "string",
      "minLength": 1
    },
    "chapter": {
      "type": "integer",
      "minimum": 1
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "required": [
          "path",
          "sha256"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "authority_effect": {
      "const": "NONE"
    }
  },
  "additionalProperties": false
}
