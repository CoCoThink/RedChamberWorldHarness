{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "FullMigrationM1Registry",
  "type": "object",
  "required": [
    "packages",
    "package_lineage",
    "documents",
    "content_hashes",
    "authority_statuses",
    "package_class_policies",
    "current_authority"
  ],
  "properties": {
    "packages": {
      "type": "array",
      "minItems": 19,
      "maxItems": 19
    },
    "package_lineage": {
      "type": "array",
      "minItems": 1
    },
    "documents": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24
    },
    "content_hashes": {
      "type": "array",
      "minItems": 24,
      "maxItems": 24
    },
    "authority_statuses": {
      "type": "array",
      "minItems": 1
    },
    "package_class_policies": {
      "type": "array",
      "minItems": 1
    },
    "current_authority": {
      "type": "object",
      "required": [
        "stable_package_ref",
        "stable_active_sha256",
        "v4_1_package_file_count",
        "current_runtime_document_count",
        "registry_coverage",
        "semantic_coverage_counts",
        "completion_gate_ready"
      ],
      "properties": {
        "stable_package_ref": {
          "const": "pkg:stable-active-v4.1"
        },
        "stable_active_sha256": {
          "const": "4645da79b1bed76f54be281c50b5df648f599ea41541fb7855685753b6a85320"
        },
        "v4_1_package_file_count": {
          "const": 23
        },
        "current_runtime_document_count": {
          "const": 15
        },
        "registry_coverage": {
          "const": "FULL"
        },
        "completion_gate_ready": {
          "const": false
        }
      }
    }
  },
  "additionalProperties": false
}
