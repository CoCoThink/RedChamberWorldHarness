{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RCWH M5 Registry Extension",
  "type": "object",
  "required": [
    "milestone",
    "document_additions",
    "content_hash_additions",
    "document_overrides",
    "current_authority_override"
  ],
  "properties": {
    "milestone": {
      "const": "M5"
    },
    "document_additions": {
      "type": "array",
      "minItems": 27,
      "maxItems": 27
    },
    "content_hash_additions": {
      "type": "array",
      "minItems": 27,
      "maxItems": 27
    },
    "document_overrides": {
      "type": "object",
      "minProperties": 2,
      "maxProperties": 2
    },
    "current_authority_override": {
      "type": "object",
      "required": [
        "literary_ecology_runtime",
        "literary_ecology_queryable",
        "literary_ecology_source_documents",
        "current_markdown_islands",
        "completion_gate_ready"
      ],
      "properties": {
        "literary_ecology_runtime": {
          "type": "string"
        },
        "literary_ecology_queryable": {
          "const": true
        },
        "literary_ecology_source_documents": {
          "const": 29
        },
        "current_markdown_islands": {
          "const": 0
        },
        "completion_gate_ready": {
          "const": false
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
