{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RCWH M3 Assembled World Runtime",
  "type": "object",
  "required": [
    "epistemic_rule",
    "sources",
    "characters",
    "relations",
    "institutions",
    "baseline",
    "events",
    "locations",
    "presence_matrix",
    "body_matrix",
    "economy_stages",
    "resource_flows",
    "knowledge_rules",
    "longlines",
    "schema_version"
  ],
  "properties": {
    "epistemic_rule": {
      "type": "string",
      "minLength": 20
    },
    "sources": {
      "type": "object",
      "minProperties": 1
    },
    "characters": {
      "type": "array",
      "minItems": 1
    },
    "locations": {
      "type": "array",
      "minItems": 1
    },
    "relations": {
      "type": "array",
      "minItems": 1
    },
    "institutions": {
      "type": "array",
      "minItems": 1
    },
    "baseline": {
      "type": "object"
    },
    "events": {
      "type": "array",
      "minItems": 1
    },
    "presence_matrix": {
      "type": "array",
      "minItems": 1
    },
    "body_matrix": {
      "type": "array",
      "minItems": 1
    },
    "economy_stages": {
      "type": "array",
      "minItems": 1
    },
    "resource_flows": {
      "type": "array",
      "minItems": 1
    },
    "knowledge_rules": {
      "type": "array",
      "minItems": 1
    },
    "longlines": {
      "type": "array",
      "minItems": 1
    },
    "schema_version": {
      "const": 1
    }
  },
  "additionalProperties": false
}
