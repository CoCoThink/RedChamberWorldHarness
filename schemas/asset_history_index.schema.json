{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "pack_refs"],
  "properties": {
    "schema_version": {"const": 1},
    "pack_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^asset:"}}
  }
}
