{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RCWH M4 Registry Extension",
  "type": "object",
  "required": [
    "milestone",
    "document_additions",
    "content_hash_additions",
    "document_overrides",
    "current_authority_override"
  ],
  "properties": {
    "milestone": {
      "const": "M4"
    },
    "document_additions": {
      "type": "array",
      "maxItems": 0
    },
    "content_hash_additions": {
      "type": "array",
      "maxItems": 0
    },
    "document_overrides": {
      "type": "object"
    },
    "current_authority_override": {
      "type": "object",
      "required": [
        "object_runtime",
        "object_queryable",
        "current_markdown_islands",
        "completion_gate_ready"
      ],
      "properties": {
        "object_runtime": {
          "type": "string"
        },
        "object_queryable": {
          "const": true
        },
        "current_markdown_islands": {
          "const": 0
        },
        "completion_gate_ready": {
          "const": false
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
