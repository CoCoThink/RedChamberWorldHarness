{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "RCWH Scenario Bundle v0.7",
  "type": "object",
  "required": [
    "id",
    "title",
    "status",
    "authority",
    "hypotheses",
    "open_interfaces",
    "current_c_relation",
    "search_policy",
    "world_replay",
    "evidence_effect",
    "stable_active_effect"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^SCN-[A-Z0-9-]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "ADMISSIBLE",
        "BLOCKED",
        "DEFERRED"
      ]
    },
    "authority": {
      "const": "SCENARIO_ONLY"
    },
    "hypotheses": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^HYP-[A-Z0-9-]+$"
      }
    },
    "open_interfaces": {
      "type": "object",
      "required": [
        "policy",
        "closed_by_scenario"
      ],
      "properties": {
        "policy": {
          "const": "PRESERVE_OPEN"
        },
        "closed_by_scenario": {
          "type": "array",
          "maxItems": 0
        }
      },
      "additionalProperties": false
    },
    "current_c_relation": {
      "enum": [
        "CURRENT_C_REFERENCE",
        "ALTERNATIVE"
      ]
    },
    "search_policy": {
      "type": "object",
      "required": [
        "search_priority",
        "evidence_bonus",
        "baseline_convenience_bonus"
      ],
      "properties": {
        "search_priority": {
          "enum": [
            "NONE",
            "EQUAL"
          ]
        },
        "evidence_bonus": {
          "const": "NONE"
        },
        "baseline_convenience_bonus": {
          "const": "NONE"
        }
      },
      "additionalProperties": false
    },
    "world_replay": {
      "type": "object",
      "required": [
        "status",
        "result_ref"
      ],
      "properties": {
        "status": {
          "enum": [
            "PENDING_P2",
            "AVAILABLE_V08"
          ]
        },
        "result_ref": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false
    },
    "evidence_effect": {
      "const": "NONE"
    },
    "stable_active_effect": {
      "const": "NONE"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
