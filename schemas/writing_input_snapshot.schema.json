{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "kind",
    "entries",
    "records",
    "authority_effect"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "kind": {
      "const": "WRITING_INPUT_SNAPSHOT"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "original",
          "blob"
        ],
        "properties": {
          "original": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "additionalProperties": false
          },
          "blob": {
            "type": "object",
            "required": [
              "path",
              "sha256"
            ],
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "additionalProperties": false
          }
        },
        "additionalProperties": false
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "id",
          "sha256",
          "value"
        ],
        "properties": {
          "kind": {
            "enum": [
              "SOURCE",
              "CLAIM",
              "ASSET"
            ]
          },
          "id": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "value": {
            "type": "object"
          }
        },
        "additionalProperties": false
      }
    },
    "authority_effect": {
      "const": "NONE"
    }
  },
  "additionalProperties": false
}
