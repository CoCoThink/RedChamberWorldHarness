{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PromotionCandidate",
  "type": "object",
  "required": [
    "id",
    "state",
    "source_competition",
    "winner_candidate_id",
    "baseline",
    "candidate",
    "allowed_changed_chapters",
    "checks",
    "stable_active_effect",
    "release_action"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^promotion:ch86:b:v1-5-candidate$"
    },
    "state": {
      "const": "REGRESSION_PASS"
    },
    "source_competition": {
      "const": "comp:43-0:ch86:pressure-test"
    },
    "winner_candidate_id": {
      "const": "ch86-B"
    },
    "baseline": {
      "type": "object",
      "required": [
        "file_ref",
        "sha256",
        "asset_ref"
      ],
      "properties": {
        "file_ref": {
          "type": "string"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "asset_ref": {
          "type": "string",
          "pattern": "^asset:"
        }
      },
      "additionalProperties": false
    },
    "candidate": {
      "type": "object",
      "required": [
        "sha256",
        "replacements"
      ],
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "replacements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "chapter",
              "path",
              "sha256",
              "trailing_newlines"
            ],
            "additionalProperties": false,
            "properties": {
              "chapter": {
                "type": "integer",
                "minimum": 1
              },
              "path": {
                "type": "string"
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "trailing_newlines": {
                "type": "integer",
                "minimum": 0,
                "maximum": 10
              }
            }
          }
        }
      }
    },
    "allowed_changed_chapters": {
      "const": [
        86
      ]
    },
    "baseline_chapter_sha256": {
      "type": "object"
    },
    "checks": {
      "type": "object",
      "additionalProperties": {
        "enum": [
          "PASS",
          "FAIL"
        ]
      }
    },
    "stable_active_effect": {
      "const": "NONE"
    },
    "release_action": {
      "const": "SEPARATE_EXPLICIT_PROMOTION_REQUIRED"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
