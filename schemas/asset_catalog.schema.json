{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PhysicalAssetCatalog",
  "type": "object",
  "required": ["schema_version", "assets"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"const": 1},
    "assets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "path", "sha256", "bytes", "media_type", "kind", "immutable", "origin_refs"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "pattern": "^asset:[a-zA-Z0-9._:-]+$"},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "bytes": {"type": "integer", "minimum": 0},
          "media_type": {"type": "string", "minLength": 1},
          "kind": {"enum": ["PRIMARY_TEXT_CONTAINER", "PROJECT_REFERENCE", "PROJECT_RESEARCH", "RELEASE_TEXT", "HISTORICAL_RECORD", "IMPORT_RECORD", "REVIEW_RECORD", "UNCLASSIFIED_INPUT", "CORPUS_DERIVATIVE"]},
          "immutable": {"const": true},
          "origin_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^origin:"}},
          "derived_from": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^asset:"}}
        }
      }
    }
  }
}
