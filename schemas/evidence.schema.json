{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvidenceClaim",
  "type": "object",
  "required": ["id", "witness", "role", "modality", "literal_target", "placement", "status"],
  "properties": {
    "id": {"type": "string"},
    "source_ref": {"type": ["string", "null"]},
    "witness": {"enum": ["W1_DIRECT", "W1_SEEN", "W2_TRANSCRIPT", "EDITORIAL"]},
    "role": {"type": "string"},
    "modality": {"type": "string"},
    "literal_target": {"type": "string"},
    "placement": {"type": "string"},
    "status": {"enum": ["HARD", "OPEN_LOCKED", "CURRENT_IMPLEMENTATION", "HISTORICAL_NOTE"]},
    "text": {"type": ["string", "null"]},
    "notes": {"type": ["string", "null"]},
    "reopen_triggers": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
